---
// Page not found. Astro builds this to /404.html, which static hosts serve for
// any address that does not exist. Added 25 Sep 2026 at the client's request.
//
// `noindex`: a not-found page should never sit in search results. The
// canonical points at the file itself because Base requires one; with noindex
// set it carries no weight.
//
// Same shell as thank-you.astro: minimal hero, then the main routes into the
// site so a reader who followed a dead link has somewhere to go.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { meetTheTeamBusiness } from '../data/meetTheTeam';
import { z } from 'astro/zod';
import { getPage } from '../lib/cms';
import * as section from '../lib/cms-schemas';

// CONTENT lives in src/content/pages/404.yaml and is edited in Pages CMS
// ("Page not found").
const page = await getPage(
  '404',
  z.object({
    seo: section.seo,
    // The `minimal` hero has no photo, and there is no usual button to fall
    // back to here, so the button is required.
    hero: section.hero.omit({ image: true }).extend({ cta: section.link }),
    whereToNext: section.tagCloud,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/404.html',
};

const business = meetTheTeamBusiness(pageMeta.description);
---

<Base
  title={pageMeta.title}
  description={pageMeta.description}
  canonical={pageMeta.canonical}
  business={business}
  noindex
>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="minimal"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta}
    />

    <TagCloud
      heading={page.whereToNext.heading}
      subheading={page.whereToNext.subheading}
      tags={page.whereToNext.tags}
      note={page.whereToNext.note}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
