---
// Retail and shopfronts — one of the THIRTEEN "by type of premises" leaf
// pages under the /commercial-cleaning/ hub (navigation.ts, "By type of
// premises" group). Built in one pass with its twelve siblings.
//
// NO CONTENT BRIEF EXISTS for any of the thirteen. All copy below is DRAFTED,
// not supplied. See src/pages/commercial-cleaning/office-cleaning.astro's header for the launch
// blockers shared across the whole cluster.
//
// ⚠️ THIS IS THE SMALLEST-TICKET PAGE IN THE CLUSTER, and the page is built
// around that rather than pretending otherwise. A single shopfront on a main
// street in Bangalow or Mullumbimby is a thirty-minute daily visit, which is
// below the point where a site walkthrough and a written scope pay for
// themselves in the way they do on the other twelve.
//
// So this is the ONE page in the cluster that does not lead with "Book a site
// walkthrough". It leads with the sitewide `quoteCta` instead, because for a
// small shop the honest, low-friction path really is a quote rather than a
// meeting — and the brand foundation document's §2.4 lists "Get an instant
// quote" as a preferred CTA precisely for this kind of buyer. The walkthrough
// CTA still appears further down, for the reader with a strip of tenancies or
// a larger store.
//
// WHAT ELSE MAKES THIS PAGE DIFFERENT structurally:
//   - `ServiceBlocks variant="list"` for the scope, with rows ordered by the
//     CLOCK rather than by area or frequency: what happens before you open,
//     during trade, after close, periodically. Strata also uses `list`, but
//     for areas; this is the only clock-ordered scope in the cluster.
//   - `Callout tone="note"` on the shared-mall problem, which is genuinely
//     confusing for a tenant and costs them money in both directions.
//   - `ImageBand` on the shopfront glass, because glass IS the product on
//     this premises type and the frame argues it better than a paragraph.
//   - No `ComparisonTable`, no `MetricsBlock`. This page is short on purpose:
//     a shop owner reading it is doing so between customers.
//
// BLOCKS LAUNCH, specific to this page:
//   - MINIMUM CHARGE. This is the page where it matters most and it is
//     bracketed twice. A thirty-minute visit has to clear a minimum or the
//     job loses money, and a shop owner should find that out from the page
//     rather than from a quote that surprises them.
//   - Whether TLB will do external shopfront glass, and up to what height.
//     Bracketed in §5.
//   - Whether TLB takes multi-tenancy or shopping-centre work, which is a
//     different sale entirely. Bracketed in branded FAQ 6.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import ImageBand from '../../components/sections/ImageBand.astro';
import Callout from '../../components/sections/Callout.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
// This page's own frames are in src/assets/commercial_cleaning/premises/;
// the prompts are in that folder's IMAGE-PROMPTS.md. Both are shot before
// opening with no shoppers in frame, which is both honest about when the work
// happens and the only way to photograph a shop floor without inventing
// customers.
// §2 backdrop, behind the Cream scrim — the homepage's, same as the hub.
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { nswLocationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { commercialBusiness, relatedPremises, walkthroughCtaLabel } from '../../data/premises';
import { howItWorks, managedForYou, theLineBody } from '../../data/brand-lines';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

// §0 Metadata. "Shop cleaning" and "retail cleaning" are both head terms and
// "shopfront" is the local word, so all three concepts sit in the title and
// description.
//
// In `pageMeta`, on `canonical`:
// ⚠️ Placeholder domain, same as every sibling page. Confirm before launch.

// ⚠️ NOTE THE TWO CTAs, and the order of them. This is the only page in the
// cluster that leads with the sitewide quote CTA rather than the walkthrough,
// for the reason set out in the file header: a thirty-minute daily visit does
// not justify a meeting, and the brand document's §2.4 names "Get an instant
// quote" as a preferred CTA for exactly this buyer.
//
// The walkthrough is offered further down, once the page has established
// that a bigger store or a strip of tenancies is a different conversation.

// §1 Hero. `split-single-image`, image right, and the CTA is `quoteCta`.
//
// ⚠️ GENERATED, NOT PHOTOGRAPHED. Same standing note as every premises page.

// §2 Definition. Answer-target block. Paragraph two names what is genuinely
// different about retail: the cleaning is merchandising, and the surface that
// matters most is the one the customer never touches.

// §3 Scope. `ServiceBlocks variant="list"` — ordered BY THE CLOCK: before you
// open, during trade, after close, periodically. Strata also uses `list` but
// for areas; this is the only clock-ordered scope in the cluster, and it is
// the order a shop owner actually thinks in.
//
// ⚠️ EVERY ITEM IS DRAFTED against standard practice, not supplied by TLB.
// The external glass row carries a real bracket.
//
// In `clockItems`, on "External glass and the footpath" (description):
// ⚠️ Real bracket. Height and reach decide whether this is a cleaning
// job or a licensed one.

// §4 The shared-mall problem. `note` — it corrects a belief a tenant
// commonly holds and it costs them money in both directions: paying for
// cleaning their lease already covers, or assuming cover they do not have.
//
// UNIQUE TO THIS PAGE, and it is the retail equivalent of the strata page's
// common-property-versus-lots distinction.

// §5 "Worth knowing". The lever here is that a shop's cleaning failure is
// visible from the street to people who never come in, so the cost is
// invisible in a way an office's is not.

// §6 Related pages. Window cleaning and pressure cleaning are appended as
// extras, because both are genuinely the thing a shopfront reader wants next
// and both already exist.

// §8 Branded FAQs, in the CUSTOMER'S voice — a shop owner or manager. The
// small-ticket reality of this page shows up here more than anywhere: two of
// the six answers are about money and minimums.
//
// In `brandedFaqItems`, on "Our shop is small. Is that too small for you?" (answer):
// ⚠️ Real bracket, and it is the most important one on the page.
// In `brandedFaqItems`, on "Do you do the windows too?" (answer):
// ⚠️ Same bracket as §3.
// In `brandedFaqItems`, on "Do you take on a whole strip or a centre?" (answer):
// ⚠️ Real bracket. A different sale, and worth knowing whether TLB
// wants it.

// §9 Non-branded FAQs, the long-tail block.
//
// ⚠️ VERIFICATION PASS REQUIRED. Checkable claims:
//   - Slips, trips and falls are a leading cause of injury in retail
//     workplaces and a wet floor during trade is a recognised hazard.
//     Correct in substance; no statistic quoted.
//   - Salt aerosol deposits on coastal glass and needs washing with a
//     detergent solution rather than dry wiping. Correct.
//   - A retail lease's cleaning clause typically distinguishes common area
//     cleaning funded through outgoings from cleaning inside the lease line.
//     Correct in substance and hedged to "typically", because leases vary.
//   - No dollar figure anywhere, same as every sibling page.
//
// In `nonBrandedFaqItems`, on "How much does shop cleaning cost?" (answer):
// ⚠️ BRACKETED ON PURPOSE, and here the minimum matters more than the
// rate.

// §10 Closing CTA. `walkthroughCta` here rather than the quote CTA the hero
// used, because by this point in the page the reader who is still going is
// the one with a bigger store or a strip of tenancies — the one for whom a
// walkthrough genuinely pays for itself. See the file header.

// CONTENT lives in src/content/pages/commercial-cleaning/retail-cleaning.yaml
// and is edited in Pages CMS ("Retail cleaning"). This file owns the layout. The
// notes above explain why each section says what it says; they stay here
// because Pages CMS rewrites the YAML on save and would drop them.
const page = await getPage(
  'commercial-cleaning/retail-cleaning',
  z.object({
    seo: section.seo,
    // The label of `walkthroughCta`, the closing block's button. It links to
    // the quote page in Site settings. Empty falls back to the site-wide
    // walkthrough label. The hero and the lease callout lead with the
    // site-wide quote button instead (see the note above `walkthroughCta`).
    ctaLabel: section.optional(section.text),
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    // ServiceBlocks' list variant draws each row's icon, which the shared
    // linkList schema leaves out, so this page adds it.
    clock: section.linkList.extend({
      items: z.array(section.linkList.shape.items.element.extend({ icon: section.optional(section.serviceIcon) })).min(1),
    }),
    glassPhoto: section.imageBand,
    // Its button falls back to the site-wide quote button.
    tenancy: section.callout,
    worthKnowing: section.textBlock,
    // The pills are the other premises pages, from Site settings, plus this
    // page's own extra links (`tags`), which go in after them (§6 above).
    related: section.tagCloud.extend({ note: section.optional(z.array(section.text)) }),
    reviews: section.sectionHeading,
    // The towns come from Site settings.
    whereWeClean: section.tagCloud.omit({ tags: true }),
    // Heading only. The paragraphs are the shared brand lines.
    brandLine: section.sectionHeading,
    brandedFaq: section.faq,
    faq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/commercial-cleaning/retail-cleaning/',
};

const walkthroughCta = { label: page.ctaLabel ?? walkthroughCtaLabel, href: quoteCta.href };

const heroImage = page.hero.image && sized(page.hero.image, '16/9');

const relatedTags = relatedPremises('/commercial-cleaning/retail-cleaning/', page.related.tags ?? []);

const business = commercialBusiness(pageMeta.description);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <ServiceBlocks
      variant="list"
      heading={page.clock.heading}
      lead={page.clock.lead}
      note={page.clock.note}
      items={page.clock.items}
    />

    {/* Glass gets a band of its own because on this premises type glass IS
        the product, and §5 spends two paragraphs arguing it. The photo makes
        the case faster than the prose does.

        ⚠️ Source is 4:3 in a 16/9 box, so `cover` crops top and bottom.
        Checked: the squeegeed swathe, the entry door and the street beyond
        all survive it, which is everything the caption claims. */}
    <ImageBand
      ratio="16/9"
      label={page.glassPhoto.image.label}
      caption={page.glassPhoto.caption}
      src={page.glassPhoto.image.src}
    />

    {/* §4 — the retail equivalent of the strata page's common-property line,
        and it costs a tenant money in both directions. */}
    <Callout tone="note" heading={page.tenancy.heading} body={page.tenancy.body} cta={page.tenancy.cta ?? quoteCta} />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.worthKnowing.heading}
      body={page.worthKnowing.body}
      cta={page.worthKnowing.cta}
      backgroundImage={page.worthKnowing.backgroundImage}
    />

    <TagCloud
      heading={page.related.heading}
      subheading={page.related.subheading}
      tags={relatedTags}
      note={page.related.note ?? []}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      groups={nswLocationGroups}
      note={page.whereWeClean.note}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={page.brandLine.heading}
      body={[managedForYou.recurring, ...theLineBody.commercial, ...howItWorks.general]}
    />

    <Faq heading={page.brandedFaq.heading} lead={page.brandedFaq.lead} items={page.brandedFaq.items} />
    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? walkthroughCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
