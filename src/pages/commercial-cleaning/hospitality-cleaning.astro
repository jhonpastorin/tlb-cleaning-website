---
// Hospitality, venues and holiday parks — one of the THIRTEEN "by type of
// premises" leaf pages under the /commercial-cleaning/ hub (navigation.ts,
// "By type of premises" group). Built in one pass with its twelve siblings.
//
// NO CONTENT BRIEF EXISTS for any of the thirteen. All copy below is DRAFTED,
// not supplied. See src/pages/commercial-cleaning/office-cleaning.astro's header for the launch
// blockers shared across the whole cluster.
//
// ⚠️ THIS IS THE STRONGEST PAGE IN THE CLUSTER ON EVIDENCE, and it is the
// only one where that is true. The brand foundation document's differentiator
// 3 is entirely about short-stay hosting: managing scheduling around
// bookings, restocking essentials, fresh flowers, "set and forget hosting".
// TLB already does turnover work at scale for Airbnb hosts, and a holiday
// park cabin turnover is the same job with a different owner. So unlike its
// twelve siblings, this page's central claim is backed by something in the
// brand document rather than bracketed.
//
// WHAT MAKES THIS PAGE DIFFERENT structurally:
//   - `PathwayCards` splits three genuinely different buyers (a venue, a
//     holiday park, a café or restaurant) rather than three situations. Only
//     this page and the office page use PathwayCards, and they use it for
//     different jobs.
//   - `MetricsBlock variant="strip"` — the one place in the cluster where
//     numbers belong, because turnaround time is the product here. ⚠️ Every
//     figure in it is bracketed; see §6.
//   - `Callout tone="note"` pointing hosts at /airbnb-holiday-home-cleaning/, the same
//     redirect pattern the aged care page uses, and for the same reason: a
//     single-property host who lands here should be somewhere better.
//   - The commercial kitchen link is load-bearing rather than decorative. A
//     café reading this page needs that page, and this one says so instead
//     of pretending to cover it.
//
// BLOCKS LAUNCH, specific to this page:
//   - Every number in §6. Turnaround window, changeover time, linen. The
//     brand document supports "we do this"; it supports no figures.
//   - LINEN. Whether TLB supplies, launders or only changes linen is the
//     single biggest commercial question in cabin and cottage turnovers and
//     it is bracketed in §5 and in branded FAQ 3.
//   - Whether TLB does its own restocking purchasing here as it does for
//     Airbnb hosts, and how consumables are billed.
//   - Whether TLB works inside a commercial kitchen at all, or stops at the
//     front of house. Bracketed in §7 and it is the honest boundary of this
//     page.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import PathwayCards from '../../components/sections/PathwayCards.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
// This page's own frames are in src/assets/commercial_cleaning/premises/;
// the prompts are in that folder's IMAGE-PROMPTS.md.
// NOTE: the holiday park amenities photograph that used to be imported here
// is still in src/assets/commercial_cleaning/premises/ and is now unused. It
// belongs with the held accommodation content, not on this page. Do not delete
// the asset.
// §2 backdrop, behind the Cream scrim — the homepage's, same as the hub.
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { comparisonColumns, serviceComparisonRows } from '../../data/comparison';
// Brief §19. Southern Gold Coast was dropped from this page's town band and
// the subheading trimmed to match. Confirmed with the client as a BUILD
// REGRESSION rather than a deliberate footprint decision, so the three-region
// band is restored: BFD 2.1 requires the whole footprint named and the
// do-not-touch rules treat a trimmed list as a regression rather than a
// choice. Same band the commercial carpet and commercial pressure pages
// already render.
import { locationGroups, locationSubheading } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { commercialBusiness, relatedPremises, walkthroughCtaLabel } from '../../data/premises';
import { howItWorks, managedForYou, theLineBody } from '../../data/brand-lines';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

// 🔴 THIS PAGE WAS REFOCUSED, NOT JUST REWRITTEN. Per the client's decision of
// 22 September 2026, workbook row 33 wins: this page is about restaurants,
// cafes, pubs and function venues, and is no longer about holiday parks.
//
// THE ACCOMMODATION CONTENT WAS MOVED, NOT DELETED. Every holiday park, cabin
// and amenities block that came off this page is preserved verbatim in
// content-plans/HELD-holiday-park-and-cabin-content.md, with its provenance and
// the reason it moved. Its destination is an OPEN CLIENT DECISION and the one
// blocker on this restructure: the recommendation is a new holiday park page
// with its own workbook row. If the client instead chooses to keep the
// accommodation material below the restaurant material here, that file puts
// every block back. Do not discard it.
//
// §0 Metadata. Title and description are the SIGNED-OFF workbook text (Keyword
// Mapping & Metadata, sheet 1 row 33), reproduced verbatim. The old title
// carried none of the mapped primary `commercial restaurant cleaning services`
// (60/mo) and named holiday parks; the old description ran 36 characters over
// and promised holiday park turnovers.
//
// ⚠️ CHANGE REQUEST FOR THE WORKBOOK OWNER, not blocking. The approved title
// drops pubs, cafes and venues entirely, which are three of the four premises
// types this page serves, and it is not what a publican or a cafe owner would
// call the service. Suggested replacement, 48 characters, which is the
// workbook's own Page column wording:
//   'Restaurant, Pub and Venue Cleaning | TLB Cleaning'
//
// ⚠️ AND A LARGER ONE, WHICH SHOULD BE CHECKED BEFORE THIS RESTRUCTURE SHIPS.
// Four of the five mapped secondaries on row 33 are recorded at 0/mo:
// `restaurant cleaning services`, `pub cleaning services`,
// `cafe cleaning services` and `venue cleaning services`. The entire 120/mo
// comes from `commercial restaurant cleaning services` (60/mo) and
// `restaurant commercial cleaning services` (60/mo), which are the same four
// words in two orders. So this page has been restructured to serve a 60/mo
// target whose plain-English variants are all logged as zero. Either those
// cells were never populated or the tool genuinely returned nothing. If
// `restaurant cleaning services` turns out to have real volume, the approved
// title is the wrong one and this restructure stands on firmer ground.
//
// In `pageMeta`, on `canonical`:
// ⚠️ Placeholder domain, same as every sibling page. Confirm before launch.

// Brief §7. The approved workbook CTA is `Book a visit`, so per Rule 4 it goes
// on every in-page button. At twelve characters it fits easily. One primary
// CTA, repeated, per BFD 9.5.
//
// ⚠️ WORTH FLAGGING, not blocking: `Book a visit` is ambiguous in hospitality,
// where "a visit" is what a customer does. A venue manager could reasonably
// read it as booking a table. The label it replaces, `Book a site walkthrough`
// (walkthroughCtaLabel in data/premises.ts, still used by the sibling premises
// pages), had no such ambiguity. Suggested replacement, 18 characters, which
// keeps the approved verb and removes the ambiguity: `Book a walkthrough`.
//
// No BFD 13.2 conflict on this page: there is no `Get an instant quote` on it
// and the pricing block promises a walkthrough and a written scope.

// §1 Hero. `split-single-image`, image right. The café reset is the frame
// that reads as hospitality fastest, and hospitality is the broadest of the
// three audiences.
//
// ⚠️ GENERATED, NOT PHOTOGRAPHED. Same standing note as every premises page.
//
// In `hero`, on "Restaurants, pubs and venues":
// Brief §8. The old label named holiday parks, which this page no longer
// covers. The replacement is the workbook's own Page column scope minus the
// word "cleaning", which the H1 beneath it carries.
// In `hero`, on `headingLines`:
// Brief §4. The mapped primary appeared nowhere in the old H1, and the H1 is
// scored present or absent. The extension is the premises list, doing double
// work here: it carries the three types the approved title drops.
//
// The old line survives the refocus better than anything else on the page,
// because a restaurant lives on reviews exactly as a cabin does. It opens
// the lead and keeps working without a word changed.
// In `hero`, on `subheading`:
// Brief §5. Rule 5's second slot, which this page did not have. Its
// extension is the SCHEDULING PROMISE rather than the H1's premises list,
// and "not around our roster" is lifted from the old hero, so a good phrase
// survives the refocus. It answers the objection a venue raises first: lost
// trading hours.
// In `hero`, on `lead`:
// Brief §6. "Cabins and holiday parks" comes out per the refocus, and the
// scheduling promise comes out because the subheading now carries it. What
// replaces both is the three things this page actually sells, which the
// reader previously had to scroll to find.

// §2 Definition. Answer-target block. Paragraph two states the thing that
// makes this premises type genuinely different from every other page in the
// cluster: the clean is not maintenance, it is the product.
//
// In `definitionBody`, on paragraph 1:
// Brief §10. The opening paragraph is worth 10 of the 100 primary-keyword
// points and needs the mapped phrase inside the first two sentences. "And
// stay" plus the cabins clause come out per the refocus. The definition
// still works, because the four retained premises types genuinely are one
// service.
// In `definitionBody`, on paragraph 2:
// One edit inside an otherwise untouched paragraph. "Cabin shower" and
// "bookings" are accommodation; "bathroom since lunch" and "covers" are the
// restaurant equivalents and they are sharper, because a mid-service
// bathroom is the single most common hospitality complaint. The argument is
// unchanged.

// §3 The three buyers. `PathwayCards` — used here for genuinely different
// buyers rather than for three situations one buyer might be in, which is
// what the office page uses it for. A venue manager, a park manager and a
// café owner want three different things from the same contractor.
//
// In `pathwayCards`, after card 2:
// Brief §11. Card 3, "A holiday park or cabin accommodation", MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md. It routed to a service this page no longer
// sells, so it went with the rest of the accommodation content rather
// than being kept as an orphan. Two cards is still a functioning router
// and the heading above counts to match.

// Brief §12. The §4 single-property redirect, "One cabin, one cottage, one
// apartment?", MOVED to content-plans/HELD-holiday-park-and-cabin-content.md.
// It existed to route single short-stay properties away from a page written
// for multi-property operators; with the accommodation scope gone it had
// nothing left to route.

// §5 Scope. `ServiceBlocks variant="icon-grid"`, grouped by WHEN it happens
// relative to trade: before service, between guests, after an event, and the
// periodic work. That is the grouping this premises type actually thinks in,
// and it differs from the office page's frequency grouping and strata's area
// grouping.
//
// ⚠️ EVERY ITEM IS DRAFTED against standard practice, not supplied by TLB.
// The linen item carries the biggest bracket on the page.
//
// In `scopeItems`, before "After an event: the reset":
// Brief §13.2. "Between guests: the cabin turnover" MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md. It carried the biggest
// unresolved bracket on the page, the linen question.
// In `scopeItems`, before "Periodically, booked outside trade":
// Brief §13.4. "Amenities blocks, more than once a day" MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md. Holiday park specific.
// In `scopeItems`, on "Periodically, booked outside trade":
// Brief §13.5. Kept, with the seasonality changed. "Out of season" and
// "January" are accommodation constraints; a restaurant's constraint is
// December trade. The list itself is all retained work.
// In `scopeItems`, on "Not us, and said out loud" (description):
// ⚠️ Real bracket, and it is the honest boundary of this page.

// Brief §14. The §6 MetricsBlock, "Turnaround is the product here", MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md. All four metrics were
// accommodation metrics and all four were unfilled placeholders, so none were
// publishable as they stood and moving them cost nothing now. The fourth,
// years cleaning short-stay properties in this region, is a genuine TLB asset
// and belongs on the Airbnb page whatever happens to the rest.

// §7 "Worth knowing". The lever here is the review, which is the only place
// on this cluster where a cleaning failure has a directly measurable dollar
// cost — and that makes the argument for itself without any claim about TLB.
// Brief §15. REWRITTEN for restaurants rather than moved: this is the page's
// BFD 14 section and its strongest argument, so the argument was worth keeping
// and only the examples had to change. The structure, the fifteen-minute
// framing and the closing "same way every single time" are all preserved; the
// examples move from cabin to dining room, and the final clause keeps the same
// move, specific knowledge of a specific room, in a restaurant register. It
// also pays off the demoted H1 line now sitting in the hero.
//
// The accommodation original is preserved in
// content-plans/HELD-holiday-park-and-cabin-content.md and should be reinstated
// if that content gets its own page.

// §8 Related pages. Airbnb, real estate and commercial pressure cleaning are
// appended: the first because it is this page's nearest neighbour, the second
// because park and venue operators often hold rental property too, and the
// third because a forecourt and a path are half of what a guest sees first.

// §10 Comparison table. Kept on this page, unlike strata and construction.
// Rows one and four are about who the person on site is and whether you have
// met them, and in accommodation that is the same question as whether your
// cabins get turned over the same way every time. The lead reframes it.
//
// In `comparisonTable`, on `lead`:
// Brief §17. "Accommodation" and "January" are the old scope; a venue's
// constraint is December.
// In `comparisonTable`, on `rows`:
// Brief §17, two row edits. serviceComparisonRows() drops the `Holiday lets`
// row, which is the accommodation row and goes with the rest of the moved
// content, and relabels `Who cleans your home` — a residential label left on
// a commercial page, wrong regardless of the refocus. The other commercial
// pages already call it this way.

// §11 Branded FAQs, in the CUSTOMER'S voice — a park manager, venue manager
// or café owner.
//
// In `brandedFaqItems`, on "Can you handle peak season?" (answer):
// Honest rather than reassuring, on purpose. Overcommitting here is
// how an accommodation contract fails publicly.
// In `brandedFaqItems`, before "Do you restock the consumables?":
// Brief §21.3. "Do you supply linen and towels?" MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md, with its linen bracket.

// §12 Non-branded FAQs, the long-tail block.
//
// ⚠️ VERIFICATION PASS REQUIRED. Checkable claims:
//   - Food businesses in Australia must keep premises and equipment clean
//     under the Food Standards Code, and councils inspect against it.
//     Correct in substance; no clause number quoted, on purpose.
//   - Holiday parks in NSW are regulated as caravan parks and manufactured
//     home estates, with amenities standards, and are inspected by local
//     councils. Correct, kept general.
//   - Nothing here should be read as compliance advice, and the food answer
//     says so.
//   - No dollar figure anywhere, same as every sibling page.
//
// In `nonBrandedFaqItems`, on "How much does restaurant cleaning cost?" (answer):
// ⚠️ BRACKETED ON PURPOSE, same as every sibling page.
// In `nonBrandedFaqItems`, before "How often should a restaurant be cleaned?":
// Brief §22.2. "How long should a cabin turnover take?" MOVED to
// content-plans/HELD-holiday-park-and-cabin-content.md. Replaced below.
// In `nonBrandedFaqItems`, before "What gets left out of a venue cleaning quote?":
// Brief §22.4. "How often should holiday park amenities be cleaned?" MOVED
// to content-plans/HELD-holiday-park-and-cabin-content.md. Replaced below,
// following the pattern the retail page uses well.

// §13 Closing CTA.
// Brief §23. The eyebrow matches the hero's, the heading keeps the old
// version's structure and its refusal to start from floor area, and "cabins,
// rooms" comes out. "Your quietest hour" is the constraint a venue recognises,
// and keeping the December reference preserves the honest capacity answer that
// made the original good.

// CONTENT lives in src/content/pages/commercial-cleaning/hospitality-cleaning.yaml
// and is edited in Pages CMS ("Hospitality cleaning"). This file owns the layout. The
// notes above explain why each section says what it says; they stay here
// because Pages CMS rewrites the YAML on save and would drop them.
const page = await getPage(
  'commercial-cleaning/hospitality-cleaning',
  z.object({
    seo: section.seo,
    // The label of the page's main button. It links to the quote page in Site
    // settings. Empty falls back to the site-wide walkthrough label.
    ctaLabel: section.optional(section.text),
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    // A card with no button of its own gets the page's main button.
    pathways: section.pathwayCards.extend({
      cards: z.array(section.pathwayCards.shape.cards.element.extend({ cta: section.optional(section.link) })).min(1),
    }),
    scope: section.iconGrid,
    worthKnowing: section.textBlock,
    // The pills are the other premises pages, from Site settings, plus this
    // page's own extra links (`tags`), which go in after them (§8 above).
    related: section.tagCloud.extend({ note: section.optional(z.array(section.text)) }),
    // The columns and rows are the shared table in Site settings. The page
    // owns its framing and the label of the "who cleans" row.
    comparison: section.comparisonTable
      .pick({ heading: true, lead: true, cornerLabel: true })
      .extend({ whoCleansLabel: section.text }),
    reviews: section.sectionHeading,
    // The subheading falls back to the shared service-area line, and the towns
    // come from Site settings.
    whereWeClean: section.tagCloud.omit({ tags: true }).extend({ subheading: section.optional(section.text) }),
    // Heading only. The paragraphs are the shared brand lines.
    brandLine: section.sectionHeading,
    brandedFaq: section.faq,
    faq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/commercial-cleaning/hospitality-cleaning/',
};

const walkthroughCta = { label: page.ctaLabel ?? walkthroughCtaLabel, href: quoteCta.href };

const heroImage = page.hero.image && sized(page.hero.image, '16/9');

const pathwayCards = page.pathways.cards.map((card, i) => ({
  number: i + 1,
  ...card,
  image: sized(card.image, '4/3'),
  cta: card.cta ?? walkthroughCta,
}));

const relatedTags = relatedPremises('/commercial-cleaning/hospitality-cleaning/', page.related.tags ?? []);

const business = commercialBusiness(pageMeta.description);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? walkthroughCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <PathwayCards heading={page.pathways.heading} headingAccent={page.pathways.headingAccent} cards={pathwayCards} />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.scope.heading}
      lead={page.scope.lead}
      items={page.scope.items}
      cta={page.scope.cta ?? walkthroughCta}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.worthKnowing.heading}
      body={page.worthKnowing.body}
      cta={page.worthKnowing.cta}
      backgroundImage={page.worthKnowing.backgroundImage}
    />

    <TagCloud
      heading={page.related.heading}
      subheading={page.related.subheading}
      tags={relatedTags}
      note={page.related.note ?? []}
    />

    <ComparisonTable
      heading={page.comparison.heading}
      cornerLabel={page.comparison.cornerLabel}
      lead={page.comparison.lead}
      columns={comparisonColumns}
      rows={serviceComparisonRows(page.comparison.whoCleansLabel)}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading ?? locationSubheading}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={page.brandLine.heading}
      body={[managedForYou.recurring, ...theLineBody.commercial, ...howItWorks.general]}
    />

    {/* Brief §21 and §22. The first block is pre-booking questions and the
        sibling commercial pages already use this pattern. The second dropped
        "Hospitality", which named the old scope, for wording that reaches for
        `restaurant cleaning services` and `venue cleaning services`, both
        mapped secondaries. Neither carries the exact primary, which keeps it
        out of a fourth heading slot. */}
    <Faq heading={page.brandedFaq.heading} lead={page.brandedFaq.lead} items={page.brandedFaq.items} />
    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? walkthroughCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
