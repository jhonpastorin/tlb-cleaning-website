  {
    question: 'What is a function room reset?',
    answer:
      'It is the clean that takes a room from the end of one event to the start of the next: tables cleared and stacked, chairs returned to the standard layout, floors vacuumed or mopped, food and spills off carpet before they set, bathrooms brought back and bins emptied. It is timed rather than thorough by nature, which is why the overnight version is the one worth paying for when a room carries two bookings in a weekend.',
  },
];

// §13 Closing CTA.
// Brief §23. The eyebrow matches the hero's, the heading keeps the old
// version's structure and its refusal to start from floor area, and "cabins,
// rooms" comes out. "Your quietest hour" is the constraint a venue recognises,
// and keeping the December reference preserves the honest capacity answer that
// made the original good.
const closingCta = {
  kicker: 'Restaurants, pubs and venues',
  heading: 'Start with your quietest hour.',
  lead: 'Not your floor area. Tell us when your room is actually empty and what your December looks like, and we will tell you honestly what we can hold.',
  cta: walkthroughCta,
};

const business = commercialBusiness(pageMeta.description);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      subheading={hero.subheading}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ServiceBlocks
      variant="icon-grid"
      heading="What our commercial restaurant cleaning services cover"
      lead="Grouped by when it happens relative to trade, because that is the only grouping a venue roster can actually use."
      items={scopeItems}
      cta={walkthroughCta}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading="Count how many one-star reviews are about cleaning"
      body={worthKnowingBody}
    />

    <TagCloud
      heading="Other premises we clean"
      subheading="Commercial cleaning for every kind of premises across the Northern Rivers and the Tweed."
      tags={relatedTags}
      note={[]}
    />

    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      lead={comparisonTable.lead}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
    />

    <TestimonialCarousel heading="What venues say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading={locationSubheading}
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={theLineHeading.fast}
      body={[managedForYou.recurring, ...theLineBody.commercial, ...howItWorks.general]}
    />

    {/* Brief §21 and §22. The first block is pre-booking questions and the
        sibling commercial pages already use this pattern. The second dropped
        "Hospitality", which named the old scope, for wording that reaches for
        `restaurant cleaning services` and `venue cleaning services`, both
        mapped secondaries. Neither carries the exact primary, which keeps it
        out of a fourth heading slot. */}
    <Faq heading="Booking a venue clean" items={brandedFaqItems} />
    <Faq heading="Restaurant and venue cleaning questions" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
