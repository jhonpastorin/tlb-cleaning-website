---
// Why TLB page, built from content-plans/why-tlb.md — section choices and
// every "don't invent this" call trace back to that document's 🚩 list.
//
// BLOCKS LAUNCH (all four flagged in the plan, none resolvable in code):
//  1. "Nine local mums" in the H1 and meta description contradicts the
//     homepage's "nine full-time cleaners, most of them mums as well"
//     (index.astro:150) — and §8 of this page's own copy says "most of us".
//     A factual claim about nine real people, in an <h1>, on the page whose
//     argument is that TLB is more honest than the alternatives. Shipped as
//     the brief wrote it; it needs settling, not silently softening.
//  2. Branded FAQ "Am I locked into anything?" is [TBC] and is HELD BACK.
//     The plan's point stands: on a page teaching contract literacy, silence
//     reads as an answer. Do not launch without it.
//  3. The four non-branded FAQs assert checkable numbers about third-party
//     contracts and cite an unnamed "published case". Built, because they
//     are the page's strongest asset — but they need a substantiation pass.
//  4. §6's comparison table rows are DERIVED, not supplied. See its own
//     comment block.
//
// Two component extensions were added for this page: `kicker` on Hero.astro
// and on CallToAction.astro (§1 and §14 both need an eyebrow label). Both
// are additive and default to rendering nothing.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ContentGrid from '../components/sections/ContentGrid.astro';
import Callout from '../components/sections/Callout.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import type { TextBlockBody } from '../components/sections/TextBlock.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { comparisonColumns, comparisonRows } from '../data/comparison';

const pageMeta = {
  title: 'Best House Cleaning Services Near You | TLB Cleaning',
  // ⚠️ Carries the "Nine local mums" claim — see blocker 1 in the header.
  description:
    'Nine local mums, no anonymous contractors and no franchise fees. See how TLB compares, and why changing cleaners is easier than you think.',
  canonical: 'https://example.com/why-tlb/',
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  areaServed: 'Northern Rivers NSW and Southern Gold Coast QLD',
  description: pageMeta.description,
};

// §1 Hero. The brief's overview runs 48 words against a 15–25 target and is
// three sentences; per the plan it's SPLIT, not cut — sentence 1 is the lead
// here, sentences 2 and 3 open §2's TextBlock. Nothing is lost.
//
// `kicker` is the new Hero prop: "WHY TLB" sits above the <h1>, outside it.
// Folding it into headingLines would make the heading read "WHY TLB Nine
// local mums, and no anonymous contractors".
//
// Hero style matches the homepage, house cleaning and deep cleaning pages:
// `split-single-image`, copy left, image right. NO ASSET YET — `image` is
// passed with a `label` but no `src`, so Placeholder renders its dashed
// briefing box in the panel. That is a deliberate reversal of this page's
// earlier call (`minimal`, to avoid a dashed box standing in for a photo):
// the style is now shared across the site, so the slot is held open here
// instead of this page opening differently from every other one.
//
// ⚠️ The dashed box is a pre-launch state. It must not ship to production —
// either the asset lands or this hero goes back to `variant="minimal"`.
//
// Dropping the asset in is a one-line change: add `src`. `ratio` is 4/3 and
// `imageFit` is contain-bottom, matching the cut-out-figure-on-a-green-circle
// template the three sourced assets use (contain so the backdrop is never
// cropped, bottom-anchored so the figure stands on the section's edge). If a
// plain photograph arrives instead, drop `imageFit` to let it default to
// `cover` and bleed edge to edge.
//
// ⚠️ This page argues "the part none of the others can show you: names and
// faces". A hero with no faces on it is the weakest possible opening for
// that argument, so a real team photo does more work here than almost
// anywhere else.
const hero = {
  kicker: 'Why TLB',
  headingLines: ['Nine local mums, and no anonymous contractors.'],
  lead: "We grew to nine full-time staff and won contracts with the region's leading real estate agencies without ever running an advertisement.",
  cta: quoteCta,
  image: {
    ratio: '4/3',
    label: 'The TLB team — the nine local cleaners this page names',
  },
};

// §4 Trust bar — positioned directly under the hero per the boilerplate's
// own instruction, ahead of its table-row position.
//
// ⚠️ Third of four wordings for the same headcount across the site.
// Card variant: the brief's lines run VERBATIM as the descriptions, each
// under a short added label — same shape as every other page's trust bar.
const trustBarCards = [
  {
    icon: 'team' as const,
    title: 'Local team',
    description: '9 full-time local team members',
  },
  {
    icon: 'chat' as const,
    title: 'Word of mouth',
    description: 'Every client came from a recommendation',
  },
  {
    icon: 'building' as const,
    title: 'Agency trusted',
    description: 'Trusted by leading Northern Rivers real estate agencies',
  },
];

// §2 Thesis + definition. Entries 1–2 are the hero overflow (see §1).
// Entry 3 is the answer-target block — it names all four competitor
// categories in one sentence, which is what the rest of the page unpacks.
const definitionBody: TextBlockBody[] = [
  'Every client came from somebody recommending us to somebody else.',
  'This page is the honest version of why.',
  'TLB Cleaning is a locally owned cleaning company serving the Northern Rivers and Southern Gold Coast. It employs nine full-time cleaners rather than subcontracting, which is the main difference between TLB and the national franchises, booking platforms and sole operators working the same area.',
];

// §3 Routing cards. Unlike the other pages' cards, all three route WITHIN
// this page (or to the team page) rather than away from it — this page is
// long, and these are its table of contents.
//
// Section heading/accent and the three CTA labels are NOT in the brief.
const pathwayCards = {
  heading: 'Three ways to read this page.',
  headingAccent: 'Start wherever you are.',
  cards: [
    {
      number: 1,
      image: { ratio: '4/3', label: 'Four cleaning business models compared' },
      title: 'How do you compare?',
      description:
        'A franchise, an online platform, a solo cleaner or a local team. They are genuinely different things and each is right for someone.',
      cta: { label: 'See the comparison', href: '#compare' },
    },
    {
      number: 2,
      image: { ratio: '4/3', label: 'House key being handed back' },
      title: 'I already have a cleaner',
      description:
        'Most people reading this do. Here is how to change without it being awkward, and the one time of year not to.',
      cta: { label: 'How to switch', href: '#switching' },
    },
    {
      number: 3,
      // ⚠️ This promises named faces. So does §7's "neither can introduce
      // you to her", and so does §14's closing CTA. Three promises pointing
      // at /about/ — confirm that page will actually show nine named
      // cleaners with photos, or the page's central claim doesn't land.
      image: { ratio: '4/3', label: 'The TLB cleaning team, named and photographed' },
      title: 'Who would actually come?',
      description:
        'The part none of the others can show you. Names and faces, before anyone knocks on your door.',
      cta: { label: 'Meet the team', href: '/about/' },
    },
  ],
};

// §5 The trade-off — SETUP → two-sided CONTRAST → RESOLUTION, built as three
// sections rather than one prose block. The two middle paragraphs are
// deliberately parallel ("solved X / what you give up is Y"), so putting them
// side by side lets the reader see the symmetry before reading a word.
const tradeOffSetup: TextBlockBody[] = [
  'Until recently you had to pick one: convenience or a person you know.',
];

// ⚠️ The two cell headings are NEW COPY, not in the brief. They name the two
// things the setup line above already names, so they're a labelling choice
// rather than an argument — but they are an addition.
const tradeOffBlocks = [
  {
    type: 'text' as const,
    heading: 'Convenience',
    body: [
      'The national platforms and franchises solved the convenience problem properly. You can book at eleven at night, you get a confirmation, and there is a number to ring if something goes wrong. What you give up is knowing who is coming.',
    ],
    tone: 'muted' as const,
  },
  {
    type: 'text' as const,
    heading: 'A person you know',
    body: [
      'Independent local cleaners solved the other half. You know her name, she knows your dog, and the work is better because she cares. What you give up is the organising: phone tag, a paper diary, and no cover when she is away.',
    ],
    tone: 'muted' as const,
  },
];

// Dark, because it's the pivot the whole page turns on — and this page runs
// long on centred light prose, so it needs the tonal break.
const tradeOffResolution: TextBlockBody[] = [
  'We built TLB to not make you choose. That is the whole idea, and everything below is downstream of it.',
];

// §6 Comparison table — the SAME table as the homepage's §8, sharing its
// columns and rows from src/data/comparison.ts. That copy was supplied
// directly by TLB with desktop and mobile mockups, so it is approved content.
//
// This REPLACES an earlier four-column table (TLB / franchise / platform /
// solo cleaner) whose rows I derived from this page's own prose because the
// brief supplied none. Approved copy beats derived copy — but see the two
// notes below, because the swap changes what this section argues.
//
// Only the heading and cornerLabel are set here; the substance is shared, so
// editing a row updates both pages at once.
//
// ⚠️ THE PAGE NOW PROMISES MORE THAN THE TABLE DELIVERS. §3's card 1 says
// "A franchise, an online platform, a solo cleaner or a local team. They are
// genuinely different things and each is right for someone", and §5 concedes
// the platforms "solved the convenience problem properly". This table is
// two columns — TLB vs "Other Brands" — with TLB ticking every row and Other
// Brands crossing every row. It does not distinguish the four models, and it
// does not show anything being right for someone else. Either card 1's copy
// softens to match, or the table needs the extra columns.
//
// ⚠️ Row 2 ("Owned and run by local mums from the Northern Rivers") restates
// the claim in blocker 1 at the top of this file. Same fact, same question.
const comparisonTable = {
  // Deliberately NOT the homepage's "Why TLB Cleaning is different" — that
  // would restate the page's own name inside it. Reframed for this context.
  heading: 'How TLB Cleaning compares',
  cornerLabel: 'What makes the difference',
  columns: comparisonColumns,
  rows: comparisonRows,
};

// §7 The model explanation. The strongest writing in the brief — straight
// prose, no list, no image. Don't break it up.
const modelBody: TextBlockBody[] = [
  'In a franchise network, local operators buy the right to trade under a corporate name. The brand does the marketing and the phone number, and an operator you have never heard of does the work. On a booking platform, an algorithm dispatches a vetted contractor. Both are legitimate ways to run a cleaning business and both are genuinely convenient.',
  'Neither can introduce you to her. To match that, they would have to employ the cleaners rather than dispatch them, keep them long enough for you to learn their names, and let you see who they are before they arrive. That is not a feature that ships in the next release. It is a different company.',
];

// §8 Flexible hours.
//
// ⚠️ "because most of us are doing it" — MOST, not all. This is the same
// fact the H1 states as "nine local mums", stated more carefully two thirds
// of the way down the same page. It agrees with the homepage and disagrees
// with this page's own headline. See blocker 1.
//
// ⚠️ "Cleaning has a staff turnover problem across the whole industry" is an
// industry claim with no source supplied — same substantiation question as
// the non-branded FAQs.
const flexibleHoursBody: TextBlockBody[] = [
  'Cleaning has a staff turnover problem across the whole industry, driven by rigid hours and low engagement. Somebody treated as interchangeable behaves as though the job is interchangeable, and the person whose house it is can tell.',
  'Our team is built around school pick-up, because most of us are doing it. That is why people stay, and why you are not meeting somebody new every fortnight. A team that loves the work does better work, and there is no clever version of that idea.',
];

// §9a Switching guide intro.
const switchingIntro: TextBlockBody[] = [
  'Almost nobody puts off changing cleaners because of price or quality. They put it off because someone has a key to their house and they do not want to have the conversation.',
];

// §9b Four objection cards. The objections keep their quote marks — the
// voice is the reader's own, and losing the quotes loses that.
//
// ⚠️ Card 3 contains the page's ONLY soft sell ("Book us once as a one-off"),
// placed inside advice that warns against being sold to. That's deliberate
// and it works. Don't let a later edit add a second pitch to the other three.
const objectionBlocks = [
  {
    type: 'text' as const,
    heading: '"She is lovely. I feel terrible."',
    body: [
      'You are allowed to change a service arrangement without it being a judgement on someone as a person. "We are making some changes at home and are going to stop the regular clean" is true, kind and complete. You do not owe a critique, and offering one usually makes it worse for both of you.',
    ],
  },
  {
    type: 'text' as const,
    heading: '"She has a key."',
    body: [
      'Ask for it back at the last clean, in person, and have the conversation then. Handling it by message and asking for the key afterwards is the version that goes badly. If there is a lockbox or a code, change it the same day as ordinary housekeeping rather than as a statement.',
    ],
  },
  {
    type: 'text' as const,
    heading: '"What if the new one is worse?"',
    body: [
      'Do not stop the old arrangement until you have had one clean from the new one. Book us once as a one-off, see how it goes, then decide. Anyone who pushes you to cancel before you have seen the work is selling, not advising.',
    ],
  },
  {
    type: 'text' as const,
    // "Tegan" in the source → "Teagan", the settled spelling.
    heading: '"She lives around here. I will run into her."',
    body: [
      'You will, because that is what living in a small town is. Which is exactly why the in-person version is worth the discomfort. Our team lives here too and so does Teagan. Nobody at TLB wants to be the reason a neighbourly relationship went sour.',
    ],
  },
];

// §9c The timing callout.
//
// Now a real Callout (tone="warning"). It shipped as a dark TextBlock while
// Callout.astro had only one consumer and this library's bar is two; the
// NDIS page's "you probably don't need a registered provider" box became the
// second, so the component was built and this was retro-fitted to it.
const timingCallout: string[] = [
  'Do not do this in the fortnight before Christmas. If you have family arriving, or you are about to list the house, or you are three weeks from moving out, this is the worst possible moment to change anything. Anybody telling you now is a great time to switch is thinking about their month, not yours.',
];

// §10 Agencies and businesses.
//
// ⚠️ hrefs are a PROPOSAL — the brief supplies none. The commercial slug in
// particular should be checked against the header mega-menu before launch.
// Icon-less, same as every other page: ServiceIcon.astro's set is abstract
// and has no agency/office glyph.
const contractorItems = [
  {
    title: 'Agencies: give us the difficult property',
    description:
      'The one with the tight window or the awkward exit condition. That is the job that tells you something.',
    href: '/real-estate-cleaning/',
  },
  {
    title: 'Businesses: start with a walkthrough',
    description:
      'Nobody can quote a building from a form. We look at it, tell you what it needs, and say if we are not the right people.',
    href: '/commercial-cleaning/',
  },
];

// §11 Social proof — bracketed [TBC] briefing slots, NOT real testimonials.
// Never fill with invented names or words.
//
// ⚠️ The brief says only "Ask Teagan for clients testimonials" — less
// direction than any sibling page got. The two angles below are the plan's
// PROPOSAL, chosen to carry this page's specific argument rather than
// generic praise. Confirm before briefing Teagan.
const testimonials = [
  {
    quote:
      '[TBC — ask Teagan for a quote from a client who switched from a franchise or a booking platform. The entire top half of this page is that comparison, and a real switcher is the only proof of it.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Client who switched to TLB from a franchise or platform' },
  },
  {
    quote:
      '[TBC — ask Teagan for a quote from a client who dreaded the conversation with their old cleaner and did it anyway. The switching guide is this page\'s most distinctive content and currently has no human evidence behind it.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Client who changed cleaners despite the awkwardness' },
  },
];

// §12 Branded FAQs — 3 of 4.
//
// HELD BACK: "Am I locked into anything?" The brief's own bracket reads
// "[TBC — confirm commercial terms before publishing. This is the single most
// important question on this page and it cannot be answered with a guess.]"
//
// ⚠️ Note this is NOT a normal hold-back. On a page that spends its length
// teaching people to read their cleaning contract, omitting the question
// about TLB's own contract is itself an answer. The page should not launch
// with this missing — get the terms confirmed.
//
// ⚠️ Also worth checking before launch: non-branded FAQ 3 below warns readers
// about non-solicitation clauses. Confirm TLB's own terms don't contain one.
//
// All three below answer by CONCEDING something. That's the page's voice
// working — keep any additions in the same register.
const brandedFaqItems = [
  {
    question: 'Can I book one clean without committing to a schedule?',
    answer: 'Yes, and for anyone changing over we would suggest you do exactly that.',
  },
  {
    question: 'Do you need to know who I was using before?',
    answer:
      'No, and we would rather not turn it into a conversation about someone else. What is useful is knowing what you want kept the same and what you want done differently.',
  },
  {
    question: 'Do you cover everywhere a national brand does?',
    // ⚠️ "Five Northern Rivers council areas" — a specific number that
    // appears nowhere else on the site, and the three suburb lists already in
    // the codebase disagree with each other. Naming the five would also feed
    // the `near me` focus keyword, which has almost nothing else on this page
    // to attach to.
    answer:
      'No, and we would not claim to. Five Northern Rivers council areas and the Southern Gold Coast.',
  },
];

// §13 Non-branded FAQs — all four drafted, and the page's strongest SEO asset:
// nobody else in this market answers "what is in my cleaning contract".
//
// ⚠️ ALSO ITS BIGGEST RISK. Every answer asserts checkable numbers about
// third-party contracts — "14 or 30 days", "24 to 48 hours", "72 hours or
// five working days", "25 per cent up to the full amount" — and FAQ 3 cites
// "one published case" without naming or linking the source. None of it is
// bracketed [TBC], so it reads ready to ship. It needs a substantiation pass
// first: sources recorded for the ranges, and a decision on whether to cite
// the non-solicitation example or soften it to "some businesses".
//
// The Australian Consumer Law characterisation in FAQ 4 is sound as a general
// statement of the consumer guarantees.
const nonBrandedFaqItems = [
  {
    question: 'How much notice should I give my current cleaner?',
    answer:
      'Two to four weeks is the usual courtesy for an ongoing arrangement, and many cleaning businesses ask for the same in their own terms. Check what you agreed when you started, because 14 or 30 days written notice is common in domestic cleaning terms. If nothing was ever written down, a fortnight is fair and gives them time to fill the slot.',
  },
  {
    question: 'Will I be charged if I cancel a booked clean?',
    answer:
      'Usually only if you cancel late. Most Australian cleaning businesses publish a window of 24 to 48 hours, though some ask for 72 hours or five working days. Inside that window, fees run from 25 per cent of the price up to the full amount. Nearly all of them also charge if the cleaner arrives and cannot get in.',
  },
  {
    question: 'Is there anything in my current terms I should check before I switch?',
    answer:
      "Two things, and neither is obvious. Some cleaning businesses include a non-solicitation clause that stops you hiring their cleaner directly, in one published case for twelve months after your last booking, with a finder's fee if you do. Others renew automatically for a further twelve-month term unless you give notice. Read what you agreed before you cancel anything.",
  },
  {
    question: 'What am I entitled to if a clean is not done properly?',
    answer:
      'The same consumer guarantees that apply to any service. Under the Australian Consumer Law, services must be provided with due care and skill and be fit for the purpose you asked for, and you are entitled to a remedy when they are not. Many cleaning businesses also ask you to report problems in writing within 24 hours, so do not sit on it.',
  },
];

// §14 Closing CTA.
//
// ⚠️ Deliberately NOT "get a quote", unlike this page's three siblings — it
// hands off to the team page instead. That is the right call for a page whose
// argument is "you can see who we are", and it should survive review even
// though it breaks the site pattern.
//
// cta.label is not in the brief; "Meet the team" chosen by TLB. Note it
// repeats the kicker directly above it, and card 3's CTA further up the page
// uses the same words — deliberate consistency, not an oversight.
//
// ⚠️ Third promise on this page of named faces at /about/. Confirm that page
// delivers them.
const closingCta = {
  kicker: 'Meet the team',
  heading: 'The one thing they cannot show you.',
  lead: 'Have a look at who would actually be walking into your house.',
  cta: { label: 'Meet the team', href: '/about/' },
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <TrustBar variant="card" cards={trustBarCards} />

    <TextBlock theme="light" align="left" body={definitionBody} />

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <TextBlock theme="light" align="left" heading="The trade-off everyone is actually making." body={tradeOffSetup} />

    <ContentGrid columns={2} blocks={tradeOffBlocks} />

    <TextBlock theme="dark" align="left" body={tradeOffResolution} />

    {/* Anchor target for §3's card 1. ComparisonTable takes no id prop, and
        adding one purely for an anchor isn't worth a shared-component change
        — same call made on deep-cleaning.astro. */}
    <div id="compare">
      <ComparisonTable
        heading={comparisonTable.heading}
        cornerLabel={comparisonTable.cornerLabel}
        columns={comparisonTable.columns}
        rows={comparisonTable.rows}
      />
    </div>

    <TextBlock theme="light" align="left" heading="A brand can be bought. A person cannot." body={modelBody} />

    <TextBlock theme="dark" align="left" heading="Flexible hours are not a perk. They are the mechanism." body={flexibleHoursBody} />

    {/* Anchor target for §3's card 2. */}
    <div id="switching">
      <TextBlock theme="light" align="left" heading="Changing cleaners is awkward. Here is how." body={switchingIntro} />
    </div>

    <ContentGrid columns={2} blocks={objectionBlocks} />

    <Callout tone="warning" body={timingCallout} />

    <ServiceBlocks
      variant="list"
      heading="If you are changing a contractor rather than a cleaner."
      lead="Moving a rent roll or a commercial contract is a different problem. You are not managing a relationship, you are managing vacancy windows or an office that has to be usable on Monday. The answer is the same in both cases: give us one job, and not your easiest one."
      items={contractorItems}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <Faq heading="Frequently Asked Questions" items={brandedFaqItems} />
    <Faq heading="Switching Cleaners: FAQs" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
