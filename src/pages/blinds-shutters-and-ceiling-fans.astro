// §12 Non-branded FAQs.
//
// ⚠️ NO HEALTH CLAIM ANYWHERE IN THIS BLOCK. Dust is the obvious hook and it
// leads directly to allergens and air quality, which this site stays out of
// (BFD 5.3, and the precedent set by the mould and mattress pages). The
// answers below talk about light, appearance and damage instead. Do not add
// an allergy angle, however well it would convert.
//
// Checkable claims:
//   - Water marks fabric blinds. Correct and the single most useful warning.
//   - Bending a venetian slat prevents it closing flat. Correct.
//   - Unbalanced fan blades cause wobble; balancing kits exist. Correct, and
//     the answer sends that to an electrician rather than offering to fix it.
const nonBrandedFaqItems = [
  {
    question: 'How often should blinds be cleaned?',
    answer:
      'A quick dust every few weeks as part of normal cleaning, and a proper detailed clean once or twice a year. Bring that forward in a kitchen, where dust binds with cooking grease into a film that no longer dusts off, and near the coast or an unsealed road, where the dust load is simply higher. Regular light dusting is what stops it reaching the greasy stage.',
  },
  {
    question: 'What is the best way to clean venetian blinds?',
    answer:
      'Dry first, always: dust or vacuum with a brush head before anything damp goes near them, because dust plus moisture is mud. Then wipe each slat with the slat supported from behind so it cannot bend. Work from the top down so what falls lands on slats you have not done yet, and finish with the head rail, the cords and the window track underneath.',
  },
  {
    question: 'Can you wash fabric or roller blinds with water?',
    answer:
      'Generally no, and this is where most self-inflicted blind damage comes from. Most roller, roman and sunscreen fabrics are treated or coated, and water leaves a visible ring as it dries that cannot be blended out the way a mark on carpet can. Dry dusting and careful spot treatment are the safe options. Anything beyond that is a specialist ultrasonic clean or a replacement.',
  },
  {
    question: 'Why does my ceiling fan wobble after being cleaned?',
    answer:
      'Almost always because a blade got bent. Fan blades are balanced as a set, and pressing down on the end of one while scrubbing the top is enough to put a slight bend in it, which shows up as a wobble as soon as the fan runs. Support the blade from underneath while you wipe. A fan that already wobbles needs a balancing kit or an electrician, not a cleaner.',
  },
  {
    question: 'How much does blind and fan cleaning cost?',
    answer:
      // ⚠️ BRACKETED ON PURPOSE, same as every sibling.
      'Usually priced per blind and per fan, with a lower rate when a whole house is done at once or when it is added to an existing clean. Size and type move it: a wide vertical blind or a plantation shutter takes longer than a small venetian. [TLB’s pricing basis and minimum charge. Confirm.]',
  },
];

const closingCta = {
  kicker: 'Blinds, shutters and ceiling fans',
  heading: 'Add it to your next clean.',
  lead: 'Blinds, shutters, tracks and fans, done once or twice a year on a visit that is already happening. Tell us which rooms and we will price it.',
  cta: { label: 'Get an instant quote', href: quoteCta.href },
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ServiceBlocks
      variant="icon-grid"
      heading="How we clean blinds, shutters and fans"
      lead="Six stages. Dry before damp, and support before pressure."
      items={methodItems}
      cta={{ label: 'Get an instant quote', href: quoteCta.href }}
    />

    <Callout tone="note" heading={scopeCallout.heading} body={scopeCallout.body} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Most damaged blinds were damaged by cleaning"
      body={worthKnowingBody}
    />

    <ServiceBlocks
      variant="list"
      heading="Other things we clean around the house"
      lead="The jobs a regular clean never has time for. Any of them can go on the same visit."
      items={clusterServices.map((service) => ({
        icon: 'spray-bottle' as const,
        title: service.label,
        description: service.blurb,
        href: service.href,
      }))}
    />

    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      lead={comparisonTable.lead}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Across the Northern Rivers and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={brandedFaqItems} />
    <Faq heading="Blind and ceiling fan cleaning FAQs" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
