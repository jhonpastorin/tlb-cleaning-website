---
// Tile and grout cleaning — one of the six "Appliances" leaf pages under the
// Home Cleaning mega-menu. See carpet-and-rug-cleaning.astro for the shared
// reasoning behind this group, and src/data/appliance-services.ts for the
// cluster links.
//
// NO CONTENT BRIEF EXISTS. All copy is DRAFTED from the brand foundation
// document. Facts only TLB holds ship as visible [brackets].
//
// ⚠️ THIS PAGE OVERLAPS /mould-cleaning-and-removal/ AND MUST DEFER TO IT.
// Black spotting in shower grout is the single most common reason someone
// searches this topic, and it is very often mould. That page is the most
// constrained on the site: it makes NO health claim, promises no permanent
// removal, and is explicit that TLB cleans surface mould only and is not a
// remediation business. This page must not quietly undercut any of that by
// treating mould as an ordinary cleaning problem.
//
// So: this page names mould once, says plainly that discoloured grout is
// often mould rather than dirt, and sends the reader there. It makes no
// health claim, offers no method for it, and promises nothing about it
// staying gone. Do not expand that. If a reader wants the mould answer, the
// answer is the mould page.
//
// BLOCKS LAUNCH:
//   - SEALING. §4's last card and branded FAQ 4 both offer to reseal grout
//     after cleaning. That is a genuinely separate service with its own
//     product, cost and cure time. Confirm TLB does it. If not, both need to
//     change from an offer to a recommendation the customer arranges.
//   - EQUIPMENT. The page describes a rotary/pressure tool with capture, not
//     a hand brush. Confirm what TLB actually uses; if it is hand scrubbing,
//     say so plainly, because hand scrubbing is honest and slow rather than
//     inferior, and the copy should not imply machinery that does not exist.
//   - Pricing basis bracketed.
//
// PHOTOGRAPHY: hero is a family B cut-out keyed against green (a pale grey
// tiled floor cannot be keyed off white). See
// src/assets/home_cleaning/appliances/IMAGE-PROMPTS.md.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import Callout from '../components/sections/Callout.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import heroImg from '../assets/home_cleaning/appliances/tile_and_grout/cleaner-scrubbing-a-grout-line.png';
import cardBathroomImg from '../assets/home_cleaning/appliances/tile_and_grout/bathroom-floor-tiles-and-grout-lines.jpg';
import cardQuoteImg from '../assets/home_cleaning/appliances/homeowner-and-cleaner-talking-in-a-living-room.jpg';
import cardTeamImg from '../assets/home_cleaning/appliances/cleaner-with-a-caddy-in-a-home-entry-hall.jpg';
import definitionBgImg from '../assets/home/house-cleaning-cleaner-wiping-tall-interior-window.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import type { TextBlockBody } from '../components/sections/TextBlock.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { comparisonColumns, comparisonRows } from '../data/comparison';
import { locationGroups } from '../data/locations';
import { trustBarCards } from '../data/trust';
import { otherApplianceServices } from '../data/appliance-services';

const OWN_HREF = '/tile-and-grout-cleaning/';

const pageMeta = {
  title: 'Tile and Grout Cleaning | TLB Cleaning',
  description:
    'Tile and grout cleaning across the Northern Rivers and the Tweed. Bathroom and kitchen grout brought back as far as it will come, with an honest answer on the rest.',
  canonical: 'https://example.com/tile-and-grout-cleaning/',
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  areaServed: 'Northern Rivers NSW and Southern Gold Coast QLD',
  description: pageMeta.description,
};

const hero = {
  kicker: 'Tile and grout cleaning',
  headingLines: ['The tiles are fine. It is the lines between them.'],
  lead:
    'Tile and grout cleaning for bathrooms, kitchens and floors across the Northern Rivers and the Tweed. We will tell you how far it will come back before we start.',
  cta: { label: 'Get an instant quote', href: quoteCta.href },
  image: {
    ratio: '1/1',
    label:
      'A TLB cleaner in an aqua polo, dark teal apron and teal gloves kneeling to work a grout line with a detail brush on a pale tiled floor',
    src: heroImg,
  },
};

const definitionBody: TextBlockBody[] = [
  'Tile and grout cleaning is the deep cleaning of hard floors and wet area walls, and in practice it is almost entirely about the grout. Tile is glazed and easy. Grout is cement based and porous, so it absorbs soap, oil, dirt and moisture and holds onto them, which is why a mopped floor can still look grubby along every line. TLB Cleaning cleans tile and grout across the Northern Rivers and the Tweed.',
  'Mopping is the reason it gets worse rather than better. A mop lifts the dirt off the tile and pushes most of it into the grout line, which sits slightly lower and is absorbent. Doing that weekly for years is why the grout in a well-kept bathroom can be darker than the grout in a neglected one.',
];

const pathwayCards = {
  heading: 'People arrive here with three questions.',
  headingAccent: 'Which one is yours?',
  cards: [
    {
      number: 1,
      image: {
        ratio: '4/3',
        label: 'The tiled floor and shower base of a family bathroom with the grout lines clearly visible',
        src: cardBathroomImg,
      },
      title: 'The grout has gone grey and mopping does nothing',
      description:
        'Because mopping is part of how it got there. Grout needs to be worked and rinsed rather than wiped, and that is a different job from the one you have been doing every week.',
      cta: { label: 'Get an instant quote', href: quoteCta.href },
    },
    {
      number: 2,
      image: {
        ratio: '4/3',
        label: 'A TLB cleaner and a homeowner talking through the job in a living room',
        src: cardQuoteImg,
      },
      title: 'We are selling or the inspection is coming',
      description:
        'Grout is one of the first things an agent, a buyer or a property manager looks at, because it reads as how the whole place has been kept. It is also one of the cheapest things to fix before a photo shoot.',
      cta: { label: 'End of lease cleaning', href: '/end-of-lease-cleaning/' },
    },
    {
      number: 3,
      image: {
        ratio: '4/3',
        label: 'A TLB cleaner in uniform with her caddy in the entry hall of a home',
        src: cardTeamImg,
      },
      title: 'I want to know who is in my home',
      description:
        'The same local team you have met, not a roster of strangers from a call centre. We are local mums who clean where we live, [insured] and [police-checked], and there is one local number to ring.',
      cta: { label: 'Why TLB', href: '/why-tlb/' },
    },
  ],
};

const methodItems = [
  {
    icon: 'target' as const,
    title: 'We work out what the surface is',
    description:
      'Glazed ceramic and porcelain will take almost anything. Natural stone, terracotta, slate and polished concrete will not, and an acid based product on stone will etch it permanently. We identify the surface before we choose a product.',
  },
  {
    icon: 'spray-bottle' as const,
    title: 'A cleaner that is left to work',
    description:
      'The solution goes on and is given time to break down the soap scum and oil in the grout. Most of the difference between a good result and a poor one is dwell time, not effort. Spraying and immediately wiping is just mopping with extra steps.',
  },
  {
    icon: 'spark' as const,
    title: 'Every line agitated',
    description:
      'Grout has to be physically worked along its length with a brush. There is no product that skips this part. The corners, the edge against the bath and the line where the floor meets the wall are the slowest and the most obvious when they are missed.',
  },
  {
    icon: 'chart-bars' as const,
    title: 'Rinsed and lifted, not wiped',
    description:
      // ⚠️ LAUNCH BLOCKER. Confirm the equipment. See the file header.
      'The loosened soil has to come off the floor rather than be spread around it, so it is rinsed and the dirty water is lifted away. Wiping a cleaned grout line with a cloth puts a good share of it straight back. [Confirm what equipment TLB uses here.]',
  },
  {
    icon: 'puzzle' as const,
    title: 'An honest look at what is left',
    description:
      'When it is clean and dry we look at it with you. Some discolouration is soil and comes out. Some is staining in the cement, some is worn or missing grout, and some is a shower that needs regrouting rather than cleaning. We will tell you which you have.',
  },
  {
    icon: 'bloom' as const,
    title: 'Sealing, if it is worth it',
    description:
      // ⚠️ LAUNCH BLOCKER. Confirm TLB seals. See the file header.
      'Clean grout can be sealed so it absorbs less and stays looking better for longer. It is a separate job with its own cost and it needs the grout to be properly dry first, so it usually means a second visit. [Confirm whether TLB offers sealing.]',
  },
];

// Deferral to the mould page. A Callout, not a TextBlock: it is a short
// aside, and SECTIONS.md is clear that is what Callout is for.
//
// ⚠️ DO NOT EXPAND THIS. See the file header. No health claim, no method, no
// promise it stays gone. The mould page owns all of that.
const mouldCallout = {
  heading: 'If the black spots keep coming back',
  body: [
    'Black or dark spotting along shower grout and silicone is very often mould rather than dirt, and mould comes back wherever the moisture that fed it is still there. Cleaning it is a cleaning job. Working out why it keeps returning is usually a ventilation or a sealing problem in the building. We have a separate page that explains what we do and do not do about mould, and it is the honest version rather than the sales version.',
  ],
  cta: { label: 'Mould cleaning and removal', href: '/mould-cleaning-and-removal/' },
};

const worthKnowingBody: TextBlockBody[] = [
  'Grout will not always come back to white, and any cleaner who promises it will is either about to disappoint you or about to do something you did not agree to. Grout is cement. It is porous, it stains through rather than on top, and after ten years of soap and hard water some of that colour is part of the material now. A good clean gets a long way, often further than people expect, but the floor you end up with is a clean old floor rather than a new one.',
  'That matters because the shortcut is bleach, and bleach is why so many bathrooms look worse a year after they were cleaned. It lightens the surface without removing what is in the grout, so it looks fixed for a few weeks and then greys back, and repeated use eats away at the grout itself until it starts crumbling out of the joint. If grout is genuinely past it, the answer is regrouting or a colour seal, not another round of bleach. We will tell you which one you are looking at.',
];

const clusterServices = otherApplianceServices(OWN_HREF);

const testimonials = [
  {
    quote:
      '[TBC. Ask Teagan for a quote from a client who thought their bathroom needed retiling and did not. That is the saving this page argues for. Written permission required (BFD 5.3).]',
    name: '[First name, TBC]',
    role: '[Suburb, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'TLB tile and grout cleaning client' },
  },
  {
    quote:
      '[TBC. Ask Teagan for a quote from a client selling or leasing, ideally mentioning what the agent said. Pays off card 2.]',
    name: '[First name, TBC]',
    role: '[Suburb, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'TLB client preparing a property' },
  },
  {
    quote:
      '[TBC. Ask Teagan for a quote where TLB gave an honest verdict rather than the answer the client wanted, for example that grout needed replacing. That evidences the whole page.]',
    name: '[First name, TBC]',
    role: '[Suburb, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'TLB client, bathroom' },
  },
];

const comparisonTable = {
  heading: 'How TLB compares',
  cornerLabel: 'Why TLB Cleaning is different',
  lead: 'The value here is not the scrubbing. It is getting a straight answer about whether your bathroom needs cleaning or needs a trade.',
  columns: comparisonColumns,
  rows: comparisonRows,
};

const brandedFaqItems = [
  {
    question: 'Will our grout go back to white?',
    answer:
      'Usually a long way, rarely all the way, and we will give you a realistic idea before we start rather than after. Grout stains through the material rather than sitting on top of it, so how far it comes back depends on the original colour, how old it is and what has been used on it before. Bleach in particular limits what is recoverable later.',
  },
  {
    question: 'Is it safe on our stone tiles?',
    answer:
      'Only with the right product, which is why we identify the surface first. Natural stone, terracotta, slate and polished concrete are porous and reactive, and the acid based cleaners that work well on ceramic will etch them permanently. If you know what your tiles are, tell us when you book. If you do not, we will work it out on site.',
  },
  {
    question: 'How long does a bathroom take?',
    answer:
      'A standard bathroom is usually a few hours, because the time goes into dwell and agitation rather than the passes themselves. A large tiled floor takes longer. We would rather quote it properly after seeing it than give you a number over the phone that we have to revise on the day.',
  },
  {
    question: 'Should we seal the grout afterwards?',
    answer:
      // ⚠️ Depends on the sealing launch blocker in the file header.
      'It is worth considering in a shower or a busy kitchen, because sealed grout absorbs less and stays looking better for longer. It has to go on properly dry grout, so it usually means coming back. It is not permanent either, and it will need doing again eventually. [Confirm whether TLB offers sealing and at what interval.]',
  },
  {
    question: 'What happens if I get in touch?',
    answer:
      'Tell us which rooms and roughly how old the tiling is. We will look at the surface and the state of the grout, give you an honest view of how far it will come back and a price. It can go on the same visit as your regular clean.',
  },
];

// §12 Non-branded FAQs.
//
// ⚠️ VERIFICATION PASS. Checkable claims here:
//   - Grout is cement based and porous. Correct.
//   - Acidic cleaners etch natural stone. Correct and important.
//   - Bleach degrades grout with repeated use and does not remove embedded
//     soil. Correct in substance and widely documented in trade guidance.
//   - ⚠️ NEVER MIX BLEACH WITH ACID OR AMMONIA. This is a genuine safety
//     point, it is the one piece of safety advice on this page, and it is
//     stated as a prohibition with no method attached, exactly as
//     mould-cleaning-and-removal.astro handles the same warning. BFD 5.3
//     bars advice that could cause harm if followed incorrectly, so this
//     tells the reader what NOT to do and nothing else. Do not expand it
//     into a how-to or name a safe alternative product.
const nonBrandedFaqItems = [
  {
    question: 'Why does grout go dark even when the floor is mopped?',
    answer:
      'Partly because of the mopping. Grout sits slightly below the tile surface and is porous, so a mop lifts soil off the glazed tile and deposits a share of it into the grout line along with the dirty water. Over years that builds up inside the material rather than on it, which is why the lines keep darkening in a bathroom that is cleaned every week.',
  },
  {
    question: 'Does bleach clean grout?',
    answer:
      'It lightens the surface without removing what is embedded in it, so the improvement is cosmetic and short lived, and the colour greys back over the following weeks. Used repeatedly it also breaks down the grout itself, which eventually crumbles and washes out of the joint. ⚠️ Never mix bleach with an acidic cleaner, with ammonia, or with any other product: the combination produces dangerous gases.',
  },
  {
    question: 'What is the difference between cleaning, sealing and regrouting?',
    answer:
      'Cleaning removes what has soaked into the existing grout. Sealing puts a barrier over clean grout so it absorbs less from then on, and needs redoing periodically. Regrouting is a trade job: the old grout is cut out and replaced, which is the right answer when it is cracked, crumbling or stained beyond recovery. Cleaning cannot fix a grout line that is physically gone.',
  },
  {
    question: 'Can you clean the silicone in a shower?',
    answer:
      'Silicone is different from grout and often the part that actually looks bad. Discoloured silicone is usually stained right through rather than dirty on the surface, and once it is, cleaning will not recover it. Replacing a bead of silicone is inexpensive and makes more visible difference to a shower than almost anything else. Persistent black spotting there is very often mould, which we cover separately.',
  },
  {
    question: 'How much does tile and grout cleaning cost?',
    answer:
      // ⚠️ BRACKETED ON PURPOSE, same as every sibling.
      'Usually priced per area or per room, with bathrooms often quoted as a whole because the wall tiling, the shower and the floor are one job. What moves the price is the area, the condition, the surface type and whether sealing is added. [TLB’s pricing basis and minimum charge. Confirm.]',
  },
];

const closingCta = {
  kicker: 'Tile and grout cleaning',
  heading: 'Find out how far it will come back.',
  lead: 'We look at the surface and the grout, give you a realistic view of the result and a price. If it needs a trade rather than a clean, we will say so.',
  cta: { label: 'Get an instant quote', href: quoteCta.href },
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ServiceBlocks
      variant="icon-grid"
      heading="How we clean tile and grout"
      lead="Six stages. Most of the result comes from dwell time and agitation, not from pressure."
      items={methodItems}
      cta={{ label: 'Get an instant quote', href: quoteCta.href }}
    />

    <Callout tone="note" heading={mouldCallout.heading} body={mouldCallout.body} cta={mouldCallout.cta} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Why bleach makes it worse in the long run"
      body={worthKnowingBody}
    />

    <ServiceBlocks
      variant="list"
      heading="Other things we clean around the house"
      lead="The jobs a regular clean never has time for. Any of them can go on the same visit."
      items={clusterServices.map((service) => ({
        icon: 'spray-bottle' as const,
        title: service.label,
        description: service.blurb,
        href: service.href,
      }))}
    />

    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      lead={comparisonTable.lead}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Across the Northern Rivers and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={brandedFaqItems} />
    <Faq heading="Tile and grout cleaning FAQs" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
