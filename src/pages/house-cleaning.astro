//
// ⚠️ "James" is named with no other context in the brief — confirm who he is
// (regular client? how long? which town?) before the label ships as alt text.
const heroVideo = {
  headingLines: ['A word from James.'],
  video: {
    ratio: '16/9',
    label: 'James, regular TLB client, talking to camera about his cleans',
  },
};

// §11 "Easy to book, instant pricing, cost effective" — NEW SECTION, and
// where the hero subheadline's three claims get paid off. That's why it earns
// the page's second button.
//
// Identical component, theme, heading and CTA to the same-named section
// already shipping on deep-cleaning.astro — same brief generation, same role
// on the page, so it isn't decided again here. TextBlock's `cta` defaults to
// the inverse-accent button variant on a dark theme, which is what that page
// renders.
const bookingBody: TextBlockBody[] = [
  "Book online in a couple of minutes, or send a text, ring us or drop us an email, whichever you'd actually do.",
  "You get a price straight away rather than waiting on a quote, and it's based on your actual place rather than a guess. Tell us the size of it and roughly what condition it's in, and if a deep clean first would serve you better than a long first regular visit, we'll say so.",
  "Cost effective because it's the same team each visit working to a set routine, so nobody is relearning your house. No lock-in, no minimum term and no exit fee. Skip a visit when you're away, and your spot stays yours.",
];

// §12 Social proof — section built, but every quote/name/role below is a
// bracketed [TBC] briefing slot, NOT a real client testimonial. Same
// convention every other page on this site uses: the visible text reads as
// obviously unfinished, so it can't be mistaken for a real customer saying a
// real thing. Swap each slot for a real quote as it's collected; never fill
// these with invented names or words.
//
// Two slots, not three, because the brief specifies exactly two jobs for this
// page's testimonials — tenure and the switcher story. There's no third
// brief-specified angle, so there's no third story to reserve.
//
// `uniform` because with exactly 2 items the carousel renders no arrows or
