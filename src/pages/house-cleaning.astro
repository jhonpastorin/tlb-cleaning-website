const testimonials = [
  {
    quote:
      "[TBC — ask Teagan for a quote from a long-standing client, ideally naming how long they've been with TLB. Tenure is the proof this page needs.]",
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Long-standing TLB client' },
  },
  {
    quote:
      '[TBC — ask Teagan for a quote from a client who has been with a few cleaners over the years. That story is what converts.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Client who switched to TLB after other cleaners' },
  },
];

// §13 Where we clean — the shared 56-town, three-region list from
// src/data/locations.ts, which every "Where we clean" section now reads
// from. It replaced this page's first-build 12-town flat list, then lived
// here as a verbatim copy of the homepage's until the duplication was
// extracted. The open questions — the /locations/<slug>/ URL pattern and
// the ~41 town pages that don't exist yet — are flagged there, where one
// fix serves every page.
//
// Two stale `isHighlighted: true` flags went with the first rewrite. That
// property no longer exists on TagCloud's Tag interface, and astro check
// does NOT catch it (excess-property checking doesn't fire on a
// const-inferred array passed to a prop), so those two pills had been
// silently rendering un-highlighted.

// §14 FAQs — twelve questions, ONE block.
//
// The first build split its FAQs into a "branded" and a "non-branded"
// accordion, because the first brief supplied two labelled lists. This
// revision supplies one H2 and one run of twelve questions, so it ships as
// one accordion — the same call deep-cleaning.astro makes for the same
// reason. Don't split it back into two for site symmetry: that would mean
// inventing the second heading and deciding which questions sit under it,
// neither of which is in the brief.
//
// The first build HELD BACK three of these (minimum booking, sick/holiday
// cover, products and equipment) as unconfirmed operational-policy claims.
// deep-cleaning.astro has since established the handling for [CONFIRM]
// answers: strip the marker from published copy (it's a note to Teagan, not
// text for a visitor), flag each inline here, and ship. These are finished
// sentences awaiting a read-through, not literal unfilled blanks. All twelve
// ship.
//
// One first-build question is DROPPED, because this revision doesn't carry
// it: "Why not just find a cleaner through a local Facebook group?" — its
// answer rested entirely on the "nine employed local mums" framing this brief
// drops.
const faqItems = [
  {
    question: "Who's in my house when I'm at work?",
    answer:
      "Someone you've met. We'll introduce the cleaner looking after your home before the first visit, so you never open the door to a stranger. How we get in is agreed when you book.",
  },
  {
    // ⚠️ [CONFIRM] — the brief marks this whole answer as a suggestion. A
    // same-cleaner assurance is a promise a client will hold TLB to on the
    // day someone different turns up. Needs Teagan's read-through.
    question: 'Will I get the same cleaner every time?',
    answer:
      "Yes, wherever we can. Your home is assigned to a team and that's who you'll see. If someone's away, another member of your team covers and we let you know beforehand.",
  },
  {
    question: "Can I skip a clean when we're away?",
    answer:
      "Yes, just let us know ahead of time and we'll move it or skip it. Your spot stays yours. Most families skip a fortnight over Christmas and pick straight back up in January.",
  },
  {
    question: 'What happens at the first visit?',
    answer:
      "It takes longer than the ones after it, because we're starting from wherever the house is. We'll walk through with you, agree the priorities, and set the rhythm from there.",
  },
  {
    question: 'Do I need to tidy up before you arrive?',
    answer:
      "Tidy, don't clean. Clearing benchtops, floors and vanities makes a real difference, because time spent moving your things is time not spent cleaning. Put away clothes, toys, dishes and anything fragile. If the house is cluttered on the day, we clean around it and some of the detail gets missed.",
  },
  {
    question: 'How much does a regular clean cost?',
    answer:
      "It depends on the size of your place, its condition and how often we come, which is why we quote rather than publish a flat rate that would be wrong for most homes. Tell us the basics and you'll have a price back quickly, with no obligation attached.",
  },
  {
    question: 'Am I locked into a contract?',
    answer:
      "No. No minimum term, no exit fee, and you can pause or skip a visit whenever you need to. Most people stay because it's working, not because they signed something.",
  },
  {
    // ⚠️ [CONFIRM], and the weakest answer on the page: as drafted it says
    // what MOST cleaning companies set and why, then defers to a quote — it
    // never states TLB's OWN minimum, so it doesn't yet answer its own
    // question. The first build held it back for exactly this reason. It
    // ships now per the deep-cleaning precedent, but this is the [CONFIRM]
    // most worth acting on.
    question: 'Is there a minimum booking?',
    answer:
      "Most cleaning companies set a minimum of around two hours, because anything shorter can't be done properly once travel and setup are counted. Tell us the size of your place when you book and we'll tell you honestly what it needs.",
  },
  {
    // ⚠️ [CONFIRM cover arrangements] — a cover guarantee is another promise
    // a client can hold TLB to. Needs Teagan's read-through.
    question: 'What if my cleaner is sick or on holiday?',
    answer:
      "Another member of your team covers, and we'll let you know in advance rather than leaving you wondering on the day.",
  },
  {
    // ⚠️ [CONFIRM product range] — this answer commits TLB to using a
    // client's own products or bringing an alternative for a baby, an
    // allergy or a pet. Whoever stocks the vans needs to agree with it.
    question: 'Do you bring your own products and equipment?',
    answer:
      "Yes. Our team arrives with everything needed, so you don't have to supply anything or set anything out. If you'd rather we used particular products in your home, because of a baby, an allergy or a pet, tell us when you book and we'll use what you've got or bring an alternative.",
  },
  {
    question: 'Can I ask for particular things to be prioritised each visit?',
    answer:
      "Yes, and most regular clients do. Tell us what matters most in your house, whether that's the bathrooms, the floors or the kitchen, and we'll work to that order every visit. If your priorities change, message us and we'll update the notes on your booking.",
  },
  {
    question: 'Can I book over the phone instead of online?',
    answer: 'Yes. Online, text, phone or email, whichever suits you.',
  },
];

// §15 Closing block — REAL COPY at last. The first brief never drafted this
// paragraph, so the first build echoed the hero's own lines as a placeholder.
// This revision supplies both sentences, so the placeholder goes.
const closingCta = {
  heading: 'Set your day, meet your team, and stop thinking about it.',
  lead: "Tell us about your place and we'll come back with a price.",
  cta: quoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* §2 + §3. Trust bar and opening paragraph share ONE photo behind a
        Cream scrim, so it is laid out across both — see the homepage for why
        a per-section background cannot do this. 75% keeps Dark Teal body
        copy above 4.5:1 over the darkest part of the frame. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75} focus="top">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ComparisonTable
      heading={inclusionsTable.heading}
      lead={inclusionsTable.lead}
      cornerLabel={inclusionsTable.cornerLabel}
      columns={inclusionsTable.columns}
      rows={inclusionsTable.rows}
      footnote={inclusionsTable.footnote}
    />

    {/* §6. Second ComparisonTable, directly after the first — flagged in the
        plan as a rhythm risk and judged acceptable: they answer two
        different questions (what happens each visit vs. how often), their
        headings and cornerLabels say so, and this one is 3x3 against the
        other's fourteen rows. */}
    <ComparisonTable
      heading={frequencyTable.heading}
      cornerLabel={frequencyTable.cornerLabel}
      columns={frequencyTable.columns}
      rows={frequencyTable.rows}
      footnote={frequencyTable.footnote}
    />

    <TextBlock theme="light" align="left" heading="The first one takes longer." body={firstVisitBody} />

    <TextBlock
      theme="dark"
      align="left"
      heading="What you're actually buying."
      body={buyingBody}
      backgroundImage={buyingBgImg}
      scrimOpacity={82}
    />

    {/* §9. Drag the handle to wipe between the two frames of each pair —
        see the §9 block above for why this is a slider and not a gallery,
        and for the fact that these four images are SAMPLES. The `note` is
        what tells the reader that; delete it with the sample imports. */}
    <BeforeAfter
      heading="The difference, on real jobs."
      lead="Drag the handle across each photo to see the same spot before and after a clean."
      pairs={beforeAfterPairs}
      note="Illustrative samples, shown while we collect before and after photos from real TLB cleans."
    />

    <VideoFeature headingLines={heroVideo.headingLines} video={heroVideo.video} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Easy to book, instant pricing, cost effective"
      body={bookingBody}
      cta={quoteCta}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
