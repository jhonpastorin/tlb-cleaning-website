---
// House cleaning page, rebuilt from the SECOND revision of the Regular House
// Cleaning brief. Section choices, positioning, and every "don't invent this"
// call trace back to content-plans/home-cleaning.md — see its "Open items"
// list for everything flagged below.
//
// Ships at /house-cleaning/ per the plan's §0 slug ruling; the plan file is
// named home-cleaning.md after the brief's own title, not after the slug.
//
// WHAT THE SECOND BRIEF CHANGED, in one place:
//  1. ✅ Trust bar moves to the five points deep-cleaning.astro and
//     index.astro already carry. That closes deep-cleaning's own flag naming
//     this page as one of four still behind.
//  2. ✅ NEW §6 "Weekly, fortnightly or monthly" — a real 3×3 comparison
//     grid, ComparisonTable's exact contract.
//  3. ✅ NEW §8 "What you're actually buying" REPLACES the old "Nobody leaves
//     a cleaner over the cleaning" bullet block. Don't re-add the bullets.
//  4. ✅ NEW §11 "Easy to book, instant pricing, cost effective" — identical
//     to the section already shipping on deep-cleaning.astro.
//  5. ✅ "Where we clean" grows from a 12-town flat list to the same 56 towns
//     in three labelled groups deep-cleaning uses. Two stale
//     `isHighlighted` flags go with it — that property no longer exists on
//     TagCloud's Tag interface and astro check does not catch it.
//  6. ✅ FAQs go from 6 across two blocks to 12 in ONE accordion, including
//     the three the first build held back. Same [CONFIRM] handling
//     deep-cleaning established: strip the marker, flag inline, ship.
//  7. ✅ The closing block gets real copy, so the hero-echo placeholder goes.
//  8. ✅ §9's before/after gallery becomes a DRAGGABLE COMPARISON SLIDER
//     (the new BeforeAfter.astro), closing the first build's own flag that
//     nothing in this library paired two images as one unit. The kitchen
//     pair is now real photography, and so is slot 2 — see §9.
//  9. ❌ The old brief's "how we compare" table is gone from this revision
//     entirely. Closed, not deferred.
//
// Sections blocked on content that doesn't exist yet are built as RESERVED
// SLOTS — labelled Placeholder frames and bracketed [TBC] briefing text.
// Obviously unfinished on sight, zero layout shift when the real assets and
// quotes land. Never fill a reserved slot with invented photos, quotes or
// names — those are outward-facing trust claims, not filler.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
// Before/after pairs — real TLB job photos. The `sample-` files are flat
// illustrations and stay only where no real pair exists for that subject yet.
import VideoFeature from '../components/sections/VideoFeature.astro';
import GoogleReviewSlider from '../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../data/googleReviews';
import TagCloud from '../components/sections/TagCloud.astro';
import { locationGroups } from '../data/locations';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
// §2 + §3 backdrop, behind the Cream scrim (this page's own folder).
// §4 situation cards. Real TLB photos (6 Oct 2026), copied into this folder
// and pre-cropped to the cards' 4:3: a hands-on bathroom clean for "got away
// from me", a cleared room onto the deck for moving out, and a lived-in
// kitchen with nobody in it for Mum or Dad's place (see card 3's note). The
// shower and kitchen are the same shots as the Airbnb and deep cleaning pages.
// §8 backdrop. The asset's own filename is literally the state this section
// is selling — a living room kept up by regular visits.
// Before/after. Both pairs are REAL TLB job photography.
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
// Site chrome (header nav, mega-menus, footer links/contact) — shared with
// index.astro, see src/data/navigation.ts.
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { trustBarCards } from '../data/trust';
import { howItWorks, managedForYou } from '../data/brand-lines';
import { localBusiness } from '../data/business';
import { z } from 'astro/zod';
import { getPage } from '../lib/cms';
import * as section from '../lib/cms-schemas';
import { sized, highlightColumn } from '../lib/cms-schemas';

// §0 Page metadata — title tag and description both drafted in full.
//
// META REVERTED TO THE KEYWORD WORKBOOK 16 Sep 2026, on TLB's instruction to
// ship the workbook copy verbatim. This is the line the previous revision
// had deliberately replaced, so that replacement is now undone: both the
// "local mums" framing and the police-checked/insured claim are back.
//
// What the revert costs, recorded so it is not lost:
//  1. The standing geo phrase "across the Northern Rivers and the Tweed" is
//     gone from this description. Every other service page carries it. This
//     page now names no service area at all in its meta.
//  2. The mapped primary `house cleaning services` is no longer contiguous
//     in the description; "Regular house cleaning" is the closest it gets.
//     The title still carries the primary verbatim.
//  3. "Same cleaner every visit" is a stronger promise than the page body
//     makes. §1 and the process copy say the same TEAM on a set day, not
//     the same individual. Worth reconciling if a client holds us to it.
// 142 characters, so no truncation risk.
//
// In `pageMeta`:
// §0: slug ruled as /house-cleaning/. Domain is still a placeholder,
// same as every other page in this repo — confirm before launch.

// In `business`:
// Three regions now, matching §3's opening paragraph and §13's groups.

// §1 Hero — copy drafted in full, both lines new this revision.
//
// The subheadline change is load-bearing, not a reword. The old lead
// explained the benefit ("so you can stop wondering whether anyone is turning
// up"); this one front-loads the three commercial claims §11 later pays off.
//
// `split-single-image` with image right and the default `cover` fit. Until
// 6 Oct 2026 this ran the transparent cut-out of two cleaners with
// `contain-bottom`; it is now a real photo of a TLB cleaner at a kitchen sink,
// so it fills the panel like any photo. Measured at 1440px the desktop panel
// is roughly square (~650x645, with the trust bar overlapping its last ~40px),
// so the file is the same slightly portrait 0.9:1 crop as the end of lease
// hero: it shows the photo's full width, oven to window. That is as wide as
// this photo goes; zooming out further needs a wider original. `ratio` is the
// mobile fallback, where the panel has no height of its own.
//
// The CTA lives here rather than on the opening paragraph below (§3), per the
// plan's ruling: Hero.astro's `cta` prop is required, so it can't be moved
// down instead, and two identical buttons half a screen apart would be worse
// than one. The brief's other two buttons (§11, §15) ARE built.

// §3 Opening paragraph — drafted in full. This is the page's answer-target
// block for `house cleaning services`, so it stays the first prose after the
// hero. `cta` deliberately unset (see §1's note above).
//
// The second sentence names THREE regions this revision, where the first
// brief named two — matching §13's three-region grouping.

// §4 Situation cards — card copy verbatim, split into title (the opening
// first-person sentence) + description (the rest). Unchanged this revision.
//
// Three things below are NOT from the brief and are flagged in the plan as
// open items: the section heading/accent lines, the per-card CTA labels, and
// the card images. The headings are placeholder structural copy so the
// section renders; the CTA labels are plain wayfinding, not marketing copy.
//
// In `pathwayCards`, on "A TLB cleaner wiping down the bottles in a walk-in shower":
// Label follows the photo: the library has no "lived-in kitchen
// before" shot, so this shows the deep clean itself — which is what
// the card's CTA sends you to. Doubles as alt text.
// In `pathwayCards`, on "A tidy, sunlit kitchen with timber cabinets and a garden window":
// §0: /house-cleaning/senior-home-cleaning/ is the domestic seniors page. It is NOT
// the same page as Commercial → "Aged care, retirement and seniors"
// (/commercial-cleaning/aged-care-cleaning/), which is cleaning aged-care
// premises. It currently has no mega-menu entry — open item.
// The home, not the person — an adult child reading this card is
// picturing their parent's place. A real, lived-in kitchen since 6 Oct
// 2026; the generated living room it replaced is in IMAGE-PROMPTS.md.

// §5 "What's included in every visit" — ONE ComparisonTable covering the room
// list and both scope lists. Content unchanged this revision, so the shape is
// unchanged too.
//
// COLUMN DESIGN — one column, three states. ComparisonTable's `values`
// accepts a string as well as a boolean, and a cell rendered as a short note
// is what carries the middle state here:
//
//   ✓                    → in every clean, at no extra cost
//   "Quoted separately"  → we do it, but it's priced separately
//   ✗                    → we don't do it at all
//
// A second "Quoted separately" column was tried first and dropped: it put a
// CHECK MARK under a negative heading on the exclusion rows (a tick meaning
// "yes, we don't do this"), and spent a full column on crosses. Folding that
// state into the cell text keeps the "costs extra is not the same as we don't
// do this" distinction the plan calls out, in half the width.
//
// The five rooms carry their task lists as `description`, so no detail from
// the brief's room-by-room list is lost in the move to a table.
//
// In `inclusionsTable`, on "Laundry room":
// ⚠️ This is the laundry ROOM. The brief also lists "laundry" (washing
// your clothes) as NOT included further down — two different things
// that would read as a flat contradiction if both rows just said
// "Laundry". The other row is disambiguated to "Washing, drying and
// folding clothes" for exactly this reason; don't shorten it back.

// §6 "Weekly, fortnightly or monthly" — NEW SECTION this revision, and a
// clean fit: the brief supplies a real 3-column × 3-row grid, which is
// ComparisonTable's exact contract. Already proven at three columns on
// deep-cleaning.astro.
//
// `highlight` on Fortnightly is the copy's own claim rendered in layout, not
// invented emphasis — the brief's closing line is "Fortnightly suits most
// homes", and the Suits row says the same thing.
//
// `cornerLabel` names the question the table answers, distinct from the <h2>
// above it — the same two-heading pattern index.astro and deep-cleaning.astro
// already use.
//
// 🟡 The "First visit" row has three IDENTICAL cells. As a comparison row it
// tells the reader nothing, and §7 immediately below is a whole section about
// exactly that. Kept verbatim because it's true and because it pre-empts the
// question at the moment the reader is choosing a frequency — but dropping it
// loses nothing and tightens the table. Flagged for review, not silently cut.
//
// ⚠️ The brief closes this section with "[CONFIRM with Teagan that this
// reflects how she would actually advise.]" The marker is stripped from the
// published copy (it's a note to Teagan, not text for a visitor), but the
// whole section is an operational recommendation a client will act on.
// Whoever schedules these jobs needs to agree with it.

// §7 "The first one takes longer" — drafted in full. Two paragraphs this
// revision where the first build had one, and the new clause "rather than
// quoting for the bigger job by default" is a real commercial promise, not a
// rewording.

// §8 "What you're actually buying" — NEW SECTION, and it REPLACES the first
// build's "Nobody leaves a cleaner over the cleaning."
//
// ⚠️ That block led with a four-item bullet list of ways cleaners fail. This
// one makes the same argument in running prose. DON'T RE-ADD THE BULLETS —
// the brief writes all three of these as paragraphs, and the list is what
// carried the old block's "nine local cleaners, employed properly" claim,
// which this revision drops along with the "local mums" framing.
//
// Photo behind the Dark Teal ground rather than a flat band: this is the line
// the page turns on, and it's the only dark prose block between two light
// ones. 82% scrim — the same figure why-tlb.astro and index.astro use for
// their own dark pivot blocks — keeps Off White copy at full contrast over
// the photo's bright window light.

// §9 Credibility signals — before/after images from genuine TLB jobs, now on
// a DRAGGABLE COMPARISON SLIDER (BeforeAfter.astro) rather than a gallery.
//
// This closes the gap the previous build wrote down in this very file:
// "nothing in SECTIONS.md pairs two images as one unit." It doesn't any more.
// PhotoGallery `grid` laid four independent frames out and left the viewer to
// hold one in memory while looking at the next; `filmstrip`, tried before
// that, actively broke the comparison by never showing a Before and its After
// at the same size. The slider makes the PAIR the unit and does the
// comparison for the viewer, in place.
//
// These frames are REAL TLB JOB PHOTOGRAPHS, published with the client's
// permission and with nothing identifying in frame — no house numbers, street
// signs, mail, people, or names on doors. That is why this section carries no
// "illustrative samples" note. Do NOT wire the `sample-` files back in without
// restoring a note that says so: a fabricated "before and after from a real
// job" is a false trust claim, not filler.
//
// ⚠️ BOTH PAIRS ARE KITCHEN SURFACES. The shower/bathroom pair this section
// used to carry was dropped rather than shown as an illustration next to a
// photograph, so nothing on this page evidences bathroom work. A real shower
// pair is the outstanding shoot; when it lands it takes slot 2 back.
//
// SWAPPING IN THE REAL PHOTOS is four import lines and deleting the note.
// The photo brief that used to live in these frames' Placeholder labels, kept
// here because it's still the brief:
//   1. BEFORE — kitchen benchtop and splashback, genuine TLB job.
//   2. AFTER  — the same benchtop, same angle.
//   3. BEFORE — shower screen and tiles, genuine TLB job.
//   4. AFTER  — the same shower screen and tiles, same angle.
// Shoot each pair from ONE FIXED POSITION. The slider wipes one frame over
// the other in place, so a shifted camera or a different crop reads as a
// glitch rather than as cleaning — a requirement the component cannot
// enforce and the brief has to.
//
// ⚠️ Two consent conditions, both from the brief, both on TLB to meet before
// real photos publish: written client permission, and no identifying detail
// in frame — no house numbers, street signs, mail, people, or names on doors.
// A "before" photo of someone's house is the most sensitive image this site
// would carry. Do NOT substitute stock photography either.
//
// Heading/lead are NOT in the brief ("Credibility signals" is a section
// label, not copy) — placeholder structural copy, flagged as an open item.

// §10 Hero video — James testimonial.
//
// Reserved slot, same reasoning: VideoPlaceholder holds a 16/9 frame with a
// play affordance and the label visible, so the real embed drops in later
// without touching layout.
//
// ⚠️ headingLines is placeholder copy. The brief's own row reads "Hero video"
// / "James video testimonial" — a section label and an asset note, neither of
// which is page copy. Needs a real H2.
//
// ⚠️ "James" is named with no other context in the brief — confirm who he is
// (regular client? how long? which town?) before the label ships as alt text.

// §11 "Easy to book, instant pricing, cost effective" — NEW SECTION, and
// where the hero subheadline's three claims get paid off. That's why it earns
// the page's second button.
//
// Identical component, theme, heading and CTA to the same-named section
// already shipping on deep-cleaning.astro — same brief generation, same role
// on the page, so it isn't decided again here. TextBlock's `cta` defaults to
// the inverse-accent button variant on a dark theme, which is what that page
// renders.

// §13 Where we clean — the shared 56-town, three-region list from
// src/data/locations.ts, which every "Where we clean" section now reads
// from. It replaced this page's first-build 12-town flat list, then lived
// here as a verbatim copy of the homepage's until the duplication was
// extracted. The open questions — the /locations/<slug>/ URL pattern and
// the ~41 town pages that don't exist yet — are flagged there, where one
// fix serves every page.
//
// Two stale `isHighlighted: true` flags went with the first rewrite. That
// property no longer exists on TagCloud's Tag interface, and astro check
// does NOT catch it (excess-property checking doesn't fire on a
// const-inferred array passed to a prop), so those two pills had been
// silently rendering un-highlighted.

// §14 FAQs — twelve questions, ONE block.
//
// The first build split its FAQs into a "branded" and a "non-branded"
// accordion, because the first brief supplied two labelled lists. This
// revision supplies one H2 and one run of twelve questions, so it ships as
// one accordion — the same call deep-cleaning.astro makes for the same
// reason. Don't split it back into two for site symmetry: that would mean
// inventing the second heading and deciding which questions sit under it,
// neither of which is in the brief.
//
// The first build HELD BACK three of these (minimum booking, sick/holiday
// cover, products and equipment) as unconfirmed operational-policy claims.
// deep-cleaning.astro has since established the handling for [CONFIRM]
// answers: strip the marker from published copy (it's a note to Teagan, not
// text for a visitor), flag each inline here, and ship. These are finished
// sentences awaiting a read-through, not literal unfilled blanks. All twelve
// ship.
//
// One first-build question is DROPPED, because this revision doesn't carry
// it: "Why not just find a cleaner through a local Facebook group?" — its
// answer rested entirely on the "nine employed local mums" framing this brief
// drops.
//
// In `faqItems`, on "Will I get the same cleaner every time?":
// ⚠️ [CONFIRM] — the brief marks this whole answer as a suggestion. A
// same-cleaner assurance is a promise a client will hold TLB to on the
// day someone different turns up. Needs Teagan's read-through.
// In `faqItems`, on "Is there a minimum booking?":
// ⚠️ [CONFIRM], and the weakest answer on the page: as drafted it says
// what MOST cleaning companies set and why, then defers to a quote — it
// never states TLB's OWN minimum, so it doesn't yet answer its own
// question. The first build held it back for exactly this reason. It
// ships now per the deep-cleaning precedent, but this is the [CONFIRM]
// most worth acting on.
// In `faqItems`, on "What if my cleaner is sick or on holiday?":
// ⚠️ [CONFIRM cover arrangements] — a cover guarantee is another promise
// a client can hold TLB to. Needs Teagan's read-through.
// In `faqItems`, on "Do you bring your own products and equipment?":
// ⚠️ [CONFIRM product range] — this answer commits TLB to using a
// client's own products or bringing an alternative for a baby, an
// allergy or a pet. Whoever stocks the vans needs to agree with it.

// §15 Closing block — REAL COPY at last. The first brief never drafted this
// paragraph, so the first build echoed the hero's own lines as a placeholder.
// This revision supplies both sentences, so the placeholder goes.

// CONTENT lives in src/content/pages/house-cleaning.yaml and is edited in
// Pages CMS ("House cleaning (hub)"). This file owns the layout. The notes
// above explain why each section says what it says; they stay here because
// Pages CMS rewrites the YAML on save and would drop them.
const page = await getPage(
  'house-cleaning',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    pathways: section.pathwayCards,
    inclusions: section.comparisonTable,
    frequency: section.comparisonTable,
    firstVisit: section.textBlock,
    buying: section.textBlock,
    beforeAfter: section.beforeAfter,
    video: section.videoFeature,
    // Body is the page's own paragraphs only. The "Managed for you" standfirst
    // above them and the "How it works" steps below them come from Brand
    // lines, so they stay the same on every page.
    booking: section.textBlock,
    reviews: section.sectionHeading,
    whereWeClean: section.tagCloud,
    faq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/house-cleaning/',
};

const business = localBusiness({
  description: pageMeta.description,
  // Three regions now, matching §3's opening paragraph and §13's groups.
  areaServed: 'Northern Rivers NSW, the Tweed, and the Southern Gold Coast QLD',
  sameAs: googleBusinessProfileUrl ? [googleBusinessProfileUrl] : [],
});

const heroImage = page.hero.image && sized(page.hero.image, '1/1');

const pathwayCards = page.pathways.cards.map((card, i) => ({
  number: i + 1,
  ...card,
  image: sized(card.image, '4/3'),
}));

// The single inclusions column, and Fortnightly (the middle column), are the
// highlighted ones.
const inclusionsColumns = highlightColumn(page.inclusions.columns, 0);
const frequencyColumns = highlightColumn(page.frequency.columns, 1);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    {/* §2 + §3. Trust bar and opening paragraph share ONE photo behind a Cream scrim,
        so it is laid out across both — see the homepage for why a per-section
        background cannot do this. 90%, raised from 75% on 29 Sep 2026.
        Measured over this frame's own darkest region under the copy column,
        75% gave 4.09:1 — an AA FAIL. 90% gives 5.90:1. Backdrop.astro's
        `opacity` doc carries the method. Re-check it if the photo is swapped
        in Pages CMS. */}
    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="top">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <PathwayCards heading={page.pathways.heading} headingAccent={page.pathways.headingAccent} cards={pathwayCards} />

    <ComparisonTable
      heading={page.inclusions.heading}
      lead={page.inclusions.lead}
      cornerLabel={page.inclusions.cornerLabel}
      columns={inclusionsColumns}
      rows={page.inclusions.rows}
      footnote={page.inclusions.footnote}
      cta={page.inclusions.cta}
    />

    {/* §6. Second ComparisonTable, directly after the first — flagged in the
        plan as a rhythm risk and judged acceptable: they answer two
        different questions (what happens each visit vs. how often), their
        headings and cornerLabels say so, and this one is 3x3 against the
        other's fourteen rows. */}
    <ComparisonTable
      heading={page.frequency.heading}
      lead={page.frequency.lead}
      cornerLabel={page.frequency.cornerLabel}
      columns={frequencyColumns}
      rows={page.frequency.rows}
      footnote={page.frequency.footnote}
      cta={page.frequency.cta}
    />

    <TextBlock
      theme="light"
      align="left"
      heading={page.firstVisit.heading}
      body={page.firstVisit.body}
      cta={page.firstVisit.cta}
      backgroundImage={page.firstVisit.backgroundImage}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.buying.heading}
      body={page.buying.body}
      cta={page.buying.cta}
      backgroundImage={page.buying.backgroundImage}
      scrimOpacity={82}
    />

    {/* §9. Drag the handle to wipe between the two frames of each pair —
        see the §9 block above for why this is a slider and not a gallery.
        Both pairs are real TLB job photography and the `note` says so —
        correct it, do not delete it, if a sample is ever wired back in. */}
    <BeforeAfter
      heading={page.beforeAfter.heading}
      lead={page.beforeAfter.lead}
      pairs={page.beforeAfter.pairs}
      note={page.beforeAfter.note}
      beforeLabel={page.beforeAfter.beforeLabel}
      afterLabel={page.beforeAfter.afterLabel}
    />

    <VideoFeature headingLines={page.video.headingLines} video={{ ...page.video.video, ratio: '16/9' }} />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.booking.heading}
      body={[managedForYou.recurring, ...page.booking.body, ...howItWorks.general]}
      cta={page.booking.cta ?? quoteCta}
      backgroundImage={page.booking.backgroundImage}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
