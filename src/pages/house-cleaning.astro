  title: 'House Cleaning Services - Regular Cleans | TLB Cleaning',
  description:
    'Regular house cleaning across the Northern Rivers and the Tweed. Set day, same team, easy to book and managed for you. Get a quote in under a minute.',
  // §0: slug ruled as /house-cleaning/. Domain is still a placeholder,
  // same as every other page in this repo — confirm before launch.
  canonical: 'https://example.com/house-cleaning/',
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  // Three regions now, matching §3's opening paragraph and §13's groups.
  areaServed: 'Northern Rivers NSW, the Tweed, and the Southern Gold Coast QLD',
  description: pageMeta.description,
};

// §1 Hero — copy drafted in full, both lines new this revision.
//
// The subheadline change is load-bearing, not a reword. The old lead
// explained the benefit ("so you can stop wondering whether anyone is turning
// up"); this one front-loads the three commercial claims §11 later pays off.
//
// `split-single-image` with image right and `imageFit="contain-bottom"`, same
// treatment as the homepage and the deep cleaning page: the asset is a
// cut-out figure on a transparent backdrop, the panel stretches to the copy
// column's height, so the default `cover` would slice the green circle's
// sides off, and the pair are flush with the bottom of their own frame, so
// anchoring there stands them on the section's edge. `ratio` states the
// asset's exact trimmed dimensions (1920x1080 down to 1364x1032 — the rest
// was empty transparent margin).
//
// The CTA lives here rather than on the opening paragraph below (§3), per the
// plan's ruling: Hero.astro's `cta` prop is required, so it can't be moved
// down instead, and two identical buttons half a screen apart would be worse
// than one. The brief's other two buttons (§11, §15) ARE built.
const hero = {
  headingLines: ['House cleaning you never have to chase.'],
  lead: 'The same local team, on the same day, every time. Easy to book, instant pricing, cost effective.',
  cta: quoteCta,
  image: {
    ratio: '1364/1032',
    label:
      'Two TLB Cleaning house cleaners in cleaning gloves standing back to back',
    src: heroImg,
  },
};

// §3 Opening paragraph — drafted in full. This is the page's answer-target
// block for `house cleaning services`, so it stays the first prose after the
// hero. `cta` deliberately unset (see §1's note above).
//
// The second sentence names THREE regions this revision, where the first
// brief named two — matching §13's three-region grouping.
const definitionBody: TextBlockBody[] = [
  'Regular home cleaning is an ongoing visit on a set schedule, weekly, fortnightly or monthly, that keeps a lived-in house on top of things rather than resetting it.',
  'TLB Cleaning provides house cleaning services across the Northern Rivers, the Tweed and the Southern Gold Coast.',
];

