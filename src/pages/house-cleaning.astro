// §5 "What's included in every visit" — ONE ComparisonTable covering the room
// list and both scope lists. Content unchanged this revision, so the shape is
// unchanged too.
//
// COLUMN DESIGN — one column, three states. ComparisonTable's `values`
// accepts a string as well as a boolean, and a cell rendered as a short note
// is what carries the middle state here:
//
//   ✓                    → in every clean, at no extra cost
//   "Quoted separately"  → we do it, but it's priced separately
//   ✗                    → we don't do it at all
//
// A second "Quoted separately" column was tried first and dropped: it put a
// CHECK MARK under a negative heading on the exclusion rows (a tick meaning
// "yes, we don't do this"), and spent a full column on crosses. Folding that
// state into the cell text keeps the "costs extra is not the same as we don't
// do this" distinction the plan calls out, in half the width.
//
// The five rooms carry their task lists as `description`, so no detail from
// the brief's room-by-room list is lost in the move to a table.
const inclusionsTable = {
  heading: "What's included in every visit.",
  lead: "What's included in every regular clean, and what sits outside it.",
  cornerLabel: 'Room by room',
  columns: [{ label: 'Every regular clean', highlight: true }],
  rows: [
    {
      label: 'Kitchen',
      description:
        'Benchtops, splashback, stovetop, sink and taps, cupboard fronts, microwave outside, bin, floors.',
      values: [true],
    },
    {
      label: 'Bathrooms and toilets',
      description: 'Shower, screen, bath, basin, taps, mirror, toilet inside and out, floors.',
      values: [true],
    },
    {
      label: 'Bedrooms and living areas',
      description: 'Beds made, surfaces dusted, mirrors, skirting boards spot-cleaned, vacuum and mop.',
      values: [true],
    },
    {
      // ⚠️ This is the laundry ROOM. The brief also lists "laundry" (washing
      // your clothes) as NOT included further down — two different things
      // that would read as a flat contradiction if both rows just said
      // "Laundry". The other row is disambiguated to "Washing, drying and
      // folding clothes" for exactly this reason; don't shorten it back.
      label: 'Laundry room',
      description: 'Sink, benches, appliance fronts, floors.',
      values: [true],
    },
    {
      label: 'Throughout',
      description: 'Cobwebs, switches and handles, all floors.',
      values: [true],
    },
    { label: 'Inside the oven', values: ['Quoted separately'] },
    { label: 'Carpet steam cleaning', values: ['Quoted separately'] },
    { label: 'Windows', values: ['Quoted separately'] },
    { label: 'Blinds', values: ['Quoted separately'] },
    { label: 'Inside the fridge', values: ['Quoted separately'] },
    { label: 'Dishes', values: [false] },
    { label: 'Washing, drying and folding clothes', values: [false] },
    { label: 'Tidying or organising belongings', values: [false] },
    { label: 'Moving heavy furniture', values: [false] },
  ],
  footnote:
    "A cross means it's not something we take on. Anything marked quoted separately we're happy to do — just ask when you book and we'll price it in.",
};

// §6 "Weekly, fortnightly or monthly" — NEW SECTION this revision, and a
// clean fit: the brief supplies a real 3-column × 3-row grid, which is
// ComparisonTable's exact contract. Already proven at three columns on
// deep-cleaning.astro.
//
// `highlight` on Fortnightly is the copy's own claim rendered in layout, not
// invented emphasis — the brief's closing line is "Fortnightly suits most
// homes", and the Suits row says the same thing.
//
// `cornerLabel` names the question the table answers, distinct from the <h2>
// above it — the same two-heading pattern index.astro and deep-cleaning.astro
// already use.
//
// 🟡 The "First visit" row has three IDENTICAL cells. As a comparison row it
// tells the reader nothing, and §7 immediately below is a whole section about
// exactly that. Kept verbatim because it's true and because it pre-empts the
// question at the moment the reader is choosing a frequency — but dropping it
// loses nothing and tightens the table. Flagged for review, not silently cut.
//
// ⚠️ The brief closes this section with "[CONFIRM with Teagan that this
// reflects how she would actually advise.]" The marker is stripped from the
// published copy (it's a note to Teagan, not text for a visitor), but the
// whole section is an operational recommendation a client will act on.
// Whoever schedules these jobs needs to agree with it.
const frequencyTable = {
  heading: 'Weekly, fortnightly or monthly',
  cornerLabel: 'How often we come',
  columns: [
    { label: 'Weekly' },
    { label: 'Fortnightly', highlight: true },
    { label: 'Monthly' },
  ],
  rows: [
    {
      label: 'Suits',
      values: [
        'Larger households, homes with pets, heavy kitchen and bathroom use',
        'Most homes',
        'Smaller households, or a top-up between deep cleans',
      ],
    },
    {
      label: 'What it does',
      values: [
        'Holds everything at the same level week to week',
        'Keeps the house steady without over-servicing',
        'Takes the edge off, though the house moves between visits',
      ],
    },
    {
      label: 'First visit',
      values: [
        'Longer than the ones after it',
        'Longer than the ones after it',
        'Longer than the ones after it',
      ],
    },
  ],
  footnote:
    "Fortnightly suits most homes. If you're not sure, start there and tell us if it isn't holding. Changing it later takes a message.",
};

// §7 "The first one takes longer" — drafted in full. Two paragraphs this
// revision where the first build had one, and the new clause "rather than
// quoting for the bigger job by default" is a real commercial promise, not a
// rewording.
const firstVisitBody: TextBlockBody[] = [
  'We start from wherever the house is, so the first visit runs longer than the ones after it and is priced differently.',
  "If it's been a while, a one-off deep clean first works out better value than paying for a long first regular clean. We'll tell you honestly which one you need rather than quoting for the bigger job by default.",
];

// §8 "What you're actually buying" — NEW SECTION, and it REPLACES the first
// build's "Nobody leaves a cleaner over the cleaning."
//
// ⚠️ That block led with a four-item bullet list of ways cleaners fail. This
// one makes the same argument in running prose. DON'T RE-ADD THE BULLETS —
// the brief writes all three of these as paragraphs, and the list is what
// carried the old block's "nine local cleaners, employed properly" claim,
// which this revision drops along with the "local mums" framing.
//
// Photo behind the Dark Teal ground rather than a flat band: this is the line
// the page turns on, and it's the only dark prose block between two light
// ones. 82% scrim — the same figure why-tlb.astro and index.astro use for
// their own dark pivot blocks — keeps Off White copy at full contrast over
// the photo's bright window light.
const buyingBody: TextBlockBody[] = [
  "It isn't a spotless house. It's not thinking about it.",
  "Not wondering whether anyone's coming this week. Not chasing a reply. Not being the one who has to raise it when the bathroom quietly stops being done properly.",
  "Set your day once, meet your team, and it happens. A reminder in the lead-up so it never sneaks up on you, and a message when we're on our way. Some clients want a quick chat when we arrive, others would rather come home to it done. Both are completely fine.",
];

// §9 Credibility signals — before/after images from genuine TLB jobs, now on
// a DRAGGABLE COMPARISON SLIDER (BeforeAfter.astro) rather than a gallery.
//
// This closes the gap the previous build wrote down in this very file:
// "nothing in SECTIONS.md pairs two images as one unit." It doesn't any more.
// PhotoGallery `grid` laid four independent frames out and left the viewer to
// hold one in memory while looking at the next; `filmstrip`, tried before
// that, actively broke the comparison by never showing a Before and its After
// at the same size. The slider makes the PAIR the unit and does the
// comparison for the viewer, in place.
//
// ⚠️ THE IMAGES CURRENTLY WIRED HERE ARE SAMPLES, NOT PHOTOGRAPHS. They are
// flat vector illustrations generated by scripts/make-before-after-samples.mjs
// so the interaction could be built and reviewed before any real client
// photography exists. Each one carries a visible SAMPLE badge, and their
// filenames say `sample-`, precisely so they cannot be mistaken for real
// jobs — the page's guardrail has not moved: a fabricated "before and after
// from a real job" is a false trust claim, not filler. The `note` prop below
// says so on the page itself, in the reader's own view, not just here in a
// comment.
//
// SWAPPING IN THE REAL PHOTOS is four import lines and deleting the note.
// The photo brief that used to live in these frames' Placeholder labels, kept
// here because it's still the brief:
//   1. BEFORE — kitchen benchtop and splashback, genuine TLB job.
//   2. AFTER  — the same benchtop, same angle.
//   3. BEFORE — shower screen and tiles, genuine TLB job.
//   4. AFTER  — the same shower screen and tiles, same angle.
// Shoot each pair from ONE FIXED POSITION. The slider wipes one frame over
// the other in place, so a shifted camera or a different crop reads as a
// glitch rather than as cleaning — a requirement the component cannot
// enforce and the brief has to.
//
// ⚠️ Two consent conditions, both from the brief, both on TLB to meet before
// real photos publish: written client permission, and no identifying detail
// in frame — no house numbers, street signs, mail, people, or names on doors.
// A "before" photo of someone's house is the most sensitive image this site
// would carry. Do NOT substitute stock photography either.
//
// Heading/lead are NOT in the brief ("Credibility signals" is a section
// label, not copy) — placeholder structural copy, flagged as an open item.
const beforeAfterPairs: BeforeAfterPair[] = [
  {
    before: {
      src: sampleKitchenBeforeImg,
      alt: 'Sample illustration: kitchen benchtop and tiled splashback before the clean, with stained grout and spills',
    },
    after: {
      src: sampleKitchenAfterImg,
      alt: 'Sample illustration: the same kitchen benchtop and splashback after the clean, grout clean and surfaces gleaming',
    },
    caption: 'Kitchen benchtop and splashback',
  },
  {
    before: {
      src: sampleShowerBeforeImg,
      alt: 'Sample illustration: shower screen and tiles before the clean, with soap scum on the glass and mould in the grout',
    },
    after: {
      src: sampleShowerAfterImg,
      alt: 'Sample illustration: the same shower screen and tiles after the clean, glass clear and grout white',
    },
    caption: 'Shower screen and tiles',
  },
];

// §10 Hero video — James testimonial.
//
// Reserved slot, same reasoning: VideoPlaceholder holds a 16/9 frame with a
// play affordance and the label visible, so the real embed drops in later
