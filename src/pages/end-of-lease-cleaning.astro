    caption: 'Oven interior',
  },
  {
    before: {
      src: sampleShowerBeforeImg,
      alt: 'Sample illustration: shower screen and grout before a bond clean, glass streaked with soap scum and grout marked',
    },
    after: {
      src: sampleShowerAfterImg,
      alt: 'Sample illustration: the same shower screen and grout after the bond clean, glass clear and joins back to colour',
    },
    caption: 'Shower screen and grout',
  },
];

// Section 10. Video. Reserved 16/9 slot. `headingLines` is drafted.
const heroVideo = {
  headingLines: ['The walkthrough, start to finish.'],
  video: {
    ratio: '16/9',
    label: 'Walkthrough video of a TLB bond clean in an empty rental, room by room',
  },
};

// Section 11. Booking and pricing. TextBlock `dark` for the same reason as
// the deep-cleaning page: it sits between two light sections, it carries the
// page's second CTA, and it argues rather than lists.
//
// [CONFIRM] on the second paragraph. "You get a price up front" is a process
// promise. It matches the instant-quote positioning in BFD 1.5
// differentiator 5, but confirm the quoting flow actually returns a price
// for bond cleans rather than a callback, because bond cleans are
// condition-dependent in a way regular cleans are not.
const bookingBody: TextBlockBody[] = [
  'Book online in a couple of minutes, or send a text, ring us or drop us an email, whichever you would actually do. Tell us the handover date when you book, because that is the date everything works back from.',
  'You get a price up front rather than waiting on a callback. It is based on the property as it actually is, so be honest about the condition when you book. Nothing you tell us will surprise us, and it means we allow the right amount of time instead of running short on the day.',
  'Book the clean for after the removalists and before the final inspection, with a day in between if you can manage it. An empty property cleans faster and better, and that gap is what gives everyone room if something needs a second look.',
];

// Section 12. Social proof. Bracketed [TBC] briefing slots, NOT real
// testimonials. Same convention as every other page: the visible text reads
// as obviously unfinished so it cannot be mistaken for a real client quote.
//
// BFD 5.2 and 3.6.3 both prohibit fabricated or paraphrased testimonials
// outright. IMAGE-GUIDELINES.md section 7 prohibits generating a face to sit
// beside one. Never fill these with invented names, words or photos.
//
// The two angles asked for are the page's two audiences, matching section 3.
const testimonials = [
  {
    quote:
      '[TBC. Ask Teagan for a quote from a tenant whose bond clean passed the exit inspection. This is the most persuasive thing that could sit on this page, and it is the one thing the page is not allowed to promise on its own behalf.]',
    name: '[Client name, TBC]',
    role: '[Suburb / property type, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Bond clean client' },
  },
  {
    quote:
      '[TBC. Ask Teagan for a quote from a property manager at one of the agencies TLB already holds a contract with. Written permission required to name the agency (BFD 5.3). An agency voice answers the capacity and turnaround question that a tenant testimonial cannot.]',
    name: '[Property manager name, TBC]',
    role: '[Agency, TBC, with permission]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Property manager at a regional real estate agency' },
  },
];

// Section 13. Where we clean. The shared 56-town, three-region list from
// src/data/locations.ts. The open questions (the /locations/<slug>/ pattern,
// the ~41 town pages that do not exist yet, and the header mega-menu's
// shorter list) are flagged there, where one fix serves every page.

// Section 14. FAQs. Ten questions, one block, matching deep-cleaning.astro
// rather than the branded/non-branded split the older pages use. BFD 3.5
// asks for an FAQ block on every service page with self-contained 40 to 80
// word answers, which is what these are.
//
// EVERY ANSWER HERE IS DRAFTED, not briefed. The ones carrying operational
// numbers or commitments are flagged individually.
const faqItems = [
  {
    // [CONFIRM] the re-clean policy. Same fact as section 6, so the two have
    // to move together. If section 6 is deleted, delete this too.
    question: 'What happens if the property fails the exit inspection?',
    answer:
      'If the agent lists something that was on our task list, tell us and we will come back and put it right at no charge. That covers what we quoted for. It does not cover work nobody booked, or damage that cleaning was never going to fix. Let us know quickly, before the keys change hands.',
  },
  {
    // Deliberately does NOT promise a bond. See the file header.
    question: 'Do you guarantee I will get my bond back?',
    answer:
      'No, and be careful of anyone who does. Your bond depends on the condition report, fair wear and tear and what the agent writes, and a cleaner controls none of those. What we promise is the part we do control: the property cleaned to the standard the inspection is measured against, and a free re-clean if something on our list is picked up.',
  },
  {
    // [CONFIRM] timings. Drafted from category convention, and left as
    // literal bracketed blanks rather than invented numbers. A wrong number
    // here sets a client's expectation on the day and misprices the job.
    question: 'How long does a bond clean take?',
    answer:
      'Longer than any other clean, because every cupboard, track and oven rack is in scope. An empty two bedroom unit in reasonable condition is usually [CONFIRM: half a day for a team]. A larger house, or one that has been lived in hard, runs to [CONFIRM: a full day or more]. We give you a realistic window when we quote.',
  },
  {
    // [CONFIRM] the exclusions. Restates section 4b. Keep the two in step or
    // the page contradicts itself about what a client is paying for.
    question: "What isn't included in a bond clean?",
    answer:
      'Carpet steam cleaning, exterior windows, pest control, garages, balconies and outdoor areas, full wall washing and any cleaning at height are quoted separately rather than assumed. Repairs, painting, gardening and rubbish removal are not cleaning and we do not do them. Ask when you book if you are unsure and we will tell you straight.',
  },
  {
    question: 'Does the property need to be empty?',
    answer:
      'It does not have to be, but it should be. An empty property cleans faster, cleans better and costs less, because nothing has to be worked around or moved twice. If furniture has to stay, tell us when you book so we quote for the property as it will actually be on the day.',
  },
  {
    // [CONFIRM] whether TLB books carpet cleaning in or refers it out. The
    // answer below says TLB quotes it, which implies TLB arranges it. If
    // that is not true, this becomes "we will point you to someone who does".
    question: 'Do I need the carpets professionally cleaned as well?',
    answer:
      'Check your lease. Many tenancies specifically require professional carpet cleaning at the end of the term, and where that is in writing the receipt is usually what the agent wants to see. We quote carpet cleaning separately rather than folding it in, so ask for it with your quote and it is organised at the same time.',
  },
  {
    question: 'Can you clean a property on the Queensland side of the border?',
    answer:
      'Yes. We work across the Northern Rivers, the Tweed and the Southern Gold Coast, so a tenancy in Coolangatta or Palm Beach is the same booking as one in Kingscliff or Byron. If you are moving across the border, you can book the clean at both ends with the same team.',
  },
  {
    question: 'How much does a bond clean cost?',
    answer:
      'It depends on the size of the property, its condition and whether extras like carpet cleaning are included, which is why we quote instead of publishing a flat rate. Tell us the basics and the handover date and you will have a price back quickly, with no obligation attached.',
  },
  {
    // [CONFIRM] the product range, and the no-power scenario, which is an
    // operational claim about how the team turns up equipped.
    question: 'Do you bring your own products and equipment?',
    answer:
      'Yes, everything. On a bond clean that matters more than usual, because the power and the water are sometimes already disconnected. Tell us when you book if the property will have no power on the day, so we come prepared rather than turning up and finding out.',
  },
  {
    question: 'How far ahead should I book?',
    answer:
      'As soon as you have the handover date. End of month and end of quarter are the busiest windows in this region because most leases end there, and those dates fill first. If you are already inside a tight window, ring us rather than booking online and we will tell you honestly what we can do.',
  },
];

// Section 15. Closing block. Drafted. Names the standard rather than the
// outcome, consistent with the rest of the page.
const closingCta = {
  heading: 'Hand back the keys with the cleaning already sorted.',
  lead: 'Tell us the property and the handover date, and we will quote for what is actually there.',
  cta: quoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar + definition block share ONE photo behind a Cream scrim, so
        it is laid out across both. 75% keeps Dark Teal body copy above 4.5:1
        over the darkest part of the frame. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75} focus="top">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards
      heading={pathwayCards.heading}
      headingAccent={pathwayCards.headingAccent}
      cards={pathwayCards.cards}
    />

    <ContentGrid
      columns={2}
      heading="What's included in a bond clean"
      lead="Every cupboard, track and fitting, because that is what the inspection looks at."
      blocks={inclusionBlocks}
    />

    <Callout tone="note" body={exclusionsCallout.body} />

    <ContentGrid
      columns={3}
      heading="How the standard is actually set"
      lead="An exit inspection is not a judgement about how clean the place feels. It is a comparison."
      blocks={standardBlocks}
    />

    <TextBlock theme="light" align="left" heading="If the agent comes back to you" body={reCleanBody} />

    <TextBlock theme="muted" align="left" heading="Both sides of the border" body={borderBody} />

    {/* Wrapper carries the #compare anchor PathwayCards card 3 links to.
        ComparisonTable takes no id prop, and adding one just for an anchor
        target isn't worth a shared-component change. */}
    <div id="compare">
      <ComparisonTable
        heading={comparisonTable.heading}
        cornerLabel={comparisonTable.cornerLabel}
        columns={comparisonTable.columns}
        rows={comparisonTable.rows}
        footnote={comparisonTable.footnote}
      />
    </div>

    {/* Drag the handle to wipe between the two frames of each pair — see
        the block above `beforeAfterPairs` for why this is a slider and not
        a gallery, and for the fact that these four images are SAMPLES. The
        `note` is what tells the reader that; delete it with the imports. */}
    <BeforeAfter
      heading="The difference, on real jobs."
      lead="Drag the handle across each photo to see the same spot before and after a bond clean."
      pairs={beforeAfterPairs}
      note="Illustrative samples, shown while we collect before and after photos from real TLB cleans."
    />

    <VideoFeature headingLines={heroVideo.headingLines} video={heroVideo.video} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Book it around the handover date"
      body={bookingBody}
      cta={quoteCta}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
