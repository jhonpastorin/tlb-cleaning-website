// Section 0. Page metadata.
//
// The description deliberately does NOT say "bond back". It names the
// standard and the service area, which is the strongest honest claim
// available. See the guarantee note in the file header.
//
// It names both states, because the cross-border service area is the point
// of section 7 and it is what a Tweed Heads tenant is actually searching on.
const pageMeta = {
  title: 'End of Lease and Bond Cleaning | TLB Cleaning',
  description:
    'Bond cleaning across the Northern Rivers and Southern Gold Coast, cleaned to the standard your exit inspection is measured against. Published task list, quoted before we start.',
  // Domain still a placeholder, same as every other page. Confirm before launch.
