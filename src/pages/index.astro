---
// Homepage built from the "TLB Cleaning — Home Page" brief (MNO Ventures,
// September 2026, Version 6). Section choices, positioning and every
// "don't invent this" call trace back to that document; where this build
// departs from the brief's literal order, the reason is stated inline.
//
// v6 rewrote the whole page against v5 (content-plans/cleaning-services-homepage.md):
// the "nine full-time cleaners" / "local mums" / police-check proof points
// are gone, the region is stated as the Northern Rivers and the Tweed
// (with the Southern Gold Coast crossed into rather than led with), and two
// new prose sections plus a much larger FAQ, service list and town list
// arrived. Treat this file, not the v5 plan, as current.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import StoryMosaic from '../components/sections/StoryMosaic.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
// Before/after slider (§ credibility signals). The four images are SAMPLE
// illustrations, not photographs — generated by
// scripts/make-before-after-samples.mjs and each stamped with a visible
// SAMPLE badge, so the interaction could be built and reviewed before any
// real client photography exists. Replace them with real paired photography
// and drop the section's `note`; the shooting and consent brief is in the
// block above `beforeAfterPairs` below.
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import type { BeforeAfterPair } from '../components/sections/BeforeAfter.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import { locationGroups } from '../data/locations';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import heroImg from '../assets/home/home-cleaner-with-cleaning-supplies-caddy.png';
// "Three cards" photos, one per card, in card order.
import pathwayHomeImg from '../assets/home/house-cleaning-team-vacuuming-open-plan-living-room.jpg';
import pathwayHolidayLetImg from '../assets/home/holiday-let-cleaning-guest-ready-cottage-living-room.jpg';
import pathwayRentalImg from '../assets/home/rental-property-cleaning-two-storey-house-exterior.jpg';
// Backdrop behind the trust bar + opening paragraph, under the Cream scrim.
import definitionBgImg from '../assets/home/house-cleaning-cleaner-wiping-tall-interior-window.png';
// "Our services" tiles — one photo per service, named for the service so a
// real shoot drops straight in over the top.
import serviceAirbnbImg from '../assets/home/service-airbnb-and-holiday-let-turnovers.jpg';
import serviceEndOfLeaseImg from '../assets/home/service-end-of-lease-and-bond-cleans.png';
import serviceRegularImg from '../assets/home/service-regular-home-cleaning.png';
import serviceRealEstateImg from '../assets/home/service-real-estate-and-property-management.jpg';
import serviceDeepCleanImg from '../assets/home/service-deep-and-one-off-cleans.png';
import type { ImageMetadata } from 'astro';
import sampleKitchenBeforeImg from '../assets/home_cleaning/before_after/sample-kitchen-before.png';
import sampleKitchenAfterImg from '../assets/home_cleaning/before_after/sample-kitchen-after.png';
import sampleShowerBeforeImg from '../assets/home_cleaning/before_after/sample-shower-before.png';
import sampleShowerAfterImg from '../assets/home_cleaning/before_after/sample-shower-after.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
// Site chrome (header nav, mega-menus, footer links/contact) — shared with
// the service pages, see src/data/navigation.ts.
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  serviceLinks,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { trustBarCards } from '../data/trust';

const pageMeta = {
  title: 'Cleaning Services & Cleaners | TLB Cleaning',
  description:
    'A local cleaning team across the Northern Rivers, the Tweed and the Southern Gold Coast. Book online, by text or over the phone. Set your day and we take it from there.',
  canonical: 'https://example.com/',
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  // v6 leads with the Northern Rivers and the Tweed; the Southern Gold
  // Coast is where the team crosses to, not part of the primary claim.
  areaServed: 'Northern Rivers NSW, the Tweed, and the Southern Gold Coast QLD',
  description: pageMeta.description,
};

// Hero — H1 and subheadline verbatim. The brief's [Button] under the
// opening paragraph is this button: the paragraph ships as its own band
// below the trust bar (see the Backdrop note), and repeating the same CTA
