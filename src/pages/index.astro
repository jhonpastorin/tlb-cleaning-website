// one. Every other [Button] in the brief is built where it was asked for.
const hero = {
  headingLines: ['TLB Cleaning.', 'Your reliable local cleaners.'],
  lead: 'A local team across the Northern Rivers and the Tweed. Easy to book, instant pricing, cost effective.',
  cta: quoteCta,
  image: {
    ratio: '1364/1032',
    label: 'TLB Cleaning cleaner in apron and gloves holding a caddy of cleaning supplies',
    src: heroImg,
  },
};

// Opening paragraph — verbatim.
const definitionBody = [
  'TLB Cleaning is a Northern Rivers cleaning company. From Lismore, Alstonville and Ballina, up through Byron, Mullumbimby and Murwillumbah to Tweed Heads, and everywhere else the beautiful Northern Rivers encompasses. We do regular home cleaning, deep and one-off cleans, end of lease and bond cleans, Airbnb turnovers and commercial cleaning.',
];

// Three cards — card copy verbatim, including the links the brief names.
// The section's own heading/accent lines aren't in the brief at all, so
// these two lines are placeholder structural copy carried over from the
// previous build, not a brand decision — flag before launch.
const pathwayCards = {
  heading: 'Tell us what you need',
  headingAccent: "we'll take it from there.",
  cards: [
    {
      number: 1,
      image: {
        ratio: '4/3',
        label: 'TLB cleaners vacuuming and dusting an open-plan living room and kitchen',
        src: pathwayHomeImg,
      },
      title: 'I need a hand at home',
      description:
        "Weekly, fortnightly or a one-off reset. The same faces every visit, and nothing to organise once it's set.",
      cta: { label: 'Get a quote', href: '/house-cleaning/' },
    },
    {
      number: 2,
      image: {
        ratio: '4/3',
        label: 'Guest-ready holiday let living room with a lit wood fire and made-up sofa',
        src: pathwayHolidayLetImg,
      },
      title: 'I have a holiday let',
      description:
        "We work to your booking calendar, not the other way around. Turnovers, restocking and guest-ready presentation, or full management if you'd rather hand the lot over.",
      cta: { label: 'Get a quote', href: '/airbnb-cleaning/' },
    },
    {
      number: 3,
      image: {
        ratio: '4/3',
        label: 'Street view of a managed two-storey rental property between tenancies',
        src: pathwayRentalImg,
      },
      title: 'I manage properties',
      description:
        'Bond and end of lease cleans that pass, and the capacity to handle a rent roll rather than one job at a time.',
      cta: { label: 'Get a quote', href: '/real-estate-cleaning/' },
    },
  ],
};

// "What we do" — the brief's five categories, verbatim. Deliberately the
// icon-led `list` variant rather than photo tiles: "Our services" further
// down is the photographic, link-per-service grid, and running both as
// tiles would make the page ask the same question twice. Each row still
// deep-links to the page that covers it.
const whatWeDoItems = [
  {
    icon: 'house' as const,
    title: 'Inside your home',
    description: 'Regular cleaning, deep and one-off cleans, end of lease and bond cleans.',
    href: '/house-cleaning/',
  },
  {
    icon: 'suitcase' as const,
    title: 'Holiday lets',
    description:
      'Airbnb and short-stay turnovers, restocking, guest-ready presentation, and full management of the property if you want it.',
    href: '/airbnb-cleaning/',
  },
  {
    icon: 'key' as const,
    title: 'For agencies',
    description: 'Bond cleans, vacancy turnarounds, routine managed-property cleans.',
    href: '/real-estate-cleaning/',
  },
  {
    icon: 'spray-bottle' as const,
    title: 'Around the house',
    description: 'Carpets, windows, gutters, pressure cleaning, ovens.',
    href: '/deep-cleaning/',
  },
  {
    icon: 'office' as const,
    title: 'For business',
    description: 'Offices and commercial premises.',
    href: '/commercial-cleaning/',
  },
];

// "Local team, run properly" — bio verbatim. The brief marks a [Team photo]
// here; no such asset exists in src/assets yet, so this stays a labelled
// Placeholder rather than borrowing an unrelated photo. StoryMosaic's image
// blocks are placeholder-only by type, so the swap is a component change,
// not a one-line import — brief the shoot from the label below.
const teamBlocks = [
  { type: 'image' as const, ratio: '3/4', label: 'The TLB Cleaning team' },
  {
    type: 'text' as const,
    body: [
      'TLB was started by Teagan Burke, an Alstonville local who built an amazing team around her, one recommendation at a time. No website, no advertising, just people telling other people about her.',
      "That team is spread right across the Northern Rivers and the Tweed now, inland and on the coast, cleaning in the same towns they live in and shop in. You'll meet whoever is looking after your place before the first visit, and you'll come to know them by name.",
      "Behind the local part is a business that runs properly. Set days, set teams, and a schedule you don't have to hold in your head.",
    ],
  },
];

// href guessed — the "Meet the team" nav item points at /about/ (see
// navigation.ts), so this matches it rather than inventing a second slug.
const teamCta = { label: 'Meet the team', href: '/about/' };

// "Easy to book, local to the core" — new in v6, copy verbatim. Runs over a
// background photo behind the Dark Teal scrim: the section is about the
// calm of not having to organise anything, and a settled, guest-ready room
// says that faster than the words do.
//
// ⚠️ The photo is REUSED from persona card 2 further up this same page. It
// is the only real photograph in the library that fits the mood — the other
// TLB assets are cut-out figures on a green circle, useless full bleed. A
// dedicated photo would be better; the swap is one import line.
const bookingBody = [
  "Book online in a couple of minutes. Or send a text, ring us, or drop us an email, whichever you'd actually do.",
  "You'll get a reminder in the lead-up so the day never sneaks up on you, and a message when we're on our way. If you run a holiday let, we'll work straight off your booking calendar so turnovers happen around your guests without you organising anything.",
  'Then we turn up and get on with it. Some clients want a quick chat and a walk through. Others would rather we let ourselves in and they come home to it done. Both are completely fine, and you can change your mind whenever you like.',
];

// "Easy to book, instant pricing, cost effective" — new in v6, copy
// verbatim. The brief's one-line "You'll know the price before we start,
// not after." is prepended at the call site as this block's first
// paragraph: TextBlock has no separate `lead` slot, and the line is doing a
// standfirst's job, so it reads as one on its own above the detail.
const pricingBody = [
  "We quote on your actual place rather than a guess, so tell us the size of it and roughly what condition it's in and we'll come back with a number. If it turns out you need less than you asked for, we'll say so. A one-off deep clean followed by a fortnightly usually works out better than paying for a long first regular clean, and we'd rather tell you that than take the bigger booking.",
  "No lock-in, no minimum term and no exit fee. If it stops suiting you, tell us and we'll stop.",
];

// Comparison table — copy supplied directly in the brief, verbatim.
//
// NOT src/data/comparison.ts: that file holds the older two-column
// TLB-vs-Other-Brands tick table, which why-tlb.astro and
// commercial-cleaning.astro still render. v6 replaces the homepage's table
// with a three-way comparison whose cells are prose, not ticks, so the two
// tables no longer share substance. Kept local rather than rewriting the
// shared file out from under two pages this brief doesn't cover —
// reconcile once those pages get their own v6 briefs.
const comparisonTable = {
  heading: 'How TLB Cleaning compares',
  cornerLabel: 'Why TLB Cleaning is different',
  columns: [
    { label: 'A national brand or app' },
    { label: 'An independent cleaner' },
    { label: 'TLB Cleaning', highlight: true },
  ],
  rows: [
    {
      label: 'Who cleans your home',
      values: ['Whoever is rostered that day', 'The same person', 'Your own local team, known by name'],
    },
    {
      label: 'When someone is away',
      values: [
        'A different contractor',
        'Rebook for another week',
        'Someone from your team covers, and we let you know first',
      ],
    },
    {
      label: 'How you book',
      values: ['Online only', 'Text or a phone call', 'Online, text, phone or email'],
    },
    {
      label: 'Reminders',
      values: ['Automated', 'Usually none', "Before the day, and again when we're on our way"],
    },
    {
      label: 'Holiday lets',
      values: ['A standard turnover', 'Depends on availability', 'Worked straight off your booking calendar'],
    },
    {
      label: 'Your schedule',
      values: ['Whatever slot is available', 'Whenever they can fit you in', 'A set day and a set team'],
    },
    {
      label: 'Commitment',
      values: ['Often a subscription', 'None', 'No lock-in, no minimum term, no exit fee'],
    },
    {
      label: 'Where they live',
      values: ['Wherever the contractor is based', 'Locally', 'In the towns they clean in, across the region'],
    },
  ],
};

// Testimonials — every quote, name and role below is a PLACEHOLDER, not a
// real client testimonial. v6 supplies only the briefing task for Teagan,
// and asks for two rather than the three the previous build reserved. Do
// not replace these with invented customer names or quotes; swap each slot
// for a real one as it is collected. `uniform` because two cards should sit
// as an equal pair — the centre-emphasis treatment needs an odd count to
// have a centre.
const testimonials = [
  {
    quote:
      "[TBC — ask Teagan for a quote from a long-standing client, ideally naming how long they've been with TLB. Tenure is the proof this page needs.]",
    name: '[Client name — TBC]',
    role: '[Town / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Long-standing TLB client' },
  },
  {
    quote:
      '[TBC — ask Teagan for a quote from a client who has been with a few cleaners over the years. That switcher story is what converts.]',
    name: '[Client name — TBC]',
    role: '[Town / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Client who switched to TLB after other cleaners' },
  },
];

// "Our services" — the brief's six services with the deep links it names.
// Titles, descriptions and hrefs live in src/data/navigation.ts as
// `serviceLinks`, shared with the footer's Services column.
// One photo per service, keyed by the service's own href so the pairing
// can't silently slip if that list is ever reordered. The photos live in
// src/assets/home under service-named filenames, so replacing one with a
// real photo of that service is a file swap with no code change.
//
// ⚠️ All five are COPIES of photos already used elsewhere on the site — the
// library has six real photographs total and no per-service shoot. They are
// placeholders in everything but name. Commercial cleaning, new to this
// list in v6, has no photo at all and renders as a plain brand tile until
// one exists.
const serviceImages: Record<string, ImageMetadata> = {
  '/house-cleaning/': serviceRegularImg,
  '/deep-cleaning/': serviceDeepCleanImg,
  '/end-of-lease-cleaning/': serviceEndOfLeaseImg,
  '/airbnb-cleaning/': serviceAirbnbImg,
  '/real-estate-cleaning/': serviceRealEstateImg,
};

const ourServiceItems = serviceLinks.map((service) => ({
  ...service,
  image: { ratio: '4/3', label: service.title, src: serviceImages[service.href] },
}));

// "Where we clean" — the brief's three regions as three labelled runs of
// pills, town lists verbatim and in the brief's own order.
//
// The list now lives in src/data/locations.ts, shared with every other
// page's "Where we clean" section — it had been copied verbatim into three
// pages while two others ran their own shorter versions. The open questions
// (the /locations/<slug>/ URL pattern, and the ~41 town pages that don't
// exist yet) are flagged there, where one fix now serves every page.

// FAQ — all twelve questions, in the brief's order, as one block rather
// than the branded/non-branded split the previous build ran. v6 interleaves
// the two kinds deliberately (franchise, then coverage, then how long a
// clean takes), and splitting them would reorder the page against the
// brief.
//
// ⚠️ Four answers are marked [CONFIRM with Teagan] in the brief and ship
// here as the brief's own suggested wording, not as signed-off copy: "Will
// I get the same cleaner every time?", "How long does a house clean take?",
// "Should I book weekly or fortnightly?" and "Do you charge extra for the
// inland towns?". The brackets are stripped so the page reads as a page;
// get these four confirmed before launch.
const faqItems = [
  {
    question: 'Are you a franchise?',
    answer:
      "No. TLB is locally owned and locally run, started here and still here. When you book, you're booking us.",
  },
  {
    // [CONFIRM with Teagan]
    question: 'Will I get the same cleaner every time?',
    answer:
      "Yes, wherever we can. Your place is assigned to a team and that's who you'll see. If someone's away, another member of your team covers and we let you know beforehand.",
  },
  {
    question: 'Do you cover the inland towns as well as the coast?',
    answer:
      "Yes. Lismore, Casino, Alstonville, Kyogle, Murwillumbah and everywhere in between. We're a Northern Rivers business, not a coastal one.",
  },
  {
    question: 'Do you clean in Queensland as well as New South Wales?',
    answer:
      'Yes. We work right across the Northern Rivers and the Tweed, and cross the border into Coolangatta, Palm Beach and Burleigh Heads.',
  },
  {
    // [CONFIRM]
    question: 'How long does a house clean take?',
    answer:
      'A rough guide for a maintained home is about an hour for each bedroom and bathroom, so a three-bedroom, two-bathroom house usually takes three to five hours for one cleaner, or roughly half that with two. Your first clean takes longer, because it brings the home to a baseline. After that, visits settle into a predictable window.',
  },
  {
    // [CONFIRM]
    question: 'Should I book weekly or fortnightly?',
    answer:
      "Fortnightly suits most homes. Weekly tends to work better for larger households, homes with pets, or anywhere the kitchen and bathrooms get heavy use. Start fortnightly and tell us if it isn't holding.",
  },
  {
    question: 'How much does a clean cost?',
    answer:
      "It depends on the size of your place, its condition and how often we come. That's why we quote rather than publish a flat rate that would be wrong for most homes. Tell us the basics and you'll have a price back quickly, with no obligation attached to it.",
  },
  {
    question: 'Is the first clean more expensive?',
    answer:
      "Usually, yes, and we'll tell you that upfront. The first visit starts from wherever the house is rather than holding a standard that's already set, so it takes longer. After that, your regular visits settle into a consistent price.",
  },
  {
    question: 'Am I locked into a contract?',
    answer:
      "No. No minimum term, no exit fee, and you can pause or skip a visit whenever you need to. Most people stay because it's working, not because they signed something.",
  },
  {
    // [CONFIRM with Teagan]
    question: 'Do you charge extra for the inland towns?',
    answer:
      "Our teams live across the region, so we're not driving in from somewhere else. Tell us where you are when you book and your quote will reflect it.",
  },
  {
    question: 'Do I need to be home?',
    answer:
      "Not at all, and most of our clients aren't. How we get in is agreed when you book, and we'll message you when we're on the way.",
  },
  {
    question: 'Can I book over the phone instead of online?',
    answer:
      "Yes. Online, text, phone or email, whichever suits you. Plenty of people would rather talk it through the first time, and we'd rather that than have you guess at a form.",
  },
];

// Closing block — copy verbatim. v6 supplies this outright, where v5 left
// it undrafted and the previous build echoed the hero's lines instead.
// Credibility signals — the before/after slider the service pages carry,
// brought onto the home page so the proof sits in the same place as the
// comparison it follows rather than only on the pages a visitor may never
// reach. Kitchen and shower: the two rooms every one of the services below
// touches, so the pair reads for the whole site rather than one service.
//
// ⚠️ THE IMAGES WIRED HERE ARE SAMPLES, NOT PHOTOGRAPHS. They are flat vector
// illustrations from scripts/make-before-after-samples.mjs, each carrying a
// visible SAMPLE badge, and their filenames say `sample-` precisely so they
// cannot be mistaken for real jobs. The guardrail every page in this build
// shares has not moved: a fabricated "before and after from a real job" is a
// false trust claim, not filler. The section's `note` prop says so on the
// page itself, in the reader's own view, not just here in a comment.
//
// This is a DRAGGABLE COMPARISON SLIDER (BeforeAfter.astro) rather than a
// PhotoGallery grid, matching what the service pages now use. A grid lays
// four independent frames out and leaves the viewer to hold one in memory
// while looking at the next; the slider makes the PAIR the unit and does the
// comparison for them, in place.
//
// Shoot each pair from ONE FIXED POSITION. The slider wipes one frame over
// the other in place, so a shifted camera or a different crop reads as a
// glitch rather than as cleaning — a requirement the component cannot
// enforce and the brief has to.
//
// The photo brief, which the sample frames stand in for:
//   1. BEFORE — kitchen benchtop and splashback, genuine TLB job.
//   2. AFTER  — the same benchtop, same angle.
//   3. BEFORE — shower screen and tiles, genuine TLB job.
//   4. AFTER  — the same shower screen and tiles, same angle.
//
// ⚠️ Two consent conditions, both on TLB to meet before real photos publish:
// written client permission, and no identifying detail in frame — no house
// numbers, street signs, mail, people, or names on doors. A "before" photo of
// someone's house is the most sensitive image this site would carry. Do NOT
// substitute stock photography either.
const beforeAfterPairs: BeforeAfterPair[] = [
  {
    before: {
      src: sampleKitchenBeforeImg,
      alt: 'Sample illustration: kitchen benchtop and tiled splashback before the clean, with stained grout and spills',
    },
    after: {
      src: sampleKitchenAfterImg,
      alt: 'Sample illustration: the same kitchen benchtop and splashback after the clean, grout clean and surfaces gleaming',
    },
    caption: 'Kitchen benchtop and splashback',
  },
  {
    before: {
      src: sampleShowerBeforeImg,
      alt: 'Sample illustration: shower screen and wall tiles before the clean, with soap scum on the glass and mould in the grout',
    },
    after: {
      src: sampleShowerAfterImg,
      alt: 'Sample illustration: the same shower screen and tiles after the clean, glass clear and grout back to colour',
    },
    caption: 'Shower screen and tiles',
  },
];

const closingCta = {
  heading: 'Set it up once, and stop thinking about it.',
  lead: "Tell us which town you're in and what your place needs, and we'll come back with a price.",
  cta: quoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={hero.cta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* The trust bar and the opening paragraph share ONE photo, so it has to
        be laid out across both — hence the wrapper rather than a
        `backgroundImage` on the TextBlock alone, which left the Cream
        strips either side of the teal card as flat colour.

        The brief lists the opening paragraph above the trust bar. It is
        inverted here because TrustBar's `card` variant is built to overlap
        the section above it — it has to sit directly under the hero, or the
        overlap lands on a paragraph and reads as a layout fault.

        75, not the default 80: enough Cream off the scrim for the photo to
        show, and still 5.0:1 for Dark Teal body copy measured over the
        DARKEST thing in the frame (the cleaner's green tee). At 70 that
        worst case drops to 4.57:1, which clears AA by too little to be
        worth it — anything lower fails. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ServiceBlocks variant="list" heading="What we do" items={whatWeDoItems} />

    <StoryMosaic theme="light" heading="Local team, run properly" blocks={teamBlocks} cta={teamCta} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Easy to book, local to the core"
      body={bookingBody}
      cta={hero.cta}
      backgroundImage={pathwayHolidayLetImg}
      scrimOpacity={82}
    />

    <TextBlock
      theme="muted"
      align="left"
      heading="Easy to book, instant pricing, cost effective"
      body={["You'll know the price before we start, not after.", ...pricingBody]}
      cta={hero.cta}
    />

    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
    />

    {/* Drag the handle to wipe between the two frames of each pair — see
        the block above `beforeAfterPairs` for why this is a slider and not
        a gallery, and for the fact that these four images are SAMPLES. The
        `note` is what tells the reader that; delete it with the imports.
        Placed directly after the comparison table: the table makes the
        claim, this is the nearest thing to evidence for it. */}
    <BeforeAfter
      heading="The difference, on real jobs."
      lead="Drag the handle across each photo to see the same spot before and after a clean."
      pairs={beforeAfterPairs}
      note="Illustrative samples, shown while we collect before and after photos from real TLB cleans."
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <ServiceBlocks variant="photo-tiles" heading="Our services" items={ourServiceItems} tileCtaLabel="See the service" />

    <TagCloud
      heading="Where we clean"
      subheading="Across the Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
