---
// Homepage built from the "TLB Cleaning — Home Page" brief (MNO Ventures,
// September 2026, Version 6). Section choices, positioning and every
// "don't invent this" call trace back to that document; where this build
// departs from the brief's literal order, the reason is stated inline.
//
// v6 rewrote the whole page against v5 (content-plans/cleaning-services-homepage.md):
// the "nine full-time cleaners" / "local mums" / police-check proof points
// are gone, the region is stated as the Northern Rivers and the Tweed
// (with the Southern Gold Coast crossed into rather than led with), and two
// new prose sections plus a much larger FAQ, service list and town list
// arrived. Treat this file, not the v5 plan, as current.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import StoryMosaic from '../components/sections/StoryMosaic.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
// Before/after slider (§ credibility signals). Now wired to real paired
// photography from TLB jobs, not the SAMPLE illustrations the service pages
// still carry — see the block above `beforeAfterPairs` below for the consent
// conditions and the shooting requirement any replacement has to meet.
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import GoogleReviewSlider from '../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../data/googleReviews';
import TagCloud from '../components/sections/TagCloud.astro';
import { locationGroups } from '../data/locations';
import { comparisonColumns, comparisonRows } from '../data/comparison';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
// "Three cards" photos, one per card, in card order.
// Backdrop behind the trust bar + opening paragraph, under the Cream scrim.
// "Our services" tiles — one photo per service, named for the service so a
// real shoot drops straight in over the top.
// Before/after pairs — real TLB job photos, supplied by the client. Kept as
// their own files rather than replacing the shared `sample-` set, which the
// service pages still rely on.
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
// Site chrome (header nav, mega-menus, footer links/contact) — shared with
// the service pages, see src/data/navigation.ts.
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  serviceLinks,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { trustBarCards } from '../data/trust';
import { howItWorks, managedForYou } from '../data/brand-lines';
import { localBusiness } from '../data/business';
import { z } from 'astro/zod';
import { getPage } from '../lib/cms';
import * as section from '../lib/cms-schemas';
import { optional, sized } from '../lib/cms-schemas';

// META SET FROM THE KEYWORD WORKBOOK 16 Sep 2026, on TLB's instruction to
// ship the workbook copy verbatim. It replaces "A local cleaning team across
// the Northern Rivers, the Tweed and the Southern Gold Coast. Book online, by
// text or over the phone. Set your day and we take it from there."
//
// Two things this reinstates that the previous revision had dropped:
//  1. "Local mums" as the framing. house-cleaning.astro dropped the same
//     phrase for the same reason why-tlb.md 🚩1 raises against "nine local
//     mums". It is a headcount/composition claim about real staff, and it is
//     back here.
//  2. "Police checked, insured and reliable." A verifiable claim, so it
//     needs to stay true of every cleaner sent, sitewide.
//
// LENGTH: 156 characters, the longest of the five workbook metas and the
// only one over ~155, so expect Google to truncate the tail. What gets cut
// is "Book online.", the call to action.

// Hero — H1 and subheadline verbatim. The brief's [Button] under the
// opening paragraph is this button: the paragraph ships as its own band
// below the trust bar (see the Backdrop note), and repeating the same CTA
// twice inside one screen would read as two different offers rather than
// one. Every other [Button] in the brief is built where it was asked for.
//
// In `hero`, on "Two TLB cleaners presenting the cushions on a freshly made bed":
// The Airbnb page's real hero photo since 6 Oct 2026, replacing the
// transparent cut-out (which ran with `contain-bottom`). Default `cover`
// fit now. `ratio` also sets the desktop panel's height: the image box
// takes that aspect at the panel's width (~645px at 1440), so '1/1' made
// the hero ~645px tall. '4/3' lets the 560px hero floor govern instead,
// and the copy is cropped to ~1.15:1 to match: window, both cleaners and
// the bed. On mobile it is the image's shape.

// Opening paragraph — verbatim.

// Three cards — card copy verbatim, including the links the brief names.
// The section's own heading/accent lines aren't in the brief at all, so
// these two lines are placeholder structural copy carried over from the
// previous build, not a brand decision — flag before launch.
//
// In `pathwayCards`:
// Holiday let moved to first and retitled by request (September 2026), to
// lead with the Full Property Care proposition. Numbers follow the order.

// "What we do" — the brief's five categories, verbatim. Deliberately the
// icon-led `list` variant rather than photo tiles: "Our services" further
// down is the photographic, link-per-service grid, and running both as
// tiles would make the page ask the same question twice. Each row still
// deep-links to the page that covers it.

// "Local team, run properly" — bio verbatim. The brief marks a [Team photo]
// here; no such asset exists in src/assets yet, so this stays a labelled
// Placeholder rather than borrowing an unrelated photo. StoryMosaic's image
// blocks are placeholder-only by type, so the swap is a component change,
// not a one-line import — brief the shoot from the label below.

// href guessed — the "Meet the team" nav item points at /about/ (see
// navigation.ts), so this matches it rather than inventing a second slug.

// "Easy to book, local to the core" — new in v6, copy verbatim. Runs over a
// background photo behind the Dark Teal scrim: the section is about the
// calm of not having to organise anything, and a settled, guest-ready room
// says that faster than the words do.
//
// ⚠️ The photo is REUSED from persona card 2 further up this same page. It
// is the only real photograph in the library that fits the mood — the other
// TLB assets are cut-out figures on a green circle, useless full bleed. A
// dedicated photo would be better; the swap is one import line.

// "Easy to book, instant pricing, cost effective" — new in v6, copy
// verbatim. The brief's one-line "You'll know the price before we start,
// not after." is prepended at the call site as this block's first
// paragraph: TextBlock has no separate `lead` slot, and the line is doing a
// standfirst's job, so it reads as one on its own above the detail.

// Comparison table — copy supplied directly in the brief, verbatim.
//
// ✅ RESOLVED — this table's rows now live in src/data/comparison.ts and are
// shared. They used to be inline here, because that shared file held an older
// two-column TLB-vs-Other-Brands tick table which why-tlb.astro and
// commercial-cleaning.astro still rendered, and this comment said: "reconcile
// once those pages get their own v6 briefs." Brand Foundation v2.0 is that
// reconciliation. The old tick table breached §2.4 (the "nine full-time
// cleaners" claim), §9.3 ("local mums") and §10.2 (a cross against a single
// "Other Brands" column says the independent cleaner does worse work), so it
// was replaced by THIS table, verbatim, rather than the other way round.
//
// So the substance below is unchanged and still the brief's own. It simply
// serves three pages now instead of one, and the site no longer ships two
// comparison tables that disagree about the same business.
//
// Heading and cornerLabel stay local: §9.4 wants the framing to differ by
// context even when the claims don't.

// "Our services" — the brief's six services with the deep links it names.
// Titles, descriptions and hrefs live in src/data/navigation.ts as
// `serviceLinks`, shared with the footer's Services column.
// One photo per service, keyed by the service's own href so the pairing
// can't silently slip if that list is ever reordered. The photos live in
// src/assets/home under service-named filenames, so replacing one with a
// real photo of that service is a file swap with no code change.
//
// Real TLB photos (6 Oct 2026) on four tiles, each copied from that
// service's own page: regular is the house cleaning hero, deep clean is the
// deep cleaning page's shower niche card, end of lease is that page's
// cleared room card, and Airbnb is the hinterland holiday let. Real estate
// and commercial still run their earlier images until those pages get real
// photos of their own.

// "Where we clean" — the brief's three regions as three labelled runs of
// pills, town lists verbatim and in the brief's own order.
//
// The list now lives in src/data/locations.ts, shared with every other
// page's "Where we clean" section — it had been copied verbatim into three
// pages while two others ran their own shorter versions. The open questions
// (the /locations/<slug>/ URL pattern, and the ~41 town pages that don't
// exist yet) are flagged there, where one fix now serves every page.

// FAQ — all twelve questions, in the brief's order, as one block rather
// than the branded/non-branded split the previous build ran. v6 interleaves
// the two kinds deliberately (franchise, then coverage, then how long a
// clean takes), and splitting them would reorder the page against the
// brief.
//
// ⚠️ Four answers are marked [CONFIRM with Teagan] in the brief and ship
// here as the brief's own suggested wording, not as signed-off copy: "Will
// I get the same cleaner every time?", "How long does a house clean take?",
// "Should I book weekly or fortnightly?" and "Do you charge extra for the
// inland towns?". The brackets are stripped so the page reads as a page;
// get these four confirmed before launch.
//
// In `faqItems`, on "Will I get the same cleaner every time?":
// [CONFIRM with Teagan]
// In `faqItems`, on "How long does a house clean take?":
// [CONFIRM]
// In `faqItems`, on "Should I book weekly or fortnightly?":
// [CONFIRM]
// In `faqItems`, on "Do you charge extra for the inland towns?":
// [CONFIRM with Teagan]

// Closing block — copy verbatim. v6 supplies this outright, where v5 left
// it undrafted and the previous build echoed the hero's lines instead.
// Credibility signals — the before/after slider the service pages carry,
// brought onto the home page so the proof sits in the same place as the
// comparison it follows rather than only on the pages a visitor may never
// reach. A kitchen benchtop and a cooktop: the two surfaces every one of the
// services below touches, so the pair reads for the whole site rather than
// one service.
//
// THESE ARE REAL TLB JOB PHOTOGRAPHS, supplied by the client — not the
// `sample-` illustrations the service pages still carry. That is why the
// section no longer runs the "illustrative samples" note: the note existed to
// stop a fabricated before/after reading as a trust claim, and there is
// nothing fabricated here. Do NOT wire the `sample-` files back into this
// section without putting that note back with them.
//
// ⚠️ Both consent conditions are met by these four frames and must hold for
// any replacement: written client permission, and no identifying detail in
// frame — no house numbers, street signs, mail, people, or names on doors. A
// "before" photo of someone's house is the most sensitive image this site
// carries. Do NOT substitute stock photography either.
//
// This is a DRAGGABLE COMPARISON SLIDER (BeforeAfter.astro) rather than a
// PhotoGallery grid, matching what the service pages now use. A grid lays
// four independent frames out and leaves the viewer to hold one in memory
// while looking at the next; the slider makes the PAIR the unit and does the
// comparison for them, in place.
//
// ⚠️ Shoot each pair from ONE FIXED POSITION — the slider wipes one frame
// over the other in place, so a shifted camera reads as a glitch rather than
// as cleaning. The cooktop pair here obeys that exactly. The kitchen pair
// does NOT: the two frames were taken from different distances, and the
// "after" has been cropped tighter (and both re-cut from portrait to 4:3) to
// bring the two to a shared magnification. The residual offset is parallax,
// which no crop can remove. If these two ever get reshot, shoot them from one
// spot and the crop correction can be dropped.

// CONTENT lives in src/content/pages/index.yaml and is edited in Pages CMS
// ("Home"). This file owns the layout. The notes above explain why each
// section says what it says; they stay here because Pages CMS rewrites the
// YAML on save and would drop them.
const page = await getPage(
  'index',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    pathways: section.pathwayCards,
    // The `list` variant with an icon on each row. linkList has no icon, and
    // iconGrid would offer a per-row button the list variant never draws.
    whatWeDo: section.linkList.extend({
      items: z.array(section.linkList.shape.items.element.extend({ icon: optional(section.serviceIcon) })).min(1),
    }),
    team: section.storyMosaic,
    booking: section.textBlock,
    // Body is the page's own paragraphs only. The "Managed for you" standfirst
    // above them and the "How it works" steps below them come from Brand
    // lines, so they stay the same on every page.
    pricing: section.textBlock,
    // The rows and columns are the shared table in Site settings, so only the
    // framing around them is this page's own.
    comparison: section.comparisonTable.omit({ columns: true, rows: true }),
    beforeAfter: section.beforeAfter,
    reviews: section.sectionHeading,
    // Each service's title, sentence and link come from Site settings > Menus
    // (shared with the footer). This page only picks a photo for each,
    // matched by the service's link so a reordered list cannot mispair them.
    // (The shared schema no longer offers a note: no photo variant draws one.)
    ourServices: section.imageCards.omit({ items: true }).extend({
      photos: z.array(
        z.object({
          service: z
            .string()
            .refine((href) => serviceLinks.some((s) => s.href === href), 'Pick one of the services in Site settings > Menus'),
          image: section.image,
        }),
      ),
    }),
    whereWeClean: section.tagCloud,
    faq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/',
};

const business = localBusiness({
  description: pageMeta.description,
  // v6 leads with the Northern Rivers and the Tweed; the Southern Gold
  // Coast is where the team crosses to, not part of the primary claim.
  areaServed: 'Northern Rivers NSW, the Tweed, and the Southern Gold Coast QLD',
  sameAs: googleBusinessProfileUrl ? [googleBusinessProfileUrl] : [],
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const pathwayCards = page.pathways.cards.map((card, i) => ({
  number: i + 1,
  ...card,
  image: sized(card.image, '4/3'),
}));

// The team photo is still a reserved slot (see the "Local team" note above).
const teamBlocks = page.team.blocks.map((block) =>
  block.type === 'image' ? { type: 'image' as const, ...sized(block.image, '3/4') } : block,
);

const ourServiceItems = serviceLinks.map((service) => {
  const photo = page.ourServices.photos.find((p) => p.service === service.href);
  return {
    ...service,
    image: sized(photo?.image ?? { label: service.title }, '4/3'),
  };
});

---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    {/* The trust bar and the opening paragraph share ONE photo, so it has to
        be laid out across both — hence the wrapper rather than a
        `backgroundImage` on the TextBlock alone, which left the Cream
        strips either side of the teal card as flat colour.

        The brief lists the opening paragraph above the trust bar. It is
        inverted here because TrustBar's `card` variant is built to overlap
        the section above it — it has to sit directly under the hero, or the
        overlap lands on a paragraph and reads as a layout fault.

        ⚠️ 90, raised from 75 on 29 Sep 2026. THIS COMMENT IS WHERE THE OLD
        NUMBER CAME FROM, and it was wrong, so the correction belongs here
        rather than only on the page that happened to expose it.

        It used to read: "still 5.0:1 for Dark Teal body copy measured over
        the DARKEST thing in the frame (the cleaner's green tee)". The
        arithmetic was fine; the pixel was not. The green tee is not the
        darkest thing in that frame — the same photo carries a black cap,
        dark denim and a timber stepladder, all well below it. Sampled
        properly across the 800px copy column, 75% put body copy at 4.22:1,
        which FAILS AA. The tee alone measures 5.53:1, which is how a real
        measurement over the wrong pixel produced a confident wrong answer.

        That conclusion was then paraphrased onto ~36 sibling pages without
        the reasoning, so one bad sample became a site-wide convention. All
        48 Backdrop call sites now sit at 90, which holds every one of the
        17 backdrop photos at 5.90:1 or better. Backdrop.astro's `opacity`
        doc carries the method and the floor.

        The honest cost: at 90 the photo survives as texture rather than as
        a picture. If that reads as too flat, the fix is a backdrop image
        that can take a scrim — high key, evenly lit, no clipped blacks
        under the copy column — not a lower number here.

        Re-check the contrast if the photo is swapped in Pages CMS. */}
    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <PathwayCards heading={page.pathways.heading} headingAccent={page.pathways.headingAccent} cards={pathwayCards} />

    <ServiceBlocks
      variant="list"
      heading={page.whatWeDo.heading}
      lead={page.whatWeDo.lead}
      items={page.whatWeDo.items}
      note={page.whatWeDo.note}
    />

    <StoryMosaic theme="light" heading={page.team.heading} blocks={teamBlocks} cta={page.team.cta} />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.booking.heading}
      body={page.booking.body}
      cta={page.booking.cta ?? quoteCta}
      backgroundImage={page.booking.backgroundImage}
      scrimOpacity={82}
    />

    <TextBlock
      theme="muted"
      align="left"
      heading={page.pricing.heading}
      body={[managedForYou.recurring, ...page.pricing.body, ...howItWorks.general]}
      cta={page.pricing.cta ?? quoteCta}
      backgroundImage={page.pricing.backgroundImage}
    />

    <ComparisonTable
      heading={page.comparison.heading}
      lead={page.comparison.lead}
      cornerLabel={page.comparison.cornerLabel}
      columns={comparisonColumns}
      rows={comparisonRows}
      footnote={page.comparison.footnote}
      cta={page.comparison.cta}
    />

    {/* Drag the handle to wipe between the two frames of each pair — see
        the block above `beforeAfterPairs` for why this is a slider and not
        a gallery. All four frames are real TLB job photography, and the
        `note` is what tells the reader so; correct it, do not delete it, if
        any sample is ever wired back in.
        Placed directly after the comparison table: the table makes the
        claim, this is the nearest thing to evidence for it. */}
    <BeforeAfter
      heading={page.beforeAfter.heading}
      lead={page.beforeAfter.lead}
      pairs={page.beforeAfter.pairs}
      note={page.beforeAfter.note}
      beforeLabel={page.beforeAfter.beforeLabel}
      afterLabel={page.beforeAfter.afterLabel}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <ServiceBlocks
      variant="photo-tiles"
      heading={page.ourServices.heading}
      lead={page.ourServices.lead}
      items={ourServiceItems}
      tileCtaLabel={page.ourServices.tileCtaLabel}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
