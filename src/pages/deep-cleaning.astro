---
// Deep cleaning page, rebuilt from the SECOND deep-cleaning brief (2026-09-08).
// Section choices and every "don't invent this" call trace back to
// content-plans/deep-cleaning.md.
//
// WHAT THE NEW BRIEF RESOLVED, against the three 🚩 blockers the first build
// shipped with:
//  1. ✅ Meta description. The old brief pasted END OF LEASE copy onto this
//     page and the build ran a written-from-the-H1 placeholder instead. The
//     new brief supplies real deep-cleaning copy — it ships verbatim.
//  2. ✅ "The task list is published on this page." It now is: §5 below is
//     the full room-by-room inclusions list, five rooms plus the two
//     exclusion groups. That FAQ answer no longer over-promises.
//  3. ✅ The "[X] days" lead-time FAQ is gone from the brief entirely, so
//     there is nothing held back for an unfilled number any more.
//  4. ✅ Credibility signals are back. That section was REMOVED at TLB's
//     direction last time, because the old brief's row for it was empty and
//     the first build had filled it on the sibling page's premise. The new
//     brief specifies it outright ("before and after images from genuine TLB
//     deep cleans, with client permission and no identifying detail"), so it
//     returns — as reserved slots, since no such images exist yet.
//  5. ✅ "Where we clean" is specified for the first time, with its own
//     three-region town list, so the "don't pick a suburb list silently"
//     hold from the first build is lifted. See §12 — it lifts it by making
//     the site's list disagreement bigger, not smaller.
//
// STILL NEEDS TEAGAN'S SIGN-OFF (the brief's own [CONFIRM] markers). These
// ship as copy rather than being held back, because the brief wrote them as
// finished sentences for review on the built page — unlike the old "[X]
// days", which was a literal blank nobody had filled. Each is flagged at its
// own definition below:
//   - §5 / §5b's full inclusions AND exclusions lists.
//   - FAQ "How long does a deep clean take?" — the duration estimate.
//   - FAQ "What isn't included in a deep clean?" — the exclusions list again.
//   - FAQ "Do you bring your own products and equipment?" — product range.
//
// Blocked-on-media sections (§8 before/after gallery, §9 video, §11
// testimonials) are built as RESERVED SLOTS — labelled Placeholder frames
// and bracketed [TBC] briefing text, obviously unfinished on sight, zero
// layout shift when the real assets land. Never fill one with invented
// photos, quotes or names.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import PathwayCards from '../components/sections/PathwayCards.astro';
import ContentGrid from '../components/sections/ContentGrid.astro';
import Callout from '../components/sections/Callout.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import PhotoGallery from '../components/sections/PhotoGallery.astro';
import VideoFeature from '../components/sections/VideoFeature.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import { locationGroups } from '../data/locations';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import heroImg from '../assets/home_cleaning/inside_your_home/deep_cleaning/deep-cleaning-spray-bottle-and-sponge.png';
// §3 situation cards — one photo per card, named for the situation it shows.
import cardRegularImg from '../assets/home_cleaning/inside_your_home/deep_cleaning/deep-cleaning-tidy-living-room-kept-up-by-regular-visits.jpg';
import cardMovingOutImg from '../assets/home_cleaning/inside_your_home/deep_cleaning/deep-cleaning-empty-room-on-moving-out-day.jpg';
import cardNotSureImg from '../assets/home_cleaning/inside_your_home/deep_cleaning/deep-cleaning-comparing-clean-types-with-a-checklist.jpg';
// §2 backdrop, behind the Cream scrim (the homepage's — this page's folder has no wide backdrop of its own).
import definitionBgImg from '../assets/home/house-cleaning-cleaner-wiping-tall-interior-window.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import type { TextBlockBody } from '../components/sections/TextBlock.astro';
// Site chrome — shared with index.astro and house-cleaning.astro.
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { trustBarCards } from '../data/trust';

// §0 Page metadata. Title and description both drafted in the brief and
// shipping verbatim — the description that used to be a placeholder here is
// now real copy (see the file header).
const pageMeta = {
  title: 'House Deep Cleaning Services - One-Off | TLB Cleaning',
  description:
    'A one-off deep clean that resets the whole house, room by room, across the Northern Rivers and the Tweed. Published task list, quoted before we start.',
  // Domain still a placeholder, same as the other pages — confirm before launch.
  canonical: 'https://example.com/deep-cleaning/',
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
  description: pageMeta.description,
};

// §1 Hero — drafted in full, `split-single-image` on the page's one hero
// photo. Image right via `imagePosition`, `ratio` matching the asset's
// native 1920x1080 so the cut-out figure isn't cropped once the layout goes
// single-column. The figure faces left, into the copy, which is the way
// round it wants to be with the image on the right.
//
// The old brief's 31-word overview (flagged in the first build as two
// sentences doing one sentence's job) has been rewritten by the new one —
// the second sentence is now the page's three-part promise, which §10 then
// expands under those same words. No longer a flag, just better copy.
//
// CTA sits here, not on §2's TextBlock: Hero.astro's `cta` prop is required.
// Same ruling as house-cleaning.astro.
const hero = {
  headingLines: ['One clean to reset the whole house'],
  lead: "Before the guests arrive, after the party, when you move in, or when it's just got away from you. Easy to book, instant pricing, cost effective.",
  cta: quoteCta,
  image: {
    ratio: '16/9',
    label:
      'TLB Cleaning cleaner in an apron and gloves spraying cleaner and holding a sponge during a deep clean',
    src: heroImg,
  },
};

// §2 Definition paragraph — unchanged between the two briefs. The
// answer-target block for `house deep cleaning services`; stays the first
// prose after the hero.
const definitionBody: TextBlockBody[] = [
  "A deep clean is a one-off, room-by-room reset that covers the detail work a regular clean doesn't reach. TLB Cleaning provides house deep cleaning services across the Northern Rivers, the Tweed and the Southern Gold Coast.",
];

// §3 Situation cards — copy verbatim, split into title (the opening
// statement) + description (the rest). Cards 1 and 2 unchanged from the
// first brief; card 3's line is now "Fair enough" rather than "Fair", and
// the brief itself now specifies the destination this build had to infer
// last time ("anchor link to the comparison table below").
//
// Section heading/accent and the three CTA labels are NOT in the brief —
// placeholder structural copy. The three photos each show the situation
// their card describes.
const pathwayCards = {
  heading: 'Not sure a deep clean is the one?',
  headingAccent: 'Start here.',
  cards: [
    {
      number: 1,
      image: { ratio: '4/3', label: 'Tidy living room kept up by regular visits', src: cardRegularImg },
      title: 'Actually, I want this regularly',
      description:
        'Most people book a deep clean first and then set up a fortnightly. That way round works well, and it costs less than doing it the other way.',
      cta: { label: 'Regular house cleaning', href: '/house-cleaning/' },
    },
    {
      number: 2,
      image: { ratio: '4/3', label: 'Empty room on moving-out day', src: cardMovingOutImg },
      title: "I'm moving out",
      description:
        "That's an end of lease clean, a different standard measured against an inspection. Different page.",
      cta: { label: 'End of lease cleaning', href: '/end-of-lease-cleaning/' },
    },
    {
      number: 3,
      // Anchor target is #compare, set on the wrapper in the template below
      // — ComparisonTable takes no id prop, and adding one just for an
      // anchor isn't worth a shared-component change. Label follows the
      // photo, not the brief line: the shot is a homeowner weighing it up at
      // her kitchen bench, not a side-by-side chart (which no photograph can
      // show). Doubles as alt text.
      image: { ratio: '4/3', label: 'Homeowner comparing cleaning options on a tablet', src: cardNotSureImg },
      title: "I'm not sure which I need",
      description: "Fair enough. Here's how the three differ, in plain terms.",
      cta: { label: 'Compare the three', href: '#compare' },
    },
  ],
};

// §5 What's included in a deep clean — THE new section, and the one that
// makes the FAQ's "the task list is published on this page" true.
//
// ⚠️ [CONFIRM the full inclusions and exclusions list with Teagan before
// publishing.] The brief's own marker. This is the page's central promise and
// the thing a client will hold TLB to on the day, task by task — it needs a
// read-through by whoever actually scopes these jobs, not just a copy
// approval.
//
// Component choice: ContentGrid `text` cells, not ServiceBlocks `icon-grid`.
// ServiceBlocks would be the obvious shape for five labelled groups, but its
// cells are icon-led and ServiceIcon.astro has no room icons at all (idea,
// spark, bloom, puzzle, target, chart-pie, chart-bars, house, suitcase, key,
// spray-bottle, office) — five rooms would have shared two or three
// unrelated glyphs, which reads worse than no icons. TextBlock with
// `{ list }` entries was the other candidate, rejected for the opposite
// reason to §6's: one column of five long comma-runs reads as a wall, where
// a 2-up grid lets someone find their own room.
//
// Each room's tasks run as the brief wrote them — one comma-separated
// sentence, not re-broken into bullets. That's a copy decision (the brief
// chose prose over a checklist look) and re-formatting it would change how
// exhaustive the list reads.
//
// Layout: 5 cells in 2 columns leaves an orphan, so "Throughout" — the
// shortest, and the only one that isn't a room — takes `span: 2` and closes
// the grid as a full-width row.
const inclusionBlocks = [
  {
    type: 'text' as const,
    heading: 'Kitchen',
    body: [
      'Inside and outside of cupboards, splashback, rangehood, oven exterior, benchtops, sink and taps, appliance exteriors, behind and beside where we can reach, floors including edges and corners.',
    ],
  },
  {
    type: 'text' as const,
    heading: 'Bathrooms and toilets',
    body: [
      'Shower screen and tiles including grout, bath, basin, taps and fittings, mirrors, exhaust fan cover, toilet inside and out including the base and behind, floors and skirting.',
    ],
  },
  {
    type: 'text' as const,
    heading: 'Bedrooms and living areas',
    body: [
      'Skirting boards, door frames, architraves, light switches and power points, window sills and tracks, inside windows, ceiling fans, cobwebs, vents, full vacuum including edges, under moveable furniture, mop.',
    ],
  },
  {
    type: 'text' as const,
    heading: 'Laundry',
    body: ['Sink, benches, cupboard fronts, behind and beside appliances where accessible, floors.'],
  },
  {
    type: 'text' as const,
    heading: 'Throughout',
    body: ['Doors, handles, light fittings, air vents, all floors and edges.'],
    span: 2,
  },
];

// §5b The two exclusion groups — Callout, not two more grid cells.
//
// They are the opposite of everything above them, and an inset panel that
// reads as an interruption is exactly Callout's stated job. A sixth grid
// cell, by contrast, gets skimmed as a sixth room. `tone="note"` — this is
// "worth knowing", not "don't do this".
//
// ⚠️ Same [CONFIRM] as §5, and the higher-stakes half of it: an exclusion a
// client didn't expect is the complaint that actually happens. The FAQ "What
// isn't included in a deep clean?" restates this list, so the two have to be
// settled together and kept in step.
const exclusionsCallout = {
  body: [
    'Quoted separately: inside the oven, carpet steam cleaning, exterior windows, blinds, inside the fridge, cleaning at height.',
    'Not included: dishes, laundry, tidying or organising belongings.',
  ],
};

// §6 When people book one — the same six occasions as the first brief, under
// the brief's own heading now ("When people book one"; "The moments this
// comes up" was this build's placeholder).
//
// Six labelled occasions, each a short title plus a one-line gloss: grid
// content, not a paragraph. ContentGrid at 3 columns (2 rows of 3) rather
// than a TextBlock bullet list, which would flatten each title/gloss pair
// into one run-on line.
const momentsBlocks = [
  {
    type: 'text' as const,
    heading: 'Moving in',
    body: ["Before the furniture, while the place is empty and it's easy."],
  },
  {
    type: 'text' as const,
    heading: 'Before guests',
    body: ['Family for Christmas, or the in-laws for a week. High stakes, short notice.'],
  },
  { type: 'text' as const, heading: 'After a party', body: ['Self-explanatory.'] },
  {
    type: 'text' as const,
    heading: 'Before it goes to market',
    body: ['Photos, open homes and first impressions.'],
  },
  {
    type: 'text' as const,
    heading: 'The spring reset',
    body: ['Windows open, everything out, the once-a-year one.'],
  },
  {
    type: 'text' as const,
    heading: 'After a long absence',
    body: ["Coming back to a house that's been shut up for months."],
  },
];

// §7 Deep clean, regular clean or bond clean — the comparison table, with
// ALL-NEW content. The first build's version came from a design mockup and
// compared task coverage (inside cupboards, skirting, oven detail…). The new
// brief replaces it with four rows that compare the SERVICES rather than the
// tasks: what each one is, the standard it's held to, when you'd book it,
// how long it runs.
//
// That's the right swap now that §5 exists. The old table was doing two jobs
// — "which service do I need" and "what gets cleaned" — and the second has
// moved to §5's actual task list, so this table gets to do only the first.
// It also drops the old "View the full room-by-room checklist" CTA that
// pointed off-page at /guides/what-is-included-in-a-deep-clean/: the
// checklist is on this page now, directly above it.
//
// `cornerLabel` names the question the table answers, since PathwayCards
// card 3 lands people here from "I'm not sure which I need".
//
// LAYOUT NOTE, carried over from the first build: the original mockup put
// heading/lead/CTA in a left-hand panel BESIDE the table. That was built as
// an optional `split` layout on ComparisonTable and reverted after measuring
// it — at a 1200px container a side panel left the 4-column table ~848px
// against the 999px it needs, pushing the third compared service off behind
// a horizontal scroll. Stacked, it fits exactly. Don't re-add the split
// without re-measuring: these rows are longer text than the old ones.
const comparisonTable = {
  heading: 'Deep clean, regular clean or bond clean',
  cornerLabel: 'Which one you need',
  columns: [
    { label: 'Deep clean', highlight: true },
    { label: 'Regular clean' },
    { label: 'End of lease clean' },
  ],
  rows: [
    {
      label: 'What it is',
      values: [
        'A one-off reset, room by room',
        'Ongoing upkeep on a set schedule',
        'A clean measured against an exit inspection',
      ],
    },
    {
      label: 'The standard',
      values: ['Back to a baseline', 'Held at that baseline', 'Whatever the inspection requires'],
    },
    {
      label: 'When',
      values: [
        'Moving in, before guests, spring, after a long gap',
        'Weekly, fortnightly or monthly',
        'When you hand back the keys',
      ],
    },
    {
      label: 'How long',
      values: [
        "Longer, because it's the detail work",
        'Predictable once the rhythm is set',
        'Depends on the property and its condition',
      ],
    },
  ],
  footnote:
    'Most people book a deep clean first and set up a regular clean afterwards. It costs less that way round, because the deep clean does the heavy work once rather than paying for a long first regular visit.',
};

// §8 Credibility signals — RESERVED SLOTS, no images exist yet.
//
// This section was removed from the first build at TLB's direction, because
// the old brief's row for it was empty and the build had filled it with
// before/after slots on the sibling page's premise. The new brief specifies
// it in almost exactly those terms — "before and after images from genuine
// TLB deep cleans, with client permission and no identifying detail" — so it
// returns. The earlier guess turned out to be right; it just wasn't briefed.
//
// PhotoGallery `grid`, four slots: two before/after pairs, which is the
// minimum that reads as a pattern rather than one lucky room. Labelled so
// nobody has to guess what belongs in each frame, and so the labels become
// the alt text once real photos land.
//
// ⚠️ Two consent conditions, both from the brief, both on TLB to meet before
// these publish: written client permission, and no identifying detail in
// frame — no house numbers, street signs, mail, people, or names on doors. A
// "before" photo of someone's house is the most sensitive image this site
// would carry.
const beforeAfterImages = [
  {
    ratio: '4/3',
    label:
      '[BEFORE — kitchen, genuine TLB deep clean. Client permission required, no identifying detail in frame.]',
  },
  {
    ratio: '4/3',
    label:
      '[AFTER — the same kitchen, same angle. Shoot both from one fixed position or the pair does not read.]',
  },
  {
    ratio: '4/3',
    label:
      '[BEFORE — bathroom or shower, genuine TLB deep clean. Client permission required, no identifying detail in frame.]',
  },
  { ratio: '4/3', label: '[AFTER — the same bathroom, same angle.]' },
];

// §9 Hero video — reserved 16/9 slot. The brief specifies the content ("a
// before-and-after video showing a deep clean"), not the heading;
// `headingLines` is placeholder copy.
const heroVideo = {
  headingLines: ['Watch a house come back.'],
  video: {
    ratio: '16/9',
    label: 'Before-and-after video of a TLB deep clean, room by room',
  },
};

// §10 Easy to book, instant pricing, cost effective — new section, and the
// hero's second sentence expanded under those same three words.
//
// TextBlock `dark` rather than `light`: it sits between the video slot and
// the testimonials, both of which are light, and it carries the page's
// second CTA. It's also the one block on the page that argues rather than
// lists, so it shouldn't look like §5 or §6. `align="left"` — three
// paragraphs of running prose, not a centred pull quote.
const bookingBody: TextBlockBody[] = [
  "Book online in a couple of minutes, or send a text, ring us or drop us an email, whichever you'd actually do.",
  "You get a price straight away rather than waiting on a quote. It's based on the house as it actually is, so tell us honestly what condition it's in when you book. Nothing you say will surprise us, and it means we allow the right amount of time rather than running short on the day.",
  "Cost effective because one deep clean does the heavy work in a single visit. If you're setting up a regular clean afterwards, this is the cheaper way round. And if the place needs more time than we've quoted, you'll hear that before we start rather than on the invoice.",
];

// §11 Social proof — bracketed [TBC] briefing slots, NOT real testimonials.
// Same convention index.astro and house-cleaning.astro both use: the visible
// text reads as obviously unfinished so it can't be mistaken for a real
// client quote. Never fill with invented names or words.
//
// The brief now specifies the two angles, where the old one said only "ask
// Teagan for Deep Cleaning testimonials" — "ideally one where the house had
// been let go, and one booked ahead of guests or a sale". Those are the two
// angles the first build proposed on its own, so the slots below are the
// brief's ask now rather than a proposal awaiting confirmation.
const testimonials = [
  {
    quote:
      '[TBC — ask Teagan for a quote from a deep clean client whose house had been let go. This answers the shame barrier the first FAQ addresses, and it is the most common reason people hesitate to book.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Deep clean client' },
  },
  {
    quote:
      '[TBC — ask Teagan for a quote from a deep clean client who booked ahead of guests or a sale. Deadline pressure is what turns a deep clean from someday into this week.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Deep clean client who booked against a deadline' },
  },
];

// §12 Where we clean — the shared 56-town, three-region list from
// src/data/locations.ts, which every "Where we clean" section now reads
// from. This page specified it first; house-cleaning.astro and the homepage
// then carried verbatim copies, so it was extracted. The open questions —
// the /locations/<slug>/ URL pattern, the ~41 town pages that don't exist
// yet, and the header mega-menu's shorter list — are flagged there, where
// one fix serves every page.

// §13 FAQs — ten questions, ONE block.
//
// Every other page on this site splits its FAQs into a "branded" and a
// "non-branded" accordion, because those briefs supplied two labelled lists.
// This brief supplies one H2 and one run of ten questions, so it ships as one
// accordion. Don't split it back into two for site symmetry — that would mean
// inventing the second heading and deciding which questions sit under it,
// neither of which is in the brief.
//
// Three answers carry [CONFIRM] markers in the brief. The markers are
// stripped from the published copy (they're notes to Teagan, not text for a
// visitor) and each is flagged inline below. All three ship as written,
// unlike the first build's "[X] days", which was a literal unfilled blank —
// these are finished sentences awaiting a read-through.
const faqItems = [
  {
    question: "My house hasn't had a proper clean in years. Is that a problem?",
    answer:
      "Not at all, that's the job. Tell us honestly how it is when you book so we can allow the right time, and we'll quote for what's actually there rather than a guess.",
  },
  {
    // No longer over-promising: §5 above IS the published task list. This was
    // 🚩2 in the first build's header.
    question: "How do I know it'll actually be a deep clean and not a quick once-over?",
    answer:
      "Because the task list is published on this page before you book. You know what you're getting, and so do we.",
  },
  {
    question: 'What if the house needs more time than we booked?',
    answer:
      "We'll tell you before we start, not after. You'll have the option to add time, or to tell us what matters most so we prioritise that. You won't get a surprise on the invoice.",
  },
  {
    // ⚠️ [CONFIRM] — the brief opens this answer with the marker. "Most of a
    // day for a team" for a three-bedroom home is an operational estimate
    // that sets a client's expectation on the day; whoever schedules these
    // jobs needs to agree with it.
    question: 'How long does a deep clean take?',
    answer:
      "Considerably longer than a regular clean, because it's the detail work. A three-bedroom home in reasonable condition is usually most of a day for a team. If it's been a while, longer. We'll give you a realistic window when we quote.",
  },
  {
    question: 'How much does a deep clean cost?',
    answer:
      "It depends on the size of the house and the condition it's in, which is why we quote rather than publish a flat rate. Tell us the basics and you'll have a price back quickly, with no obligation attached.",
  },
  {
    // ⚠️ [CONFIRM the full exclusions list.] This restates §5b's Callout —
    // the same fact in two places, so they have to be settled together and
    // kept in step. If one changes and the other doesn't, the page
    // contradicts itself about what a client is paying for.
    question: "What isn't included in a deep clean?",
    answer:
      "A deep clean covers the detail work inside your home, so a few jobs sit outside it. We don't wash dishes, do laundry, or tidy and organise your belongings. Cleaning at height, exterior windows, carpet steam cleaning and inside-the-oven work are all quoted separately. If you're unsure whether something is covered, ask when you book and we'll tell you straight.",
  },
  {
    // The first build held this back as an unconfirmed safety-and-liability
    // claim about what staff will lift. The new brief carries no [CONFIRM] on
    // it, which reads as that confirmation having happened — still worth one
    // sentence of verification with Teagan, since it's the only answer on the
    // page about physical risk to floors and to the team.
    question: 'Do cleaners move furniture during a deep clean?',
    answer:
      "Yes, within reason. Our team moves light furniture like dining chairs, bedside tables and small items so we can clean properly underneath and behind. We don't move heavy furniture, appliances or anything that could be damaged. If you want behind a wardrobe or under a bed done, move it beforehand or tell us and we'll work out what's possible.",
  },
  {
    // ⚠️ [CONFIRM product range.] The brief's marker. The answer makes a
    // two-part promise — everything is brought, and preferences can be
    // accommodated — and the second half is the one to check: it commits TLB
    // to using a client's nominated products.
    question: 'Do you bring your own products and equipment?',
    answer:
      "Yes, everything. If you'd prefer particular products used in your home, tell us when you book.",
  },
  {
    question: 'Can I book a deep clean and then set up a regular one?',
    answer:
      "Yes, and most people do. It's the cheaper way round, because the deep clean does the heavy work once and the regular visits hold it there.",
  },
  {
    question: 'Can I book over the phone instead of online?',
    answer: 'Yes. Online, text, phone or email, whichever suits you.',
  },
];

// §14 Closing block — in the brief this time, so it's no longer this build's
// own addition echoing the hero. Real copy, split at the sentence break: the
// promise as the heading, the ask as the lead.
const closingCta = {
  heading: 'One clean, and the house starts again.',
  lead: "Tell us the condition it's in and we'll quote for what's actually there.",
  cta: quoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar + definition block share ONE photo behind a Cream scrim,
        so it is laid out across both — see the homepage for why a
        per-section background cannot do this. 75% keeps Dark Teal body
        copy above 4.5:1 over the darkest part of the frame. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ContentGrid
      columns={2}
      heading="What's included in a deep clean"
      lead="Everything in a regular clean, plus the detail work underneath it."
      blocks={inclusionBlocks}
    />

    <Callout tone="note" body={exclusionsCallout.body} />

    <ContentGrid columns={3} heading="When people book one" blocks={momentsBlocks} />

    {/* Wrapper carries the #compare anchor PathwayCards card 3 links to —
        ComparisonTable takes no id prop, and adding one just for an anchor
        target isn't worth a shared-component change. */}
    <div id="compare">
      <ComparisonTable
        heading={comparisonTable.heading}
        cornerLabel={comparisonTable.cornerLabel}
        columns={comparisonTable.columns}
        rows={comparisonTable.rows}
        footnote={comparisonTable.footnote}
      />
    </div>

    <PhotoGallery
      heading="Before, and after"
      lead="Real TLB deep cleans, shot twice from the same spot."
      images={beforeAfterImages}
    />

    <VideoFeature headingLines={heroVideo.headingLines} video={heroVideo.video} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Easy to book, instant pricing, cost effective"
      body={bookingBody}
      cta={quoteCta}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently asked questions" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
