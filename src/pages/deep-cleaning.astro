// isn't there is a trust cost at the exact moment the reader is deciding.
const heroVideo = {
  headingLines: ['Watch a deep clean, room by room.'],
  video: {
    ratio: '16/9',
    label: 'Before-and-after video of a TLB deep clean, room by room',
  },
};

// §10 The Line as a section heading, with the hero's second sentence
// expanded under those same three words.
//
// ⚠️ `fast`, not `instant`. This page read "instant pricing" until v2.0 §13.2
// was applied, and §13.2 names deep cleans specifically as work instant
// pricing "works badly for". The heading, the hero lead and paragraph two of
// bookingBody below all said it, so all three moved together. See
// data/brand-lines.ts for why there are two variants at all.
//
// §1.4 "Managed for you" is prepended at the call site as this block's
// standfirst, the `oneOff` wording because a deep clean has no set day or
// set team to promise.
//
// TextBlock `dark` rather than `light`: it sits between the video slot and
// the testimonials, both of which are light, and it carries the page's
// second CTA. It's also the one block on the page that argues rather than
// lists, so it shouldn't look like §5 or §6. `align="left"` — three
// paragraphs of running prose, not a centred pull quote.
//
// ⚠️ The standfirst is PAGE-LOCAL from 14 Sep 2026, replacing the shared
// `managedForYou.oneOff`. That line was a feature list — date, confirmation,
// message, told first — read in the order TLB does them rather than the order
// a client feels them. The rewrite names the frustration first (BFD §5.2's
// real objection: the organising, not the cleaning) and then resolves it with
// the same four promises. Kept here rather than pushed back into
// brand-lines.ts because every other one-off page still wants the short form.
const managedForYouDeepClean =
  "Managed for you. The part people put off isn't the cleaning, it's the organising: working out who to ask, waiting on a quote that never lands, then wondering whether anyone's actually coming. You pick a date that suits you, you get it confirmed in writing, you get a message when we're on the way, and if anything changes you hear it from us first.";

const bookingBody: TextBlockBody[] = [
  "Book online in a couple of minutes, or send a text, ring us or drop us an email, whichever you'd actually do.",
  "You get a quote back fast rather than waiting days on someone to come out. It's based on the house as it actually is, so tell us honestly what condition it's in when you book. Nothing you say will surprise us, and it means we allow the right amount of time rather than running short on the day.",
  // "your home", not "the place", from 14 Sep 2026: it picks up the
  // `home deep cleaning services` phrasing, which sits in the same 590/mo
  // cluster as the mapped primary but barely appears on a page that is
  // otherwise entirely about houses.
  "Cost effective because one deep clean does the heavy work in a single visit. If you're setting up a regular clean afterwards, this is the better way round. And if your home needs more time than we've quoted, you'll hear that before we start rather than on the invoice.",
];

// §10b What a deep clean costs — NEW section, added 14 Sep 2026.
//
// Three of the four competitors on page one of `deep cleaning services`
// publish a real number and TLB publishes nothing. This targets roughly
// 120/mo of direct pricing intent (`deep cleaning prices`, `deep clean cost`,
// `how much does a deep clean cost`) plus the second-most-asked People Also
// Ask question on the primary term.
//
// ⚠️ BLOCKING, AND IT IS WHY THIS DOES NOT RENDER YET. The price band is
// Teagan's to supply and nobody else's to estimate. `pricingConfirmed` stays
// false until it lands, which keeps the whole section off the page — a live
// pricing section reading "[Teagan to confirm]" is a worse outcome than no
// pricing section at all, and it is the one place on this page where the
// reserved-slot convention used for the testimonials and the video misfires:
// an unfinished price is read as a price.
//
// The same flag governs FAQ 5 below, so the two move together. While it is
// false the FAQ keeps its current self-contained answer; the moment it is
// true the section appears and the FAQ starts pointing up at it. Flip the
// flag, drop the real band into `pricingBand`, and both land in one change.
// This is the single most valuable outstanding item on the page.
const pricingConfirmed = false;
const pricingBand = '[Teagan to confirm: price band for a 3 bed / 2 bath deep clean]';

const pricingSection = {
  heading: 'What a deep clean costs',
  body: [
    `A deep clean is priced on the size of the place and the condition it's in, not on a flat hourly rate that would be wrong for most houses. A three bedroom, two bathroom home in reasonable condition sits around ${pricingBand}. If it's been a while, it runs higher, and you'll hear that when we quote rather than on the invoice.`,
    'What moves the number: how many bathrooms, whether the kitchen needs the rangehood and cupboard interiors done, how much is stored on the floor, and whether anything from the quoted-separately list is going in.',
    "You get the figure back fast, based on your actual place rather than a guess. And if a regular clean would serve you better than a deep one, we'll tell you that before you book rather than after.",
  ],
};

// §11 Social proof — bracketed [TBC] briefing slots, NOT real testimonials.
// Same convention index.astro and house-cleaning.astro both use: the visible
// text reads as obviously unfinished so it can't be mistaken for a real
// client quote. Never fill with invented names or words.
//
// The brief now specifies the two angles, where the old one said only "ask
// Teagan for Deep Cleaning testimonials" — "ideally one where the house had
// been let go, and one booked ahead of guests or a sale". Those are the two
// angles the first build proposed on its own, so the slots below are the
// brief's ask now rather than a proposal awaiting confirmation.
const testimonials = [
  {
    quote:
      '[TBC — ask Teagan for a quote from a deep clean client whose house had been let go. This answers the shame barrier the first FAQ addresses, and it is the most common reason people hesitate to book.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Deep clean client' },
  },
  {
    quote:
      '[TBC — ask Teagan for a quote from a deep clean client who booked ahead of guests or a sale. Deadline pressure is what turns a deep clean from someday into this week.]',
    name: '[Client name — TBC]',
    role: '[Suburb / property type — TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Deep clean client who booked against a deadline' },
  },
];

// §12 Where we clean — the shared 56-town, three-region list from
// src/data/locations.ts, which every "Where we clean" section now reads
// from. This page specified it first; house-cleaning.astro and the homepage
// then carried verbatim copies, so it was extracted. The open questions —
// the /locations/<slug>/ URL pattern, the ~41 town pages that don't exist
// yet, and the header mega-menu's shorter list — are flagged there, where
// one fix serves every page.

// §13 FAQs — ten questions, ONE block.
//
// Every other page on this site splits its FAQs into a "branded" and a
// "non-branded" accordion, because those briefs supplied two labelled lists.
// This brief supplies one H2 and one run of ten questions, so it ships as one
// accordion. Don't split it back into two for site symmetry — that would mean
// inventing the second heading and deciding which questions sit under it,
// neither of which is in the brief.
//
// Three answers carry [CONFIRM] markers in the brief. The markers are
// stripped from the published copy (they're notes to Teagan, not text for a
// visitor) and each is flagged inline below. All three ship as written,
// unlike the first build's "[X] days", which was a literal unfilled blank —
// these are finished sentences awaiting a read-through.
const faqItems = [
  {
    question: "My house hasn't had a proper clean in years. Is that a problem?",
    answer:
      "Not at all, that's the job. Tell us honestly how it is when you book so we can allow the right time, and we'll quote for what's actually there rather than a guess.",
  },
  {
    // No longer over-promising: §5 above IS the published task list. This was
    // 🚩2 in the first build's header.
    question: "How do I know it'll actually be a deep clean and not a quick once-over?",
    answer:
      "Because the task list is published on this page before you book. You know what you're getting, and so do we.",
  },
  {
    question: 'What if the house needs more time than we booked?',
    answer:
      "We'll tell you before we start, not after. You'll have the option to add time, or to tell us what matters most so we prioritise that. You won't get a surprise on the invoice.",
  },
  {
    // ⚠️ [CONFIRM] — the brief opens this answer with the marker. "Most of a
    // day for a team" for a three-bedroom home is an operational estimate
    // that sets a client's expectation on the day; whoever schedules these
    // jobs needs to agree with it.
    question: 'How long does a deep clean take?',
    answer:
      "Considerably longer than a regular clean, because it's the detail work. A three-bedroom home in reasonable condition is usually most of a day for a team. If it's been a while, longer. We'll give you a realistic window when we quote.",
  },
  {
    // Two answers, one flag. Once §10b's pricing section ships this question
    // repeats it, so the confirmed version stops re-explaining and sends the
    // reader up to the actual figure instead. While `pricingConfirmed` is
    // false that section does not exist and a pointer to it would be a dead
    // reference, so the original self-contained answer stands.
    question: 'How much does a deep clean cost?',
    answer: pricingConfirmed
      ? "It depends on the size of the house and the condition it's in. There's a price guide further up this page, and you'll have a firm number back quickly once you tell us the basics. No obligation attached."
      : "It depends on the size of the house and the condition it's in, which is why we quote rather than publish a flat rate. Tell us the basics and you'll have a price back quickly, with no obligation attached.",
  },
  {
    // ⚠️ [CONFIRM the full exclusions list.] This restates §5b's Callout —
    // the same fact in two places, so they have to be settled together and
    // kept in step. If one changes and the other doesn't, the page
    // contradicts itself about what a client is paying for.
    question: "What isn't included in a deep clean?",
    answer:
      "A deep clean covers the detail work inside your home, so a few jobs sit outside it. We don't wash dishes, do laundry, or tidy and organise your belongings. Cleaning at height, exterior windows, carpet steam cleaning and inside-the-oven work are all quoted separately. If you're unsure whether something is covered, ask when you book and we'll tell you straight.",
  },
  {
    // The first build held this back as an unconfirmed safety-and-liability
    // claim about what staff will lift. The new brief carries no [CONFIRM] on
    // it, which reads as that confirmation having happened — still worth one
    // sentence of verification with Teagan, since it's the only answer on the
    // page about physical risk to floors and to the team.
    question: 'Do cleaners move furniture during a deep clean?',
    answer:
      "Yes, within reason. Our team moves light furniture like dining chairs, bedside tables and small items so we can clean properly underneath and behind. We don't move heavy furniture, appliances or anything that could be damaged. If you want behind a wardrobe or under a bed done, move it beforehand or tell us and we'll work out what's possible.",
  },
  {
    // ⚠️ [CONFIRM product range.] The brief's marker. The answer makes a
    // two-part promise — everything is brought, and preferences can be
    // accommodated — and the second half is the one to check: it commits TLB
    // to using a client's nominated products.
    question: 'Do you bring your own products and equipment?',
    answer:
      "Yes, everything. If you'd prefer particular products used in your home, tell us when you book.",
  },
  {
    question: 'Can I book a deep clean and then set up a regular one?',
    answer:
      "Yes, and most people do. It's the better way round, because the deep clean does the heavy work once and the regular visits hold it there.",
  },
  {
    question: 'Can I book over the phone instead of online?',
    answer: 'Yes. Online, text, phone or email, whichever suits you.',
  },
  {
    // Added 14 Sep 2026. `apartment deep clean` is 140/mo, up roughly 80%
    // year on year, with a local pack firing, and the page spoke only about
    // houses. The strata sentence is the half that earns the question: lift
    // bookings and contractor access rules are what actually goes wrong on
    // the day.
    question: 'Do you deep clean apartments and units?',
    answer:
      "Yes. An apartment deep clean is the same task list in a smaller footprint, so it usually takes less time than a house with the same number of bedrooms. Strata buildings sometimes have lift bookings or access rules for contractors, so tell us the building when you book and we'll sort that out beforehand rather than on the day.",
  },
];

// §14 Closing block — in the brief this time, so it's no longer this build's
// own addition echoing the hero. Real copy, split at the sentence break: the
// promise as the heading, the ask as the lead.
// Reworked 14 Sep 2026. The heading takes the same one-word fix as the H1, so
// the page opens and closes on the term. The second sentence of the lead
// lands the BFD §1.5 payoff the whole page has been building toward and had
// never quite said out loud.
const closingCta = {
  heading: 'One deep clean, and the house starts again.',
  lead: "Tell us the condition your home is in and we'll quote for what's actually there. Most people book this once, then set up a fortnightly and stop thinking about the house altogether.",
  cta: pageQuoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar + definition block share ONE photo behind a Cream scrim,
        so it is laid out across both — see the homepage for why a
        per-section background cannot do this. 75% keeps Dark Teal body
        copy above 4.5:1 over the darkest part of the frame. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ContentGrid
      columns={2}
      heading="What's included in a deep clean"
      lead="Everything in a regular clean, plus the detail work underneath it. This is the full deep cleaning checklist, published before you book rather than after."
      blocks={inclusionBlocks}
    />

    <Callout tone="note" body={exclusionsCallout.body} cta={exclusionsCallout.cta} />

    {/* Heading rewritten 14 Sep 2026. "When people book one" referred back
        to a heading the reader may have scrolled past and carried no
        keyword; the new one works as a standalone answer, which is what
        BFD §14 asks of every service-page section. */}
    <ContentGrid columns={3} heading="When people book a deep clean" blocks={momentsBlocks} />

    {/* Wrapper carries the #compare anchor PathwayCards card 3 links to —
        ComparisonTable takes no id prop, and adding one just for an anchor
        target isn't worth a shared-component change. */}
    <div id="compare">
      <ComparisonTable
        heading={comparisonTable.heading}
        cornerLabel={comparisonTable.cornerLabel}
        columns={comparisonTable.columns}
        rows={comparisonTable.rows}
        footnote={comparisonTable.footnote}
      />
    </div>

    {/* Drag the handle to wipe between the two frames of each pair — see
        the block above `beforeAfterPairs` for why this is a slider and not
        a gallery, and for the fact that these four images are SAMPLES. The
        `note` is what tells the reader that; delete it with the imports.

        Heading rewritten 14 Sep 2026: "the difference, on real jobs"
        asserted the jobs were real while the images are labelled
        illustrative. The new one carries the keyword and describes what the
        module actually shows. */}
    <BeforeAfter
      heading="The difference a deep clean makes."
      lead="Drag the handle across each photo to see the same spot before and after a deep clean."
      pairs={beforeAfterPairs}
      note="Illustrative samples, shown while we collect before and after photos from real TLB cleans."
    />

    <VideoFeature headingLines={heroVideo.headingLines} video={heroVideo.video} />

    <TextBlock
      theme="dark"
      align="left"
      heading={theLineHeading.fast}
      body={[managedForYouDeepClean, ...bookingBody]}
      cta={pageQuoteCta}
    />

    {/* §10b, gated on `pricingConfirmed` — see the block above
        `pricingSection`. Renders nothing until Teagan's price band lands,
        and FAQ 5 swaps to point at it on the same flag. */}
    {pricingConfirmed && (
      <TextBlock theme="muted" align="left" heading={pricingSection.heading} body={pricingSection.body} />
    )}

    {/* ⚠️ The two cards below are still bracketed [TBC] briefing slots, not
        testimonials. They are fine in a staging build (the convention is
        shared with index.astro and house-cleaning.astro) but they must NOT
        go live: visible instructions to the founder are a credibility
        failure, and BFD §12.2 forbids writing substitutes. If the two real
        quotes are not collected before launch, hide this section rather
        than publishing it — an absent testimonial block is neutral. */}
    <TestimonialCarousel heading="What our deep clean clients say" testimonials={testimonials} uniform />

    {/* The Tweed was being folded into its neighbours. BFD §2.1 lists it
        separately on purpose: Kingscliff, Pottsville and Tweed Heads are
        neither Northern Rivers nor Gold Coast to anyone who lives there, and
        grouping them wrongly is the small error that tells a local you don't
        know the area.

        ⚠️ The GROUPS below still show only the eight towns the client asked
        for in Sept 2026, with the Tweed group hidden entirely (see
        data/locations.ts). So this line now names three regions while the
        list shows two. It is accurate about where TLB cleans and it looks
        short on the page, and closing that gap is NOT this page's call:
        restoring the full 56-town, three-group list is a site-wide data
        change against a standing client instruction. Raise it before
        touching locations.ts. */}
    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    {/* The generic heading was identical on every service page, which gives
        Google and an AI assistant nothing to tell them apart. */}
    <Faq heading="Frequently asked questions about deep cleaning" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
