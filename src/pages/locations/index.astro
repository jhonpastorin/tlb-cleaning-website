---
// The locations hub, shipping at /locations/.
//
// WHY IT EXISTS. Every footer on the site carries "View all locations" →
// `/locations/`, and the primary nav carries "Locations" → the same href.
// That link was a 404 on all 106 built pages. locations.ts' own header has
// carried a standing warning about it ("⚠️ Still 404ing … /locations/ itself,
// which every footer on the site links to"); this file is what closes it.
//
// WHAT IT IS FOR, and what it deliberately is not. Its job is to route: name
// the three regions, say what each is actually like to work in, and hand the
// reader all 56 towns as links. It is NOT a fourth "cleaners in <somewhere>"
// page — that shape belongs to /locations/<town>/ and duplicating it at the
// parent would put a 57th near-identical page on the pile the town route
// already has to justify (see townPages.ts' doorway-page warning).
//
// EVERYTHING IS DERIVED FROM src/data/locations.ts. The town lists, the
// region grouping, the counts in §4 — none of it is typed out here. Add a
// town to locations.ts and it appears on this page, in the mega-menu, in
// every "Where we clean" band, and as its own page, with no edit to this
// file. That is the same rule the guides hub follows, and it is the whole
// reason locations.ts was extracted in the first place.
//
// ⚠️ THE DOORWAY-PAGE DECISION IS STILL OPEN AND THIS PAGE INHERITS IT.
// townPages.ts' header sets out the choice: write a real `local` paragraph
// for all 56 towns, or publish only the towns that have one. If TLB picks the
// second, this page needs NO structural change — drop a town's `href` in
// locations.ts and `TagCloud` renders it as a plain <span> pill instead of a
// link, which is exactly the "we clean here, there is no page for it" state
// this page should show. The mechanism is already documented in locations.ts.
//
// ✅ THIS PAGE LISTS EVERY TOWN TLB WORKS IN AGAIN. For two days in September
// 2026 it rendered a curated subset — eight towns, then fourteen — while the
// rest still had built pages that nothing linked to. The client's 18 Sep call
// ended that: every band names all 56 and links the live ones, so this page is
// back to being the complete list it started as. locations.ts' `navigableTowns`
// is the one switch that decides which of them are clickable.
//
// Every count, heading and region block below is derived from the town arrays,
// so a town added there lands here without an edit; the only hand-written
// things are the region paragraphs in §4 and the FAQ answers.
//
// ⚠️ THE CROSS-BORDER SERVICE QUESTION IS OPEN SITEWIDE AND IS NOT SETTLED
// HERE. commercial-cleaning.astro and ndis-cleaning.astro render
// `nswLocationGroups` (NSW only) while footerContact, end-of-lease-cleaning
// §7 and the Airbnb page all claim the Southern Gold Coast. This page uses
// the full `locationGroups`, matching the majority and matching the header's
// own "Areas we clean" menu — but §5's Queensland cell deliberately describes
// only the domestic and holiday-let work the site already claims across the
// border, and says nothing about commercial or NDIS either way. Asserting
// coverage this repo has not been told about would be inventing a service
// area. When TLB settles it, that cell gains a sentence and the two NSW-only
// pages either widen or stay.
//
// PHOTOGRAPHY: the three region photos from src/assets/locations/, reused
// from townPages.ts rather than re-imported by path, so the alt text and the
// "no hero may name a town or a landmark" rule stay in one place.
// IMAGE-GUIDELINES.md §5.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import MetricsBlock from '../../components/sections/MetricsBlock.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import type { ServiceIconName } from '../../components/ui/ServiceIcon.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
  serviceLinks,
} from '../../data/navigation';
import { trustBarCards } from '../../data/trust';
import {
  locationGroups,
  northernRiversTowns,
  tweedTowns,
  southernGoldCoastTowns,
  allTowns,
} from '../../data/locations';
import { heroImages, regions } from '../../data/townPages';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';

// §0 Metadata. The title leads with the service area rather than with a
// service, because that is what this page is and because "cleaners northern
// rivers" style queries land here rather than on a town page. The three
// region names are all in the description: they are the terms people
// actually use for where they live, and only one of them ("Northern Rivers")
// appears in the site's own name for itself.

// Counts, derived rather than written. A hardcoded "56 towns" is wrong the
// first time somebody edits locations.ts and nobody notices for a year.
//
// These count EVERY town again, which is the same thing this page now lists.
// They went through a curated phase in September 2026 and the counts followed
// it down to eight and then fourteen; the client's 18 Sep call put the full
// list back, so they are simply the array lengths once more.
const townCount = allTowns.length;
// The display groups and the geographic regions are the same three again, so
// either would give 3 here. `locationGroups` is the one this page actually
// renders, so it is the one that is counted: if a heading is ever added or
// merged, the number follows the page rather than the map.
const regionCount = locationGroups.length;
const stateCount = new Set(regions.map((r) => r.state)).size;

// §1 Hero. `full-width-photo`, matching /locations/<town>/ rather than the
// service pages' `split-single-image`: a location page opens on a place, and
// that variant floats a solid card over the photo so the copy never depends
// on the photo's own contrast.
//
// The valley photo, not either of the house photos. This page is about a
// region rather than a home, and the other two are the heroes individual
// town pages open on — using one here would make the parent look like one of
// its children.

// §2 The answer block. Definition-style opening sentence for the answer
// engines, then the sentence that says the thing a service-area page usually
// leaves out: where the edges are and what happens at them.
//
// The last paragraph is the honest one. A cleaning business that claims a
// two-hour radius and then declines half of it is worse than one that names
// its edge, and "ask us anyway" is already the note under every "Where we
// clean" band on the site.

// §3 The three numbers. `MetricsBlock` `grid` rather than `StatBand`: these
// are plain figures about coverage, not brand-band trust claims with a CTA
// attached, which is the distinction SECTIONS.md draws between the two.
//
// ⚠️ All three are DERIVED FROM locations.ts, so unlike the trust bar's own
// "98% of our clients stay with us" and "over 100 local homes" — both of
// which are unsourced claims flagged in trust.ts — these three cannot be
// wrong unless the town list is. Deliberately no client, staff or revenue
// figure here for exactly that reason.

// §4 The three regions. `ContentGrid` at two columns, image side set purely
// by array order the way StoryMosaic is — row one image-then-text, row two
// text-then-image, row three image-then-text.
//
// The Tweed pair came out when that region was hidden in September 2026 and is
// back verbatim, because the copy was never the reason it went: the region is
// listed again, so the cell that describes it belongs here again too.
//
// Each cell says what the region is actually like to clean in, which is the
// only thing this page can offer that the pill list below cannot. None of it
// is a claim about TLB's operations; it is geography and weather, both of
// which are checkable and neither of which goes stale.
//
// ⚠️ THE PHOTOS ARE GENERATED SCENES, NOT PHOTOGRAPHS OF THESE PLACES.
// townPages.ts' own header states the rule and the alt text below is its
// label, verbatim, for that reason: "a generated image captioned as a real
// place is a fabricated claim about that place". The copy names towns; the
// image labels never do. Do not write a new label here that says "Byron Bay".

// §5 The list. ONE `TagCloud` with both groups, not two stacked TagClouds —
// SECTIONS.md's own note on why `groups` exists says consecutive instances
// would mean Dark Teal bands back to back, each repeating a heading, and would
// throw away the fact that the two regions are in different states.
//
// This is the same `locationGroups` every "Where we clean" band on the site
// renders. It is deliberately identical here: this page is the canonical home
// of that list, and a hub whose list disagreed with the one on every other
// page would be the exact drift locations.ts was extracted to end. That now
// includes the hiding — locations.ts hides a town once, for the menu, this
// page and every band at the same time.
const allTownGroups = locationGroups;

// §6 The services. Same six the footer column, the homepage grid and all 56
// town pages render, reused from navigation.ts with the town route's own
// icon map so a reader arriving from a footer link can get straight to what
// they actually wanted.
//
// ⚠️ Icons keyed by href, not by array index, copied from
// /locations/<town>/'s own map for the same reason it gives: reordering
// serviceLinks must not silently shuffle the icons. If a seventh service is
// added to navigation.ts it needs an entry in BOTH maps — the `list` variant
// renders a fixed icon segment per row, so a missing icon leaves an empty
// block rather than collapsing.
const serviceIcons: Record<string, ServiceIconName> = {
  '/house-cleaning/': 'house',
  '/house-cleaning/deep-cleaning/': 'spray-bottle',
  '/house-cleaning/end-of-lease-cleaning/': 'bloom',
  '/airbnb-holiday-home-cleaning/': 'suitcase',
  '/house-cleaning/real-estate-cleaning/': 'key',
  '/commercial-cleaning/': 'office',
};

const serviceItems = serviceLinks.map((service) => ({
  icon: serviceIcons[service.href],
  title: service.title,
  description: service.description,
  href: service.href,
}));

// §7 FAQs. Location-level questions only — coverage, edges, the border,
// travel. The what-is-included questions belong on the service pages and the
// per-town ones are already on the 56 town pages; repeating either here would
// add duplicate text to a site that already has 56 pages running one
// template.
//
// ⚠️ ANSWER 3 (travel charge) IS THE SAME UNCONFIRMED OPERATIONAL PROMISE
// /locations/<town>/ makes on all 56 pages, and it is flagged there too. It
// asserts no travel charge anywhere on this page's list, and that list is now
// all 56 towns again — Kyogle and Woodburn at one edge, Miami at the other.
// That is the widest this promise has ever been. It was briefly a much smaller
// one, while the page listed eight towns inside an hour of each other; the
// wording never changed to match either way. Worth putting to TLB before
// launch rather than after the first Kyogle quote.
//
// ⚠️ ANSWER 2 is no longer carrying a hidden-towns gap — the page names every
// town TLB works in again — but it is still the right answer: the list is a
// description of where the team works regularly, not a boundary, and people
// just outside it still ask.
//
// ⚠️ ANSWER 4 (the border) is the one genuine differentiator on this page and
// it restates what end-of-lease-cleaning.astro §7 already claims, so it is
// consistent rather than new.

// §8 Closing CTA. The town-page CTA asks for the size of the place; this one
// asks for the suburb, because on this page the reader has just been looking
// at a map of them and that is the question the page has been asking all the
// way down.

// CONTENT lives in src/content/pages/locations/index.yaml and is edited in
// Pages CMS ("Locations > Locations hub"). This file owns the layout, the
// photos (Site settings > Locations > Region photos) and every count. The
// notes above explain why each section says what it says; they stay here
// because Pages CMS rewrites the YAML on save and would drop them.
//
// The counts reach the copy through placeholders an editor types in any text
// field, e.g. "{townCount} towns across three regions". Single braces, so
// they cannot be confused with the site-wide {{tokens}}. A placeholder this
// page does not know fails the build, so a typo never ships as "{twonCount}".
const placeholders: Record<string, string> = {
  townCount: String(townCount),
  regionCount: String(regionCount),
  stateCount: String(stateCount),
  northernRiversCount: String(northernRiversTowns.length),
  tweedCount: String(tweedTowns.length),
  southernGoldCoastCount: String(southernGoldCoastTowns.length),
};

function fillPlaceholders(value: unknown, path: string): unknown {
  if (typeof value === 'string') {
    return value.replace(/(?<!\{)\{(\w+)\}(?!\})/g, (_, name: string) => {
      const filled = placeholders[name];
      if (filled === undefined) {
        throw new Error(
          `[CMS] src/content/pages/locations/index.yaml: ${path} uses {${name}}, which this page does not fill in. Available: ${Object.keys(
            placeholders,
          )
            .map((key) => `{${key}}`)
            .join(', ')}`,
        );
      }
      return filled;
    });
  }
  if (Array.isArray(value)) return value.map((item, i) => fillPlaceholders(item, `${path}.${i}`));
  if (value && typeof value === 'object') {
    return Object.fromEntries(
      Object.entries(value).map(([key, item]) => [key, fillPlaceholders(item, path ? `${path}.${key}` : key)]),
    );
  }
  return value;
}

const page = await getPage(
  'locations/index',
  z.preprocess(
    (raw) => fillPlaceholders(raw, ''),
    z.object({
      seo: section.seo,
      // The photo is the valley region photo, chosen in code (see §1).
      hero: section.hero.omit({ image: true }),
      definition: section.textBlock,
      // The grid variant shows no photo, so the section has none.
      numbers: section.metricsBlock.omit({ image: true }),
      // The three region cells, in map order. The photos between them are the
      // region photos, placed in code (see §4), so the count is fixed.
      regions: section.textGrid.extend({
        items: section.textGrid.shape.items.length(3, 'Exactly three regions: Northern Rivers, the Tweed, Southern Gold Coast'),
      }),
      towns: section.tagCloud,
      services: section.sectionIntro,
      faq: section.faq,
      closingCta: section.callToAction,
    }),
  ),
);

const pageMeta = {
  ...page.seo,
  // ⚠️ Placeholder domain, same as every page in this repo. Confirm before launch.
  canonical: 'https://tlbcleaning.com.au/locations/',
};

// ⚠️ `areaServed` here is the full three-region string, unlike a town page's
// (which correctly narrows to its own town — that is the point of those
// pages). This one is the parent, so the wide string is right. Every other
// field is still empty, inherited from every page built before these; one fix
// in one place would fill the whole site's structured data and nobody has
// supplied the details yet.
const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
});

const heroImage = { ratio: '16/9', label: heroImages.valley.label, src: heroImages.valley.src };

const regionPhoto = (key: keyof typeof heroImages) => ({
  type: 'image' as const,
  ratio: '4/3',
  label: heroImages[key].label,
  src: heroImages[key].src,
});
const regionText = (i: number) => ({ type: 'text' as const, ...page.regions.items[i] });
const regionBlocks = [
  regionPhoto('hinterland-home'),
  regionText(0),
  regionText(1),
  regionPhoto('valley'),
  regionPhoto('coastal-home'),
  regionText(2),
];
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    {/* `cardWidth="wide"` (640px rather than the 480px default). At the
        default width this page's heading wrapped to four lines and the lead
        to three, which made a tall narrow column over a wide landscape
        photo — the region shot is the one image on the site with real depth
        in it and the card was covering the half worth seeing. The 56
        /locations/<town>/ pages keep the default: their headings are one
        short line ("Cleaners in Ballina.") and widening those would leave a
        mostly-empty card. */}
    <Hero
      variant="full-width-photo"
      cardWidth="wide"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <TrustBar variant="card" surface="plain" cards={trustBarCards} />

    <TextBlock
      theme="light"
      align="left"
      heading={page.definition.heading}
      body={page.definition.body}
      cta={page.definition.cta}
      backgroundImage={page.definition.backgroundImage}
    />

    <MetricsBlock heading={page.numbers.heading} lead={page.numbers.lead} metrics={page.numbers.metrics} />

    {/* Two columns, and the side each block lands on is purely its position
        in the array: image then text, text then image, image then text. */}
    <ContentGrid heading={page.regions.heading} lead={page.regions.lead} columns={2} blocks={regionBlocks} />

    <TagCloud
      heading={page.towns.heading}
      subheading={page.towns.subheading}
      tags={page.towns.tags}
      groups={allTownGroups}
      note={page.towns.note}
    />

    <ServiceBlocks variant="list" heading={page.services.heading} lead={page.services.lead} items={serviceItems} />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
