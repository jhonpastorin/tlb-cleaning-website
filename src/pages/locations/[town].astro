---
// THE LOCATION PAGE, once, for all 56 towns at /locations/<town>/.
//
// This started life as a single hand-built sample, src/pages/locations/
// lismore.astro. That file is gone: it became this route the moment a second
// town was wanted, because the alternative was 56 copies of one layout and a
// guarantee that they would drift apart. locations.ts' own header documents
// what that costs — four copies of one town list, three of them stale. The
// layout lives here once; everything town-specific lives in
// src/data/townPages.ts.
//
// TO ADD OR CHANGE A TOWN, DON'T TOUCH THIS FILE. Towns come from
// locations.ts (the same arrays the header mega-menu and every "Where we
// clean" section render), and per-town substance — the local paragraph,
// hand-picked neighbours, a different hero — comes from townPages.ts.
//
// ⚠️ READ townPages.ts' HEADER BEFORE PUBLISHING THESE. As things stand 55 of
// the 56 pages differ only by a town name and six suburb links, which is the
// definition of a doorway page. The route is ready; the content decision is
// not made, and it is not this file's to make.
//
// ⚠️ Copy below is drafted by this build in the house-cleaning brief's voice.
// There is no content plan for location pages in content-plans/, unlike every
// service page on this site. Treat it as a first draft to react to.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import BeforeAfter from '../../components/sections/BeforeAfter.astro';
// Before/after pairs — real TLB job photos. The `sample-` files are flat
// illustrations and stay only where no real pair exists for that subject yet.
// The content imports sit here, where the four before/after photo imports
// were, on purpose: Astro orders a page's CSS by import position, so moving
// them changes the order of the built stylesheets.
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { highlightColumn } from '../../lib/cms-schemas';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
// Before/after: the SAME pairs house-cleaning.astro runs, deliberately reused
// rather than regenerated. The kitchen pair is now REAL TLB job photography;
// so is slot 2. No sample illustration is left on this page.
//
// ⚠️ WATCH THE TOWN CLAIM. This is a location page, so a real job photo is
// the one place a reader could infer the job was done in THIS town. Nothing
// states that — the heading, lead and `note` all say "a real TLB clean" with
// no place attached — and it has to stay that way. Never caption these with
// the town name unless the job really was there; see house-cleaning.astro §9
// and consent brief.
import type { TagGroup } from '../../components/sections/TagCloud.astro';
import type { ServiceIconName } from '../../components/ui/ServiceIcon.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
  serviceLinks,
} from '../../data/navigation';
import { trustBarCards } from '../../data/trust';
import { isNavigableTown, townSlug } from '../../data/locations';
import { townPages, type TownPage } from '../../data/townPages';

export const getStaticPaths = (() =>
  townPages.map((page) => ({
    params: { town: page.slug },
    props: { page },
  }))) satisfies GetStaticPaths;

const { page: townPage } = Astro.props as { page: TownPage };
const { town, region, nearby, hero: heroImage, local } = townPage;

// "The Tweed" reads wrong after another article ("the surrounding The
// Tweed"), so prose drops the leading article and the label keeps it for
// headings and the kicker where it stands alone.
const regionProse = region.label.replace(/^The /, '');
const state = region.state;

// CONTENT lives in src/content/pages/locations/town.yaml and is edited in
// Pages CMS ("Locations > Town page template"). It is the copy every one of
// the 56 town pages shares; each town's photo, local paragraph and neighbours
// are in its own file (src/content/towns/). This file owns the layout. The
// notes below explain why each section says what it says; they stay here
// because Pages CMS rewrites the YAML on save and would drop them.
//
// The town and its region reach the copy through placeholders an editor types
// in any text field, e.g. "Cleaners in {town}." Single braces, so they cannot
// be confused with the site-wide {{tokens}}. A placeholder this page does not
// know fails the build, so a typo never ships as "Cleaners in {twon}."
const placeholders: Record<string, string> = {
  town,
  region: regionProse,
  regionName: region.label,
  state,
};

function fillPlaceholders(value: unknown, path: string): unknown {
  if (typeof value === 'string') {
    return value.replace(/(?<!\{)\{(\w+)\}(?!\})/g, (_, name: string) => {
      const filled = placeholders[name];
      if (filled === undefined) {
        throw new Error(
          `[CMS] src/content/pages/locations/town.yaml: ${path} uses {${name}}, which the town pages do not fill in. Available: ${Object.keys(
            placeholders,
          )
            .map((key) => `{${key}}`)
            .join(', ')}`,
        );
      }
      return filled;
    });
  }
  if (Array.isArray(value)) return value.map((item, i) => fillPlaceholders(item, `${path}.${i}`));
  if (value && typeof value === 'object') {
    return Object.fromEntries(
      Object.entries(value).map(([key, item]) => [key, fillPlaceholders(item, path ? `${path}.${key}` : key)]),
    );
  }
  return value;
}

const page = await getPage(
  'locations/town',
  z.preprocess(
    (raw) => fillPlaceholders(raw, ''),
    z.object({
      seo: section.seo,
      // The photo is the town's own, from its file in src/content/towns/.
      hero: section.hero.omit({ image: true }),
      // The town's own `local` paragraphs follow this body.
      definition: section.textBlock,
      // The six services come from the site-wide service list.
      services: section.sectionIntro,
      choose: section.comparisonTable,
      beforeAfter: section.beforeAfter,
      reviews: section.sectionHeading,
      // The suburbs are the town's neighbours, worked out in code (see below),
      // so there are no tags to edit; `groupLabel` heads them.
      nearby: section.tagCloud.omit({ tags: true }).extend({ groupLabel: section.text }),
      faq: section.faq,
      closingCta: section.callToAction,
    }),
  ),
);

// Page metadata. The title follows the "[service] [suburb]" shape this whole
// location-page programme exists to rank for.
const pageMeta = {
  ...page.seo,
  // Domain is a placeholder on every page in this repo — confirm before launch.
  canonical: `https://tlbcleaning.com.au${townSlug(town)}`,
};

// ⚠️ `areaServed` and `addressLocality` are the two fields that should NOT be
// the site-wide three-region string every service page uses. A LocalBusiness
// whose area of service is the town the page is about is the whole point of
// the page existing. The address is this town's, so it replaces the empty
// site-wide one.
const business = {
  ...localBusiness({
    description: pageMeta.description,
    areaServed: `${town} and the surrounding ${regionProse}, ${state}`,
    sameAs: googleBusinessProfileUrl ? [googleBusinessProfileUrl] : [],
  }),
  address: {
    streetAddress: '',
    addressLocality: town,
    addressRegion: state,
    postalCode: '',
    addressCountry: 'AU',
  },
};

// Hero. `full-width-photo` rather than the service pages'
// `split-single-image`: those run a cut-out figure on a transparent backdrop,
// and this page's asset is a scene photo — a place, which is what a location
// page opens on. The variant floats a solid content card over the photo, so
// the copy's legibility never depends on the photo behind it.
//
// The photo and its alt text both come from townPages.ts. Each town now has
// its own scene there rather than sharing one of three region photos, but the
// rule that a label may never name a town, a landmark or a street is
// unchanged and is the reason a generated scene is publishable at all — see
// the townHeroes header. Don't write a label here.
const heroImageBlock = { ratio: '16/9', label: heroImage.label, src: heroImage.src };

// Opening paragraph — the answer-target block for "cleaners <town>".
//
// ⚠️ The two sentences below are true of every town TLB services. `local` is
// what stops this page being a template with a name in it, and it is empty
// for every town but the one that gets written first. See townPages.ts.
const introBody = [...page.definition.body, ...local];

// Services. `serviceLinks` is the same six the footer column and the homepage
// grid render, reused rather than retyped so a seventh service appears on all
// 56 pages automatically. Descriptions are the homepage brief's verbatim and
// are deliberately NOT reworded per town: rewriting six service descriptions
// 56 times is how a site ends up with 336 slightly different accounts of the
// same six services.
//
// ⚠️ The `list` variant renders a fixed 120px icon segment on every row, so an
// item with no icon leaves a solid empty block — these icons are required by
// the variant, not decoration. Keyed by href rather than by array index so
// reordering serviceLinks can't silently shuffle them, and matched to the
// homepage's own "What we do" icons where the same service appears there.
const serviceIcons: Record<string, ServiceIconName> = {
  '/house-cleaning/': 'house',
  '/house-cleaning/deep-cleaning/': 'spray-bottle',
  '/house-cleaning/end-of-lease-cleaning/': 'bloom',
  '/airbnb-holiday-home-cleaning/': 'suitcase',
  '/house-cleaning/real-estate-cleaning/': 'key',
  '/commercial-cleaning/': 'office',
};

const serviceItems = serviceLinks.map((service) => ({
  icon: serviceIcons[service.href],
  title: service.title,
  description: service.description,
  href: service.href,
}));

// A quick comparison of the three things people search a town name for. The
// rows are the same distinctions the service pages already draw; the table
// exists here so a visitor who landed on a town page rather than a service
// page can self-select without reading three pages first.
//
// End of lease, the third column, is the highlighted one.
const chooseColumns = highlightColumn(page.choose.columns, 2);

// Nearby suburbs: a per-town group, not the site-wide 56-town list. This
// section's job on a location page is internal linking to its actual
// neighbours, and the full list is already in the header mega-menu.
//
// Every one of these links resolves, because this route builds all 56 towns —
// before it existed, locations.ts carried a standing warning that the
// mega-menu shipped ~41 dead links.
//
// Only the live towns are LINKED, though, using locations.ts' `isNavigableTown`
// — the same predicate the mega-menu, the region pages and every "Where we
// clean" band apply. A neighbour whose page is not live is still named, as a
// plain pill, because it is still genuinely next door; naming it and linking it
// are two different claims. Until 18 Sep 2026 this linked every neighbour
// unconditionally, which was safe only because `nearby` had already been
// filtered to the curated list upstream. That filter is gone, so the rule is
// applied here instead.
const nearbyGroups: TagGroup[] = [
  {
    label: page.nearby.groupLabel,
    tags: nearby.map((suburb) => ({
      label: suburb,
      ...(isNavigableTown(suburb) ? { href: townSlug(suburb) } : {}),
    })),
  },
];

// FAQs. Six questions, all of them the ones a person searching a town name
// actually asks: coverage, timing, access, pricing. The generic
// what-is-included questions stay on the service pages where they belong.
// Twelve identical FAQs across 56 town pages would be the single biggest
// block of duplicate text on the site.
//
// ⚠️ Two answers make operational promises — no travel charge, and lead time —
// that need Teagan's confirmation before launch. They are now on 56 pages
// rather than one, so a wrong answer here is wrong 56 times. Same handling as
// the service pages' [CONFIRM] answers: strip the marker, flag inline, ship.
//
// ⚠️ THE TRAVEL CHARGE ANSWER IS THE ONE TO CHECK. It asserts that every town
// in all three regions is inside the regular run, including the far edges of
// the map. If there is a town TLB charges travel to, or reaches less often,
// that town needs an override rather than this blanket answer.

---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="full-width-photo"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImageBlock}
    />

    <TrustBar variant="card" surface="plain" cards={trustBarCards} />

    <TextBlock
      theme="light"
      align="left"
      heading={page.definition.heading}
      body={introBody}
      cta={page.definition.cta}
      backgroundImage={page.definition.backgroundImage}
    />

    {/* `list` variant rather than the homepage's image tiles: six rows of text
        link out cleanly and, unlike photo tiles, don't imply that the photo
        was taken in this town — which across 56 towns would be 56 implied
        claims about where a photo came from. */}
    <ServiceBlocks
      variant="list"
      heading={page.services.heading}
      lead={page.services.lead}
      items={serviceItems}
    />

    <ComparisonTable
      heading={page.choose.heading}
      lead={page.choose.lead}
      cornerLabel={page.choose.cornerLabel}
      columns={chooseColumns}
      rows={page.choose.rows}
      footnote={page.choose.footnote}
      cta={page.choose.cta}
    />

    <BeforeAfter
      heading={page.beforeAfter.heading}
      lead={page.beforeAfter.lead}
      pairs={page.beforeAfter.pairs}
      note={page.beforeAfter.note}
      beforeLabel={page.beforeAfter.beforeLabel}
      afterLabel={page.beforeAfter.afterLabel}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.nearby.heading}
      subheading={page.nearby.subheading}
      groups={nearbyGroups}
      note={page.nearby.note}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
