---
// Oven, BBQ and appliance cleaning — one of the six "Appliances" leaf pages
// under the Home Cleaning mega-menu. See carpet-and-rug-cleaning.astro for
// the shared reasoning behind this group, and src/data/appliance-services.ts
// for the cluster links.
//
// NO CONTENT BRIEF EXISTS. All copy is DRAFTED from the brand foundation
// document. Facts only TLB holds ship as visible [brackets].
//
// THIS IS THE ONLY PAGE IN THE GROUP THAT IS ACTUALLY ABOUT APPLIANCES, which
// is worth remembering when the menu group gets renamed (see
// appliance-services.ts). It covers three related but distinct jobs — oven,
// barbecue and other appliances — and the risk is that it reads as three thin
// pages stapled together. §4 is therefore built around the ONE method they
// share (take it apart, soak the parts, clean the cavity while they soak)
// rather than three separate walkthroughs.
//
// ⚠️ THIS PAGE OVERLAPS /house-cleaning/end-of-lease-cleaning/. The oven is the single most
// common bond-clean failure point and that page already owns the bond
// argument. This page mentions it once and links there. Do not build out a
// bond-cleaning argument here.
//
// BLOCKS LAUNCH:
//   - PYROLYTIC OVENS. Branded FAQ 3 says TLB does not chemically clean the
//     inside of a pyrolytic oven, because the coating can be damaged by
//     caustic cleaners and the manufacturer's own cycle is the correct
//     method. Confirm that is TLB's position. It is the standard trade
//     position and it protects everyone, but it must be TLB's actual policy
//     before it is published as one.
//   - THE DIP TANK. §4 describes soaking racks and parts. Confirm whether TLB
//     carries a heated dip tank, soaks on site in trays, or takes parts away.
//     All three are legitimate and they give the customer completely
//     different answers about mess, time and whether they lose their oven for
//     a day.
//   - CAUSTIC vs NON-CAUSTIC. The page says "the products we use" without
//     characterising them, deliberately, because nobody has said. If TLB uses
//     non-caustic products that is a real selling point worth stating; if it
//     uses caustic ones, the safety framing needs to be honest. Do not guess.
//   - WHICH APPLIANCES. §4's last card lists rangehood, fridge and microwave.
//     Confirm the actual list, and confirm whether dishwasher and washing
//     machine are in or out.
//   - Pricing basis bracketed.
//
// BEFORE/AFTER: this page now runs a REAL cooktop pair, not the SAMPLE oven
// illustration it used to. ⚠️ THE SUBJECT CHANGED WITH IT. The section's
// heading and lead used to be about oven DOOR GLASS, which the cooktop
// photograph does not show, so both were rewritten to match what is on
// screen. An oven-interior/door-glass pair is still the strongest possible
// image for this page and is the next one worth shooting; when it exists,
// add it as a second pair and put the door-glass copy back.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import PathwayCards from '../../components/sections/PathwayCards.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import BeforeAfter from '../../components/sections/BeforeAfter.astro';
// Before/after pairs — real TLB job photos. The `sample-` files are flat
// illustrations and stay only where no real pair exists for that subject yet.
// The two data imports below sit here, between components, on purpose: Astro
// orders a page's inline CSS by import position, and they hold the slots the
// before/after photo imports used to, so the built CSS order is unchanged.
import { comparisonColumns, comparisonRows } from '../../data/comparison';
import { locationGroups } from '../../data/locations';
import TagCloud from '../../components/sections/TagCloud.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import cardTeamImg from '../../assets/home_cleaning/appliances/cleaner-with-a-caddy-in-a-home-entry-hall.jpg';
import { whoIsInYourHomeCard } from '../../data/whoIsInYourHome';
// Before/after: REAL cooktop photography. See the file header.
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { trustBarCards } from '../../data/trust';
import { otherApplianceServices } from '../../data/appliance-services';
// The five exterior pages, for the cross-sell grid. See the note above
// crossSellItems.
import { outsideServices } from '../../data/outsideYourHome';
import { theLineHeading, howItWorks, managedForYou, theLineBody } from '../../data/brand-lines';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const OWN_HREF = '/house-cleaning/oven-cleaning/';

// §0 Metadata. Title and description are the SIGNED-OFF workbook text
// (Keyword Mapping & Metadata, sheet 1 row 11), reproduced verbatim. The old
// title split the mapped primary across "Oven," and "Cleaning", so
// `oven cleaning service` (400/mo) was absent from it; the old description ran
// 16 characters over the limit.
//
// 🔴 BLOCKS LAUNCH. The approved description claims "Non-toxic products."
// BFD 2.4 lists every claim TLB is cleared to make and no product or chemical
// claim appears on it, and this page's own copy pulls against it in two
// places: §14 explains that the enamel inside a self-cleaning oven "can be
// damaged by the caustic products used on ordinary ovens", and branded FAQ 1
// answers the chemical question with "It should not" rather than a guarantee.
// A flat claim in the result and a hedge on the page is the wrong way round.
// Confirm the products, or swap in the suggested replacement from
// oven-and-bbq-cleaning-copy-rewrite.md:
//   'Oven cleaning that removes baked-on grease from racks, trays, doors and
//    glass, plus BBQ cleaning. Ventilated as we work. Book your oven clean today.'
// Resolve the meta, not §14 and not FAQ 1.

// The page's one primary CTA, per BFD 9.5, repeated on every in-page button.
// `Book your oven clean today` is the approved workbook CTA and it fits a
// button at 26 characters, so it goes on unchanged.
//
// It also resolves a BFD 13.2 conflict: the old `Get an instant quote`
// promised instant pricing on a page whose own pricing block says the honest
// answer is a fast quote rather than an instant one. The approved CTA is an
// instruction to book rather than a pricing promise.
//
// The header keeps the site-wide quoteCta — that is chrome, not this page.
// Routing card 2 keeps `End of lease cleaning` and card 3 keeps `Why TLB`:
// those are navigation to another page, not this page's CTA.

// §1 Hero. The H1 now carries the mapped primary `oven cleaning service`
// (400/mo) as an exact contiguous phrase — the plural counts as verbatim —
// extended with the region, because this is a local-intent term with
// `oven cleaning near me` (300/mo) and `oven cleaning services near me`
// (150/mo) behind it. The old heading is not lost: it opens the lead, because
// it cannot absorb the mapped phrase without reading like a machine wrote it.
//
// The subheading is a NEW line. Its extension is scope rather than the H1's
// region, it leads with the door glass because that is the page's strongest
// and most specific hook, and it carries `oven and bbq cleaning` (100/mo) into
// the heading structure.

// In `definitionBody`:
// Opens with the mapped phrase as a contiguous string — the opening
// paragraph is scored on the first two sentences — and picks up
// `professional oven cleaning` (200/mo). One clause changed.

// §4 The shared method, not three separate walkthroughs. See the file header.
//
// In `methodItems`, on "The parts go in to soak":
// ⚠️ LAUNCH BLOCKER. Confirm the actual arrangement. See header.
// In `methodItems`, on "The other appliances, same visit":
// ⚠️ LAUNCH BLOCKER. Confirm the actual list. See header.

// REAL before/after photography. See the file header. The `note` is not optional.

// The cross-sell grid. The five interior siblings, then the five "Outside your
// home" pages.
//
// WHY THE EXTERIOR FIVE WERE ADDED. Window, gutter, roof, high pressure and
// exterior house washing link each other correctly but have NO working inbound
// link from anywhere outside their own cluster — the mega-menu's flat URLs for
// them all 404. This module is where they belong. See scorecard-before.md.
//
// The blurbs and icons come straight from outsideYourHome.ts, the same data
// the five exterior pages render in their own "The rest of the outside" row,
// so the wording is consistent site-wide rather than reinvented here. Every
// href is the nested one, never the flat menu guess.
const clusterServices = otherApplianceServices(OWN_HREF);

const crossSellItems = [
  ...clusterServices.map((service) => ({
    icon: 'spray-bottle' as const,
    title: service.label,
    description: service.blurb,
    href: service.href,
  })),
  ...outsideServices.map(({ icon, label, description, href }) => ({
    icon,
    title: label,
    description,
    href,
  })),
];

// In `brandedFaqItems`, on "Will the kitchen smell of chemicals afterwards?":
// ⚠️ Deliberately does not characterise the products. See header.
// In `brandedFaqItems`, on "Do you clean pyrolytic and self-cleaning ovens?":
// ⚠️ LAUNCH BLOCKER. Confirm this is TLB's policy. See file header.

// §12 Non-branded FAQs.
//
// ⚠️ VERIFICATION PASS. Checkable claims here:
//   - Pyrolytic ovens run a high temperature cycle, roughly 400-500°C,
//     reducing residue to ash. Correct; the temperature is given as "around
//     500 degrees" rather than an exact figure because it varies by model.
//   - Caustic oven cleaners can damage pyrolytic enamel, and manufacturers
//     specify the pyrolytic cycle instead. Correct and the standard trade
//     position.
//   - "Self clean" on non-pyrolytic ovens is usually a steam assist.
//     Correct for most of the Australian market.
//   - The film between oven door panes needs the door separated. Correct.
//   - ⚠️ SAFETY. The last answer warns against mixing cleaning products and
//     gives no method or product advice, following BFD 5.3 and the same
//     approach house-cleaning/mould-removal.astro takes. Do not turn it into
//     a how-to.
//
// In `nonBrandedFaqItems`, on "How much does oven cleaning cost?":
// ⚠️ BRACKETED ON PURPOSE, same as every sibling.

// CONTENT lives in src/content/pages/house-cleaning/oven-cleaning.yaml and is
// edited in Pages CMS ("Oven cleaning"). This file owns the layout. The notes
// above explain why each section says what it says; they stay here because
// Pages CMS rewrites the YAML on save and would drop them.
const page = await getPage(
  'house-cleaning/oven-cleaning',
  z.object({
    seo: section.seo,
    // The text of the page's one primary button. It always links to the
    // site-wide quote page, so only the words are editable.
    buttonLabel: section.text,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    // The third card is the shared "Who is in my home" card, added in code.
    // A card whose button is left empty gets the page's primary button.
    pathways: section.pathwayCards.extend({
      cards: z.array(section.pathwayCards.shape.cards.element.extend({ cta: section.optional(section.link) })).min(1),
    }),
    method: section.iconGrid,
    beforeAfter: section.beforeAfter,
    selfClean: section.textBlock,
    // The rows are the shared appliance and outside-your-home cross-links.
    otherServices: section.sectionIntro,
    // The columns and rows are the shared comparison table (Site settings).
    comparison: section.comparisonTable.omit({ columns: true, rows: true }),
    reviews: section.sectionHeading,
    whereWeClean: section.tagCloud,
    bookingFaq: section.faq,
    generalFaq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/house-cleaning/oven-cleaning/',
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW and Southern Gold Coast QLD',
  sameAs: googleBusinessProfileUrl ? [googleBusinessProfileUrl] : [],
});

const pageCta = { label: page.buttonLabel, href: quoteCta.href };

const heroImage = page.hero.image && sized(page.hero.image, '1/1');

const pathwayCards = [
  ...page.pathways.cards.map((card, i) => ({
    number: i + 1,
    ...card,
    image: sized(card.image, '4/3'),
    cta: card.cta ?? pageCta,
  })),
  whoIsInYourHomeCard(cardTeamImg),
];

---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? pageCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <PathwayCards heading={page.pathways.heading} headingAccent={page.pathways.headingAccent} cards={pathwayCards} />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.method.heading}
      lead={page.method.lead}
      items={page.method.items}
      cta={page.method.cta ?? pageCta}
    />

    {/* Real TLB job photography — see the file header. The heading and lead
        describe the COOKTOP because that is what the frames show; if an
        oven-interior pair is ever added, they have to change again. */}
    <BeforeAfter
      heading={page.beforeAfter.heading}
      lead={page.beforeAfter.lead}
      pairs={page.beforeAfter.pairs}
      note={page.beforeAfter.note}
      beforeLabel={page.beforeAfter.beforeLabel}
      afterLabel={page.beforeAfter.afterLabel}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.selfClean.heading}
      body={page.selfClean.body}
      cta={page.selfClean.cta}
      backgroundImage={page.selfClean.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.otherServices.heading}
      lead={page.otherServices.lead}
      items={crossSellItems}
    />

    <ComparisonTable
      heading={page.comparison.heading}
      cornerLabel={page.comparison.cornerLabel}
      lead={page.comparison.lead}
      columns={comparisonColumns}
      rows={comparisonRows}
      footnote={page.comparison.footnote}
      cta={page.comparison.cta}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={theLineHeading.fast}
      body={[managedForYou.oneOff, ...theLineBody.residential, ...howItWorks.general]}
    />

    {/* Both FAQ headings renamed. The first five questions are all about
        booking, timing and what happens on the day, and this brings the page
        into line with the carpet page's "Booking a carpet clean". The second
        describes its block more accurately, since barbecues come up in it, and
        picks up `oven and bbq cleaning` (100/mo) as an exact phrase. The
        mapped primary is deliberately kept out of both: three exact instances
        is the ceiling and the H1, subheading and process H2 have spent them. */}
    <Faq heading={page.bookingFaq.heading} lead={page.bookingFaq.lead} items={page.bookingFaq.items} />
    <Faq heading={page.generalFaq.heading} lead={page.generalFaq.lead} items={page.generalFaq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? pageCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
