//
// Shoot each pair from ONE fixed position or the pair does not read.
const beforeAfterPairs: BeforeAfterPair[] = [
  {
    before: {
      src: cooktopBeforeImg,
      alt: 'A gas cooktop before a TLB bond clean, with spilled coffee grounds, crumbs and food scraps across the black enamel',
    },
