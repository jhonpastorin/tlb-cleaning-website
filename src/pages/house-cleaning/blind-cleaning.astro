---
// Blinds, shutters and ceiling fans — the last of the six "Appliances" leaf
// pages under the Home Cleaning mega-menu. See carpet-and-rug-cleaning.astro
// for the shared reasoning behind this group, and
// src/data/appliance-services.ts for the cluster links.
//
// NO CONTENT BRIEF EXISTS. All copy is DRAFTED from the brand foundation
// document. Facts only TLB holds ship as visible [brackets].
//
// WHAT THIS PAGE IS ACTUALLY SELLING. Nobody wakes up wanting their blinds
// cleaned. This is the least urgent service in the group and the copy accepts
// that rather than manufacturing urgency: it sells the job as the one a
// regular clean never has time for, best done as an add-on. The strongest
// honest hooks are the ones the page uses — a ceiling fan turned on after
// months off, and the fact that this is above eye level so it is invisible
// until sunlight hits it.
//
// ⚠️ NO HEALTH CLAIM. Dust is the other obvious angle and it leads straight
// to allergens and air quality, which is exactly where this site does not go.
// Same rule as the mattress and mould pages, same reason (BFD 5.3). Say the
// blinds are dusty and leave it there.
//
// BLOCKS LAUNCH:
//   - ULTRASONIC vs IN SITU. Venetian and fabric blinds are cleaned either in
//     place, or taken down and put through an ultrasonic bath off site. They
//     are completely different services: different price, and one of them
//     means the customer has bare windows for a day or two. Confirm which TLB
//     does. §4 currently describes in-situ cleaning, which is the more common
//     answer for a domestic cleaner, and branded FAQ 4 hedges the other.
//   - HEIGHT AND SAFETY. Ceiling fans and tall windows mean working at
//     height off a ladder. Confirm TLB's own limit — how high the team will
//     go, and where a two-storey void or a raked ceiling becomes a job they
//     decline. The page currently says there is a limit without naming it.
//   - ROLLER AND FABRIC BLINDS. Confirm whether TLB cleans fabric and roller
//     blinds at all, or only hard surfaces (venetians, shutters, verticals).
//     Water marks fabric blinds permanently and plenty of cleaners decline.
//   - Pricing basis bracketed.
//
// PHOTOGRAPHY: hero is a family B cut-out keyed against green (white blind
// slats cannot be keyed off white). See
// src/assets/home_cleaning/appliances/IMAGE-PROMPTS.md.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import PathwayCards from '../../components/sections/PathwayCards.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import Callout from '../../components/sections/Callout.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
// Pathway cards 2 and 3 (6 Oct 2026). Card 2 is the hero's image as a 4:3
// copy, with the same retouch. Card 3 is the Airbnb page's real bed photo,
// copied here under a blind-page name.
import cardTeamImg from '../../assets/airbnb/airbnb-turnover-cleaner-making-up-a-bed.jpg';
import { whoIsInYourHomeCard } from '../../data/whoIsInYourHome';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { comparisonColumns, comparisonRows } from '../../data/comparison';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherApplianceServices } from '../../data/appliance-services';
import { outsideServices } from '../../data/outsideYourHome';
import { howItWorks, managedForYou, theLineBody } from '../../data/brand-lines';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const OWN_HREF = '/house-cleaning/blind-cleaning/';

// §0 Metadata. Title and description are the client-supplied text, verbatim.
//
// 🔴 BLOCKS LAUNCH. Both now name CURTAINS, which this page never offered
// before. The only curtain copy is the non-branded FAQ added alongside this
// change, and its TLB-specific sentence is bracketed. Confirm TLB cleans
// curtains, and whether in place or off site, before this ships.

// §1 Hero. The H1 carries the primary `blind cleaning` as an exact
// contiguous phrase, extended with the region, the same shape as the sibling
// pages. No subheading: the lead is the hero's one paragraph, repeating the
// primary and carrying the old heading's hook.
//
// In `hero`, on "A cleaner wiping the slats of a white venetian blind with a microfibre cloth":
// Client-supplied image since 6 Oct 2026, replacing the transparent
// cut-out (which ran with `contain-bottom`). Default `cover` fit now. The
// supplied image is AI-edited (the spray bottle's label rendered as
// garbled text), so it is not described as an unedited photo anywhere;
// the label is softened and phone-style grain added so it reads less
// generated. The file is a 0.9:1 crop, cloth to bottle, so the roughly
// square desktop panel shows its full width. `ratio` is the mobile
// fallback.

// In `methodItems`, on the description of "Fabric handled dry, or not at all":
// ⚠️ LAUNCH BLOCKER. Confirm whether TLB cleans fabric blinds.
// In `methodItems`, on the description of "Only as high as is safe":
// ⚠️ LAUNCH BLOCKER. Confirm the actual limit. See the file header.

// The one genuinely useful warning on the page, and it is a real one: the
// ultrasonic question decides whether the customer loses their windows for a
// day. Callout rather than TextBlock because it is a short aside.

const clusterServices = otherApplianceServices(OWN_HREF);
const windowCleaning = outsideServices.find((service) => service.href === '/house-cleaning/window-cleaning/')!;

// In `brandedFaqItems`, on the answer to "What about high windows and raked ceilings?":
// ⚠️ Depends on the height launch blocker in the file header.
// In `brandedFaqItems`, on the answer to "Can you clean our fabric roller blinds?":
// ⚠️ Depends on the fabric launch blocker in the file header.

// §12 Non-branded FAQs.
//
// ⚠️ NO HEALTH CLAIM ANYWHERE IN THIS BLOCK. Dust is the obvious hook and it
// leads directly to allergens and air quality, which this site stays out of
// (BFD 5.3, and the precedent set by the mould and mattress pages). The
// answers below talk about light, appearance and damage instead. Do not add
// an allergy angle, however well it would convert.
//
// Checkable claims:
//   - Water marks fabric blinds. Correct and the single most useful warning.
//   - Bending a venetian slat prevents it closing flat. Correct.
//   - Unbalanced fan blades cause wobble; balancing kits exist. Correct, and
//     the answer sends that to an electrician rather than offering to fix it.
//
// In `nonBrandedFaqItems`, on the answer to "How much does blind and fan cleaning cost?":
// ⚠️ BRACKETED ON PURPOSE, same as every sibling.
// In `nonBrandedFaqItems`, on "Can curtains be cleaned without taking them down?":
// Added so the `curtain cleaning` FAQ heading is backed by content. The
// general advice is standard; the last sentence is TLB's and bracketed.
// See the metadata launch blocker.


// The page's own "Get an instant quote" button, written out here rather than
// using the shared `quoteCta` so its label stays the same if the site-wide
// button's wording changes. It goes to the same place.
const instantQuoteCta = { label: 'Get an instant quote', href: quoteCta.href };

// CONTENT lives in src/content/pages/house-cleaning/blind-cleaning.yaml and is
// edited in Pages CMS ("Blind cleaning", under House cleaning). This file owns
// the layout. The notes above explain why each section says what it says;
// they stay here because Pages CMS rewrites the YAML on save and would drop
// them.
const page = await getPage(
  'house-cleaning/blind-cleaning',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    // The page's own cards. The "who is in my home" card after them is
    // shared, from Site settings.
    pathways: section.pathwayCards,
    method: section.iconGrid,
    scope: section.callout,
    worthKnowing: section.textBlock,
    // Heading and lead only: the rows are window cleaning plus the other
    // appliance pages, from the shared cross-link lists.
    sameVisit: section.sectionIntro,
    // The table's columns and rows are the shared comparison table.
    comparison: section.comparisonTable.omit({ columns: true, rows: true }),
    reviews: section.sectionHeading,
    whereWeClean: section.tagCloud,
    // Heading only: the paragraphs under it all come from Brand lines.
    brandLine: section.sectionHeading,
    faq: section.faq,
    nonBrandedFaq: section.faq,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/house-cleaning/blind-cleaning/',
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW and Southern Gold Coast QLD',
  sameAs: googleBusinessProfileUrl ? [googleBusinessProfileUrl] : [],
});

const heroImage = page.hero.image && sized(page.hero.image, '1/1');

const ownCards = page.pathways.cards.map((card, i) => ({
  number: i + 1,
  ...card,
  image: sized(card.image, '4/3'),
}));
const pathwayCards = [
  ...ownCards,
  {
    ...whoIsInYourHomeCard(cardTeamImg, 'A local TLB cleaner tucking in the bedspread on a made bed'),
    number: ownCards.length + 1,
  },
];
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? instantQuoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <PathwayCards heading={page.pathways.heading} headingAccent={page.pathways.headingAccent} cards={pathwayCards} />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.method.heading}
      lead={page.method.lead}
      note={page.method.note}
      items={page.method.items}
      cta={instantQuoteCta}
    />

    <Callout tone="note" heading={page.scope.heading} body={page.scope.body} cta={page.scope.cta} />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.worthKnowing.heading}
      body={page.worthKnowing.body}
      cta={page.worthKnowing.cta}
      backgroundImage={page.worthKnowing.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.sameVisit.heading}
      lead={page.sameVisit.lead}
      items={[
        // Window cleaning leads the list to back the heading. It is not in
        // the appliance cluster, so it is added here rather than in
        // appliance-services.ts. Label, href and blurb from outsideYourHome.ts.
        {
          icon: 'spray-bottle' as const,
          title: windowCleaning.label,
          description: windowCleaning.description,
          href: windowCleaning.href,
        },
        ...clusterServices.map((service) => ({
          icon: 'spray-bottle' as const,
          title: service.label,
          description: service.blurb,
          href: service.href,
        })),
      ]}
    />

    <ComparisonTable
      heading={page.comparison.heading}
      cornerLabel={page.comparison.cornerLabel}
      lead={page.comparison.lead}
      columns={comparisonColumns}
      rows={comparisonRows}
      footnote={page.comparison.footnote}
      cta={page.comparison.cta}
    />

    <GoogleReviewSlider heading={page.reviews.heading} reviews={googleReviews} profileUrl={googleBusinessProfileUrl} />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={page.brandLine.heading}
      body={[managedForYou.oneOff, ...theLineBody.residential, ...howItWorks.general]}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />
    <Faq heading={page.nonBrandedFaq.heading} lead={page.nonBrandedFaq.lead} items={page.nonBrandedFaq.items} />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? instantQuoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
