// route-to-a-related-service row: icon, title, description and a real href
// per row. See the block above `commercialRows` for why this section is a
// list of linked rows rather than a TextBlock of running prose.
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
// Before/after slider (§ credibility signals). The four images are
// AI-GENERATED illustrations, not photographs of TLB jobs: each "after" is a
// Gemini edit of its "before", so the two frames share one camera position.
// Prompts in src/assets/home_cleaning/inside_your_home/mould_cleaning_and_removal/BEFORE-AFTER-PROMPTS.md.
// Replace them with real paired photography and drop the section's `note`;
// the shooting and consent brief is in the block above `beforeAfterPairs`.
import BeforeAfter from '../../components/sections/BeforeAfter.astro';
import GoogleReviewSlider from '../../components/sections/GoogleReviewSlider.astro';
import { googleBusinessProfileUrl, googleReviews } from '../../data/googleReviews';
