    answer:
      'It depends on how much there is, what it is growing on and how much of it can actually be cleaned, which is why we quote rather than publish a rate. A photo with your enquiry gets you an accurate price much faster, and it lets us tell you early if this is a job for a trade instead.',
    // ⚠️ THE LAST UNANSWERED QUESTION ON THE PAGE, and it stays that way
    // until Teagan supplies a price band for a typical bathroom mould clean.
    // The answer above is honest and it is not an answer. One sentence with a
    // real number finishes it, and nobody but her can supply that number —
    // the same call deep-cleaning.astro's gated pricing section makes, and
    // for the same reason: an estimated price is read as a price.
  },
];

// Section 16. Closing block. Drafted. Repeats the page's position rather
// than a promise, which is the only close consistent with everything above.
// Heading and lead unchanged 15 Sep 2026 — the button label is the only edit
// here, and it is the fourth and last instance of it. See `pageQuoteCta`.
const closingCta = {
  heading: 'Tell us what you are looking at.',
  lead: 'Send a photo with your enquiry and you will get an honest answer, including if the answer is that you need a trade rather than a cleaner.',
  cta: pageQuoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    {/* Cut-out figure on transparency, so the section colour shows through.
        The subject is framed waist-up and cropped by the bottom edge, which
        contain-bottom then anchors. Two framing mistakes were made here
        before this one worked, both worth not repeating: a full standing
        figure is too thin for the panel, and empty canvas around the subject
        shrinks it under a contain fit. Crop to the subject. */}
    <Hero
      variant="split-single-image"
      imagePosition="right"
      imageFit="contain-bottom"
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar + definition block share ONE photo behind a Cream scrim, so
        it is laid out across both. 75% keeps Dark Teal body copy above 4.5:1
        over the darkest part of the frame. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75} focus="top">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards
      heading={pathwayCards.heading}
      headingAccent={pathwayCards.headingAccent}
      cards={pathwayCards.cards}
    />

    <ContentGrid
      columns={2}
      heading="Where it turns up, and what we do about it"
      lead="Mould grows in the same handful of places in house after house on this coast."
      blocks={surfaceBlocks}
    />

    <Callout tone="note" body={scopeCallout.body} />

    <ContentGrid
      columns={3}
      heading="Why it happens here"
      lead="This is a mould climate. It is not a reflection on how you keep your house."
      blocks={climateBlocks}
    />

    {/* `warning` is the charcoal panel SECTIONS.md reserves for "don't do
        this". Strictly two things, no method. Do not expand into a how-to. */}
    <Callout tone="warning" heading={safetyCallout.heading} body={safetyCallout.body} />

    {/* Wrapper carries the #moisture anchor PathwayCards card 3 links to.
        TextBlock takes no id prop, and adding one just for an anchor target
        isn't worth a shared-component change. Same pattern the sibling pages
        use for #compare. */}
    <div id="moisture">
      <TextBlock
        theme="light"
        align="left"
        heading="Cleaning takes it off. Moisture is what brings it back."
        body={moistureBody}
      />
    </div>

    {/* ⚠️ OUTSTANDING, 15 Sep 2026: the "Deep clean" column header should
        link to /house-cleaning/deep-cleaning/. ComparisonTable's `columns` take a `label`
        and a `highlight` and no `href`, so this needs the component to gain
        one — it is a shared change across every page using the table, not a
        copy change, and it was not worth making unilaterally from here. The
        table content itself is unchanged and stays that way: it is the best
        routing module on the page. */}
    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
      footnote={comparisonTable.footnote}
    />

    {/* §9b, new 15 Sep 2026. Sits HERE, after the comparison table and
        before the health question, on purpose: the reader has just been
        shown which of the three jobs theirs is, and a property manager or a
        venue owner reading that table is exactly who the next section is
        for. Putting it any later buries the only block on the page that
        serves `commercial mould cleaning` at all. See the block above
        `commercialRows` for what the list shape cost. */}
    <ServiceBlocks
      variant="list"
      heading="Mould cleaning services for agencies, holiday lets and commercial premises"
      lead="Most of this page is written for somebody looking at their own bathroom ceiling. The work is the same when it is not your house, but the pressure around it is different. One provider, one point of contact, and the same people who already know the building."
      items={commercialRows}
    />

    <TextBlock
      theme="muted"
      align="left"
      heading="On the health question"
      body={healthBody}
    />

    {/* Drag the handle to wipe between the two frames of each pair — see
        the block above `beforeAfterPairs` for why this is a slider and not
        a gallery, and for the fact that these four images are SAMPLES. The
        `note` is what tells the reader that; delete it with the imports. */}
    <BeforeAfter
      heading="The difference, on real jobs."
      lead="Drag the handle across each photo to see the same spot before and after a mould clean."
      pairs={beforeAfterPairs}
      note="Illustrative samples, shown while we collect before and after photos from real TLB cleans."
    />

    <TextBlock
      theme="dark"
      align="left"
      heading="Send us a photo and we will tell you straight"
      body={bookingBody}
      cta={pageQuoteCta}
    />

    {/* ⚠️ TESTIMONIALS HIDDEN 15 Sep 2026, not deleted.
        <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

        Both cards are bracketed [TBC] briefing notes addressed to Teagan by
        name, and they were rendering on a live page where anyone could read
        them. That is a credibility failure at the exact point the page asks
        to be believed, and BFD §12.2 rules out writing substitutes, so
        hiding is the only move left. An absent testimonial block is neutral;
        a visible instruction to the founder is not.

        The `testimonials` array above is kept deliberately: the two quotes
        it describes are the right two to chase, and the second one — a
        client thanking TLB for turning work away — would prove the promise
        the whole page is making better than anything else could. Delete this
        wrapper and restore the line above the moment two real quotes with
        written consent exist. Blocked on the client. */}

    {/* ✅ RESOLVED 18 Sep 2026. The copy review of this page read the town
        list as all three groups present and complete per BFD §2.1, and
        reported no regression. For three days that was wrong — locations.ts
        ran a curated list that rendered two groups while this page's hero,
        lead and definition paragraph all named the Tweed. The client's call to
        name every mega-menu town and link only the live pages restored the
        third group, so the review's reading is accurate again.

        Kept as a note rather than deleted because the fix was a site-wide data
        change in locations.ts, not a change here: this page never diverged on
        its own, and the next review should not read the history as a new
        finding. */}
    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    {/* §1.3 The Line as a section heading, with §1.4 as its standfirst.
        The copy, and the reason this page gets `fast` rather than the other
        variant, both live in data/brand-lines.ts. Change it there, not here.

        `muted`, not `dark`: TagCloud above paints --color-brand and Faq below
        paints --color-surface, so Cream between them keeps the page
        alternating instead of stacking two dark bands.

        No CTA prop. §9.5 wants one primary CTA per page, repeated, and the
        closing CallToAction is directly under the FAQs. */}
    <TextBlock
      theme="muted"
      align="left"
      heading={theLineHeading.fast}
      body={[managedForYou.oneOff, ...theLineBody.condition]}
    />

    <Faq heading="Frequently asked questions" items={faqItems} />

    <CallToAction variant="secondary" heading={closingCta.heading} lead={closingCta.lead} cta={closingCta.cta} />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
