import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
// Section 1 hero. Cut-out figure on transparency (IMAGE-GUIDELINES.md family
// B), a 1080x1080 PNG with an alpha channel, so ratio 1/1 and contain-bottom.
// Square rather than the family's usual 16/9 for the reason set out on the
// slot below. The figure faces left, into the copy, because the image sits on
// the right.
// Section 3 pathway cards. Card 1 is the only image on this page that shows
