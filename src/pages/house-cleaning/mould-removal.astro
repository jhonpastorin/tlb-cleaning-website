// "fix" it back without asking.
//
// The lead's second sentence was "We remove what is there, and we tell you
// honestly what is feeding it." It now opens on `mould removal` and says
// "on the surfaces you can see", which lands the second term in the
// subheading AND pulls the surface-work-not-remediation boundary forward out
// of the definition paragraph. The honesty beat is unchanged in substance.
// The Line itself is untouched: the standing pricing rule sets "Easy to
// book, fast quoting, cost effective" for every non-regular service page and
// this page already carried it, so the review's proposal to change "fast
// quoting" to "fast quote" here does not apply. Only the button changes.
const hero = {
  headingLines: ['Mould cleaning services and mould removal that gets it off'],
  lead: `Our mould cleaning services cover bathrooms, walls, ceilings and wardrobes right across the Northern Rivers, the Tweed and the Southern Gold Coast. Mould removal on the surfaces you can see, and an honest answer about what is feeding it. ${theLine.fast}`,
  cta: heroQuoteCta,
  image: {
    // 1/1, not the 16/9 the other heroes use, and deliberately. This panel is
    // a `contain` fit in a near-square column, so any empty canvas around the
    // cut-out is dead space that scales the figure DOWN: at 16/9 the subject
    // was 60% of the canvas width and rendered about two thirds height. A
    // canvas cropped to the subject lets contain scale it to the full panel.
    ratio: '1/1',
    label: 'TLB cleaner in uniform reaching up with a cloth to wipe along the top of a wall',
    src: heroImg,
  },
