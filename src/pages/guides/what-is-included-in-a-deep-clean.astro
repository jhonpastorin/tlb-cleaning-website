---
// Guide: "What is included in a deep clean?". Sixth of the nine guides; the
// cluster's shared data is in src/data/guides.ts.
//
// ⚠️ THE CONSISTENCY PROBLEM ON THIS PAGE IS THE SHARPEST OF THE NINE.
// deep-cleaning.astro already answers this exact question in its §5, from a
// SUPPLIED brief with approved copy — the only inclusions list on this site
// that is not drafted. So this guide must not restate it in different words,
// or the site publishes two scopes of work for one service and the drafted
// one silently competes with the approved one.
//
// The resolution: this page answers the question the SERVICE page cannot,
// which is the comparative one. A reader searching "what is included in a
// deep clean" is almost never asking for a task list in the abstract. They
// are asking one of three things:
//   1. Is this different from what my regular cleaner already does? → §4.
//   2. Is this the same as a bond clean? → §5's table.
//   3. Will it fix the specific thing that is bothering me? → §6.
// So the page is built around the LINE BETWEEN the three cleans, drawn task
// by task, and it hands the actual scope of works to the service page rather
// than reprinting it.
//
// ⚠️ WHERE THE TASK LISTS DO APPEAR (§4's three columns), EVERY LINE IS
// TAKEN FROM THE APPROVED deep-cleaning.astro §5 COPY OR FROM
// end-of-lease-cleaning.astro §4, not newly written. If either of those
// changes, this page changes with it. The regular-clean column is the one
// exception and it is DRAFTED, because no regular-clean scope of works
// exists anywhere in this repo — house-cleaning.astro describes the service
// without publishing a task list. That column is flagged at its definition.
//
// ⚠️ The exclusions in §7 are deep-cleaning.astro's own §5b exclusions,
// which are themselves marked [CONFIRM] on that page. They inherit the same
// flag here. One answer fixes both pages.
//
// PHOTOGRAPHY: reused. IMAGE-GUIDELINES.md §5 — the "comparing clean types
// with a checklist" frame already means exactly this on the end-of-lease
// page's third pathway card, which is the same idea this whole guide is.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides } from '../../data/guides';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized, highlightColumn } from '../../lib/cms-schemas';

const selfHref = '/guides/what-is-included-in-a-deep-clean/' as const;

// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// §1 Hero. The heading is the definition compressed to one idea: a deep
// clean is about the things that never get touched, not about doing the
// normal things harder. That distinction is what the whole page rests on.

// §2 The answer block. Definition first, then the sentence that does the
// actual work — the distinction is horizontal versus vertical, or rather
// surfaces you use versus surfaces you do not.

// §3 What makes it a deep clean. ContentGrid text cells, six, three rows.
//
// These are CATEGORIES of work rather than a task list, which is how this
// page stays out of the service page's territory. The service page publishes
// the scope; this page explains the logic behind it, which is genuinely
// different content and is the thing a reader can use to judge somebody
// else's quote too.

// §4 The three-way comparison. THE section of the page.
//
// ⚠️ PROVENANCE OF EACH COLUMN, and this matters more here than anywhere
// else on the page:
//   - The DEEP CLEAN column is deep-cleaning.astro §5's approved brief copy,
//     compressed. Approved content.
//   - The BOND CLEAN column is end-of-lease-cleaning.astro §4 and §4b, which
//     are themselves marked [CONFIRM] on that page.
//   - The REGULAR CLEAN column is DRAFTED. No regular-clean scope of works
//     exists anywhere in this repo. house-cleaning.astro sells the service
//     without publishing a task list, so this column is what a weekly or
//     fortnightly visit conventionally covers, not what TLB's covers.
//     ⚠️ CONFIRM IT WITH TEAGAN, and consider publishing a real regular-clean
//     task list on house-cleaning.astro — the absence of one is the reason
//     this column had to be invented.
//
// The deep clean column is highlighted because this is the deep clean guide
// and the highlight marks the subject, which is also the "this is us"
// convention the component states. index.astro, deep-cleaning.astro and
// end-of-lease-cleaning.astro each highlight their own service in their own
// version of this table, so the pattern is already established.

// §5 The ordering advice. `note` tone.
//
// This is deep-cleaning.astro's own footnote argument expanded into its own
// section, because it is the most actionable thing on the page and it is
// worth money to the reader.

// §6 Will it fix my actual problem. ServiceBlocks icon-grid, six items.
//
// This is the section that answers the real question behind the query, and
// three of the six answers are "no, and here is what will", which is the
// same honesty the roof and carpet pages use. A page that says a deep clean
// fixes everything is a page nobody believes.

// §7 The exclusions. Warning tone, used once.
//
// ⚠️ INHERITED [CONFIRM]. These are deep-cleaning.astro §5b's own exclusion
// groups, which carry a [CONFIRM] on that page. Same answer fixes both.

// §8 When to book one. Dark TextBlock with a list.
//
// The six occasions are deep-cleaning.astro §6's own list, reused
// deliberately rather than reinvented, so the guide and the service page
// agree on when this service is for.

// §9 Next reads.
const nextGuides = otherGuides(selfHref, [
  '/guides/how-much-does-house-cleaning-cost/',
  '/guides/the-end-of-lease-cleaning-checklist/',
  '/guides/steam-dry-or-shampoo-which-carpet-cleaning-method/',
]);

// §10 The pill band.

// §11 FAQs.

// §12 Closing CTA.

// CONTENT lives in src/content/pages/guides/what-is-included-in-a-deep-clean.yaml
// and is edited in Pages CMS ("Guides > What is in a deep clean"). This file
// owns the layout. The notes above explain why each section says what it
// says, including where each table column comes from; they stay here because
// Pages CMS rewrites the YAML on save and would drop them. The editor carries
// the short version of each warning as a field description.
const page = await getPage(
  'guides/what-is-included-in-a-deep-clean',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    // ContentGrid text cells only.
    categories: section.textGrid,
    cleanTable: section.comparisonTable,
    order: section.callout,
    // The button under the grid is the site-wide quote button, set in code.
    willItFix: section.iconGrid,
    exclusions: section.callout,
    when: section.textBlock,
    // The three guides listed come from site data (nextGuides above).
    readNext: section.sectionIntro,
    faq: section.faq,
    // `tags` holds only this page's own extra links. relatedGuides() adds the
    // other guides before them and the hub link after them.
    moreGuides: section.tagCloud,
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: `https://tlbcleaning.com.au${selfHref}`,
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const categoryBlocks = page.categories.items.map((item) => ({ type: 'text' as const, ...item }));

// "Deep clean" (the middle column) is the highlighted one.
const cleanColumns = highlightColumn(page.cleanTable.columns, 1);

const moreGuideTags = relatedGuides(selfHref, page.moreGuides.tags ?? []);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <ContentGrid
      heading={page.categories.heading}
      lead={page.categories.lead}
      columns={2}
      blocks={categoryBlocks}
    />

    <ComparisonTable
      heading={page.cleanTable.heading}
      cornerLabel={page.cleanTable.cornerLabel}
      lead={page.cleanTable.lead}
      columns={cleanColumns}
      rows={page.cleanTable.rows}
      footnote={page.cleanTable.footnote}
      cta={page.cleanTable.cta}
    />

    <Callout tone="note" heading={page.order.heading} body={page.order.body} cta={page.order.cta} />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.willItFix.heading}
      lead={page.willItFix.lead}
      items={page.willItFix.items}
      cta={page.willItFix.cta ?? quoteCta}
    />

    <Callout
      tone="warning"
      heading={page.exclusions.heading}
      body={page.exclusions.body}
      cta={page.exclusions.cta}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.when.heading}
      body={page.when.body}
      cta={page.when.cta}
      backgroundImage={page.when.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.readNext.heading}
      lead={page.readNext.lead}
      items={nextGuides}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <TagCloud
      heading={page.moreGuides.heading}
      subheading={page.moreGuides.subheading}
      tags={moreGuideTags}
      note={page.moreGuides.note}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
