---
// Guide: "What the law actually says: end of lease cleaning in NSW and QLD",
// shipping at the long slug navigation.ts' Guides mega-menu already commits
// to. First of the nine guides; the cluster's shared data is in
// src/data/guides.ts.
//
// WHY THIS PAGE EXISTS. end-of-lease-cleaning.astro §5 carries an explicit
// note asking for exactly this: "outbound links to NSW Fair Trading and the
// Queensland Residential Tenancies Authority should be added (BFD 3.3 asks
// for authoritative external sources) once there is a guides section to host
// them." This is that host. §7 of this page is those links.
//
// ⚠️⚠️ THIS IS THE HIGHEST-RISK PAGE IN THE REPO AND IT MUST NOT PUBLISH
// WITHOUT REVIEW. It describes how two states' residential tenancy law works.
// Everything below was drafted, not supplied, and the standard applied was:
//
//   * State the STRUCTURE (which Act, which body holds the bond, which
//     tribunal hears a dispute, what the condition report is for). Structure
//     changes rarely and is checkable in a minute.
//   * State the PRINCIPLE ("the same condition, fair wear and tear
//     excepted"). It is the operative phrase in both states and it is the
//     whole point of the page.
//   * State NO timeframes, NO dollar figures, NO entitlements, and NO advice
//     about what a reader should do in their own dispute. Every one of those
//     differs by state, changes without notice, and turns a guide into legal
//     advice TLB is not qualified or insured to give.
//
// Three specific claims need checking against the current instruments before
// launch, each marked ⚠️ VERIFY at its definition:
//   1. The NSW carpet-cleaning / fumigation term and its animal condition.
//   2. The NSW and QLD condition-report forms and who completes them.
//   3. The QLD dispute path running through the RTA before QCAT.
// A tenancy lawyer or an experienced local property manager can clear all
// three in one read. Do that read.
//
// ⚠️ NOT LEGAL ADVICE, and the page says so to the reader in §3, not just
// here in a comment. BFD 5.3 forbids guaranteeing outcomes TLB cannot
// control; the same logic applies to telling someone what the law entitles
// them to. The page explains the framework and then points at the two
// regulators.
//
// THE THESIS, and it is the reason the guide is worth publishing: the
// standard in both states is the CONDITION the property is left in, measured
// against the condition report, not a receipt from a professional cleaner.
// That single sentence is what most tenants in this region do not know, it is
// what makes the page linkable, and it is also — awkwardly and honestly — an
// argument that a tenant does not strictly have to hire TLB. The page makes
// it anyway. BFD 3.1's voice is "straight with you", and a guide that shades
// the law toward the seller is worth nothing to a reader and nothing to the
// site's authority.
//
// NO GUARANTEE ANYWHERE. Same rule as end-of-lease-cleaning.astro: nothing on
// this page promises a bond, a pass or a refund.
//
// PHOTOGRAPHY: reused, not generated. IMAGE-GUIDELINES.md §5 — "Reuse before
// generating. Same subject = same file." The handover photo already means
// "the inspection moment" on the end-of-lease page and it means the same here.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides, lastReviewed } from '../../data/guides';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const selfHref = '/guides/what-the-law-actually-says-end-of-lease-cleaning-in-nsw-and-qld/' as const;

// §0 Metadata. The title leads with the question a tenant types, not with
// the Acts. "End of lease cleaning laws NSW" and the QLD equivalent are the
// real queries; the legislation names belong in the body where they can be
// cited rather than in the title where they read as a law-firm page.
//
// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// §1 Hero. The kicker names the section, so a reader arriving from search
// knows this is an article rather than a service page before they read a
// word of it. Every guide in the cluster uses the same two-part kicker.
//
// The heading is the thesis, compressed. It is also the answer to the query.

// §2 The answer block. Definition-style opening sentence, subject-predicate-
// object second sentence, per BFD 3.6.2 — this is the passage most likely to
// be lifted whole into an AI overview, so it has to be correct standing on
// its own with no surrounding page.
//
// ⚠️ The phrase "the same condition, fair wear and tear excepted" is the
// operative standard in both states and is stated deliberately, in quotes, as
// the thing the reader should recognise on their own agreement. VERIFY the
// wording against the current NSW standard form agreement and the current QLD
// general tenancy agreement before launch. The concept is not in doubt; the
// exact words are what a lawyer will check.

// §3 The disclaimer, and it goes high on the page rather than in a footer.
// `note` tone, not `warning`: this is "worth knowing before you read on",
// not "do not do this".
//
// A cleaning company writing about tenancy law has an obvious incentive
// problem, and the honest move is to name it in the second paragraph rather
// than hope nobody notices. That paragraph is doing brand work as well as
// compliance work — BFD 3.1.

// §4 The side-by-side. A real ComparisonTable rather than two text columns,
// because "which body, which form, which tribunal" is genuinely tabular and
// the whole value of the section is that a reader can run their eye down one
// column and across one row. ContentGrid cannot keep a row aligned across two
// entities, which is the exact gap SECTIONS.md says this component was built
// to fill.
//
// Neither column is highlighted. A highlight in this component means "this is
// us"; there is no "us" in a table comparing two states, and tinting one
// state would imply a preference the page does not hold.
//
// ⚠️ VERIFY EVERY CELL. These are structural facts, checkable in minutes on
// each regulator's own site, and they are the cells a reader will trust most
// because they look the most definite:
//   - NSW: Residential Tenancies Act 2010 (NSW); bond held by NSW Fair
//     Trading (Rental Bonds Online); disputes to NCAT.
//   - QLD: Residential Tenancies and Rooming Accommodation Act 2008 (Qld);
//     bond held by the Residential Tenancies Authority; RTA dispute
//     resolution before QCAT.
//   - The condition report form names and numbers, particularly the QLD
//     entry (Form 1a) and exit (Form 14a) reports, which are cited here by
//     number and are the single easiest thing on the page to get wrong.
// No timeframes appear in any cell, on purpose. Do not add any.

// §5 Fair wear and tear. The concept that decides more bond arguments than
// any other and the one nobody explains to a first-time renter.
//
// ContentGrid text cells at two columns rather than a bullet list, because
// each of the four needs a sentence of reasoning after the example — a list
// would flatten "this is not a cleaning failure" into "this is fine", which
// is a different and wrong claim.
//
// ⚠️ These are ILLUSTRATIONS OF A PRINCIPLE, not rulings. Every example is
// deliberately generic and none of them says "you will not be charged for
// this", because whether a specific mark is wear or damage is a question of
// fact that a tribunal decides. Keep it that way.

// §6 The professional-cleaning question. THE section people arrive for, and
// the one with the most misinformation around it in this category.
//
// `warning` tone, used once on the page. It is a "do not just accept this"
// message, which is exactly the tone's stated job in SECTIONS.md.
//
// ⚠️⚠️ VERIFY BEFORE LAUNCH, THIS IS THE CLAIM THAT MATTERS MOST.
// The position stated: in both states the standard is the condition of the
// property, and a general blanket term requiring professional cleaning
// regardless of condition is not automatically enforceable. NSW is the more
// specific of the two — the standard form agreement permits an additional
// term requiring carpet cleaning or fumigation at the end of the tenancy only
// where the tenant was permitted to keep an animal at the property. That
// carve-out is stated below and it is the single most checkable, most
// citable, most wrong-if-wrong sentence on the page. Check it against the
// current Residential Tenancies Regulation and the current standard form
// agreement, not against a blog.
//
// The last paragraph deliberately does NOT tell the reader to refuse. It
// tells them to ask what the agreement says and to talk to the regulator.
// That is the line between explaining and advising, and the page stays on the
// explaining side of it.

// §7 The outbound links this whole guides section was waiting for, per
// end-of-lease-cleaning.astro §5's own note.
//
// ServiceBlocks `list` rather than prose, because none of the prose
// components in this library can render a link inside a paragraph — every
// text prop is escaped (checked, not assumed: TextBlock, Callout, Faq and
// ContentGrid all interpolate their strings rather than using set:html). A
// row list with a real `href` is the honest way to get an outbound link onto
// the page without adding an HTML-injection prop to a shared component.
//
// ⚠️ These two URLs are the front doors of each regulator, chosen over
// deep links on purpose: a deep link into a specific guidance page rots
// within a year and a regulator's home page does not. Confirm both resolve
// before launch, and note neither opens in a new tab — ServiceBlocks' list
// rows render a plain <a>. That is a component change if TLB wants it, not a
// page one.
//
// In `regulatorLinks`, on "Your own tenant advocacy service" (its link):
// ⚠️ Placeholder. NSW runs the Tenants Union / local Tenants Advice and
// Advocacy Services; QLD has Tenants Queensland. Both have stable URLs.
// Left pointing at the NSW regulator rather than guessing a service name
// and a URL for a cross-border readership — CONFIRM the two real
// destinations and split this row in two if TLB wants both named.

// §8 What actually happens to the bond. Process, not entitlement — no
// timeframes, no amounts, no "you are owed".
//
// Dark TextBlock: it is the one genuinely procedural passage on the page and
// the dark band separates it from the argument above it.

// §9 Where this leaves you, practically. The bridge from law to service, and
// it has to be honest about the fact that the law does not require TLB.
//
// Note the last sentence: it sells time and certainty, not compliance,
// because compliance is not what a cleaner sells. BFD 4.5.

// §10 Next reads. Three of the eight, chosen rather than dumped — the two
// end-of-lease siblings a reader of this page genuinely wants next, plus the
// deep-clean explainer for the reader who has worked out this is not the job
// they need.
const nextGuides = otherGuides(selfHref, [
  '/guides/the-end-of-lease-cleaning-checklist/',
  '/guides/how-much-does-end-of-lease-cleaning-cost/',
  '/guides/what-is-included-in-a-deep-clean/',
]);

// §11 The pill band: every other guide, plus the two service pages this one
// leans on. Shared helper, this page's own href filtered out.

// §12 FAQs. Non-branded and answer-targeted — these are the long-tail
// queries the page is built to catch, and each answer stands alone at 40 to
// 80 words per BFD 3.5.
//
// ⚠️ SAME REVIEW APPLIES HERE AS TO THE BODY. Answer 1 is the page's thesis
// restated and carries the same verification burden as §6. Answer 5 states
// that neither state's standard is "spotless", which is a characterisation
// rather than a quotation and is the sentence most likely to need softening
// after review.

// §13 Closing CTA. Points at the service, not at a hard sell, because a
// reader who has just been told they may not need to hire anyone will not
// respond to one.

// CONTENT lives in
// src/content/pages/guides/what-the-law-actually-says-end-of-lease-cleaning-in-nsw-and-qld.yaml
// and is edited in Pages CMS ("Guides > What the law actually says"). This
// file owns the layout. The notes above explain why each section says what it
// says, including every VERIFY item; they stay here because Pages CMS rewrites
// the YAML on save and would drop them. The editor carries the short version
// of each warning as a field description.
//
// No block on this page stays code-only: nothing renders through set:html
// (the only mention of it is the §7 note above, about the components).
const page = await getPage(
  'guides/what-the-law-actually-says-end-of-lease-cleaning-in-nsw-and-qld',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty. Body is the page's own
    // paragraphs only: the "Last reviewed" line after them is shared.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    disclaimer: section.callout,
    stateTable: section.comparisonTable,
    // ContentGrid text cells only.
    wearDamageDirt: section.textGrid,
    professionalCleaning: section.callout,
    // A ServiceBlocks `list` whose rows keep their icons, so each row also
    // has an optional icon.
    regulators: section.linkList.extend({
      items: z
        .array(section.linkList.shape.items.element.extend({ icon: section.optional(section.serviceIcon) }))
        .min(1),
    }),
    bond: section.textBlock,
    practical: section.textBlock,
    // The three guides listed come from site data (nextGuides above).
    readNext: section.sectionIntro,
    faq: section.faq,
    // `tags` holds only this page's own extra links. relatedGuides() adds the
    // other guides before them and the hub link after them.
    moreGuides: section.tagCloud,
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: `https://tlbcleaning.com.au${selfHref}`,
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const wearBlocks = page.wearDamageDirt.items.map((item) => ({ type: 'text' as const, ...item }));

const moreGuideTags = relatedGuides(selfHref, page.moreGuides.tags ?? []);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={[...page.definition.body, lastReviewed]}
        cta={page.definition.cta}
      />
    </Backdrop>

    <Callout
      tone="note"
      heading={page.disclaimer.heading}
      body={page.disclaimer.body}
      cta={page.disclaimer.cta}
    />

    <ComparisonTable
      heading={page.stateTable.heading}
      cornerLabel={page.stateTable.cornerLabel}
      lead={page.stateTable.lead}
      columns={page.stateTable.columns}
      rows={page.stateTable.rows}
      footnote={page.stateTable.footnote}
      cta={page.stateTable.cta}
    />

    <ContentGrid
      heading={page.wearDamageDirt.heading}
      lead={page.wearDamageDirt.lead}
      columns={2}
      blocks={wearBlocks}
    />

    <Callout
      tone="warning"
      heading={page.professionalCleaning.heading}
      body={page.professionalCleaning.body}
      cta={page.professionalCleaning.cta}
    />

    <ServiceBlocks
      variant="list"
      heading={page.regulators.heading}
      lead={page.regulators.lead}
      note={page.regulators.note}
      items={page.regulators.items}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.bond.heading}
      body={page.bond.body}
      cta={page.bond.cta}
      backgroundImage={page.bond.backgroundImage}
    />

    <TextBlock
      theme="light"
      align="left"
      heading={page.practical.heading}
      body={page.practical.body}
      cta={page.practical.cta}
      backgroundImage={page.practical.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.readNext.heading}
      lead={page.readNext.lead}
      items={nextGuides}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <TagCloud
      heading={page.moreGuides.heading}
      subheading={page.moreGuides.subheading}
      tags={moreGuideTags}
      note={page.moreGuides.note}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
