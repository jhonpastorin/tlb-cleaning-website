---
// Guide: "How to choose a commercial cleaner". Ninth and last of the guides;
// the cluster's shared data is in src/data/guides.ts.
//
// THE AUDIENCE IS A BUYER, NOT A HOMEOWNER, and it changes the whole page.
// This reader is a practice manager, a venue owner, a strata committee or a
// facilities coordinator. They are running a procurement, they will be
// answerable to somebody for the decision, and they want a defensible basis
// for it. So:
//   * The CTA is the walkthrough, not the quote form, matching the whole
//     commercial cluster (src/data/premises.ts' walkthroughCtaLabel).
//   * §4 is a specification, not a list of tips — it is written so it can be
//     pasted into a request for quote.
//   * §6 is about contracts and exit terms, which no domestic guide needs
//     and which is the section that will actually get this page shared
//     internally.
//
// ⚠️ THE OBVIOUS TRAP ON THIS PAGE, AND HOW IT IS AVOIDED. A guide called
// "how to choose a commercial cleaner", written by a commercial cleaner, is
// one sentence away from being a checklist of TLB's own features dressed up
// as impartial advice. Two rules were applied throughout:
//   1. Every criterion is one a reader can apply to ANY tenderer, including
//      ones TLB would lose on. §4's "can they cover a sick day" and §6's
//      "what is the exit clause" are both questions a larger contractor
//      answers better than a nine-person local business does, and they are
//      on the page anyway.
//   2. TLB is named once, in §8, after the advice is finished, and the
//      section says plainly which kinds of site the business is not the
//      right answer for. A guide that concludes "and the answer is us" is
//      not a guide.
//
// ⚠️ NOTHING HERE STATES A LEGAL OBLIGATION. Insurance, workers
// compensation, WHS duties and subcontracting arrangements all get
// mentioned as things to ASK ABOUT, never as things the page asserts the
// law requires of anybody. The reader is told to verify with the insurer or
// their own adviser. Same discipline as the tenancy law guide. BFD 5.3.
//
// ⚠️ NO CLAIMS ABOUT COMPETITORS. §5 describes how a low quote is
// constructed, in general terms, and names nobody. It is a description of
// arithmetic, not an accusation.
//
// PHOTOGRAPHY: reused from src/assets/commercial_cleaning/.
// IMAGE-GUIDELINES.md §5.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { nswLocationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides } from '../../data/guides';
import { walkthroughCtaLabel } from '../../data/premises';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const selfHref = '/guides/how-to-choose-a-commercial-cleaner/' as const;

// The commercial cluster's own CTA, not the sitewide quote form. Commercial
// work is priced on a walkthrough — the hub, both commercial services and
// all thirteen premises pages already make this call, and a guide aimed at
// the same buyer should not send them somewhere different.
const walkthroughCta = { label: walkthroughCtaLabel, href: quoteCta.href };

// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// ⚠️ areaServed is NSW-only here, following the call commercial-cleaning.astro
// and premises.ts both made for the commercial cluster, rather than the
// two-state string the other eight guides use. Same open sitewide question:
// if TLB does commercial work across the border, this string, the location
// band below and premises.ts all change together.

// §1 Hero. The heading names the actual failure mode of this purchase, which
// is not that the wrong cleaner is chosen but that nobody wrote down what
// was being bought.

// §2 The answer block. Definition-style, then the sentence that reframes the
// purchase: you are buying a schedule of work performed by people you will
// not meet, at a time you are not there. That framing is what makes the rest
// of the page follow.

// §3 Write the scope first. Dark TextBlock with a list.
//
// This is the single most useful thing on the page and it is the step almost
// nobody takes. It also has a real commercial benefit for whoever runs the
// tender: three quotes against one scope are comparable; three quotes
// against three assumptions are not.

// §4 The questions. ServiceBlocks icon-grid, six.
//
// ⚠️ EVERY ONE OF THESE IS APPLIED TO TLB AS WELL, and two of them are
// questions a larger contractor answers better than a nine-person local
// business does — see the file header. That is the point. If this list only
// selected for TLB it would not be a guide.

// §5 Why a cheap quote is cheap. Warning tone, used once.
//
// ⚠️ ARITHMETIC, NOT ACCUSATION. Nobody is named, no claim is made about any
// competitor's arrangements, and nothing is said about legality. It sets out
// what a rate has to cover and invites the reader to work out which item is
// missing. Same treatment as the house cleaning cost guide's §7, adapted for
// a commercial buyer who can actually do the sum.

// §6 The contract terms that matter. A ComparisonTable — the two columns are
// two kinds of agreement rather than two vendors, so neither is highlighted.
//
// This section is the reason a facilities manager would send this page to a
// colleague, and it is genuinely the part of the purchase that is least
// discussed in this category.

// §7 Sector-specific requirements. ContentGrid text cells, four, two rows.
//
// ⚠️ NONE OF THESE STATE A LEGAL REQUIREMENT. Each says "your obligations
// are yours to establish" in substance, and the cells describe what to ask a
// cleaner about rather than what any regulation demands. A page that told a
// medical practice what its infection control obligations are would be
// giving advice this business is not qualified to give.

// §8 Where TLB fits, and where it does not. Deliberately last, after the
// advice, and it names the limits first.
//
// ⚠️ THE HONEST LIMITS PARAGRAPH IS NOT DECORATION AND SHOULD NOT BE CUT IN
// REVIEW. A nine-person local business genuinely cannot service a
// multi-site national contract or a 24-hour industrial roster, and saying so
// costs nothing (those buyers were never going to sign) while making
// everything else on the page credible.

// §9 Next reads. Only two of the eight are genuinely relevant to a
// commercial buyer, so only two are shown — a padded list would be filler.
const nextGuides = otherGuides(selfHref, [
  '/guides/steam-dry-or-shampoo-which-carpet-cleaning-method/',
  '/guides/what-is-included-in-a-deep-clean/',
]);

// §10 The pill band.

// §11 FAQs.

// §12 Closing CTA. The walkthrough, matching the whole commercial cluster.

// CONTENT lives in src/content/pages/guides/how-to-choose-a-commercial-cleaner.yaml
// and is edited in Pages CMS ("Guides > Choosing a commercial cleaner"). This
// file owns the layout. The notes above explain why each section says what it
// says; they stay here because Pages CMS rewrites the YAML on save and would
// drop them. The editor carries the short version of each warning as a field
// description. Buttons left empty in the CMS fall back to walkthroughCta, not
// the sitewide quote button, for the reason given where it is defined.
const page = await getPage(
  'guides/how-to-choose-a-commercial-cleaner',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    scope: section.textBlock,
    // The button under the grid is walkthroughCta, set in code.
    questions: section.iconGrid,
    cheapQuote: section.callout,
    termsTable: section.comparisonTable,
    // ContentGrid text cells only.
    sectors: section.textGrid,
    whereWeFit: section.textBlock,
    // The two guides listed come from site data (nextGuides above).
    readNext: section.sectionIntro,
    faq: section.faq,
    // `tags` holds only this page's own extra links. relatedGuides() adds the
    // other guides before them and the hub link after them.
    moreGuides: section.tagCloud,
    // The towns are the NSW-only groups (nswLocationGroups), set in code.
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: `https://tlbcleaning.com.au${selfHref}`,
};

const business = localBusiness({
  description: pageMeta.description,
  // NSW-only: see the areaServed note above.
  areaServed: 'Northern Rivers and Tweed, NSW',
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const sectorBlocks = page.sectors.items.map((item) => ({ type: 'text' as const, ...item }));

const moreGuideTags = relatedGuides(selfHref, page.moreGuides.tags ?? []);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? walkthroughCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <TextBlock
      theme="dark"
      align="left"
      heading={page.scope.heading}
      body={page.scope.body}
      cta={page.scope.cta}
      backgroundImage={page.scope.backgroundImage}
    />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.questions.heading}
      lead={page.questions.lead}
      items={page.questions.items}
      cta={page.questions.cta ?? walkthroughCta}
    />

    <Callout
      tone="warning"
      heading={page.cheapQuote.heading}
      body={page.cheapQuote.body}
      cta={page.cheapQuote.cta}
    />

    <ComparisonTable
      heading={page.termsTable.heading}
      cornerLabel={page.termsTable.cornerLabel}
      lead={page.termsTable.lead}
      columns={page.termsTable.columns}
      rows={page.termsTable.rows}
      footnote={page.termsTable.footnote}
      cta={page.termsTable.cta}
    />

    <ContentGrid
      heading={page.sectors.heading}
      lead={page.sectors.lead}
      columns={2}
      blocks={sectorBlocks}
    />

    <TextBlock
      theme="light"
      align="left"
      heading={page.whereWeFit.heading}
      body={page.whereWeFit.body}
      cta={page.whereWeFit.cta}
      backgroundImage={page.whereWeFit.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.readNext.heading}
      lead={page.readNext.lead}
      items={nextGuides}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <TagCloud
      heading={page.moreGuides.heading}
      subheading={page.moreGuides.subheading}
      tags={moreGuideTags}
      note={page.moreGuides.note}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={nswLocationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? walkthroughCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
