---
// Guide: "The Airbnb turnover checklist". Seventh of the nine guides; the
// cluster's shared data is in src/data/guides.ts.
//
// THE AUDIENCE IS DIFFERENT FROM EVERY OTHER GUIDE IN THE SET, and the page
// is written accordingly. A tenant reading the bond clean checklist is doing
// this once. A host reading this one is doing it fifty times a year, is
// already competent, and is looking for the specific things that cost them
// reviews rather than for an introduction to cleaning. So:
//   * No explaining what a changeover is beyond the answer-target sentence.
//   * The order section is about the CLOCK, not about gravity — a host's
//     constraint is an eleven-to-three window, not "top to bottom".
//   * §6 is the section that earns the page: the four failure modes that
//     generate most bad cleanliness reviews. That is trade knowledge a host
//     cannot get from Airbnb's own help pages.
//
// ⚠️ WHAT MUST STAY CONSISTENT WITH airbnb-cleaning.astro. That page already
// sells the service, including linen and restocking, and this guide must not
// promise operational things that page has not committed to. Anything about
// how TLB itself runs a turnover is kept to §8 and points at the service
// page rather than restating a scope.
//
// ⚠️ PLATFORM NAMING. "Airbnb" is in the slug, the title and the head term
// because that is what people search, and it is used as the common noun for
// short-stay letting throughout. The page is careful never to imply any
// affiliation with, endorsement by, or partnership with Airbnb — BFD 5.3.
// The body says "the platform" wherever the specific brand is not needed. Do
// not add an Airbnb logo, badge or brand colour to this page.
//
// ⚠️ NO REVIEW-SCORE CLAIMS. Nothing here promises a rating, a Superhost
// status or an outcome, for the same reason nothing on the end of lease page
// promises a bond. §6 describes what causes complaints, which is an
// observation, not a guarantee about what avoiding them will produce.
//
// PHOTOGRAPHY: reused, all four from src/assets/airbnb/ where they already
// mean exactly these moments. IMAGE-GUIDELINES.md §5.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides } from '../../data/guides';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const selfHref = '/guides/the-airbnb-turnover-checklist/' as const;

// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// §1 Hero. The heading names the actual constraint of the job, which is the
// thing that separates a turnover from a house clean and the thing every
// host recognises immediately.

// §2 The answer block. Definition-style opener, then the sentence that
// frames the whole guide: a turnover is a hospitality job with a deadline,
// not a domestic clean.

// §3 The run, in order. Dark TextBlock with a list — the same treatment the
// bond clean checklist gives its own order section, and for the same reason:
// it is short, sequential, and it wants to read as a method.
//
// The sequencing logic here is genuinely different from the bond clean's.
// That one is about gravity (everything falls downwards). This one is about
// the clock and about the two things that cannot be rushed at the end
// (linen and the final look). Worth keeping distinct if either is edited.

// §4 The checklist proper. ContentGrid text cells, one task per body entry,
// same treatment and same reasoning as the bond clean checklist page: the
// cell's --space-xs gap stacks short lines as a scannable list.
//
// Six cells, three clean rows at two columns.
//
// ⚠️ THE LINEN AND CONSUMABLES CELLS DESCRIBE A CONVENTIONAL SHORT-STAY
// STANDARD, NOT TLB'S SERVICE. What TLB supplies, launders or restocks is
// on airbnb-cleaning.astro and is not restated here. If a host reads this as
// a promise of what turns up in the van, the page has failed — §8 draws that
// line explicitly.

// §5 The four failure modes. THE section of the page, and the reason a host
// would bookmark it.
//
// ⚠️ THESE ARE OBSERVATIONS ABOUT WHAT GENERATES COMPLAINTS, drafted from
// category experience rather than from TLB's own records. They are stated as
// patterns, not as statistics — no percentages, no "most reviews", nothing
// that implies data this repo does not have.
//
// ⚠️ If TLB does hold real data on what its hosts' guests complain about,
// that is proprietary and would make this the strongest section on the site.
// Ask Teagan.

// §6 What to photograph, and why. `note` tone.
//
// This is an operational habit that protects a host in a damage claim, and
// it costs nothing. It is also the closest this page comes to advice about a
// platform's process, so it stays general and makes no claim about what any
// platform will or will not accept.

// §7 The two things a turnover is not. ContentGrid, two image/text rows —
// image position by array order, the same way the roof page does it.
//
// This section exists because the two most expensive mistakes a host makes
// with cleaning are both scheduling mistakes rather than cleaning ones, and
// nobody tells them.

// §8 What we actually do. Short, and it points at the service page rather
// than restating a scope, for the reason in the file header.

// §9 Next reads. Includes the Byron cap guide, which is the natural next
// read for a host in this specific region and is the strongest internal link
// on the page.
const nextGuides = otherGuides(selfHref, [
  '/guides/the-byron-shire-60-day-short-stay-cap-what-it-means-for-hosts/',
  '/guides/what-is-included-in-a-deep-clean/',
  '/guides/steam-dry-or-shampoo-which-carpet-cleaning-method/',
]);

// §10 The pill band.

// §11 FAQs.

// §12 Closing CTA.

// CONTENT lives in src/content/pages/guides/the-airbnb-turnover-checklist.yaml
// and is edited in Pages CMS ("Guides > The Airbnb turnover checklist"). This
// file owns the layout. The notes above explain why each section says what it
// says; they stay here because Pages CMS rewrites the YAML on save and would
// drop them. The editor carries the short version of each warning as a field
// description.
const page = await getPage(
  'guides/the-airbnb-turnover-checklist',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    run: section.textBlock,
    // ContentGrid text cells only.
    checklist: section.textGrid,
    // The button under the grid is the site-wide quote button, set in code.
    failures: section.iconGrid,
    photos: section.callout,
    notTurnover: section.contentGrid,
    ourService: section.textBlock,
    // The three guides listed come from site data (nextGuides above).
    readNext: section.sectionIntro,
    faq: section.faq,
    // `tags` holds only this page's own extra links. relatedGuides() adds the
    // other guides before them and the hub link after them.
    moreGuides: section.tagCloud,
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: `https://tlbcleaning.com.au${selfHref}`,
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const checklistBlocks = page.checklist.items.map((item) => ({ type: 'text' as const, ...item }));

// Photos are laid out at 4/3.
const misconceptionBlocks = page.notTurnover.items.map((item) =>
  item.type === 'image' ? { type: 'image' as const, ratio: '4/3', ...item.image } : item,
);

const moreGuideTags = relatedGuides(selfHref, page.moreGuides.tags ?? []);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <TextBlock
      theme="dark"
      align="left"
      heading={page.run.heading}
      body={page.run.body}
      cta={page.run.cta}
      backgroundImage={page.run.backgroundImage}
    />

    <ContentGrid
      heading={page.checklist.heading}
      lead={page.checklist.lead}
      columns={2}
      blocks={checklistBlocks}
    />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.failures.heading}
      lead={page.failures.lead}
      note={page.failures.note}
      items={page.failures.items}
      cta={quoteCta}
    />

    <Callout tone="note" heading={page.photos.heading} body={page.photos.body} cta={page.photos.cta} />

    {/* Two columns, image side set purely by array order: row one is image
        then text, row two text then image. */}
    <ContentGrid
      heading={page.notTurnover.heading}
      lead={page.notTurnover.lead}
      columns={2}
      blocks={misconceptionBlocks}
    />

    <TextBlock
      theme="light"
      align="left"
      heading={page.ourService.heading}
      body={page.ourService.body}
      cta={page.ourService.cta}
      backgroundImage={page.ourService.backgroundImage}
    />

    <ServiceBlocks
      variant="list"
      heading={page.readNext.heading}
      lead={page.readNext.lead}
      items={nextGuides}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <TagCloud
      heading={page.moreGuides.heading}
      subheading={page.moreGuides.subheading}
      tags={moreGuideTags}
      note={page.moreGuides.note}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
