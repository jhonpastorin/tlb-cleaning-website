---
// The Guides hub, shipping at /guides/.
//
// WHY THIS PAGE EXISTS WHEN IT WAS NOT ON THE LIST. navigation.ts' Guides
// mega-menu item carries `href: '/guides/'` as its own destination, the way
// every other Level-A item points at a real page ("the mega-menu is
// additive, not a replacement destination" — MegaMenuNavItem's own doc
// comment in types.ts). Without this file that header link, and every "All
// guides" pill at the foot of the nine leaf pages, is a 404. It is the
// smallest page in the cluster and it is the one that stops the other nine
// from dead-ending.
//
// DELIBERATELY THIN. A hub's job is to route, not to rank in its own right,
// so this page has no manufactured essay in front of the list. It carries a
// hero, one short framing paragraph, the nine guides in their two mega-menu
// clusters, a route back to the services, and a CTA. Nothing else.
//
// THE TWO CLUSTERS ARE navigation.ts' OWN GROUPS, read from
// src/data/guides.ts rather than retyped, so the menu and this page cannot
// present the nine in two different arrangements. That is the same rule the
// premises hub follows.
//
// ⚠️ If a tenth guide is added, it is added to src/data/guides.ts and this
// page picks it up with no edit. That is the whole point of deriving the
// sections from `guidePages` rather than hand-listing them here.
//
// PHOTOGRAPHY: reused. IMAGE-GUIDELINES.md §5.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
  serviceLinks,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { guidePages, guidesBusiness, otherGuides } from '../../data/guides';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// §1 Hero. The heading is the promise the whole section has to keep, and it
// is also the thing that makes these guides different from the category's
// usual thin SEO filler: three of the nine argue against buying something.

// §2 The framing paragraph. One only. A hub that opens with five hundred
// words before the list is a hub that has forgotten its job.
//
// The second paragraph is the section's editorial policy, stated to the
// reader rather than only in a comment, and it is a real commitment: three
// of the nine genuinely conclude that the reader may not need to hire
// anybody.

// §3 and §4. The nine, in their two mega-menu clusters, derived from
// guidePages rather than hand-listed — add a tenth guide to
// src/data/guides.ts and it appears here with no edit to this file.
//
// `ServiceBlocks` `list` is the right variant: it renders icon + title +
// description as a row link, which is exactly a guide index entry, and it is
// the same treatment the leaf pages use for their own "read next" rows so
// the section reads as one system.
const tenancyGuides = otherGuides(
  null,
  guidePages.filter((g) => g.cluster === 'End of lease & tenancy').map((g) => g.href),
);
const homesGuides = otherGuides(
  null,
  guidePages.filter((g) => g.cluster === 'Homes, hosting & commercial').map((g) => g.href),
);

// §5 Back to the services. The hub's other job: a reader who came for a
// guide and decided they want the service should not have to go back up to
// the header to find it.
//
// serviceLinks is navigation.ts' own list with its own descriptions, reused
// rather than rewritten, so the six services are described here exactly as
// they are on the homepage.
const serviceItems = serviceLinks.map(({ title, description, href }, i) => ({
  icon: (['house', 'spray-bottle', 'key', 'suitcase', 'target', 'office'] as const)[i],
  title,
  description,
  href,
}));

// CONTENT lives in src/content/pages/guides/index.yaml and is edited in
// Pages CMS ("Guides > Guides (hub)"). This file owns the layout. The notes
// above explain why each section says what it says; they stay here because
// Pages CMS rewrites the YAML on save and would drop them. The guide rows
// and the six services still come from site data, so only each band's
// heading and lead are page content.
const page = await getPage(
  'guides/index',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty. Re-check the text
    // contrast over the 90% scrim if it is swapped in Pages CMS.
    intro: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    tenancyGuides: section.sectionIntro,
    homesGuides: section.sectionIntro,
    services: section.sectionIntro,
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: 'https://tlbcleaning.com.au/guides/',
};

const business = guidesBusiness(pageMeta.description);

const heroImage = page.hero.image && sized(page.hero.image, '4/3');
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.intro.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.intro.heading}
        body={page.intro.body}
        cta={page.intro.cta}
      />
    </Backdrop>

    <ServiceBlocks
      variant="list"
      heading={page.tenancyGuides.heading}
      lead={page.tenancyGuides.lead}
      items={tenancyGuides}
    />

    <ServiceBlocks
      variant="list"
      heading={page.homesGuides.heading}
      lead={page.homesGuides.lead}
      items={homesGuides}
    />

    <ServiceBlocks
      variant="list"
      heading={page.services.heading}
      lead={page.services.lead}
      items={serviceItems}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
