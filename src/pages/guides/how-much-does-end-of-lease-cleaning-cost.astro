---
// Guide: "How much does end of lease cleaning cost?". Third of the nine
// guides; the cluster's shared data is in src/data/guides.ts.
//
// ⚠️⚠️ THE HARDEST EDITORIAL PROBLEM ON THE SITE, AND HOW THIS PAGE SOLVES IT.
// The query is a price query. The searcher wants a number. This repo has
// never been given TLB's rates, its minimum charge, or its pricing basis, and
// BFD 5.3 (Australian Consumer Law) makes an invented price a real problem
// rather than a placeholder. Two bad options and one good one:
//
//   BAD: invent a range. A fabricated "$250 to $600" is a misleading price
//        representation, and it is the exact thing every other page in this
//        repo has refused to do.
//   BAD: publish nothing and say "contact us". That is the answer a reader
//        already has, it wastes the query, and BFD 3.1's whole voice is the
//        opposite of it.
//   THIS PAGE: publish the STRUCTURE of the price in full — every variable
//        that moves it, in the order it moves it by, plus how to compare two
//        quotes — and leave the numbers themselves as [CONFIRM] brackets that
//        cannot be published half-filled.
//
// That is genuinely useful without being invented, and the honest version of
// this page is more persuasive than a made-up range anyway, because it is the
// page that explains why the cheap quote is cheap.
//
// ⚠️ SIX BRACKETED SLOTS, all marked [CONFIRM] inline. Every one needs
// Teagan's answer before launch. A page that publishes with a bracket visible
// is worse than one that never published, so if the numbers are not coming,
// the honest move is to cut §5 and §6 and ship the rest.
//
// NO GUARANTEE ANYWHERE, per BFD 5.3 and 3.5. §7 explicitly explains why a
// "bond back guarantee" attached to a price is usually a term about a
// re-clean rather than about money.
//
// PHOTOGRAPHY: reused. IMAGE-GUIDELINES.md §5 — the moving-out-day photo
// already means exactly this moment on two other pages.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import heroImg from '../../assets/home_cleaning/inside_your_home/deep_cleaning/deep-cleaning-empty-room-on-moving-out-day.jpg';
import definitionBgImg from '../../assets/home_cleaning/inside_your_home/end_of_lease_and_bond_cleaning/end-of-lease-property-manager-at-a-vacant-handover.jpg';
import type { TextBlockBody } from '../../components/sections/TextBlock.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides } from '../../data/guides';

const selfHref = '/guides/how-much-does-end-of-lease-cleaning-cost/' as const;

const pageMeta = {
  title: 'How Much Does End of Lease Cleaning Cost? | TLB Cleaning',
  description:
    'What moves the price of a bond clean in the Northern Rivers, the Tweed and the Southern Gold Coast, what a cheap quote has usually left out, and how to compare two quotes properly.',
  // ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.
  canonical: `https://example.com${selfHref}`,
};

const business = {
  name: 'TLB Cleaning',
  url: 'https://example.com/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: '',
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
  description: pageMeta.description,
};

// §1 Hero. The heading concedes the thing a price page normally hides — that
// the number depends — and then immediately promises the useful version of
// that answer. Conceding first is what makes the rest of the page credible.
const hero = {
  kicker: 'Guide · End of lease and tenancy',
  headingLines: ['Nobody can price your bond clean', 'without knowing what state it is in.'],
  lead:
    'What actually moves the price of an end of lease clean, in the order it moves it by. Plus the four things a cheap quote has almost always left out, and how to hold two quotes against each other.',
  cta: quoteCta,
  image: {
    ratio: '4/3',
    label: 'An empty room on moving-out day, bare floor and stripped walls, light through an uncurtained window',
    src: heroImg,
  },
};

// §2 The answer block. It has to answer the query honestly in the first two
// sentences, because that is what gets lifted into an overview, and the
// honest answer is "it is quoted, and here is what it is quoted on".
//
// ⚠️ The last sentence carries the page's one real commitment: TLB quotes
// before starting, against a published task list. That is already claimed on
// end-of-lease-cleaning.astro, so it is consistent rather than new. If it is
// not actually true, it comes off both pages together.
const definitionBody: TextBlockBody[] = [
  'End of lease cleaning is priced per job rather than per hour by most cleaners in this region, and the quote is built from the size of the property, its condition, whether it is empty, and which extras the property needs. Two identical floor plans can be hundreds of dollars apart, and condition is usually the reason.',
  'Anyone who gives you a firm price for a bond clean without asking about the oven, the carpets and whether the place is empty is either guessing or planning to revise it on the day. TLB Cleaning quotes against the task list published on our end of lease page, before the work starts.',
];

// §3 What moves the price, in order. ContentGrid text cells at two columns,
// six cells, three clean rows.
//
// The ORDER is the value here. Most competitor pages list variables
// alphabetically or by room; this one lists them by how much they actually
// move a quote, which is the thing a reader cannot work out for themselves.
//
// ⚠️ The ordering is drafted from category convention. If TLB's own quoting
// weights these differently — and the oven-versus-condition ranking is the
// one most likely to differ — reorder them.
const priceDriverBlocks = [
  {
    type: 'text' as const,
    heading: '1. Condition, not size',
    body: [
      'The single biggest variable, and the one that surprises people. A well-kept four-bedroom house can quote under a neglected two-bedroom unit, because the hours go into build-up rather than into floor area.',
      'This is why a real quote asks how long you have been there, whether there were pets, and whether anyone has cleaned the oven in that time.',
    ],
  },
  {
    type: 'text' as const,
    heading: '2. Empty or furnished',
    body: [
      'A furnished property is roughly twice the work and it never finishes as well. Everything has to be moved, worked around and put back, and half the surfaces the inspection checks are underneath something.',
      'Book the clean for the day after the truck. It is the cheapest single decision on this page.',
    ],
  },
  {
    type: 'text' as const,
    heading: '3. The oven, and how bad it is',
    body: [
      'An oven that has been wiped through the tenancy is twenty minutes. An oven that has not been touched in three years is a job of its own, and on a fixed-price quote it is the item most likely to be re-priced when the cleaner sees it.',
      'Send a photo of the inside of it when you ask for a quote. It is the most useful photo you can send.',
    ],
  },
  {
    type: 'text' as const,
    heading: '4. Bathrooms and wet areas',
    body: [
      'Bathroom count moves a bond clean price more than bedroom count does, because a bathroom is dense detail work — screen, grout, base, drain, fan, toilet — and a bedroom is mostly floor.',
      'A three-bedroom, one-bathroom house and a three-bedroom, three-bathroom house are not the same job.',
    ],
  },
  {
    type: 'text' as const,
    heading: '5. The extras the property needs',
    body: [
      'Carpet steam cleaning, exterior windows, balconies, garages, wall washing beyond spot cleaning, pest control. Each is quoted separately by nearly every cleaner, including us.',
      'They are the reason two quotes for "the same job" can be far apart. One has included them and one has not.',
    ],
  },
  {
    type: 'text' as const,
    heading: '6. Timing and access',
    body: [
      'A clean squeezed into the last afternoon before a handover, on a weekend, at the end of the month, in a building with one lift and a loading dock booking, costs more than the same clean on a quiet Tuesday.',
      'The end of the month is peak in this region for exactly the reason you would expect. Book earlier and you have more to negotiate with.',
    ],
  },
];

// §4 The comparison the reader actually needs: what separates a cheap quote
// from a complete one. A real ComparisonTable, and this one DOES highlight a
// column, because here there genuinely is an "us" — the column describes how
// TLB quotes, and the claims in it are already made on the service page.
//
// ⚠️ EVERY CLAIM IN THE HIGHLIGHTED COLUMN IS A COMMITMENT. Written quote
// before starting, published task list, extras named up front, employed
// cleaners. All four are already claimed elsewhere on the site (the
// comparison rows in src/data/comparison.ts and end-of-lease-cleaning.astro),
// so this is consistent rather than new — but if any of them is not true,
// it is false here and false there.
//
// The right-hand column deliberately says "a cheap quote", not "other
// cleaners". It is a description of a type of quote, not a claim about named
// competitors, which is both fairer and safer.
const quoteTable = {
  heading: 'Why one quote is half the other',
  cornerLabel: 'What to check before you compare two numbers',
  lead: 'Almost every large gap between two bond clean quotes comes from one of these six rows, not from one cleaner being greedy.',
  columns: [{ label: 'A complete quote', highlight: true }, { label: 'A cheap quote' }],
  rows: [
    {
      label: 'A written scope of works',
      description: '(You can see which tasks the number covers)',
      values: [true, false],
    },
    {
      label: 'Carpet steam cleaning',
      values: ['Named as included or excluded', 'Usually silent, and usually not included'],
    },
    {
      label: 'The oven',
      values: ['Priced after asking about its condition', 'Priced as a line item, re-priced on the day'],
    },
    {
      label: 'Exterior windows and balconies',
      values: ['Named either way', 'Assumed to be out of scope without saying so'],
    },
    {
      label: 'Who turns up',
      description: '(And whether they are the person you spoke to)',
      values: ['An employed team, briefed on the scope', 'Whoever the platform assigned this morning'],
    },
    {
      label: 'What happens if the agent comes back',
      values: ['A stated policy you can read before you book', 'A guarantee badge, with the terms elsewhere'],
    },
  ],
  footnote:
    'If you are comparing two quotes, do not compare the numbers. Compare the task lists, and add the missing items to the cheaper one before you decide. Very often that is the entire difference.',
};

// §5 The bracketed pricing block. THE section that cannot publish half-filled.
//
// ⚠️⚠️ [CONFIRM] × 4 IN THIS BLOCK. Every bracket below is a real number only
// TLB holds. The block is written so that filling the brackets is the only
// work needed — the framing, the caveats and the ACL-safe hedging are already
// correct around them.
//
// If Teagan will not publish numbers at all, DELETE this section rather than
// softening it into a vague paragraph. A price section with no prices in it
// is worse than no price section, and the rest of the page stands without it.
const pricingBody: TextBlockBody[] = [
  'Here is how ours works, in plain terms.',
  {
    list: [
      'Basis: [CONFIRM. Is a TLB bond clean priced as a fixed quote per property, or hourly, or fixed with an hourly overrun clause? This is the first thing a reader wants and the first thing a competitor states.]',
      'Minimum charge: [CONFIRM the minimum job charge, if there is one. A studio or a one-bedroom unit is the case this answers.]',
      'What a typical range looks like: [CONFIRM. A range by property size, stated as a range with condition named as the variable. Do not publish a single figure, and do not publish anything that has not been checked against real recent jobs.]',
      'Extras: [CONFIRM the pricing basis for carpet steam cleaning, exterior windows, balconies and garages. Per room, per square metre, or per job.]',
      'Deposit and payment: [CONFIRM whether a deposit is taken, and when payment falls due relative to the inspection.]',
    ],
  },
  'Every one of those is quoted against the published task list rather than against a guess, and the quote comes before the work does. If something turns up on the day that changes the job, you hear about it before it is done and not on the invoice.',
];

// §6 The false economy argument. Warning tone, used once.
//
// This is the persuasive centre of the page and it makes no claim about TLB
// at all, which is what makes it read as advice rather than as a pitch.
const falseEconomyCallout = {
  heading: 'The cheapest quote is sometimes the most expensive one',
  body: [
    'A bond clean is one of the few purchases where a bad outcome costs more than the job did. If the clean is rejected, the usual sequence is that the agent has it re-done at a rate nobody negotiated and takes it from your bond, and you are now out both amounts. The gap between the cheapest quote and a complete one is routinely smaller than a single re-clean.',
    'That is not an argument for the most expensive quote either. It is an argument for the quote you can read. Ask for the task list, check the four usual omissions against it, and pick on the basis of what is actually being done.',
  ],
};

// §7 Guarantees and what they actually mean. This is the page where a
// competitor's guarantee badge does its work, so this is where it gets
// examined — honestly, and without accusing anyone of anything.
//
// ⚠️ TLB'S OWN RE-CLEAN POLICY IS STILL UNCONFIRMED. The service page carries
// the same open item with a bracketed window. This page therefore describes
// the CATEGORY's guarantees and points at the service page rather than
// restating a policy that has not been settled. When the policy is confirmed,
// this section gets one added sentence and the service page gets the detail.
const guaranteeBody: TextBlockBody[] = [
  'Almost every national platform in this category leads with a bond back guarantee, and it is worth understanding what is usually behind the badge.',
  'In nearly every case the guarantee is a re-clean commitment, not a money commitment: if the agent lists something from the agreed scope, the cleaner returns within a stated window and fixes it. That is a genuinely useful thing to be offered. It is not, however, a promise that your bond will be returned, because no cleaner controls what an agent writes in a report or what a tribunal decides.',
  'So read the terms rather than the badge. The questions worth asking are: how long is the window, does it cover only the items that were in the original scope, and do you have to notify the cleaner before you respond to the agent. A cleaner who answers those three plainly is offering you something real.',
  'We do not advertise a bond back guarantee, for the reason above. What we do offer is set out on the end of lease page, in the same words we would use on the phone.',
];

// §8 How to get a quote that holds. Six practical items, icon-grid.
const quoteWellItems = [
  {
    icon: 'target' as const,
    title: 'Say whether it will be empty',
    description:
      'It changes the price more than almost anything else, and a quote given for an empty property and delivered on a furnished one gets revised on the day. Say which it is.',
  },
  {
    icon: 'idea' as const,
    title: 'Photograph the oven',
    description:
      'Open the door and take one photo of the inside. It is the item most often re-priced on arrival and the one a photo settles instantly.',
  },
  {
    icon: 'puzzle' as const,
    title: 'Count the wet areas, not the bedrooms',
    description:
      'Bathrooms, ensuites, separate toilets and the laundry. That count moves a bond clean quote more than the bedroom count does.',
  },
  {
    icon: 'spray-bottle' as const,
    title: 'Ask about carpets explicitly',
    description:
      'Whether they are included, what method is used, and whether it is booked for after the clean. It is the most common gap between two quotes in this category.',
  },
  {
    icon: 'chart-bars' as const,
    title: 'Give the real handover date',
    description:
      'Not the date you hope for. A clean booked with a day of slack in front of the inspection can be finished properly; one booked for the morning of cannot be redone if something goes wrong.',
  },
  {
    icon: 'chart-pie' as const,
    title: 'Ask for it in writing, against a list',
    description:
      'A number in a text message is not a quote you can compare or hold anyone to. A number attached to a task list is.',
  },
];

// §9 Next reads.
const nextGuides = otherGuides(selfHref, [
  '/guides/the-end-of-lease-cleaning-checklist/',
  '/guides/what-the-law-actually-says-end-of-lease-cleaning-in-nsw-and-qld/',
  '/guides/how-much-does-house-cleaning-cost/',
]);

// §10 The pill band.
const moreGuideTags = relatedGuides(selfHref, [
  { label: 'End of lease and bond cleaning', href: '/end-of-lease-cleaning/' },
  { label: 'Carpet and rug cleaning', href: '/carpet-and-rug-cleaning/' },
  { label: 'Deep cleaning', href: '/deep-cleaning/' },
]);

// §11 FAQs.
//
// ⚠️ NOT ONE OF THESE ANSWERS CONTAINS A DOLLAR FIGURE, and that is
// deliberate rather than an oversight. Answer 1 explains the structure
// instead. When TLB's real numbers land in §5, answer 1 can point at them.
const faqItems = [
  {
    question: 'How much does end of lease cleaning cost?',
    answer:
      'It is quoted per property rather than sold at a list price, because condition moves it more than size does. The quote is built from the property’s size, how it has been kept, whether it will be empty, how many wet areas there are, and which extras the place needs. Ask for the quote against a written task list so you can compare it to another one.',
  },
  {
    question: 'Why are two quotes for the same house so far apart?',
    answer:
      'Usually because one includes carpet steam cleaning, exterior windows or the oven and the other does not, and neither says so on the front page. Add the missing items to the cheaper quote before comparing. Very often that closes the whole gap, and sometimes it reverses which one is cheaper.',
  },
  {
    question: 'Is a bond clean more expensive than a deep clean?',
    answer:
      'Generally yes, for the same property. A deep clean is measured against a baseline you set; a bond clean is measured against someone else’s checklist and includes work a deep clean quotes separately, notably inside the oven and inside every cupboard. The two are different jobs at different standards, not the same job at two prices.',
  },
  {
    question: 'Does it cost more if the property is still furnished?',
    answer:
      'Yes, and by a lot. A furnished bond clean is roughly twice the work, because every surface has to be moved around rather than simply cleaned, and it still does not finish as well. Booking the clean for the day after the removal truck is the single cheapest decision available to you.',
  },
  {
    question: 'Do I need carpet steam cleaning as well?',
    answer:
      'It depends on your agreement, your state and the condition of the carpet. It is quoted separately by nearly every cleaner, so ask for it with the main quote rather than after the inspection. If it is being done, book it for after the clean rather than before, or the carpet is walked on damp all day.',
  },
  {
    question: 'What happens if the agent is not satisfied?',
    answer:
      'That depends on what the cleaner has committed to before you booked, which is why it is worth reading. Most offer a return visit within a stated window for items that were in the original scope. None of them can promise what an agent will write in a report, so treat a plain re-clean policy as the useful thing and a guarantee badge as the thing to read the terms of.',
  },
];

// §12 Closing CTA.
const closingCta = {
  kicker: 'End of lease and bond cleaning',
  heading: 'Get the quote and the list together.',
  lead: 'Tell us the property, the handover date and whether it will be empty. You get a price and the task list it is priced against, before anybody starts.',
  cta: { label: 'Get an end of lease quote', href: '/end-of-lease-cleaning/' },
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={80} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <ContentGrid
      heading="What moves the price, in order"
      lead="Six variables. They are listed by how much they actually change a quote, which is not the order most price pages use."
      columns={2}
      blocks={priceDriverBlocks}
    />

    <ComparisonTable
      heading={quoteTable.heading}
      cornerLabel={quoteTable.cornerLabel}
      lead={quoteTable.lead}
      columns={quoteTable.columns}
      rows={quoteTable.rows}
      footnote={quoteTable.footnote}
    />

    <TextBlock theme="dark" align="left" heading="How we price ours" body={pricingBody} />

    <Callout tone="warning" heading={falseEconomyCallout.heading} body={falseEconomyCallout.body} />

    <ServiceBlocks
      variant="icon-grid"
      heading="How to get a quote that holds on the day"
      lead="Six things to tell whoever is quoting. All of them protect you from a price that changes when the van arrives."
      items={quoteWellItems}
      cta={quoteCta}
    />

    <TextBlock
      theme="light"
      align="left"
      heading="About bond back guarantees"
      body={guaranteeBody}
    />

    <ServiceBlocks
      variant="list"
      heading="Read next"
      lead="The three guides that follow on from this one."
      items={nextGuides}
    />

    <Faq heading="End of lease cleaning costs: frequently asked questions" items={faqItems} />

    <TagCloud
      heading="More guides"
      subheading="Everything else we have written down."
      tags={moreGuideTags}
      note={['Something we have not covered? Ask us and we will write it.']}
    />

    <TagCloud
      heading="Where we clean"
      subheading="Northern Rivers, the Tweed and the Southern Gold Coast."
      groups={locationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
