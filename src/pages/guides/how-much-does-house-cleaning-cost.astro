---
// Guide: "How much does house cleaning cost?". Fourth of the nine guides;
// the cluster's shared data is in src/data/guides.ts.
//
// ⚠️ SAME PRICING PROBLEM AS THE BOND CLEAN COST GUIDE, SAME SOLUTION.
// The repo has never been given TLB's rates. Publishing an invented range is
// a misleading price representation under BFD 5.3, and publishing "contact
// us" wastes the query. So this page publishes the STRUCTURE of the price in
// full and leaves the numbers as [CONFIRM] brackets that cannot ship
// half-filled. See the header of
// how-much-does-end-of-lease-cleaning-cost.astro for the full reasoning; it
// is not repeated here.
//
// ⚠️ FIVE BRACKETED SLOTS in §5. If Teagan will not publish numbers, DELETE
// §5 rather than softening it. The rest of the page stands without it.
//
// WHAT MAKES THIS PAGE DIFFERENT FROM THE BOND CLEAN COST GUIDE, so the two
// do not read as one article published twice:
//   * Its central question is hourly versus fixed, which does not arise on a
//     bond clean (that job is almost always fixed).
//   * Its second question is the first clean versus the ones after it, which
//     is specific to ongoing work and is the number one source of "why was
//     the first invoice higher" complaints in this category.
//   * Its warning section is about the cash rate rather than the cheap
//     quote — the undercutting mechanism is genuinely different for ongoing
//     domestic work than for one-off bond work, and this is the page where
//     TLB's "employed, not subcontracted" position is actually load-bearing.
//
// ⚠️ THE EMPLOYMENT ARGUMENT IN §6 IS THE STRONGEST THING ON THE PAGE AND IT
// RESTS ON A CLAIM THIS REPO INHERITED. src/data/comparison.ts row 1 says
// "Nine full-time cleaners employed by TLB, not subcontracted". Every page on
// the site carries it. §6 explains the cost consequence of it, which is a
// legitimate extension, but if the employment position ever changes then §6
// is the section that becomes false first.
//
// PHOTOGRAPHY: reused. IMAGE-GUIDELINES.md §5.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBar from '../../components/sections/TrustBar.astro';
import Backdrop from '../../components/ui/Backdrop.astro';
import TextBlock from '../../components/sections/TextBlock.astro';
import Callout from '../../components/sections/Callout.astro';
import ContentGrid from '../../components/sections/ContentGrid.astro';
import ComparisonTable from '../../components/sections/ComparisonTable.astro';
import ServiceBlocks from '../../components/sections/ServiceBlocks.astro';
import TagCloud from '../../components/sections/TagCloud.astro';
import Faq from '../../components/sections/Faq.astro';
import CallToAction from '../../components/sections/CallToAction.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import logoImg from '../../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../../assets/logo/tlb-logo-square.png';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../../data/navigation';
import { locationGroups } from '../../data/locations';
import { trustBarCards } from '../../data/trust';
import { otherGuides, relatedGuides } from '../../data/guides';
import { localBusiness } from '../../data/business';
import { z } from 'astro/zod';
import { getPage } from '../../lib/cms';
import * as section from '../../lib/cms-schemas';
import { sized } from '../../lib/cms-schemas';

const selfHref = '/guides/how-much-does-house-cleaning-cost/' as const;

// In `pageMeta`:
// ⚠️ Placeholder domain, same as every page on the site. Confirm before launch.

// §1 Hero. The heading states the thing that makes an hourly rate almost
// useless as a comparison tool, which is the page's whole argument.

// §2 The answer block. Definition-first, then the sentence that reframes the
// query: the useful number is cost per visit at a stated scope, not the
// hourly rate, and almost every price page in this category gets that
// backwards.

// §3 Hourly against fixed. A real ComparisonTable — genuinely tabular, two
// compared models, one feature per row.
//
// NEITHER COLUMN IS HIGHLIGHTED, on purpose. There is no "us" here: both
// models are legitimate and which suits you depends on your house. Tinting
// one would be a claim the page does not actually want to make, and the
// footnote says so.
//
// ⚠️ If TLB prices one way and not the other, this table needs one added
// sentence saying which — and §5's [CONFIRM] block is where that lands.

// §4 What moves the price. ContentGrid text cells, six, three rows at two
// columns.
//
// Deliberately different variables from the bond clean cost guide's six —
// frequency and pets do not appear there, and condition-versus-size is
// framed differently because on ongoing work the condition is a function of
// the frequency you chose.

// §5 The first clean. `note` tone.
//
// This section exists because it is the single most common billing surprise
// in ongoing domestic cleaning, and explaining it in advance turns a
// complaint into a reasonable expectation. It is also a genuine trust signal:
// saying "the first one costs more, here is why" before you book is the
// opposite of what a cheap operator does.
//
// ⚠️ CONFIRM TLB ACTUALLY WORKS THIS WAY. Some cleaners charge a higher
// first visit, some quote a separate initial deep clean, some absorb it. The
// page currently describes the first two as the category norm and does not
// state which one TLB does — §6's bracket is where that answer goes.

// §6 The bracketed pricing block. Same treatment as the bond clean guide.
//
// ⚠️⚠️ [CONFIRM] × 5. Cannot publish half-filled. Delete the section rather
// than vaguing it out if the numbers are not coming.

// §7 What is inside the rate. Warning tone, used once.
//
// THE section where TLB's employment position does real work, and the reason
// this page exists at all rather than just the bond clean one. It is written
// as an explanation of what a rate has to cover, not as an accusation about
// anybody's arrangements — which is both fairer and considerably safer.
//
// ⚠️ Deliberately makes NO claim about the legality or tax status of anyone
// else's business. It describes costs. Keep it that way.

// §8 How to compare two quotes properly. Six items, icon-grid.

// §9 Next reads.
const nextGuides = otherGuides(selfHref, [
  '/guides/what-is-included-in-a-deep-clean/',
  '/guides/steam-dry-or-shampoo-which-carpet-cleaning-method/',
  '/guides/how-much-does-end-of-lease-cleaning-cost/',
]);

// §10 The pill band.

// §11 FAQs. No dollar figures anywhere, same rule as the bond clean cost
// guide and for the same reason.

// §12 Closing CTA.

// CONTENT lives in src/content/pages/guides/how-much-does-house-cleaning-cost.yaml
// and is edited in Pages CMS ("Guides > What house cleaning costs"). This
// file owns the layout. The notes above explain why each section says what it
// says, including the [CONFIRM] brackets; they stay here because Pages CMS
// rewrites the YAML on save and would drop them. The editor carries the short
// version of each warning as a field description.
const page = await getPage(
  'guides/how-much-does-house-cleaning-cost',
  z.object({
    seo: section.seo,
    hero: section.hero,
    // Its background photo sits behind the trust bar and this block together
    // (the Backdrop below), so it cannot be left empty.
    definition: section.textBlock.extend({ backgroundImage: section.backgroundPhoto }),
    modelTable: section.comparisonTable,
    // ContentGrid text cells only.
    priceDrivers: section.textGrid,
    firstClean: section.callout,
    pricing: section.textBlock,
    rate: section.callout,
    // The button under the grid is the site-wide quote button, set in code.
    compare: section.iconGrid,
    // The three guides listed come from site data (nextGuides above).
    readNext: section.sectionIntro,
    faq: section.faq,
    // `tags` holds only this page's own extra links. relatedGuides() adds the
    // other guides before them and the hub link after them.
    moreGuides: section.tagCloud,
    whereWeClean: section.tagCloud,
    closingCta: section.callToAction,
  }),
);

const pageMeta = {
  ...page.seo,
  canonical: `https://tlbcleaning.com.au${selfHref}`,
};

const business = localBusiness({
  description: pageMeta.description,
  areaServed: 'Northern Rivers NSW, the Tweed and Southern Gold Coast QLD',
});

const heroImage = page.hero.image && sized(page.hero.image, '4/3');

const priceDriverBlocks = page.priceDrivers.items.map((item) => ({ type: 'text' as const, ...item }));

const moreGuideTags = relatedGuides(selfHref, page.moreGuides.tags ?? []);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={page.hero.kicker}
      headingLines={page.hero.headingLines}
      subheading={page.hero.subheading}
      lead={page.hero.lead}
      cta={page.hero.cta ?? quoteCta}
      image={heroImage}
    />

    <Backdrop image={page.definition.backgroundImage} tint="muted" opacity={90} focus="center">
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading={page.definition.heading}
        body={page.definition.body}
        cta={page.definition.cta}
      />
    </Backdrop>

    <ComparisonTable
      heading={page.modelTable.heading}
      cornerLabel={page.modelTable.cornerLabel}
      lead={page.modelTable.lead}
      columns={page.modelTable.columns}
      rows={page.modelTable.rows}
      footnote={page.modelTable.footnote}
      cta={page.modelTable.cta}
    />

    <ContentGrid
      heading={page.priceDrivers.heading}
      lead={page.priceDrivers.lead}
      columns={2}
      blocks={priceDriverBlocks}
    />

    <Callout
      tone="note"
      heading={page.firstClean.heading}
      body={page.firstClean.body}
      cta={page.firstClean.cta}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading={page.pricing.heading}
      body={page.pricing.body}
      cta={page.pricing.cta}
      backgroundImage={page.pricing.backgroundImage}
    />

    <Callout tone="warning" heading={page.rate.heading} body={page.rate.body} cta={page.rate.cta} />

    <ServiceBlocks
      variant="icon-grid"
      heading={page.compare.heading}
      lead={page.compare.lead}
      note={page.compare.note}
      items={page.compare.items}
      cta={quoteCta}
    />

    <ServiceBlocks
      variant="list"
      heading={page.readNext.heading}
      lead={page.readNext.lead}
      items={nextGuides}
    />

    <Faq heading={page.faq.heading} lead={page.faq.lead} items={page.faq.items} />

    <TagCloud
      heading={page.moreGuides.heading}
      subheading={page.moreGuides.subheading}
      tags={moreGuideTags}
      note={page.moreGuides.note}
    />

    <TagCloud
      heading={page.whereWeClean.heading}
      subheading={page.whereWeClean.subheading}
      tags={page.whereWeClean.tags}
      groups={locationGroups}
      note={page.whereWeClean.note}
    />

    <CallToAction
      variant="secondary"
      kicker={page.closingCta.kicker}
      heading={page.closingCta.heading}
      lead={page.closingCta.lead}
      cta={page.closingCta.cta ?? quoteCta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
