---
// Schools and childcare centres — one of the THIRTEEN "by type of premises"
// leaf pages under the /commercial-cleaning/ hub (navigation.ts, "By type of
// premises" group). Built in one pass with its twelve siblings.
//
// NO CONTENT BRIEF EXISTS for any of the thirteen. All copy below is DRAFTED,
// not supplied. See src/pages/office-cleaning.astro's header for the launch
// blockers shared across the whole cluster.
//
// ⚠️ THE WORKING WITH CHILDREN CHECK IS A GATE, NOT A FEATURE, and it is why
// §3 is where it is. commercial-cleaning.astro's own source already carries
// an OPEN QUESTION about a Blue Card, which is the Queensland equivalent —
// that question was raised on the hub and never answered, and this page is
// the one it actually blocks. In NSW, paid work in a child-related setting
// requires a Working With Children Check clearance, and a school or centre
// director cannot lawfully engage a cleaner who does not hold one.
//
// So this page's §3 Callout is not persuasion. It is the page telling the
// reader what to demand, including from us, and it is the block a director
// will read first. If TLB cannot evidence a current WWCC for every cleaner
// who would attend, THIS PAGE MUST NOT SHIP — unlike its siblings, where a
// missing bracket is a copy problem rather than a legal one.
//
// WHAT MAKES THIS PAGE DIFFERENT structurally:
//   - `Callout tone="warning"` on the WWCC, above everything else, and
//     phrased as an instruction to the reader rather than a claim about TLB.
//   - The scope splits into TWO icon grids, one for schools and one for
//     childcare, because the two settings share a menu label and almost
//     nothing else. A school is cleaned when it is empty; a childcare room
//     has children's mouths on the toys. Merging them would produce a scope
//     that is wrong for both.
//   - `ImageBand` on the bathroom block, because in both settings the
//     bathrooms are the single thing a parent judges a centre on and the
//     first thing a cheap scope thins out.
//   - No `ComparisonTable`. The shared rows are written for someone choosing
//     who enters their home. Deliberate omission, same call as strata,
//     construction and medical.
//
// BLOCKS LAUNCH, specific to this page:
//   - WWCC for every cleaner. See above. This is the gate.
//   - The Queensland question the hub left open: whether TLB works across
//     the border and therefore needs Blue Cards too. `nswLocationGroups`
//     below says NSW only, which is at least internally consistent.
//   - Whether TLB will do a childcare centre's nappy change area and
//     bathrooms, which is the least pleasant and most scrutinised part of
//     the job. Bracketed in §5.
//   - Whether TLB can work to a centre's National Quality Framework
//     obligations in writing. Bracketed in branded FAQ 3. A centre in an
//     assessment cycle will ask.
//   - Nothing here claims an education-sector cleaning accreditation or
//     government panel membership. Do not add one without evidence.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import Callout from '../components/sections/Callout.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import StoryMosaic from '../components/sections/StoryMosaic.astro';
import ImageBand from '../components/sections/ImageBand.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
// This page's own frames are in src/assets/commercial_cleaning/premises/;
// the prompts are in that folder's IMAGE-PROMPTS.md.
//
// ⚠️ NO CHILDREN IN ANY FRAME, and that is a hard rule rather than a
// stylistic one. IMAGE-GUIDELINES §7 forbids generating a person presented
// as a real, identifiable individual; a generated child in a named
// business's marketing is worse again, because a parent reading this page
// cannot tell that the child is not a real child at a real centre. Every
// frame here is deliberately after hours or after pickup.
import heroImg from '../assets/commercial_cleaning/premises/childcare-cleaner-wiping-low-tables-after-pickup.jpg';
import classroomImg from '../assets/commercial_cleaning/premises/school-cleaner-mopping-a-classroom-after-hours.jpg';
import bathroomImg from '../assets/commercial_cleaning/premises/school-bathroom-block-cleaned-after-hours.jpg';
// §2 backdrop, behind the Cream scrim — the homepage's, same as the hub.
import definitionBgImg from '../assets/home/house-cleaning-cleaner-wiping-tall-interior-window.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import type { TextBlockBody } from '../components/sections/TextBlock.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
} from '../data/navigation';
import { nswLocationGroups } from '../data/locations';
import { trustBarCards } from '../data/trust';
import { commercialBusiness, relatedPremises, walkthroughCtaLabel } from '../data/premises';

// §0 Metadata. Both settings in the title because both have to land here,
// and the description leads with the check rather than with the cleaning,
// because that is what a director is searching for reassurance about.
const pageMeta = {
  title: 'School and Childcare Cleaning | TLB Cleaning',
  description:
    'Cleaning for schools, preschools and childcare centres across the Northern Rivers and the Tweed. A Working With Children checked local team, a written scope, and bathrooms done properly.',
  // ⚠️ Placeholder domain, same as every sibling page. Confirm before launch.
  canonical: 'https://example.com/schools-and-childcare-centres/',
};

const walkthroughCta = { label: walkthroughCtaLabel, href: quoteCta.href };

// §1 Hero. `split-single-image`, image right. The childcare frame leads
// rather than the classroom because childcare is the harder, more scrutinised
// half of this page and the half with more buyers per square kilometre in
// this region.
//
// ⚠️ GENERATED, NOT PHOTOGRAPHED, AND NO CHILDREN IN FRAME. See the import
// comment above — that second part is a hard rule on this page.
const hero = {
  kicker: 'Schools and childcare cleaning',
  headingLines: ['Everything here', 'gets touched by a two-year-old.'],
  lead:
    'Cleaning for schools, preschools and childcare centres across the Northern Rivers and the Tweed. A Working With Children checked local team, working after pickup, on a scope written for the way children actually use a room.',
  cta: walkthroughCta,
  image: {
    ratio: '16/9',
    label:
      'A cleaner wiping down a low round table in a bright, tidy childcare playroom after the last pickup of the day',
    src: heroImg,
  },
};

// §2 Definition. Answer-target block. Paragraph two makes the split the rest
// of the page is built on, because a school and a childcare centre share a
// menu label and very little else.
const definitionBody: TextBlockBody[] = [
  'School and childcare cleaning is the daily cleaning of an education setting: classrooms and playrooms, bathrooms, hall and library, staff rooms and offices, and the hard surfaces of outdoor play areas. TLB Cleaning does this work across the Northern Rivers and the Tweed for schools, preschools, long day care centres and out of school hours care.',
  'The two settings need different scopes and are best not merged. A school is cleaned when it is empty, at desk height, by people nobody meets. A childcare room is cleaned around children who put their hands and their mouths on everything at knee height, and the cleaner is somebody the educators see every day. Same trade, different job, and the sections below are split for that reason.',
];

// §3 The check. `warning`, above everything else on the page, and phrased as
// an instruction to the reader rather than as a claim about TLB.
//
// THIS IS THE MOST IMPORTANT BLOCK IN THE CLUSTER. See the file header: it is
// the only place where a missing bracket is a legal problem rather than a
// copy problem.
//
// ⚠️ VERIFICATION PASS REQUIRED, and this is the block to check hardest:
//   - In NSW, paid workers in child-related work must hold a Working With
//     Children Check clearance, and the employer or engaging organisation
//     must verify the clearance number online before the person starts.
//     Correct in substance. THE VERIFICATION STEP IS THE POINT of the second
//     paragraph, because it is the part organisations skip.
//   - Cleaning in a school or childcare service is generally child-related
//     work. Correct, and worded as "generally" because the boundary can
//     depend on the arrangement.
//   - A WWCC clearance is held by the individual, not the company. Correct,
//     and it is why "our company is checked" is not an answer.
//   - Queensland's equivalent is the Blue Card, which is the open question
//     commercial-cleaning.astro raised and nobody answered.
//   - NO CLEARANCE VALIDITY PERIOD IS QUOTED, because it has changed and a
//     stale number here would be actively misleading.
//   - NSW Fair Trading and the Office of the Children's Guardian are the
//     right primary sources; the brand foundation document (§3.3) already
//     approves government sources for exactly this.
const wwccCallout = {
  heading: 'Ask us for the clearance numbers. Then verify them yourself.',
  body: [
    'In New South Wales, paid work in a child-related setting requires a Working With Children Check clearance, and cleaning a school or childcare centre is child-related work. The clearance belongs to the individual person, not to the company they work for, which is why "our team is all checked" is not an answer to anything. There is no company-level version of it.',
    'The step organisations skip is the second one. As the engaging service you are expected to verify each clearance number online before that person starts, and to keep a record that you did. So ask any cleaning contractor for a clearance number per individual who will attend your site, verify each one yourself, and ask what happens when they send a replacement at short notice. Ask us the same, and hold us to producing it in writing rather than in a sentence.',
  ],
};

// §3b The bridge into the two scopes. `StoryMosaic theme="light"` with two
// blocks — text, then the classroom frame. It exists to make the page's own
// structure legible before the reader hits two scope grids in a row: the
// split is the argument, so it gets stated rather than left to be inferred
// from two headings.
//
// Array order IS the layout (see SECTIONS.md). Text first here, because the
// photo is the school half of a claim the text has to make about both.
const splitBlocks = [
  {
    type: 'text' as const,
    body: [
      'A school and a childcare centre arrive at the same contractor and need two different documents. In a school, the room is empty when we are in it, the work is at desk height, and nobody who uses the building ever meets the cleaner. Everything hard about it is scheduling: term breaks, sport, exams, and the fact that a hall floor cannot be sealed on a Tuesday.',
      'In a childcare room, the cleaner is somebody the educators see every afternoon, the work is in the bottom sixty centimetres, and the surfaces that matter most are the ones children put in their mouths. Everything hard about it is trust and product choice. So the two scopes below are separate on purpose, and if you run both, you get both.',
    ],
  },
  {
    type: 'image' as const,
    ratio: '4/3',
    label:
      'A cleaner mopping the vinyl floor of a bright primary school classroom after hours, chairs stacked on the desks',
    src: classroomImg,
  },
];

// §4 School scope. `ServiceBlocks variant="icon-grid"`, first of TWO on this
// page — the split the file header explains.
//
// ⚠️ EVERY ITEM IS DRAFTED against standard practice, not supplied by TLB.
const schoolItems = [
  {
    icon: 'office' as const,
    title: 'Classrooms, after hours',
    description:
      'Floors vacuumed or mopped with chairs up, desks and tables wiped, whiteboard ledges and trays done, bins emptied and relined, and the reading corner and shelving tidied rather than just dusted around. Sinks in art and science rooms cleaned properly, because that is where a term’s worth of paint ends up.',
  },
  {
    icon: 'target' as const,
    title: 'Bathrooms, twice where it counts',
    description:
      'Toilets, urinals, basins and taps cleaned and disinfected, floors mopped including behind the pans, mirrors done, consumables restocked. In a primary school the bathrooms need a mid-day check as well as an after hours clean, and that check is the single most valuable half hour on the schedule.',
  },
  {
    icon: 'spray-bottle' as const,
    title: 'High-touch surfaces',
    description:
      'Door handles and push plates, light switches, handrails, bubbler and tap handles, and the shared equipment in specialist rooms. In a school these are how a gastro outbreak crosses a year group in three days, and they are the first thing a thin scope drops because nobody sees them being skipped.',
  },
  {
    icon: 'bloom' as const,
    title: 'Hall, library, canteen and staff areas',
    description:
      'Hall floors, library carpet and shelving, staff room kitchenette and bathrooms, and the front office and reception where every parent and visitor arrives. Canteen front of house cleaned; anything behind a canteen servery is a food premises with its own rules and its own page.',
  },
  {
    icon: 'key' as const,
    title: 'Outdoor hard surfaces',
    description:
      'Covered walkways, entry paths, the COLA slab and the seating areas swept and litter cleared, drains checked clear. Concrete in this region goes dark with algae through a wet season and needs pressure cleaning periodically, which is a separate service booked into a term break.',
  },
  {
    icon: 'chart-bars' as const,
    title: 'Term breaks: the periodic work',
    description:
      'Carpet extraction in classrooms and the library, hard floor strip and seal where the vinyl needs it, high dusting, vents, window sills and internal glass. School holidays are the only real window for any of it, so it goes on the schedule against a named break rather than "as required".',
  },
];

// §5 Childcare scope. The second icon grid, and deliberately shorter and
// sharper than the school one — the things that are genuinely different, not
// a restatement of the same list at a lower height.
//
// ⚠️ EVERY ITEM IS DRAFTED against standard practice, not supplied by TLB.
// The nappy change item carries a real bracket and it is the least pleasant
// and most scrutinised part of the work.
const childcareItems = [
  {
    icon: 'house' as const,
    title: 'Everything at knee height',
    description:
      'Low tables and chairs including the undersides and the legs, shelf edges, the bottom half of every door, the skirtings and the corners behind the book box. Children live in the bottom sixty centimetres of a room, and an adult-height clean misses most of it.',
  },
  {
    icon: 'spark' as const,
    title: 'Soft surfaces and mats',
    description:
      'Rugs and mats vacuumed properly rather than run over, cushion covers and soft furnishings vacuumed, sleep mats wiped down, and cot and stretcher frames done. Carpet in a childcare room needs extraction more often than an office does, because what lands on it is not dust.',
  },
  {
    icon: 'target' as const,
    title: 'Bathrooms and the nappy change area',
    description:
      // ⚠️ Real bracket, and it needs answering before this page ships.
      'Child-height toilets and basins, floors, and the nappy change bench, sink, bin and the wall behind it. [Whether TLB cleans the nappy change area, and with what products. Confirm.] It is the least pleasant line on any childcare scope and the one an assessor looks at first, so it needs naming rather than assuming.',
  },
  {
    icon: 'spray-bottle' as const,
    title: 'Products that belong in a room with children',
    description:
      'Low-odour, low-residue products, everything rinsed rather than left to dry on a surface a child will mouth, and nothing stored anywhere a child can reach. Our chemicals leave the building with us. If your centre’s policy specifies particular products, yours wins and it goes on the scope.',
  },
  {
    icon: 'puzzle' as const,
    title: 'What stays with educators',
    description:
      'Toys and equipment that go in mouths are sanitised by your educators, on your own rotation, under your own policy. We are happy to clean storage tubs and shelving, but a cleaner sanitising the toys is a cleaner making a food-safety-grade judgement about your service. That stays with the people who are trained for it.',
  },
  {
    icon: 'idea' as const,
    title: 'Working around the roster',
    description:
      'Most of the clean happens after the last pickup. What has to happen during the day — a bathroom check, a spill, an outdoor area — is done by someone your educators know by name, signed in, and never alone in a room with children. That last part is not negotiable and it is not a favour.',
  },
];

// §6 "Worth knowing". The lever here is absence: cleaning in an education
// setting is measured in days children are not in the room, which is a cost
// a director already tracks.
//
// ⚠️ VERIFICATION PASS REQUIRED:
//   - Education and care services in Australia operate under the National
//     Quality Framework, and the National Quality Standard includes
//     obligations about the physical environment being safe, clean and well
//     maintained. Correct in substance. NO QUALITY AREA OR ELEMENT NUMBER IS
//     QUOTED, on purpose — the NQS has been revised and a stale reference is
//     worse than none.
//   - Gastroenteritis and hand-foot-and-mouth spread readily in childcare and
//     surface cleaning is part of the recognised control set. Correct.
//   - No outbreak statistic is quoted, because any specific number would
//     need a source this page cannot cite.
const worthKnowingBody: TextBlockBody[] = [
  'The cost of thin cleaning in a school or centre is not measured in complaints, it is measured in absences. A gastro run through a childcare room takes out a third of the children and a couple of educators for a week, and it travels by hands onto surfaces far more than it travels through the air. The surfaces it uses are the ones a cheap scope drops first: door handles at child height, tap handles, the edge of the nappy change bench, the shelf every child grabs on the way past.',
  'For a centre there is a second layer to it. Education and care services operate under the National Quality Framework, and a safe, clean, well maintained physical environment is part of what a service is assessed on. An assessor does not want to hear that you have a cleaner. They want to see what that cleaner does, how often, and how you know it happened. A written scope with frequencies against each area is the difference between an assertion and evidence, and it is the reason we write ours to be filed rather than to be quoted.',
];

// §7 Related pages. Aged care is the nearest neighbour in terms of screening
// and cleaning around people, and the hospitality page's holiday parks are
// the other setting with children's amenities.
const relatedTags = relatedPremises('/schools-and-childcare-centres/');

// §8 Social proof. Bracketed [TBC] briefing slots, NOT real testimonials.
//
// ⚠️ HARD RULES, and they are stricter here than anywhere else on the site.
// Never quote a child. Never quote a parent about a named centre in a way
// that identifies their child's centre. Never name a specific school without
// written permission from the principal or the department, since a school's
// name is a public institution's name rather than a business's. These slots
// ask for the director, principal or business manager only.
// IMAGE-GUIDELINES §7 already forbids generating a face for any of them.
const testimonials = [
  {
    quote:
      '[TBC. Ask Teagan for a quote from a centre director about the clearance paperwork being produced without being chased. That is what a director is actually buying and it is what §3 argues for. Role and town, with written permission — and confirm the service is happy to be named at all.]',
    name: '[Centre name, TBC]',
    role: '[Role, for example centre director, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'TLB childcare cleaning client' },
  },
  {
    quote:
      '[TBC. Ask Teagan for a quote from a school business manager about the term-break periodic work happening on the dates it was scheduled. Nothing else in a school year has that little slack.]',
    name: '[School name, TBC]',
    role: '[Role, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'School business manager, TLB client' },
  },
  {
    quote:
      '[TBC. Ask Teagan for a quote about the same cleaners being known to educators by name. ⚠️ Do NOT source this from a parent or a child — see the §8 comment in this file.]',
    name: '[Service name, TBC]',
    role: '[Role, TBC]',
    rating: 5,
    avatar: { ratio: '1/1', label: 'Education and care service, TLB client' },
  },
];

// §9 Branded FAQs, in the CUSTOMER'S voice — a director, principal or
// business manager.
const brandedFaqItems = [
  {
    question: 'Do your cleaners hold a Working With Children Check?',
    answer:
      // ⚠️ THE gate. See the file header. This answer must not ship with the
      // bracket still in it.
      'They have to, and so does anyone else quoting your site. [TLB’s position: a current WWCC clearance number for every cleaner who would attend, produced in writing on request, and what happens when a replacement is sent at short notice. Confirm before this page ships.] Because our cleaners are employed by TLB rather than subcontracted, there is no third party holding that paperwork, which is what makes it possible to give you per person rather than per company.',
  },
  {
    question: 'When would you be on site?',
    answer:
      'After the last pickup for a centre, and after hours for a school, with the periodic work booked into term breaks. Anything that genuinely has to happen during the day — a bathroom check, a spill, an outdoor area — is done by someone your staff know, signed in through your own process, and never alone in a room with children.',
  },
  {
    question: 'Can you work to our own policies?',
    answer:
      // ⚠️ Real bracket. A service in an assessment cycle will ask for this.
      'Yes, and yours wins over our standard scope wherever they differ. If your cleaning and infection control policy specifies a product, a method or a frequency, it goes on the scope in writing. [Whether TLB will provide a written cleaning procedure a service can attach to its own NQF documentation. Confirm.] Ask for that at the walkthrough rather than at your next assessment.',
  },
  {
    question: 'Who sanitises the toys?',
    answer:
      'Your educators, on your own rotation and under your own policy. It is not us being unhelpful: toy sanitising is a judgement about your service’s practice and it belongs with people trained in it, and a cleaner doing it informally creates a gap in your own records. We clean storage tubs, shelving and the surfaces the toys sit on, which is the part that supports your rotation rather than replacing it.',
  },
  {
    question: 'What products would you use around children?',
    answer:
      'Low-odour, low-residue products, rinsed rather than left to air dry on any surface a child will touch or mouth, and nothing stored on site within reach. Our chemicals arrive and leave with the cleaner. Where your policy names particular products or requires a particular dilution, we use yours and it is written into the scope.',
  },
  {
    question: 'What happens if I get in touch?',
    answer:
      'We walk the site after hours with you, including the bathrooms and the nappy change area, and ask what your own policies require. Then you get a written scope split by area with a frequency against each line, a price per visit, and a schedule for the periodic work against named term breaks. No obligation.',
  },
];

// §10 Non-branded FAQs, the long-tail block.
//
// ⚠️ VERIFICATION PASS REQUIRED. Checkable claims:
//   - NSW WWCC: individual clearance, employer verification obligation.
//     Correct; no validity period quoted, on purpose.
//   - Queensland's equivalent is the Blue Card. Correct, and it is the open
//     question the hub raised.
//   - The National Quality Framework and National Quality Standard apply to
//     approved education and care services and include physical environment
//     obligations. Correct in substance; no element number quoted.
//   - Surface cleaning is part of the recognised control set for gastro and
//     hand-foot-and-mouth in childcare. Correct.
//   - No dollar figure anywhere, same as every sibling page.
const nonBrandedFaqItems = [
  {
    question: 'How much does school or childcare cleaning cost?',
    answer:
      // ⚠️ BRACKETED ON PURPOSE, same as every sibling page.
      'It is priced per visit against a written scope. The number moves with how many rooms and bathrooms there are, how much of the floor is carpet, whether a mid-day bathroom check is included, and how much outdoor hard surface there is. A centre with four rooms and a school with twenty classrooms are different jobs at different frequencies. [TLB’s pricing basis. Confirm.]',
  },
  {
    question: 'Do cleaners need a Working With Children Check in NSW?',
    answer:
      'Yes, where the work is child-related, and cleaning a school or childcare service generally is. The clearance is issued to the individual rather than to their employer, and the engaging organisation is expected to verify each clearance number online before that person starts and keep a record of doing so. Queensland uses a separate scheme, the Blue Card, so a contractor working across the border needs both. Check with the Office of the Children’s Guardian for the current requirements.',
  },
  {
    question: 'What are the cleaning requirements for childcare centres in Australia?',
    answer:
      'Approved education and care services operate under the National Quality Framework, and the National Quality Standard includes obligations about the physical environment being safe, clean and well maintained. The Standard sets the outcome rather than a task list, so each service translates it into its own cleaning and hygiene policy. That policy, not a contractor’s brochure, is the document a cleaning scope should be written against. This is general information, not compliance advice.',
  },
  {
    question: 'How often should a childcare centre be cleaned?',
    answer:
      'Daily at minimum for every room, bathroom and the nappy change area, with the main clean after the last pickup. Bathrooms and high-touch surfaces need attention during the day as well, which is why most centres run a mid-day check alongside the daily clean. Carpet extraction in a childcare room is usually two to four times a year rather than annually, because of what lands on it.',
  },
  {
    question: 'How does cleaning reduce illness in childcare?',
    answer:
      'Because the illnesses that close a room travel by hands and surfaces rather than through the air. Gastroenteritis and hand-foot-and-mouth both spread readily in a childcare setting, and surface cleaning of the things children actually touch — low door handles, tap handles, table edges, shelf lips, the change bench — is part of the recognised control set alongside handwashing and exclusion periods. Floors matter far less than the bottom sixty centimetres of everything else.',
  },
  {
    question: 'Should school cleaning happen during term breaks or during term?',
    answer:
      'Both, and they are different work. Daily cleaning happens during term, after hours. The periodic work — carpet extraction, hard floor strip and seal, high dusting, vents, internal glass — needs empty rooms and drying time, so it only really fits a term break. A scope that does not name which break each periodic task falls into tends to see none of them happen.',
  },
];

// §11 Closing CTA.
const closingCta = {
  kicker: 'Schools and childcare cleaning',
  heading: 'Ask us for the clearance numbers first.',
  lead: 'Then a walkthrough after hours, including the bathrooms and the change area. You get a written scope with a frequency against every line, and the periodic work booked to named term breaks.',
  cta: walkthroughCta,
};

const business = commercialBusiness(pageMeta.description);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    {/* §3 — above everything else on the page. The most important block in
        the cluster; see the file header. */}
    <Callout tone="warning" heading={wwccCallout.heading} body={wwccCallout.body} />

    <StoryMosaic theme="light" heading="Same trade, two different jobs" blocks={splitBlocks} />

    {/* §4 and §5 — TWO scope grids, not one. A school is cleaned empty at
        desk height; a childcare room is cleaned around children at knee
        height. Merging them produces a scope that is wrong for both. */}
    <ServiceBlocks
      variant="icon-grid"
      heading="Schools: what goes on the scope"
