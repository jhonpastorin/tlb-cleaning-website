      // out to be wrong is worse than no number, and the ACCC treats
      // from-pricing as a claim.
      'Commercial pressure cleaning is usually priced per square metre, with a minimum charge for small jobs. The rate moves with the surface, how badly stained it is, access to water and power, whether the work is after hours and whether the wash water has to be captured. Ask for the price against a written scope rather than an hourly rate, so you can see what is actually included. [TLB’s pricing basis and minimum charge. Confirm.]',
  },
];

// §13 Closing CTA. Same offer as the hero, worded as what actually happens.
const closingCta = {
  kicker: 'Commercial pressure cleaning',
  heading: 'Start with a walkthrough.',
  lead: 'We come and walk the site, look at the surfaces and tell you what will clean up and what will not. Then you get a written scope and a price. No obligation.',
  cta: { label: 'Book a site walkthrough', href: quoteCta.href },
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar and definition share ONE photo behind a Cream scrim, laid
        across both sections. 75% keeps Dark Teal body copy above 4.5:1 over
        the darkest part of the frame.

        The photo is this page's own wide exterior rather than the homepage
        interior the hub and the carpet sibling borrow. See the import. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <ServiceBlocks
      variant="icon-grid"
      heading="What a pressure clean actually involves"
      lead="Six stages, in this order. The last two are what you are really paying for."
      items={scopeItems}
      cta={{ label: 'Book a site walkthrough', href: quoteCta.href }}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading="Two things to ask before you let anyone start"
      body={worthKnowingBody}
    />

    {/* ⚠️ RESERVED SLOT: before and after slider (BeforeAfter.astro).

        A half-cleaned car park is the most persuasive image in this entire
        category, and the component is already running on five pages.

        NOT BUILT because BeforeAfter has no reserved-slot mode by design: its
        `src` is required, since a comparison slider with nothing to compare
        has no meaningful empty state. No commercial exterior photography
        exists.

        THE PHOTO BRIEF: one surface, shot from a fixed tripod position,
        before and after, with NOTHING moved between the frames — no car
        parked in the second shot, no bin shifted. Concrete and pavers are the
        best subjects because the change is unmistakable. Two or three pairs
        is plenty. Drop it in here, between "Worth knowing" and the related
        pages. */}

    <TagCloud
      heading="Where we pressure clean"
      subheading="Outdoor hard surfaces for workplaces across the Northern Rivers and the Tweed."
      tags={settingTags}
      note={[]}
    />

    <ComparisonTable
      heading={comparisonTable.heading}
      cornerLabel={comparisonTable.cornerLabel}
      lead={comparisonTable.lead}
      columns={comparisonTable.columns}
      rows={comparisonTable.rows}
    />

    <TestimonialCarousel heading="What our clients say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Across the Northern Rivers and the Tweed."
      groups={nswLocationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently Asked Questions" items={brandedFaqItems} />
    <Faq heading="Commercial Pressure Cleaning FAQs" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
