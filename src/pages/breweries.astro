  lead: 'And we will ask about your brew calendar before your floor area. Then a written scope split into production and taproom, with the boundary written down rather than assumed.',
  cta: walkthroughCta,
};

const business = commercialBusiness(pageMeta.description);
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    {/* §1 — the only `split-collage` hero in the cluster. Three frames,
        production / hospitality / production, because the page's argument is
        that this is two buildings on one lease and a single hero image would
        have to pick a side. */}
    <Hero
      variant="split-collage"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      lead={hero.lead}
      cta={hero.cta}
      collageImages={hero.collageImages}
    />

    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock theme="muted" align="left" body={definitionBody} />
    </Backdrop>

    {/* §3 — the spine of the page, before any scope. Not to be softened; see
        the file header. */}
    <Callout tone="warning" heading={cipCallout.heading} body={cipCallout.body} />

    {/* §4 — the second `highlight` in the cluster after the medical page. The
        reader picks the side of the wall they are asking about rather than
        reading through all three. */}
    <ServiceBlocks
      variant="highlight"
      heading="Two standards, one building"
      lead="Pick the side you are asking about. The third panel is the boundary, and it is the most important of the three."
      items={zoneItems}
    />

    {/* The drain frame, given a band of its own because §5 is about to argue
        that this unglamorous strip of stainless is the most important surface
        in the building, and the photo makes that legible before the argument
        starts.

        ⚠️ Source is 4:3 in a 16/9 box, so `cover` crops top and bottom.
        Checked: the trench drain, the lifted grate end and the kegs all
        survive the crop, which is everything the caption claims. */}
    <ImageBand
      ratio="16/9"
      label="A cleaner squeegeeing water towards a stainless trench drain beside a row of clean stainless kegs in a brewery cellar"
      caption="Grates up, channel scrubbed, squeegeed dry. The most important surface in the building."
      src={kegLineImg}
    />

    <ContentGrid
      heading="Four things about drains"
      lead="Every brewer already knows this. Every landlord and most venue managers do not."
      columns={2}
      blocks={drainBlocks}
    />

    <TextBlock
      theme="dark"
      align="left"
      heading="Your CIP protects the vessel. Nothing protects the room."
      body={worthKnowingBody}
    />

    <TagCloud
      heading="Other premises we clean"
      subheading="Commercial cleaning for every kind of premises across the Northern Rivers and the Tweed."
      tags={relatedTags}
      note={[]}
    />

    <TestimonialCarousel heading="What brewers say" testimonials={testimonials} uniform />

    <TagCloud
      heading="Where we clean"
      subheading="Across the Northern Rivers and the Tweed."
      groups={nswLocationGroups}
      note={["If a town isn't listed, ask us anyway."]}
    />

    <Faq heading="Frequently Asked Questions" items={brandedFaqItems} />
    <Faq heading="Brewery Cleaning FAQs" items={nonBrandedFaqItems} />

    <CallToAction
      variant="secondary"
      kicker={closingCta.kicker}
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
