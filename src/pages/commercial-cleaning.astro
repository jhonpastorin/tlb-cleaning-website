    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    <Hero
      variant="split-single-image"
      imagePosition="right"
      kicker={hero.kicker}
      headingLines={hero.headingLines}
      subheading={hero.subheading}
      lead={hero.lead}
      cta={hero.cta}
      image={hero.image}
    />

    {/* Trust bar + definition block share ONE photo behind a Cream scrim,
        so it is laid out across both — see the homepage for why a
        per-section background cannot do this. 75% keeps Dark Teal body
        copy above 4.5:1 over the darkest part of the frame. */}
    {/* ✅ H2 ADDED (copy-rewrite brief §9). This block had no heading at all:
        it rendered as two paragraphs of body copy with nothing above them, so
        the only heading on the page carrying the primary keyword was an FAQ
        label. This is not a new section — the paragraph below already reads
        as a definition and is the page's strongest answer-target — it is a
        heading for a section that already existed. */}
    <Backdrop image={definitionBgImg} tint="muted" opacity={75}>
      <TrustBar variant="card" cards={trustBarCards} />
      <TextBlock
        theme="muted"
        align="left"
        heading="What commercial cleaning covers"
        body={definitionBody}
      />
    </Backdrop>

    <PathwayCards heading={pathwayCards.heading} headingAccent={pathwayCards.headingAccent} cards={pathwayCards.cards} />

    <TextBlock
      theme="dark"
      align="left"
      heading="Why two quotes for the same clean can look nothing alike"
      body={worthKnowingBody}
    />

    {/* ✅ NOTE LINE FILLED (copy-rewrite brief §11). `note={[]}` was rendering
        as blank space under the pills. "Where we clean" below already uses the
        same slot to the same effect, and this is the smallest version of the
        BFD §8.3 worry — whether a business like yours is one TLB actually
        cleans. Fifteen pills cannot answer that for the sixteenth reader. */}
    <TagCloud
      heading="What we clean"
      subheading="Ongoing cleaning for workplaces across the Northern Rivers and the Tweed."
      tags={premisesTags}
      note={["If your premises isn't on the list, ask us anyway. Most of it is the same work in a different building."]}
    />

    {/* ⚠️ THE SCOPE OF WORK BELONGS HERE AND DOES NOT EXIST.
        The block above tells the reader "the number that actually matters
        is not the hourly rate, it is what is in the scope", and then asks
        to demand a task list from any cleaner. Branded FAQ 4 promises "we
        agree the scope in writing". Non-branded FAQ 4 says "get it written
        into the scope before you sign anything". The page tells the reader
        to demand a scope four times and never shows one — which currently
        leaves TLB as the only cleaner on the page not showing its own.

        This is the highest-value missing content here, above even the
        definition paragraph, because it is what the page's own argument
        promises. It needs: what's done every visit, what's weekly vs.
        monthly, and whether consumables are in or out.

        NOT INVENTED. This is TLB's actual commercial scope and only they can
