// split/join rather than a regex: a word-boundary escape in the frontmatter
// trips the Astro compiler, and no boundary is needed anyway — "walkthrough"
// appears once and never as part of a longer word.
//
// ⚠️ FOLD THIS BACK into data/brand-lines.ts the moment the premises pages
// adopt "Book a walk-through" as well, and delete this block.
const theLineBodyCommercial: TextBlockBody[] = theLineBody.commercial.map((paragraph) =>
  paragraph.split('walkthrough').join('walk-through'),
);

// §13 Closing CTA — ⚠️ not in the brief, which has no closing-CTA row (and
// three mid-page rows reading "CTA -" with nothing after them).
//
// The lead is what actually happens, and it is now the ONLY place this copy
