const brandedFaqItems = [
  {
    question: 'Are we too small a business for you?',
    answer:
      'Not at all. A two person office matters to us as much as a large one does. We quote the same way, run the same set schedule and send the same team whatever the size, and small premises are a large part of what we already clean.',
