---
// THE REGION PAGE, once, for all three regions at /locations/<region>/.
//
// WHY A LAYOUT AND THREE THIN PAGE FILES, rather than one dynamic route.
// /locations/<town>/ is already a dynamic route, and a second dynamic route
// in the same directory claims the same URL pattern — Astro cannot tell
// /locations/byron-bay/ from /locations/northern-rivers/ by shape alone. A
// static file wins over a dynamic sibling without ambiguity, so the three
// regions ship as three ~6-line files that each hand this layout a slug.
// The layout lives here once, exactly as [town].astro does for 56 towns.
//
// TO ADD A REGION, DON'T TOUCH THIS FILE. Regions come from
// src/data/regionPages.ts; add an entry there and a matching thin page file.
// Read that file's header first — particularly its warning that a region
// page which differs only by a name and a town list is a doorway page.
//
// ⚠️ COPY IS REUSED, NOT DRAFTED. The body paragraphs are the /locations/
// hub's own §4 region cells, verbatim. regionPages.ts explains why, and
// records the cost: the hub and these three pages now carry identical
// paragraphs, and one of the two should eventually be rewritten so they
// differ. Do not let that note get lost if this page is edited.
//
// ⚠️ NO TESTIMONIALS, NO BEFORE/AFTER, deliberately. A town page carries
// both. This page does not, because neither can be made true of a region:
// TestimonialCarousel on /locations/<town>/ is already flagged there as
// showing the same quotes on all 56 pages, and repeating that trick at
// region level would multiply an existing problem rather than add anything.
// Add them when there is region-specific material, not before.
//
// PHOTOGRAPHY. The three region photos from townPages.ts' own `heroImages`,
// reused rather than re-imported by path so the alt text and the "no hero
// may name a town or a landmark" rule stay in one place. These are generated
// scenes, not photographs of these places — IMAGE-GUIDELINES.md §5 and
// townPages.ts' header. The copy names towns; the image labels never do.
import Base from './Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import ServiceBlocks from '../components/sections/ServiceBlocks.astro';
import TagCloud from '../components/sections/TagCloud.astro';
import Faq from '../components/sections/Faq.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import logoImg from '../assets/logo/tlb-logo-horizontal.png';
import footerLogoImg from '../assets/logo/tlb-logo-square.png';
import type { ServiceIconName } from '../components/ui/ServiceIcon.astro';
import type { Tag } from '../components/sections/TagCloud.astro';
import {
  primaryNav,
  headerNav,
  headerSecondaryCta,
  footerServiceLinks,
  footerContact,
  footerCopyright,
  quoteCta,
  serviceLinks,
} from '../data/navigation';
import { trustBarCards } from '../data/trust';
import { isNavigableTown, townSlug } from '../data/locations';
import { regionHero, regionPageBySlug } from '../data/regionPages';

interface Props {
  /** A slug from regionPages.ts. */
  slug: string;
}

const { slug } = Astro.props;
const region = regionPageBySlug(slug);
const hero = regionHero(region);

const pageMeta = {
  title: region.meta.title,
  description: region.meta.description,
  // ⚠️ Same domain every page in this repo uses. Confirm before launch.
  canonical: `https://tlbcleaning.com.au/locations/${region.slug}/`,
};

// ⚠️ `areaServed` narrows to this region, which is the point of the page —
// the /locations/ hub carries the wide three-region string instead. Every
// other field is empty, inherited from every page built before these; one
// fix in one place would fill the whole site's structured data and nobody
// has supplied the details yet.
const business = {
  name: 'TLB Cleaning',
  url: 'https://tlbcleaning.com.au/',
  logo: '',
  telephone: '',
  email: '',
  address: {
    streetAddress: '',
    addressLocality: '',
    addressRegion: region.state,
    postalCode: '',
    addressCountry: 'AU',
  },
  sameAs: [],
  areaServed: `${region.headingLabel}`,
  description: pageMeta.description,
};

// The town pills. Every town in the region is NAMED; only a navigable one is
// LINKED, which is the same rule the header menu follows and which
// locations.ts' `navigableTowns` is the single source for. TagCloud renders a
// tag with no href as a plain <span> pill, which is exactly the "we clean
// here, there is no page to send you to" state — its own documented
// behaviour, not a workaround.
const townTags: Tag[] = region.towns.map((town) => ({
  label: town,
  ...(isNavigableTown(town) ? { href: townSlug(town) } : {}),
}));

// Same six services the footer column, the homepage grid, the hub and all 56
// town pages render, reused from navigation.ts.
//
// ⚠️ Icons keyed by href, not by array index, copied from the hub's own map
// for the reason it gives: reordering serviceLinks must not silently shuffle
// the icons. A seventh service needs an entry in every one of these maps —
// the `list` variant renders a fixed icon segment per row, so a missing icon
// leaves an empty block rather than collapsing.
const serviceIcons: Record<string, ServiceIconName> = {
  '/house-cleaning/': 'house',
  '/house-cleaning/deep-cleaning/': 'spray-bottle',
  '/house-cleaning/end-of-lease-cleaning/': 'bloom',
  '/house-cleaning/airbnb-cleaning/': 'suitcase',
  '/house-cleaning/real-estate-cleaning/': 'key',
  '/commercial-cleaning/': 'office',
};

const serviceItems = serviceLinks.map((service) => ({
  icon: serviceIcons[service.href],
  title: service.title,
  description: service.description,
  href: service.href,
}));

// Region-level questions only. The what-is-included questions belong on the
// service pages and the per-town ones are on the town pages; repeating either
// here would add duplicate text to a site that already runs 56 pages off one
// template.
//
// ⚠️ THE TRAVEL-CHARGE ANSWER IS THE SAME UNCONFIRMED OPERATIONAL PROMISE
// /locations/<town>/ makes on all 56 pages and the hub makes again, and it is
// flagged in both. It asserts no travel charge anywhere in this region,
// which at region level covers the far edges — Kyogle, Woodburn, Mooball —
// and the hub's version now covers the same full list. If TLB does
// charge for the outer reaches, this is the first answer to fix and it is
// wrong on four pages, not one.
const faqItems = [
  {
    question: `Do you clean every town in ${region.label}?`,
    answer: `Every town on this page, yes. If your suburb is not named here, ask anyway — the list is where we work regularly, not a fence. We would rather tell you straight than have you guess from a map.`,
  },
  {
    question: 'Is there a travel charge for the outer towns?',
    answer:
      'No. The price is the same wherever you are on this page. [CONFIRM] — this promise is made on every location page on the site and has not been confirmed operationally.',
  },
  {
    question: 'Do you work across the border?',
    answer:
      'Yes. We work both sides of the Tweed, which is unusual — most cleaners pick a state. It matters most at the end of a lease, when the paperwork changes even though the cleaning does not.',
  },
  {
    question: 'Can I get the same cleaner each visit?',
    answer:
      'That is how regular cleaning is set up: a set day and the same team, so nobody has to be talked through your house twice. One-off and end-of-lease jobs are scheduled around the date you need rather than a standing slot.',
  },
];

const closingCta = {
  heading: `Get a quote for ${region.label}.`,
  lead: 'Tell us the suburb and what needs doing. We will come back with a price and a day, not a call centre.',
  cta: quoteCta,
};
---

<Base title={pageMeta.title} description={pageMeta.description} canonical={pageMeta.canonical} business={business}>
  <SiteHeader
    logo={{ label: 'TLB Cleaning', src: logoImg }}
    primaryNav={primaryNav}
    serviceNav={headerNav}
    secondaryCta={headerSecondaryCta}
    cta={quoteCta}
  />

  <main id="main">
    {/* `full-width-photo`, matching /locations/<town>/ and the hub rather than
        the service pages' `split-single-image`: a location page opens on a
        place, and that variant floats a solid card over the photo so the copy
        never depends on the photo's own contrast. */}
    <Hero
      variant="full-width-photo"
      kicker="Areas we clean"
      headingLines={region.headingLines}
      lead={region.lead}
      cta={quoteCta}
      image={{ ratio: '16/9', label: hero.label, src: hero.src }}
    />

    <TrustBar variant="card" surface="plain" cards={trustBarCards} />

    <TextBlock
      theme="light"
      align="left"
      heading={`Cleaning in ${region.label}.`}
      body={region.intro}
    />

    {/* `list` variant rather than the homepage's image tiles, same call the
        town route makes: six rows of text link out cleanly and don't imply
        that the photo was taken in this region. */}
    <ServiceBlocks
      variant="list"
      heading={`What we do across ${region.label}`}
      lead="Every service below is available in every town on this page."
      items={serviceItems}
    />

    <TagCloud
      heading={`Towns we clean in ${region.label}`}
      subheading={`${region.towns.length} towns and suburbs, ${region.headingLabel}.`}
      tags={townTags}
      note={["If a suburb isn't listed, ask us anyway."]}
    />

    <Faq heading={`Cleaning in ${region.label}: your questions`} items={faqItems} />

    <CallToAction
      variant="secondary"
      heading={closingCta.heading}
      lead={closingCta.lead}
      cta={closingCta.cta}
    />
  </main>

  <SiteFooter
    logo={{ label: 'TLB Cleaning', src: footerLogoImg }}
    columns={[
      { title: 'Services', links: footerServiceLinks },
      { title: 'Locations', links: [{ label: 'View all locations', href: '/locations/' }] },
    ]}
    contact={footerContact}
    copyright={footerCopyright}
  />
</Base>
