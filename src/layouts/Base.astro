---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

// Preload the display face used for H1 (Poppins 700) so the largest,
// earliest text on the page doesn't wait on font discovery via the CSS.
import poppinsBoldWoff2 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';

// Every page on the site reaches this layout, so this import is the one place
// the noindex decision has to be made. See site-env.ts for why it fails closed.
import { isStaging, robotsContent, siteEnv } from '../data/site-env';

export interface LocalBusinessInfo {
  name: string;
  url: string;
  logo: string;
  telephone: string;
  email: string;
  address: {
    streetAddress: string;
    addressLocality: string;
    addressRegion: string;
    postalCode: string;
    addressCountry: string;
  };
  sameAs: string[];
  areaServed: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  business: LocalBusinessInfo;
}

const { title, description, canonical, ogImage, business } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  url: business.url,
  logo: business.logo,
  image: ogImage ?? business.logo,
  telephone: business.telephone,
  email: business.email,
  description: business.description,
  areaServed: business.areaServed,
  address: {
    '@type': 'PostalAddress',
    ...business.address,
  },
  sameAs: business.sameAs,
};

// Google Tag Manager. One container across both environments; the ID is not a
// secret, so it lives here rather than in an env var.
const GTM_CONTAINER_ID = 'GTM-KDMCQNN9';

// Pushed BEFORE the container loads, so siteEnv is already on the dataLayer
// when GTM fires its very first event and every tag can read it.
const dataLayerInit = `window.dataLayer = window.dataLayer || [];
window.dataLayer.push({ siteEnv: '${siteEnv}' });`;

// Googles snippet verbatim, with the container ID interpolated.
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_CONTAINER_ID}');`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Tag Manager, as high in the head as the document allows: only
        charset and viewport go above it, and both have to, because they change
        how the rest of the document is parsed and laid out.

        ⚠️ GTM LOADS ON STAGING TOO, on purpose, so tags can be tested there
        with Preview mode. What keeps staging traffic out of GA4 and Ads is a
        blocking exception on siteEnv === "staging", and THAT EXCEPTION LIVES IN
        THE GTM UI, NOT IN THIS REPO. It is not version controlled and nothing
        here can verify it. If it is removed or never configured, staging
        silently starts reporting as real traffic. The noindex in this same head
        does not help with that: indexing and tag firing are unrelated.

        is:inline on both, for the same reason as the JSON-LD below: without it
        Astro bundles, hashes and relocates the script, which loses the position
        the snippet depends on. */}
    <script is:inline set:html={dataLayerInit} />
    <!-- Google Tag Manager -->
    <script is:inline set:html={gtmSnippet} />
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Staging only. The canonical above deliberately still points at the
        production domain — with noindex present that is harmless, and it keeps
        staging and production markup identical apart from this one line. */}
    {isStaging && <meta name="robots" content={robotsContent} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={business.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" content="#234B51" />
    {/* Favicon set lives in public/ and is served from the site root. The
        .ico carries the legacy/desktop sizes; the PNGs are what modern
        browsers actually pick, and apple-touch-icon is the iOS home screen.
        No .svg in the set — the one that used to sit here was the previous
        brand's placeholder mark. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={poppinsBoldWoff2} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    {/* Google Tag Manager noscript fallback. Google requires it immediately
        after the opening <body>. It is display:none and zero-sized, so it stays
        out of the skip links focus order and adds nothing visible. */}
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
