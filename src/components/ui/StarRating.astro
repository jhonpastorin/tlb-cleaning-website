---
// Extracted from TestimonialCarousel.astro once LogoBar.astro's featured
// quote needed the exact same star-row — real reuse, not speculative (same
// bar ServiceIcon.astro was held to). Deliberately sets no `color` itself —
// callers set it on their own wrapper, since currentColor inherits fine and
// a class passed straight into this component's root wouldn't be stylable
// from the caller's scoped <style> anyway (see Hero.astro's header comment).
interface Props {
  rating: number;
  max?: number;
}

const { rating, max = 5 } = Astro.props;
---

<span class="star-rating" role="img" aria-label={`${rating} out of ${max} stars`}>
  {Array.from({ length: max }).map((_, i) => (
    <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
      <path
        d="M10 1.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8Z"
        fill={i < rating ? 'currentColor' : 'none'}
        stroke="currentColor"
        stroke-width="1"
      />
    </svg>
  ))}
</span>

<style>
  .star-rating {
    display: inline-flex;
    gap: 2px;
  }
</style>
