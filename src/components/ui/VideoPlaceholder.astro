---
interface Props {
  ratio?: string;
  label: string;
  caption?: string;
  class?: string;
}

const { ratio = '16/9', label, caption, class: className } = Astro.props;
---

<div
  class:list={['video-placeholder', className]}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={`${label} (video)`}
>
  <span class="video-placeholder__label">{label} · {ratio}</span>

  <span class="video-placeholder__play" aria-hidden="true">
    <svg viewBox="0 0 64 64" width="28" height="28" focusable="false">
      <path d="M22 16 L48 32 L22 48 Z" fill="currentColor" />
    </svg>
  </span>

  {caption && (
    <span class="video-placeholder__caption">{caption}</span>
  )}
</div>

<style>
  .video-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-muted);
    border: 1px dashed var(--color-border-muted);
    border-radius: inherit;
    overflow: hidden;
  }

  .video-placeholder__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-body);
    text-align: center;
    padding: 0 var(--space-md);
  }

  .video-placeholder__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-inverse);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .video-placeholder__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-xs) var(--space-md);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
    color: var(--color-on-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
  }
</style>
