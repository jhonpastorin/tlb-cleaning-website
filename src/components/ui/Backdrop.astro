---
// Puts ONE background photo behind a run of adjacent sections, with the
// brand ground laid over it as a scrim.
//
// Why this exists rather than each section carrying its own photo (which
// TextBlock.astro's `backgroundImage` already does, and still does for a
// section standing alone): two stacked sections each rendering the same
// image would each `cover` their own box, so the photo would restart at the
// seam between them — two different crops of the same room, visibly
// mismatched. Here the image is laid out once, across the full height of
// everything slotted in.
//
// The children must not paint their own backgrounds over it. Rather than
// giving every section a "transparent" theme, this sets the background
// token each one already reads to `transparent` from out here — see the
// :global rules at the bottom of the sheet. A section added to this list
// needs its own background to be a token, not a hardcoded colour.
//
// `display: flow-root` on the root is load-bearing. The trust bar's card
// variant pulls itself UP into the hero with a negative top margin; without
// a block formatting context that margin collapses through this wrapper and
// drags the wrapper's top edge — and so the photo's — up over the bottom of
// the hero. With one, the wrapper's top edge stays on the hero's bottom
// edge and the card overflows above it, which is exactly the arrangement
// the overlap wants.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The photo. Decorative by definition here, so it renders with alt="". */
  image: ImageMetadata;
  /** Which ground goes over it. Matches TextBlock's theme names so a wrapped
   *  block and its wrapper can't be described in two different vocabularies. */
  tint?: 'light' | 'muted' | 'dark';
  /** Scrim opacity, 0-100. Default 90. Lower shows more photo, at the cost of
   *  the copy's contrast against whatever happens to be underneath it.
   *
   *  ⚠️ DO NOT DROP THIS BELOW 90 ON `muted` WITHOUT MEASURING. The old
   *  advice here was "re-check the wrapped copy against the lightest AND
   *  darkest areas of the image", which was correct and was not followed by
   *  anyone, because it asks the caller to go and do an unspecified amount of
   *  work. So here is the number instead.
   *
   *  Method, if you do need to re-measure: composite the photo under
   *  `color-mix(in srgb, Cream <opacity>%, transparent)` in 8-bit sRGB, which
   *  is how the browser blends it, then take the WCAG ratio of Dark Teal
   *  (--color-body, #234B51) against the 0.5th percentile of luminance inside
   *  the centre 55.6% of the frame. That band is .container--narrow (800px) at
   *  a 1440px viewport, i.e. where the copy actually sits. A percentile rather
   *  than the single darkest pixel, so sensor noise doesn't set the budget.
   *
   *  Measured across all 17 photos used as backdrops on this site, 29 Sep 2026:
   *
   *    75%   4.09 - 4.57:1    FAILS AA on 5 of the 17
   *    78%   ~4.67:1          bare pass
   *    80%   4.63 - 5.29:1    bare pass
   *    90%   5.90 - 6.26:1    passes with margin on every one
   *
   *  4.5:1 is the AA floor, but a bare pass is worth less over a photograph
   *  than over a flat fill: glyph edges compete with image edges, so effective
   *  legibility runs below the point-sampled ratio. Hence 90, not 80.
   *
   *  The flip side, stated honestly: at 90 most of these photos survive as
   *  texture rather than as pictures. If a backdrop needs to READ as a photo,
   *  the answer is an image that can take a scrim — high key, evenly lit, no
   *  clipped blacks under the centre column — not a lower number here. */
  opacity?: number;
  /** Which part of the photo survives the crop. These sections are a shallow
   *  band and the image is landscape, so `cover` throws away most of its
   *  height — 'center' (the default) keeps the middle. Use 'top' when the
   *  subject sits high in the frame, 'bottom' when it sits low. */
  focus?: 'top' | 'center' | 'bottom';
  /** Set for a backdrop above the fold, so the photo isn't lazy-loaded. */
  eager?: boolean;
}

const { image, tint = 'muted', opacity = 90, focus = 'center', eager = false } = Astro.props;
---

<div
  class:list={['backdrop', `backdrop--${tint}`]}
  style={`--backdrop-scrim-opacity: ${opacity}%; --backdrop-focus: ${focus};`}
>
  <div class="backdrop__bg" aria-hidden="true">
    <Image
      src={image}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class="backdrop__scrim"></span>
  </div>

  <div class="backdrop__content">
    <slot />
  </div>
</div>

<style>
  .backdrop--light {
    --backdrop-ground: var(--color-surface);
  }

  .backdrop--muted {
    --backdrop-ground: var(--color-surface-muted);
  }

  .backdrop--dark {
    --backdrop-ground: var(--color-inverse);
  }

  .backdrop {
    display: flow-root; /* see the header comment — not cosmetic */
    position: relative;
    isolation: isolate;
    /* Shows while the photo loads, and stands in for good if it never does. */
    background: var(--backdrop-ground);
  }

  .backdrop__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .backdrop__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--backdrop-focus, center);
    display: block;
  }

  .backdrop__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--backdrop-ground) var(--backdrop-scrim-opacity, 80%), transparent);
  }

  .backdrop__content {
    position: relative;
    z-index: 1;
  }

  /* Hand every wrapped section a transparent ground. Each of these targets a
     token the section already reads for its own background, so nothing here
     reaches past a section's public surface into its internals. */
  .backdrop__content :global(.text-block) {
    --text-block-bg: transparent;
  }

  .backdrop__content :global(.trust-bar--card) {
    --trust-bar-fill: transparent;
  }
</style>
