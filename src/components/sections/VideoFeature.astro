---
import VideoPlaceholder from '../ui/VideoPlaceholder.astro';
import { sectionHeadingTags } from '../../lib/headings';

interface Props {
  headingLines: string[];
  video: { label: string; caption?: string; ratio?: string };
}

const { headingLines, video } = Astro.props;

const { Heading } = sectionHeadingTags(headingLines.join(' '));

// ⚠️ HIDDEN ON EVERY PAGE (6 Oct 2026). This section can only render
// VideoPlaceholder's dashed frame and no real video exists yet, so it was
// showing visitors an empty "Walkthrough video of..." box. The callers (house
// cleaning, deep cleaning, end of lease) keep their <VideoFeature> line and
// copy, so the section returns from here: give it a real video to play, then
// set this to true.
const showSection = false;
---

{showSection && (
<section class="video-feature" aria-labelledby="video-feature-heading">
  <div class="container video-feature__inner">
    <Heading id="video-feature-heading" class="title-2 video-feature__heading">
      {headingLines.map((line) => (
        <>
          {line}
          <br />
        </>
      ))}
    </Heading>

    <div class="video-feature__frame">
      <VideoPlaceholder ratio={video.ratio ?? '16/9'} label={video.label} caption={video.caption} />
    </div>
  </div>
</section>
)}

<style>
  .video-feature__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .video-feature__heading {
    max-width: 26ch;
  }

  .video-feature__frame {
    width: 100%;
    max-width: 720px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .video-feature__inner {
      padding-block: var(--space-xl);
    }
  }
</style>
