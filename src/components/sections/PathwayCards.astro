---
import Placeholder from '../ui/Placeholder.astro';
import Button from '../ui/Button.astro';
import type { ImageBlock, ButtonData } from '../../data/types';

interface Card {
  number: number;
  image: ImageBlock;
  title: string;
  description: string;
  cta: ButtonData;
}

interface Props {
  heading: string;
  /** Second heading line, on its own line under `heading` — pass as a prop, never hardcode a second string. Styled the same Off White as the rest of the heading; see the note on `.pathway__heading-accent` for why it is no longer a contrasting colour. */
  headingAccent: string;
  cards: Card[];
}

const { heading, headingAccent, cards } = Astro.props;
---

<section class="pathway" aria-labelledby="pathway-heading">
  <div class="container pathway__inner">
    <h2 id="pathway-heading" class="pathway__heading">
      {heading}
      <br />
      <span class="pathway__heading-accent">{headingAccent}</span>
    </h2>

    <ul class="pathway__list">
      {cards.map((card) => (
        <li class="pathway__card">
          <div class="pathway__image">
            <Placeholder ratio={card.image.ratio} label={card.image.label} src={card.image.src} />
          </div>
          <div class="pathway__body">
            <div class="pathway__title-row">
              <span class="pathway__number" aria-hidden="true">{card.number}</span>
              <h3 class="pathway__title">{card.title}</h3>
            </div>
            <p class="pathway__description">{card.description}</p>
            <Button label={card.cta.label} href={card.cta.href} variant={card.cta.variant ?? 'brand'} fullWidth />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pathway {
    background: var(--color-inverse);
  }

  .pathway__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .pathway__heading {
    text-align: center;
    color: var(--color-on-inverse);
  }

  /* ⚠️ WAS --color-brand, AND THAT MADE THIS LINE INVISIBLE ON ALL 24 PAGES
     USING THIS COMPONENT. The section band above is --color-inverse, and
     tokens.css Layer 2 resolves --color-brand and --color-inverse to the
     SAME Dark Teal (#234B51) — so the accent line was teal ink on a teal
     band at 1:1 contrast, rendering as a blank second line under the
     heading.

     This is a leftover from the brand re-skin, not an original mistake: the
     `headingAccent` prop is still documented as "rendered in brand yellow",
     which it was under the previous brand's palette. That yellow has no
     successor in the TLB brand bible, so the accent now simply matches the
     rest of the heading rather than inventing a colour the brand does not
     have. --color-on-inverse is Off White (#F4EFE3) at 8.33:1 on this band,
     which is the white this site actually uses; --tlb-white is a placeholder
     primitive, not a brand colour, so do not reach for it here.

     Exactly the bug class Callout.astro's own style block already warns
     about. If this line is ever meant to be visually distinct again, the
     only Layer 2 role available is --color-accent (Mint Green) — check its
     contrast on the band before using it, and change it here so all 24 pages
     move together. */
  .pathway__heading-accent {
    color: var(--color-on-inverse);
  }

  .pathway__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    width: 100%;
  }

  .pathway__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .pathway__image {
    border-radius: 0;
  }

  .pathway__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .pathway__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .pathway__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-small);
    flex-shrink: 0;
  }

  .pathway__title {
    font-size: var(--title-6);
    color: var(--color-on-surface);
  }

  .pathway__description {
    color: var(--color-body);
    flex: 1;
  }

  /* mirrors --bp-md (spec: stack to one column below 800px) */
  @media (max-width: 800px) {
    .pathway__list {
      grid-template-columns: 1fr;
    }
  }
</style>
