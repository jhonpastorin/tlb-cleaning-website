---
// Five variants, one component — extend with a variant value, don't fork:
//  - icon-grid (default): icons + label + description in a responsive grid.
//  - image-cards: image-top cards, each with a full-width dark footer link
//    (a different affordance than Button.astro's pill — see SECTIONS.md).
//  - list: stacked pill-shaped rows, icon segment + text + a circular
//    "go" arrow.
//  - highlight: N compact cards feed one enlarged showcase panel above them;
//    clicking a card swaps the showcase's content with a brief zoom-in.
//  - slider: one showcase panel at a time, navigated with prev/next arrows
//    and dots — the exact interaction pattern TestimonialCarousel.astro
//    already established, adapted to a single 100%-wide slide per item
//    instead of a 3-up centred/scaled track.
//
// See Hero.astro's header comment for the Placeholder-wrapping rule this
// file follows throughout: never pass a class straight into <Placeholder>
// when this file's <style> needs to size or position it — wrap it in a
// plain <div> authored here instead, or the rule silently never matches.
import Placeholder from '../ui/Placeholder.astro';
import Button from '../ui/Button.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import type { ServiceIconName } from '../ui/ServiceIcon.astro';
import type { ImageBlock, ButtonData } from '../../data/types';

type Variant = 'icon-grid' | 'image-cards' | 'list' | 'highlight' | 'slider';

interface ServiceItem {
  /** icon-grid, list */
  icon?: ServiceIconName;
  /** image-cards, highlight, slider */
  image?: ImageBlock;
  title: string;
  description: string;
  /** image-cards (footer bar), highlight/slider (showcase button) */
  cta?: ButtonData;
  /** list only: row link target. Defaults to '#' if omitted. */
  href?: string;
}

interface Props {
  variant?: Variant;
  heading: string;
  lead?: string;
  items: ServiceItem[];
  /** icon-grid only: optional closing CTA under the grid. */
  cta?: ButtonData;
}

const { variant = 'icon-grid', heading, lead, items, cta } = Astro.props;
---

{variant === 'icon-grid' && (
  <section class="service-blocks service-blocks--icon-grid" aria-labelledby="service-blocks-heading">
    <div class="container">
      <div class="service-blocks__intro">
        <h2 id="service-blocks-heading">{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>

      <div class="service-blocks__grid">
        {items.map((item) => (
          <div class="service-blocks__icon-item">
            {item.icon && <ServiceIcon name={item.icon} class="service-blocks__icon" />}
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>

      {cta && (
        <div class="service-blocks__cta">
          <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />
        </div>
      )}
    </div>
  </section>
)}

{variant === 'image-cards' && (
  <section class="service-blocks service-blocks--image-cards" aria-labelledby="service-blocks-heading">
    <div class="container">
      <div class="service-blocks__intro">
        <h2 id="service-blocks-heading">{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>

      <div class="service-blocks__cards">
        {items.map((item) => (
          <div class="service-blocks__card">
            {item.image && (
              <div class="service-blocks__card-media">
                <Placeholder ratio="4/3" label={item.image.label} src={item.image.src} />
              </div>
            )}
            <div class="service-blocks__card-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
            {item.cta && (
              <a class="service-blocks__card-footer" href={item.cta.href}>
                {item.cta.label}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{variant === 'list' && (
  <section class="service-blocks service-blocks--list" aria-labelledby="service-blocks-heading">
    <div class="container">
      <div class="service-blocks__intro">
        <h2 id="service-blocks-heading">{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>

      <ul class="service-blocks__list">
        {items.map((item) => (
          <li>
            <a class="service-blocks__row" href={item.href ?? '#'}>
              <span class="service-blocks__row-icon">
                {item.icon && <ServiceIcon name={item.icon} />}
              </span>
              <span class="service-blocks__row-body">
                <span class="service-blocks__row-title">{item.title}</span>
                <span class="service-blocks__row-desc">{item.description}</span>
              </span>
              <span class="service-blocks__row-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{variant === 'highlight' && items.length > 0 && (
  <section class="service-blocks service-blocks--highlight" aria-labelledby="service-blocks-heading">
    <div class="container">
      <div class="service-blocks__intro">
        <h2 id="service-blocks-heading">{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>

      <div class="service-blocks__showcase" data-highlight>
        {items.map((item, i) => (
          <div class="service-blocks__showcase-panel" data-panel hidden={i !== 0}>
            {item.image && (
              <div class="service-blocks__showcase-media">
                <Placeholder ratio="4/3" label={item.image.label} src={item.image.src} eager={i === 0} />
              </div>
            )}
            <div class="service-blocks__showcase-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              {item.cta && <Button label={item.cta.label} href={item.cta.href} variant={item.cta.variant ?? 'inverse'} />}
            </div>
          </div>
        ))}

        <div class="service-blocks__triggers">
          {items.map((item, i) => (
            <button type="button" class="service-blocks__trigger" data-trigger aria-pressed={i === 0}>
              {item.image && (
                <span class="service-blocks__trigger-media">
                  <Placeholder ratio="4/3" label={item.image.label} src={item.image.src} />
                </span>
              )}
              <span class="service-blocks__trigger-body">
                <span class="service-blocks__trigger-title">{item.title}</span>
                <span class="service-blocks__trigger-desc">{item.description}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'slider' && items.length > 0 && (
  <section class="service-blocks service-blocks--slider" aria-labelledby="service-blocks-heading">
    <div class="container">
      <div class="service-blocks__intro">
        <h2 id="service-blocks-heading">{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>

      <div class="service-blocks__slider" data-slider>
        <button type="button" class="service-blocks__arrow service-blocks__arrow--prev" data-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="service-blocks__slider-viewport">
          <div class="service-blocks__slider-track" data-track>
            {items.map((item, i) => (
              <div class="service-blocks__slide" data-slide>
                {item.image && (
                  <div class="service-blocks__slide-media">
                    <Placeholder ratio="4/3" label={item.image.label} src={item.image.src} eager={i === 0} />
                  </div>
                )}
                <div class="service-blocks__slide-body">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  {item.cta && <Button label={item.cta.label} href={item.cta.href} variant={item.cta.variant ?? 'inverse'} />}
                </div>
              </div>
            ))}
          </div>
        </div>

        <button type="button" class="service-blocks__arrow service-blocks__arrow--next" data-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      {items.length > 1 && (
        <div class="service-blocks__dots" role="group" aria-label="Choose slide">
          {items.map((item, i) => (
            <button type="button" class="service-blocks__dot" data-dot data-index={i} aria-label={`Show ${item.title}`} aria-current={i === 0 ? 'true' : 'false'} />
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* ---- icon-grid (default) ------------------------------------------------ */

  .service-blocks--icon-grid {
    padding-block: var(--space-2xl);
  }

  .service-blocks__intro {
    text-align: center;
    max-width: var(--container-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .service-blocks__intro h2 {
    margin-bottom: var(--space-sm);
  }

  .service-blocks--icon-grid .service-blocks__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl) var(--space-lg);
  }

  .service-blocks__icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
  }

  .service-blocks__icon {
    color: var(--color-on-surface);
    margin-bottom: var(--space-xs);
  }

  .service-blocks__icon-item h3 {
    font-size: var(--title-7);
  }

  .service-blocks__icon-item p {
    color: var(--color-body);
    max-width: 30ch;
  }

  .service-blocks--icon-grid .service-blocks__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .service-blocks--icon-grid .service-blocks__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .service-blocks--icon-grid .service-blocks__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- image-cards --------------------------------------------------------- */

  .service-blocks--image-cards {
    padding-block: var(--space-2xl);
  }

  .service-blocks__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .service-blocks__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .service-blocks__card-media {
    border-radius: 0;
  }

  .service-blocks__card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
  }

  .service-blocks__card-body h3 {
    font-size: var(--title-7);
  }

  .service-blocks__card-body p {
    color: var(--color-body);
    font-size: var(--text-small);
  }

  .service-blocks__card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    text-decoration: none;
  }

  .service-blocks__card-footer svg {
    flex-shrink: 0;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .service-blocks__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .service-blocks__cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---- list ----------------------------------------------------------------- */

  .service-blocks--list {
    padding-block: var(--space-2xl);
  }

  .service-blocks__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .service-blocks__row {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--color-surface-muted);
  }

  .service-blocks__row-icon {
    flex-shrink: 0;
    width: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
  }

  .service-blocks__row-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3xs);
    padding: var(--space-md) var(--space-lg);
  }

  .service-blocks__row-title {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-big);
    color: var(--color-on-surface);
  }

  .service-blocks__row-desc {
    color: var(--color-body);
    font-size: var(--text-small);
  }

  .service-blocks__row-arrow {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    align-self: center;
    margin-inline-end: var(--space-md);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .service-blocks__row-icon {
      width: 80px;
    }

    .service-blocks__row-body {
      padding: var(--space-sm) var(--space-md);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .service-blocks__row-icon {
      width: 64px;
    }

    .service-blocks__row-arrow {
      width: 36px;
      height: 36px;
      margin-inline-end: var(--space-sm);
    }
  }

  /* ---- highlight -------------------------------------------------------------
     Compact trigger cards (same card language as image-cards) feed one
     enlarged showcase panel. Only the active panel is un-hidden — using the
     `hidden` attribute means inactive panels leave the a11y tree and tab
     order for free, and the showcase's height simply follows whichever
     panel is currently shown, no overlay-positioning needed. */

  .service-blocks--highlight {
    padding-block: var(--space-2xl);
  }

  .service-blocks__showcase-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  /* Author CSS beats user-agent CSS at equal specificity, so an unqualified
     `display: grid` above silently wins over the browser's built-in
     `[hidden] { display: none }` — found live, the same way the
     Placeholder-scoping bug was: every panel rendered at once regardless of
     its `hidden` attribute. This re-asserts it at author level. */
  .service-blocks__showcase-panel[hidden] {
    display: none;
  }

  .service-blocks__showcase-panel.is-zooming {
    animation: service-blocks-zoom var(--duration-base) var(--ease-standard);
  }

  @keyframes service-blocks-zoom {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .service-blocks__showcase-media {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .service-blocks__showcase-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .service-blocks__triggers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .service-blocks__trigger {
    display: flex;
    flex-direction: column;
    text-align: left;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .service-blocks__trigger[aria-pressed='true'] {
    border-color: var(--color-brand);
  }

  .service-blocks__trigger-media {
    display: block;
    border-radius: 0;
  }

  .service-blocks__trigger-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .service-blocks__trigger-title {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--title-7);
    color: var(--color-on-surface);
  }

  .service-blocks__trigger-desc {
    color: var(--color-body);
    font-size: var(--text-small);
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .service-blocks__showcase-panel {
      grid-template-columns: 1fr;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .service-blocks__triggers {
      grid-template-columns: 1fr;
    }
  }

  /* ---- slider ----------------------------------------------------------------
     One 100%-wide slide at a time, sliding on a translateX track — simpler
     than TestimonialCarousel's offsetLeft-centred multi-up math since every
     slide is exactly the viewport's width. Same arrow/dot/keyboard pattern. */

  .service-blocks--slider {
    padding-block: var(--space-2xl);
  }

  .service-blocks__slider {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .service-blocks__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-blocks__slider-viewport {
    flex: 1;
    overflow: hidden;
  }

  .service-blocks__slider-track {
    display: flex;
    will-change: transform;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .service-blocks__slide {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
    padding-inline: var(--space-3xs);
  }

  .service-blocks__slide-media {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .service-blocks__slide-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .service-blocks__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  .service-blocks__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border-muted);
  }

  .service-blocks__dot[aria-current='true'] {
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .service-blocks__slide {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // highlight: click any trigger card to swap the showcase panel above it.
  document.querySelectorAll<HTMLElement>('[data-highlight]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-trigger]'));

    function activate(index: number) {
      panels.forEach((panel, i) => {
        const active = i === index;
        panel.hidden = !active;
        if (active) {
          panel.classList.remove('is-zooming');
          void panel.offsetWidth; // force reflow so the animation restarts every time
          panel.classList.add('is-zooming');
        }
      });
      triggers.forEach((trigger, i) => trigger.setAttribute('aria-pressed', String(i === index)));
    }

    triggers.forEach((trigger, i) => trigger.addEventListener('click', () => activate(i)));
  });

  // slider: prev/next arrows + dots slide a translateX track, one item at a time.
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.parentElement?.querySelectorAll<HTMLButtonElement>('[data-dot]') ?? []);
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');

    let index = 0;

    function render() {
      if (!track) return;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
    }

    function go(delta: number) {
      if (slides.length === 0) return;
      index = (index + delta + slides.length) % slides.length;
      render();
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        index = Number(dot.dataset.index ?? 0);
        render();
      });
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      }
    });

    render();
  });
</script>
