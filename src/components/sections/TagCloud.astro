---
interface Tag {
  label: string;
  href?: string;
}

interface Props {
  heading: string;
  subheading: string;
  tags: Tag[];
  note: string[];
}

const { heading, subheading, tags, note } = Astro.props;

// Build-time random suffix per instance — the same fix ServiceBlocks.astro
// and Faq.astro already apply. The id was the literal string
// "tag-cloud-heading", harmless with one instance per page (true of every
// build until now) but commercial-cleaning.astro renders two TagClouds
// ("What we clean" and "Where we clean"), which produced two elements
// sharing one id and left the second section's aria-labelledby pointing at
// the first section's heading. Found by building that page, not by an audit.
const headingId = `tag-cloud-heading-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="tag-cloud" aria-labelledby={headingId}>
  <div class="container tag-cloud__inner">
    <h2 id={headingId} class="tag-cloud__heading">{heading}</h2>
    <p class="tag-cloud__subheading">{subheading}</p>

    <ul class="tag-cloud__list">
      {tags.map((tag) => {
        const Tag = tag.href ? 'a' : 'span';
        return (
          <li>
            <Tag href={tag.href} class="tag-cloud__tag">
              {tag.label}
            </Tag>
          </li>
        );
      })}
    </ul>

    <p class="tag-cloud__note">
      {note.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .tag-cloud {
    background: var(--color-brand);
  }

  .tag-cloud__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .tag-cloud__heading {
    color: var(--color-on-brand);
  }

  .tag-cloud__subheading {
    color: var(--color-on-brand);
  }

  .tag-cloud__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    width: 100%;
    margin-block: var(--space-md);
  }

  .tag-cloud__tag {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    text-align: center;
    /* --color-accent (Mint Green), not --color-inverse: tokens.css now
       points --color-inverse at the same Dark Teal as --color-brand for
       the unified dark identity the brand bible calls for, which would
       make an --color-inverse ring invisible against this tag's own
       background. Mint Green also matches the deck's actual use of that
       colour — a small decorative accent, not a page-filling tone. Every
       tag uses this outlined pill now; there's no unhighlighted variant. */
    border: 2px solid var(--color-accent);
  }

  .tag-cloud__note {
    color: var(--color-on-brand);
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .tag-cloud__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .tag-cloud__list {
      grid-template-columns: 1fr;
    }
  }
</style>
