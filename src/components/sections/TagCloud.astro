---
interface Tag {
  label: string;
  href?: string;
  isHighlighted?: boolean;
}

interface Props {
  heading: string;
  subheading: string;
  tags: Tag[];
  note: string[];
}

const { heading, subheading, tags, note } = Astro.props;
---

<section class="tag-cloud" aria-labelledby="tag-cloud-heading">
  <div class="container tag-cloud__inner">
    <h2 id="tag-cloud-heading" class="tag-cloud__heading">{heading}</h2>
    <p class="tag-cloud__subheading">{subheading}</p>

    <ul class="tag-cloud__list">
      {tags.map((tag) => {
        const Tag = tag.href ? 'a' : 'span';
        return (
          <li>
            <Tag
              href={tag.href}
              class:list={['tag-cloud__tag', { 'tag-cloud__tag--highlight': tag.isHighlighted }]}
            >
              {tag.label}
            </Tag>
          </li>
        );
      })}
    </ul>

    <p class="tag-cloud__note">
      {note.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .tag-cloud {
    background: var(--color-brand);
  }

  .tag-cloud__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .tag-cloud__heading {
    color: var(--color-on-brand);
  }

  .tag-cloud__subheading {
    color: var(--color-on-brand);
  }

  .tag-cloud__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
    width: 100%;
    margin-block: var(--space-md);
  }

  .tag-cloud__tag {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    text-align: center;
  }

  .tag-cloud__tag--highlight {
    background: var(--color-brand);
    color: var(--color-on-brand);
    /* --color-accent (Mint Green), not --color-inverse: tokens.css now
       points --color-inverse at the same Dark Teal as --color-brand for
       the unified dark identity the brand bible calls for, which would
       make an --color-inverse ring invisible against this tag's own
       background. Mint Green also matches the deck's actual use of that
       colour — a small decorative accent, not a page-filling tone. */
    border: 2px solid var(--color-accent);
  }

  .tag-cloud__note {
    color: var(--color-on-brand);
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .tag-cloud__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .tag-cloud__list {
      grid-template-columns: 1fr;
    }
  }
</style>
