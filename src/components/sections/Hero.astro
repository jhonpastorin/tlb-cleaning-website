---
// Five variants, one component — extend with a variant value, don't fork:
//  - split-mosaic (default): yellow hero, copy + trust-badge card left, an
//    asymmetric N-image mosaic right. The original/only built variant.
//  - full-width-photo: single full-bleed photo behind the section; a
//    surface-coloured content card floats over it (own solid background, so
//    legibility never depends on the photo's contrast).
//  - split-single-image: two flush half-width panels, one plain image, one
//    copy panel — no brand-colour fill, no mosaic, no trust-badge card.
//    Takes an `imagePosition` ('left' default | 'right') to mirror the two
//    panels rather than forking a near-identical variant — same call as
//    `minimal`'s `align`.
//  - split-collage: copy panel + a static two-column image collage (NOT an
//    interactive carousel, despite the wireframe's label — see SECTIONS.md).
//  - minimal: text-only, no image at all — headline + lead + CTA in a plain
//    panel, for informational pages that don't need a photo. Takes an
//    `align` ('left' default | 'center') and an optional `stats` row rather
//    than forking a sixth variant for what's the same layout family.
//
// IMPORTANT: Astro only stamps an element with THIS component's scoped-style
// attribute when that element is written directly in this file's template.
// A class passed straight into <Placeholder class="…" /> lands on
// Placeholder's own root, under Placeholder's scope, not this one — any
// rule here targeting that class silently never matches. So every
// Placeholder that needs sizing/position from this file's <style> is wrapped
// in a plain <div> authored right here, and the rule targets the wrapper.
// (This was found live: an unwrapped .hero__logo defaulted to Placeholder's
// own width:100%, which blew out a 1fr/1fr grid to ~10/90 before the fix.)
import Placeholder from '../ui/Placeholder.astro';
import Button from '../ui/Button.astro';
import type { ImageBlock, MosaicImage, ButtonData } from '../../data/types';

type Variant = 'split-mosaic' | 'full-width-photo' | 'split-single-image' | 'split-collage' | 'minimal';

interface HeroStat {
  value: string;
  caption: string;
}

interface Props {
  variant?: Variant;
  /** Short eyebrow label rendered ABOVE the <h1>, outside it — e.g. "WHY TLB".
   *  Deliberately not folded into `headingLines`: those all render inside the
   *  single page <h1>, so a kicker there would become part of the heading text
   *  ("WHY TLB Nine local mums…"), which is wrong semantically and visually.
   *  Same idea PhotoGallery.astro's `story` steps already have as `step`. */
  kicker?: string;
  headingLines: string[];
  lead: string;
  cta: ButtonData;
  /** Small badge/logo above the heading. Optional on every variant. */
  logo?: ImageBlock;
  /** split-mosaic only: trust badges inside the white card under the copy. */
  badges?: ImageBlock[];
  /** split-mosaic only: the asymmetric N-image grid (works with any count >= 1). */
  images?: MosaicImage[];
  /** full-width-photo / split-single-image only: the one hero image. */
  image?: ImageBlock;
  /** split-single-image only: which side the image panel sits on at desktop
   *  widths. Default 'left'. Mobile is unaffected — copy stays above the
   *  image below --bp-lg for both positions. */
  imagePosition?: 'left' | 'right';
  /** full-width-photo / split-single-image only: how `image` fills its panel.
   *  Default 'cover', which is what a photo wants. Use 'contain' for a cut-out
   *  figure on a transparent backdrop — the panel stretches to the copy's
   *  height, so 'cover' crops the sides off a frame that was meant to be seen
   *  whole. Nothing shows in the leftover space; the section's own background
   *  is already what a transparent asset sits on. 'contain-bottom' anchors it
   *  to the panel's bottom edge instead of centring it — for a cut-out whose
   *  subject is flush with the bottom of its own frame, so it stands on the
   *  section edge rather than floating above it. */
  imageFit?: 'cover' | 'contain' | 'contain-bottom';
  /** split-collage only: images flow alternately into two stacked columns (works with any count >= 1). No wide/offset — each image's own ratio does the sizing. */
  collageImages?: ImageBlock[];
  /** minimal only: content alignment. Default 'left'. */
  align?: 'left' | 'center';
  /** minimal only: optional compact stat row below the CTA (no icon — see StatBand.astro for the icon-bearing full-width version). Omit for the plain text-only look. */
  stats?: HeroStat[];
}

const {
  kicker,
  variant = 'split-mosaic',
  headingLines,
  lead,
  cta,
  logo,
  badges = [],
  images = [],
  image,
  imagePosition = 'left',
  imageFit = 'cover',
  collageImages = [],
  align = 'left',
  stats = [],
} = Astro.props;

const wide = images.find((img) => img.span === 'wide');
const rest = images.filter((img) => img.span !== 'wide');

// Simple alternating two-column split — not a masonry algorithm, just enough
// to turn a flat list into the collage's left/right columns.
const collageColA = collageImages.filter((_, i) => i % 2 === 0);
const collageColB = collageImages.filter((_, i) => i % 2 === 1);
---

{variant === 'split-mosaic' && (
  <section class="hero hero--split-mosaic" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__copy">
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />

        <div class="hero__badges">
          {badges.map((badge) => (
            <div class="hero__badge">
              <Placeholder ratio={badge.ratio} label={badge.label} />
            </div>
          ))}
        </div>
      </div>

      <div class="hero__mosaic">
        {wide && (
          <div class="hero__mosaic-item hero__mosaic-item--wide">
            <Placeholder ratio={wide.ratio} label={wide.label} src={wide.src} eager />
          </div>
        )}
        <div class="hero__mosaic-row">
          {rest.map((img) => (
            <div class:list={['hero__mosaic-item', { 'hero__mosaic-item--offset': img.offset }]}>
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'full-width-photo' && image && (
  <section class="hero hero--full-width-photo" aria-labelledby="hero-heading">
    <div class="hero__media">
      <Placeholder ratio="16/9" label={image.label} src={image.src} fit={imageFit} eager />
    </div>

    <div class="container">
      <div class="hero__card">
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />
      </div>
    </div>
  </section>
)}

{variant === 'split-single-image' && image && (
  <section
    class:list={['hero', 'hero--split-single', { 'hero--split-single-reverse': imagePosition === 'right' }]}
    aria-labelledby="hero-heading"
  >
    <div class="hero__grid">
      <div class="hero__media">
        <Placeholder ratio={image.ratio ?? '4/3'} label={image.label} src={image.src} fit={imageFit} eager />
      </div>

      <div class="hero__copy">
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />
      </div>
    </div>
  </section>
)}

{variant === 'split-collage' && collageImages.length > 0 && (
  <section class="hero hero--split-collage" aria-labelledby="hero-heading">
    <div class="container hero__grid">
      <div class="hero__copy">
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />
      </div>

      <div class="hero__collage">
        <div class="hero__collage-col">
          {collageColA.map((img) => (
            <div class="hero__collage-item">
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
        <div class="hero__collage-col">
          {collageColB.map((img) => (
            <div class="hero__collage-item">
              <Placeholder ratio={img.ratio} label={img.label} src={img.src} eager />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{variant === 'minimal' && (
  <section class="hero hero--minimal" aria-labelledby="hero-heading">
    <div class="container">
      <div class:list={['hero__content', { 'hero__content--center': align === 'center' }]}>
        {logo && (
          <div class="hero__logo">
            <Placeholder ratio={logo.ratio ?? '2/1'} label={logo.label} src={logo.src} />
          </div>
        )}
        {kicker && <p class="hero__kicker">{kicker}</p>}
        <h1 id="hero-heading">
          {headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h1>
        <p class="lead">{lead}</p>
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'inverse'} />

        {stats.length > 0 && (
          <div class="hero__stats">
            {stats.map((stat) => (
              <div class="hero__stat">
                <span class="hero__stat-value">{stat.value}</span>
                <span class="hero__stat-caption">{stat.caption}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* Desktop floor shared by every variant, so a page's hero opens at the same
     height whichever layout it uses — a `minimal` informational hero and the
     homepage's `split-single-image` shouldn't differ in scale just because
     one has a photo. 560px is the value `full-width-photo` already carried on
     its own; it now reads this instead of repeating the literal.

     Each variant applies it to whichever box actually needs to grow: the
     split variants put it on .hero__grid so the ROW stretches and the photo
     panel grows with it (on the section, the row would keep its content
     height and the photo would leave a band of empty background beneath
     itself); `minimal` has no grid, so it goes on the section, which becomes
     a flex container purely to keep the copy centred in the taller band.
     Every variant releases the floor below --bp-lg — on a phone the content
     is already taller than this, and a floor there only risks dead space.
     `full-width-photo` is the exception: its photo IS the background, so it
     keeps a definite (shorter) height on mobile rather than dropping to
     auto. */
  .hero {
    --hero-min-height: 560px;
  }

  /* Eyebrow label above the H1. Sized/spaced to read as a label, not a
     subheading — uppercase with wide tracking is what distinguishes it from
     the lead line below the heading. */
  .hero__kicker {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
    opacity: 0.75;
  }

  /* ---- split-mosaic (default) ------------------------------------------ */

  .hero--split-mosaic {
    background: var(--color-brand);
    padding-block: var(--space-xl);
  }

  .hero--split-mosaic .hero__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: var(--hero-min-height);
  }

  .hero--split-mosaic .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    color: var(--color-on-brand);
  }

  .hero--split-mosaic .hero__copy h1 {
    color: var(--color-on-brand);
  }

  .hero--split-mosaic .hero__copy .lead {
    color: var(--color-on-brand);
    max-width: 46ch;
  }

  .hero--split-mosaic .hero__badges {
    display: flex;
    gap: var(--space-sm);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-md);
    margin-top: var(--space-xs);
  }

  .hero--split-mosaic .hero__badge {
    flex: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .hero--split-mosaic .hero__mosaic {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero--split-mosaic .hero__mosaic-item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero--split-mosaic .hero__mosaic-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .hero--split-mosaic .hero__mosaic-item--offset {
    transform: translateY(var(--space-md));
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-mosaic .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero--split-mosaic .hero__copy {
      order: 1;
    }

    .hero--split-mosaic .hero__mosaic {
      order: 2;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-mosaic {
      padding-block: var(--space-lg);
    }

    .hero--split-mosaic .hero__badges {
      flex-direction: column;
    }

    .hero--split-mosaic .hero__mosaic-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero--split-mosaic .hero__mosaic-item--offset {
      transform: none;
    }
  }

  /* ---- full-width-photo -------------------------------------------------
     Full-bleed photo behind the section; the card carries its own solid
     --color-surface background, so text contrast never depends on what's in
     the photo underneath it. */

  .hero--full-width-photo {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--hero-min-height);
    overflow: hidden;
  }

  .hero--full-width-photo .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero--full-width-photo .container {
    position: relative;
    z-index: 1;
  }

  .hero--full-width-photo .hero__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 480px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .hero--full-width-photo .hero__logo {
    width: 120px;
  }

  .hero--full-width-photo .hero__card .lead {
    max-width: 40ch;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--full-width-photo {
      /* Not `auto` like the other variants: this one's photo is the
         background, so it still needs a definite height to be visible at
         all — just a shorter one on a phone. */
      min-height: 420px;
    }

    .hero--full-width-photo .hero__card {
      padding: var(--space-md);
      gap: var(--space-sm);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .hero--full-width-photo .hero__card {
      max-width: 100%;
    }
  }

  /* ---- split-single-image ------------------------------------------------
     Two flush half-width panels — no container gutter between them, unlike
     split-mosaic which is inset. Grid row height is driven by the copy
     panel's content; the image wrapper stretches to match (grid default
     align-items: stretch) and Placeholder fills it via height:100% +
     object-fit:cover, falling back to its own aspect-ratio once the layout
     collapses to one column on mobile and the row height is no longer
     definite. */

  /* Off White fills the whole section, not each panel, so the two halves read
     as one continuous band with no seam down the middle. It's also the
     backdrop a cut-out asset with real transparency (the homepage's hero
     figure) sits on — Placeholder's --image branch deliberately clears its
     own background. Set explicitly rather than left to inherit the body:
     this variant owns its band colour, same as every other variant here.
     Invisible under an opaque cover photo either way. */
  .hero--split-single {
    background: var(--color-surface);
    /* The inset that puts this hero's copy on the same vertical line as every
       .container section on the page. .container is `max-width: --container;
       margin-inline: auto; padding-inline: --space-md`, so its content edge
       sits at max(--space-md, (page - --container) / 2 + --space-md) from the
       page edge. This hero is full-bleed by design — the photo runs off the
       viewport edge — so the copy side has to reproduce that line itself,
       which it does as an empty grid track below.

       Percentages in a track size resolve against the grid container's own
       inline size, and this grid spans the full page width — the same basis
       .container measures from. That's why this isn't written with 100vw:
       100vw includes the scrollbar, which .container's `margin: auto` does
       not, so a vw-based gutter would sit ~half a scrollbar off. */
    --hero-gutter: max(var(--space-md), calc((100% - var(--container)) / 2 + var(--space-md)));
  }

  /* photo | copy | gutter. The photo bleeds off the outer edge; the copy's
     far edge lands on the container line. Mirrored under -reverse below. */
  .hero--split-single .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr var(--hero-gutter);
    /* The copy panel's own justify-content: center keeps the text optically
       centred in whatever height wins. See --hero-min-height at the top of
       this sheet for why the floor sits on the grid, not the section. */
    min-height: var(--hero-min-height);
  }

  /* Both panels are pinned to row 1. Without an explicit row, auto-placement
     walks forward only: -reverse puts the DOM-first .hero__media in column 3,
     which parks the cursor past column 2, so .hero__copy gets bumped to a
     second row and the hero renders as a diagonal stair instead of a split. */
  .hero--split-single .hero__media {
    grid-column: 1;
    grid-row: 1;
    overflow: hidden;
    /* Keep an empty image slot on the section's own band colour instead of
       Placeholder's default Cream, which would split this hero into two
       different-coloured halves — the exact seam the section-level
       background above exists to avoid. Tracks --color-surface rather than
       restating it, so the two can't drift apart. The dashed border still
       marks the slot as unfilled. No effect once `src` is set: the image
       branch keeps no background of its own. */
    --placeholder-bg: var(--color-surface);
  }

  .hero--split-single .hero__copy {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-md);
    /* Inner edge (facing the photo) gets the full --space-xl gap; the outer
       edge gets nothing, because the gutter track beside it is already
       holding exactly the container's inset. Padding there too would push
       the copy inside the line everything else lines up on. */
    padding-block: var(--space-xl);
    padding-inline: var(--space-xl) 0;
    min-width: 0;
  }

  .hero--split-single .hero__logo {
    width: 120px;
    flex-shrink: 0;
  }

  .hero--split-single .hero__copy .lead {
    max-width: 42ch;
  }

  /* imagePosition="right" — mirror all three tracks, gutter now leading:
     gutter | copy | photo. Desktop only; the --bp-lg block below collapses
     both positions to one column and orders copy first there. */
  .hero--split-single-reverse .hero__grid {
    grid-template-columns: var(--hero-gutter) 1fr 1fr;
  }

  .hero--split-single-reverse .hero__copy {
    grid-column: 2;
    padding-inline: 0 var(--space-xl);
  }

  .hero--split-single-reverse .hero__media {
    grid-column: 3;
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-single .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    /* Drop the desktop placement entirely. An explicit `grid-column: 2` (or
       3) in a one-column grid doesn't clamp — it generates implicit columns
       and the layout silently goes back to being side-by-side. The row reset
       matters just as much: leaving both panels pinned to `grid-row: 1` would
       stack them on top of each other in the same cell. One column, rows
       auto-placed, `order` below deciding which comes first. */
    .hero--split-single .hero__media,
    .hero--split-single .hero__copy {
      grid-column: 1;
      grid-row: auto;
    }

    /* Copy first on mobile — the message and CTA shouldn't sit below a
       full-width image on a small screen. */
    .hero--split-single .hero__media {
      order: 2;
    }

    /* One column, so there's no gutter track and no inner edge to hold off
       from: the copy carries the container's own --space-md inset directly.
       Shorthand deliberately, to clear the desktop padding-inline pair. */
    .hero--split-single .hero__copy {
      order: 1;
      padding: var(--space-lg) var(--space-md);
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-single .hero__copy {
      padding: var(--space-md);
    }
  }

  /* ---- split-collage -----------------------------------------------------
     Copy panel (same neutral treatment as split-single-image, not the
     brand-yellow fill split-mosaic uses) + a static two-column image
     collage. Explicitly NOT an interactive carousel — the wireframe this
     was built from was labelled "Carousel Image" but its own description
     and visual both show a fixed collage; see SECTIONS.md for that call. */

  .hero--split-collage .hero__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-lg);
    align-items: center;
    min-height: var(--hero-min-height);
  }

  .hero--split-collage .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero--split-collage .hero__copy .lead {
    max-width: 46ch;
  }

  .hero--split-collage .hero__logo {
    width: 120px;
  }

  .hero--split-collage .hero__collage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: start;
  }

  .hero--split-collage .hero__collage-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero--split-collage .hero__collage-item {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* mirrors --bp-lg */
  @media (max-width: 1025px) {
    .hero--split-collage .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero--split-collage .hero__copy {
      order: 1;
    }

    .hero--split-collage .hero__collage {
      order: 2;
    }
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .hero--split-collage .hero__grid {
      gap: var(--space-md);
    }
  }

  /* ---- minimal -------------------------------------------------------------
     Text-only: headline + lead + CTA, no image. --color-surface-muted gives
     it a faint tint distinct from the page's white background, matching the
     wireframe, without being a brand-colour band like split-mosaic. */

  .hero--minimal {
    background: var(--color-surface-muted);
    padding-block: var(--space-2xl);
    /* Flex purely to centre the single .container child inside the floor —
       without it the copy would sit at the top of a 560px band. */
    min-height: var(--hero-min-height);
    display: flex;
    align-items: center;
  }

  .hero--minimal .hero__content {
    display: flex;
