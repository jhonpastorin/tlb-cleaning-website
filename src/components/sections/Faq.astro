---
// Accordion only — "FAQ Grid" (the wireframe's second example: static Q&A
// cards, alternating tones, all visible at once, no expand/collapse) is
// exactly ContentGrid.astro's `text` block type already: question as
// `heading`, answer as `body`, tone alternated per card. See the usage
// example in SECTIONS.md rather than a second variant here — reuse over
// duplication is the default in this library; ask for it built again as a
// variant on this file if you specifically want the two FAQ looks grouped
// under one component (same trade-off Hero.astro's `split-mosaic` vs.
// StoryMosaic overlap and ContentGrid's `columns={2}` vs. StoryMosaic
// overlap both went through — see those entries for the reasoning either
// way).
//
// No JS at all: native <details>/<summary>, grouped with a shared `name` so
// opening one closes the others (accordion, not independent disclosures) —
// browser-native keyboard support and expanded-state announcement for free.
// The +/- icon is pure CSS, driven by the `[open]` attribute selector.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  lead?: string;
  items: FaqItem[];
}

const { heading, lead, items } = Astro.props;

// `name`-grouped <details> exclusivity is document-wide, not scoped to this
// component's own markup — two <Faq> instances on one page sharing a
// literal "faq" name would incorrectly close each other's open items. A
// build-time-random suffix keeps each instance's group to itself with zero
// client-side JS.
const groupName = `faq-${Math.random().toString(36).slice(2, 9)}`;

// The heading id needed the same treatment and didn't get it when the group
// name above was fixed — it stayed the literal "faq-heading". Every page
// that renders a branded and a non-branded FAQ block (index.astro,
// ndis-cleaning.astro, commercial-cleaning.astro) has therefore been
// shipping two elements with one id, with the second section's
// aria-labelledby resolving to the first section's heading. Same fix,
// applied to both now.
const headingId = `faq-heading-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="faq" aria-labelledby={heading ? headingId : undefined}>
  <div class="container container--narrow">
    {heading && (
      <div class="faq__intro">
        <h2 id={headingId}>{heading}</h2>
        {lead && <p class="lead">{lead}</p>}
      </div>
    )}

    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item" name={groupName} open={i === 0}>
          <summary class="faq__question">
            <span class="faq__number">{i + 1}.</span>
            <span class="faq__question-text">{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-2xl);
  }

  .faq__intro {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .faq__intro h2 {
    margin-bottom: var(--space-sm);
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq__item {
    background: var(--color-surface);
  }

  .faq__question {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__item[open] .faq__question {
    background: var(--color-surface-muted);
  }

  .faq__number {
    color: var(--color-body);
    flex-shrink: 0;
  }

  .faq__question-text {
    flex: 1;
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    color: var(--color-on-surface);
  }

  /* CSS-only plus/minus: a horizontal + vertical bar, the vertical bar
     scales to zero when the parent <details> is open — no icon swap, no JS. */
  .faq__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-on-surface);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 2px;
  }

  .faq__icon::before {
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .faq__icon::after {
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .faq__item[open] .faq__icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq__answer {
    background: var(--color-surface-muted);
    padding: 0 var(--space-lg) var(--space-md) calc(var(--space-lg) + 1.5rem);
  }

  .faq__answer p {
    color: var(--color-body);
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .faq__question {
      padding: var(--space-sm) var(--space-md);
    }

    .faq__answer {
      padding: 0 var(--space-md) var(--space-sm) calc(var(--space-md) + 1.25rem);
    }
  }
</style>
