---
// Two variants, one component — extend with a variant value, don't fork:
//  - divided (default): a hairline-divided row of short proof-point phrases
//    on the page surface. The original build.
//  - card: the same proof points as a Dark Teal rounded card that OVERLAPS
//    the hero above it, each point icon-led with a bold title + supporting
//    line. Takes `cards` rather than `items` — the same per-variant prop call
//    Hero.astro already makes (`images` / `image` / `collageImages`).
//
// Distinct from both:
//  - StatBand.astro / MetricsBlock.astro: those are number-led captions
//    (a `value` figure per item is the whole contract). This is for a row
//    of short proof-point PHRASES that aren't uniformly numeric.
//  - TagCloud.astro: that's a long enumerable category list rendered as
//    pills. This is 3-5 short sentences in one divided row, not pills.
//
// `divided`'s divider treatment reuses Hero.astro's `minimal` variant's
// `stats` row styling verbatim (border-left hairlines, same mobile
// stack-to-border-top behaviour) rather than inventing a second visual
// language for the same idea — no shared code between the two, just the
// same established pattern.
type Variant = 'divided' | 'card';

export type TrustBarIconName = 'team' | 'map-pin' | 'building' | 'chat' | 'shield-check' | 'sparkle';

interface TrustCard {
  icon: TrustBarIconName;
  title: string;
  description: string;
}

interface Props {
  variant?: Variant;
  /** divided only: one short proof-point phrase per item. */
  items?: string[];
  /** card only: icon + bold title + supporting line per item. */
  cards?: TrustCard[];
}

const { variant = 'divided', items = [], cards = [] } = Astro.props;
---

{variant === 'divided' && (
  <section class="trust-bar" aria-label="Why choose us">
    <div class="container">
      <ul class="trust-bar__list">
        {items.map((item) => (
          <li class="trust-bar__item">{item}</li>
        ))}
      </ul>
    </div>
  </section>
)}

{variant === 'card' && (
  <section class="trust-bar trust-bar--card" aria-label="Why choose us">
    <div class="container">
      <ul class="trust-bar__card">
        {cards.map((card) => (
          <li class="trust-bar__cell">
            <span class="trust-bar__icon" aria-hidden="true">
              {card.icon === 'team' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="9" cy="8" r="3.2" />
                  <path d="M2.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5" stroke-linecap="round" />
                  <path d="M16 5.4a3.2 3.2 0 0 1 0 5.2M17.5 13.9c2.3.6 4 2.7 4 5.1" stroke-linecap="round" />
                </svg>
              )}
              {card.icon === 'map-pin' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M12 21.5s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke-linejoin="round" />
                  <circle cx="12" cy="10.5" r="2.6" />
                </svg>
              )}
              {card.icon === 'building' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M3.5 20.5h17" stroke-linecap="round" />
                  <path d="M5.5 20.5V6.2l7-3.2v17.5M18.5 20.5V9.8l-6-2.7" stroke-linejoin="round" />
                  <path d="M8.2 8.4v1.8M8.2 13v1.8M15.4 12.6v1.8" stroke-linecap="round" />
                </svg>
              )}
              {card.icon === 'chat' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M20.5 12.2c0 4-3.8 7.2-8.5 7.2a9.9 9.9 0 0 1-2.7-.4L4.5 20.5l1.3-3.4A6.9 6.9 0 0 1 3.5 12c0-4 3.8-7.2 8.5-7.2s8.5 3.2 8.5 7.4Z" stroke-linejoin="round" />
                  <path d="M8.6 12h.01M12 12h.01M15.4 12h.01" stroke-linecap="round" stroke-width="2.2" />
                </svg>
              )}
              {card.icon === 'shield-check' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M12 2.8 4.8 5.6v6c0 4.4 3 8.4 7.2 9.6 4.2-1.2 7.2-5.2 7.2-9.6v-6L12 2.8Z" stroke-linejoin="round" />
                  <path d="m8.8 11.8 2.3 2.4 4.1-4.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {card.icon === 'sparkle' && (
                <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M11 3l1.7 4.9L17.6 9.6l-4.9 1.7L11 16.2l-1.7-4.9L4.4 9.6l4.9-1.7L11 3Z" stroke-linejoin="round" />
                  <path d="M18 15.2l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <div class="trust-bar__text">
              <p class="trust-bar__title">{card.title}</p>
              <p class="trust-bar__desc">{card.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  /* ---- divided (default) ------------------------------------------------ */
  .trust-bar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border-muted);
  }

  .trust-bar__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding-block: var(--space-md);
  }

  .trust-bar__item {
    padding-inline: var(--space-lg);
    border-left: 1px solid var(--color-border-muted);
    font-size: var(--text-small);
    color: var(--color-body);
    text-align: center;
  }

  .trust-bar__item:first-child {
    padding-inline-start: 0;
    border-left: none;
  }

  .trust-bar__item:last-child {
    padding-inline-end: 0;
  }

  /* ---- card --------------------------------------------------------------
     Overlaps the section above (the hero) by --trust-bar-overlap. That value
     is a fixed length, not a percentage: percentage margins resolve against
     the parent's WIDTH, so "30% of the card's own height" has no direct CSS
     expression here. 2.75rem is ~30% of the card's ~9rem desktop height at
     this padding with a two-line description — retune it alongside either.
     The section carries no background or border of its own, so the hero
     shows through the overlapped strip. */
  .trust-bar--card {
    --trust-bar-overlap: 2.75rem;
    background: none;
    border-bottom: none;
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * var(--trust-bar-overlap));
  }

  .trust-bar__card {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    background: var(--color-brand);
    color: var(--color-on-brand);
    border-radius: var(--radius-md);
    padding: var(--space-lg) var(--space-md);
  }

  .trust-bar__cell {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-inline: var(--space-md);
    /* Same hairline idea as the divided variant, tinted off the band's own
       ink so the two can't drift apart. */
    border-left: 1px solid color-mix(in srgb, var(--color-on-brand) 25%, transparent);
  }

  .trust-bar__cell:first-child {
    border-left: none;
  }

  .trust-bar__icon {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--color-accent);
  }

  .trust-bar__title {
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .trust-bar__desc {
    font-size: var(--text-small);
    line-height: var(--leading-snug);
    margin-top: var(--space-3xs);
    color: color-mix(in srgb, var(--color-on-brand) 80%, transparent);
  }

  /* mirrors --bp-lg — two cells per row before the single column, so three
     or four of them don't squeeze to unreadable widths at tablet size. */
  @media (max-width: 1025px) {
    .trust-bar__card {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .trust-bar__cell:nth-child(odd) {
      border-left: none;
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .trust-bar__list {
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
    }

    .trust-bar__item {
      padding-inline: 0;
      border-left: none;
      border-top: 1px solid var(--color-border-muted);
      padding-top: var(--space-sm);
    }

    .trust-bar__item:first-child {
      border-top: none;
      padding-top: 0;
    }

    /* One cell per row here, so the stacked card runs far taller than the
       desktop one — a 30%-of-height overlap would swallow the hero's bottom
       third. Overlap just enough to keep the "sitting on the hero" read. */
    .trust-bar--card {
      --trust-bar-overlap: 1.5rem;
    }

    .trust-bar__card {
      grid-template-columns: 1fr;
    }

    .trust-bar__cell {
      padding-inline: 0;
      border-left: none;
    }
  }
</style>
