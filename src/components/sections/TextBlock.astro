---
// New component — added while building the TLB homepage from
// content-plans/cleaning-services-homepage.md (§2, §7), which flagged this
// exact gap twice: a plain "one paragraph of prose, no image, no card"
// section had no home in SECTIONS.md. Two independent real consumers on one
// page is the same bar this library sets elsewhere for "worth a shared
// component" (see ServiceIcon.astro's own justification).
//
// Deliberately NOT StoryMosaic: that component always lays out a 2-column
// grid, so a text-only use leaves an empty half-width gap that reads as a
// layout bug rather than a deliberate choice (see SECTIONS.md's own
// "not recommended" note on that stretch). This is single-column, no image
// slot, ever.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import type { ButtonData } from '../../data/types';

// A body entry is either a paragraph (string) or a bullet list
// ({ list: [...] }). Order-driven rather than a separate `bullets` prop,
// because a list usually needs to sit BETWEEN paragraphs — a lead-in line
// above it, the conclusion below — which a trailing prop can't express.
// Same "array order is the layout" call StoryMosaic.astro and
// ContentGrid.astro already make. `string[]` still satisfies this, so every
// existing caller is unchanged.
export type TextBlockBody = string | { list: string[] };

interface Props {
  /** light = the page's own Off White (no visible band edge), muted = the
   *  Cream neutral, dark = the Dark Teal band. `muted` exists because a
   *  `light` block sitting on a `light` page reads as empty space rather
   *  than a section; it's the same Cream --color-surface-muted already
   *  carries for Hero's minimal panel and ServiceBlocks' list rows. */
  theme?: 'light' | 'muted' | 'dark';
  align?: 'left' | 'center';
  heading?: string;
  body: TextBlockBody[];
  cta?: ButtonData;
  /** Optional full-bleed photo behind the block. The theme's own background
   *  colour is then laid over it as a scrim at `scrimOpacity`, so the photo
   *  reads through without the copy ever depending on the photo's own
   *  contrast. Purely atmospheric, so it renders with alt="" — anything the
   *  reader needs to know is in the prose. */
  backgroundImage?: ImageMetadata;
  /** How opaque that scrim is, 0-100. Default 80: enough of the theme colour
   *  to keep body text at its normal contrast, enough photo to be legible as
   *  a photo. Drop it for a more visible image, but re-check the text against
   *  the LIGHTEST area of the photo before you do — the scrim is the only
   *  thing standing between the copy and whatever is underneath. */
  scrimOpacity?: number;
}

const {
  theme = 'light',
  align = 'center',
  heading,
  body,
  cta,
  backgroundImage,
  scrimOpacity = 80,
} = Astro.props;

// Random suffix so multiple instances on one page never collide — same fix
// Faq.astro already applies to its own per-instance heading, and the same
// bug class ServiceBlocks.astro was patched for while building this same
// page (see SECTIONS.md's patch notes on both).
const headingId = `text-block-heading-${Math.random().toString(36).slice(2, 9)}`;
---

<section
  class:list={['text-block', `text-block--${theme}`, { 'text-block--photo': backgroundImage }]}
  aria-labelledby={heading ? headingId : undefined}
>
  {backgroundImage && (
    <div class="text-block__bg" aria-hidden="true">
      <Image src={backgroundImage} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="lazy" />
      <span class="text-block__scrim" style={`--text-block-scrim-opacity: ${scrimOpacity}%;`}></span>
    </div>
  )}
  <div class="container container--narrow">
    <div class:list={['text-block__inner', { 'text-block__inner--center': align === 'center' }]}>
      {heading && <h2 id={headingId}>{heading}</h2>}
      <div class="text-block__body">
        {body.map((entry) =>
          typeof entry === 'string' ? (
            <p>{entry}</p>
          ) : (
            <ul class="text-block__list">
              {entry.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        )}
      </div>
      {cta && (
        <div class="text-block__cta">
          <Button label={cta.label} href={cta.href} variant={cta.variant ?? (theme === 'dark' ? 'inverse-accent' : 'brand')} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Each theme names its own ground once, in --text-block-bg, and both the
     flat background and the photo scrim read it — so a theme can never end
     up with a scrim in a different colour than the band it belongs to. */
  .text-block--light {
    --text-block-bg: var(--color-surface);
  }

  .text-block--muted {
    --text-block-bg: var(--color-surface-muted);
  }

  .text-block--dark {
    --text-block-bg: var(--color-inverse);
  }

  .text-block {
    background: var(--text-block-bg);
  }

  /* ---- optional background photo -----------------------------------------
     The photo sits in its own absolutely-positioned layer with the scrim
     stacked directly over it; `isolation: isolate` keeps that stack from
     interacting with anything else on the page, and the container is lifted
     to z-index 1 so the copy stays above both. The section keeps its flat
     --text-block-bg underneath as well: that is what shows while the image
     is still loading, and what the section falls back to if it never does. */
  .text-block--photo {
    position: relative;
    isolation: isolate;
  }

  .text-block__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .text-block__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .text-block__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--text-block-bg) var(--text-block-scrim-opacity, 80%), transparent);
  }

  .text-block--photo > .container {
    position: relative;
    z-index: 1;
  }

  .text-block__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .text-block__inner--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .text-block--dark :global(h2) {
    color: var(--color-on-inverse);
  }

  .text-block__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    font-size: var(--text-big);
    line-height: var(--leading-normal);
  }

  .text-block--light .text-block__body,
  .text-block--muted .text-block__body {
    color: var(--color-body);
  }

  .text-block--dark .text-block__body {
    color: var(--color-on-inverse);
  }

  /* reset.css clears list-style globally, so the markers are drawn here as
     ::before pseudo-elements rather than by re-enabling list-style — that
     keeps the marker colour tokenised per theme, which a native marker
     can't be without ::marker support assumptions. */
  .text-block__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .text-block__list li {
    position: relative;
    padding-left: var(--space-md);
  }

  .text-block__list li::before {
    content: '';
    position: absolute;
    left: 0;
    /* centres the dot on the first line's cap height at --text-big */
    top: calc(var(--text-big) * var(--leading-normal) / 2);
    transform: translateY(-50%);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }

  /* A centred block still gets a left-aligned list — centred bullet text is
     unreadable at more than a couple of words. The list box itself stays
     centred within the measure. */
  .text-block__inner--center .text-block__list {
    text-align: left;
    align-self: center;
  }

  .text-block__cta {
    display: flex;
    margin-top: var(--space-xs);
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .text-block__inner {
      padding-block: var(--space-xl);
    }
  }
</style>
