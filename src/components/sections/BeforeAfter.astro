---
// Draggable before/after comparison sliders — two photos of one scene laid
// exactly on top of each other, with a handle that wipes between them.
//
// WHY THIS IS A NEW COMPONENT and not a PhotoGallery variant. The
// house-cleaning build had already flagged this gap in its own source, out
// loud: "nothing in SECTIONS.md pairs two images as one unit." Every existing
// option treats images as a SET of independent frames —
//   - PhotoGallery `grid` lays N frames out side by side. A viewer has to
//     hold one in memory and saccade to the other, which is exactly the
//     comparison a slider does for them.
//   - PhotoGallery `filmstrip` grows the ACTIVE frame and shrinks the rest,
//     so a Before and its own After are never the same size at the same
//     moment. That was the specific tension the first build wrote down.
//   - ContentGrid/StoryMosaic have no concept of two images as one unit at
//     all.
// The unit here is the PAIR, and the interaction is a wipe between its two
// members. That isn't a layout variant of "some photos" — it's a different
// content shape, so it's a different file, per this library's own bar.
//
// ⚠️ Both images in a pair must be the SAME SCENE from the SAME POSITION.
// The slider wipes one over the other in place, so anything that moves
// between the two frames — a shifted camera, a chair that got pushed in,
// a different crop — reads as a glitch rather than as cleaning. This is a
// content requirement the component cannot enforce; the photo brief has to.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface PairImage {
  /** A statically-imported image. Required — unlike most of this library,
   *  there is no reserved-slot mode here: a comparison slider with nothing
   *  to compare has no meaningful empty state. Use PhotoGallery's labelled
   *  Placeholder frames while the photography is still pending. */
  src: ImageMetadata;
  /** Alt text. Describes the scene AND its state ("kitchen benchtop before
   *  the clean"), since the state is the whole point of the pair. */
  alt: string;
}

export interface BeforeAfterPair {
  before: PairImage;
  after: PairImage;
  /** Optional line under the frame naming what the pair shows, e.g.
   *  "Kitchen benchtop and splashback". */
  caption?: string;
  /** Where the handle starts, 0-100. Default 50. Set lower to open on mostly
   *  "after", higher for mostly "before". */
  start?: number;
  /** Aspect ratio of the frame, e.g. "4/3". Default "4/3". Both images are
   *  object-fit: cover'd into it, so a pair shot at a different ratio still
   *  aligns with itself. */
  ratio?: string;
}

interface Props {
  heading?: string;
  lead?: string;
  pairs: BeforeAfterPair[];
  /** Label on the left/overlay half. Default 'Before'. */
  beforeLabel?: string;
  /** Label on the right/base half. Default 'After'. */
  afterLabel?: string;
  /** Optional closing note under the grid — provenance, consent, or (as the
   *  house-cleaning page currently uses it) the fact that the images on show
   *  are illustrative samples rather than real jobs. */
  note?: string;
}

const {
  heading,
  lead,
  pairs,
  beforeLabel = 'Before',
  afterLabel = 'After',
  note,
} = Astro.props;

// Build-time random suffix per instance — the same fix Faq.astro,
// ServiceBlocks.astro and TagCloud.astro all already apply, for the same
// reason. Two of these on one page would otherwise emit duplicate ids: the
// section heading's, and one per range input (each of which needs its own id
// for its <label>). A duplicate input id silently sends every label's clicks
// to the first matching input on the page.
const uid = `ba-${Math.random().toString(36).slice(2, 8)}`;
const headingId = `${uid}-heading`;
---

<section class="before-after" aria-labelledby={heading ? headingId : undefined}>
  <div class="container before-after__inner">
    {heading && <h2 id={headingId} class="before-after__heading">{heading}</h2>}
    {lead && <p class="before-after__lead">{lead}</p>}

    <div class="before-after__grid">
      {pairs.map((pair, i) => {
        const inputId = `${uid}-range-${i}`;
        const start = Math.min(100, Math.max(0, pair.start ?? 50));
        return (
          <figure class="before-after__figure">
            <div
              class="before-after__frame"
              data-ba-frame
              style={`aspect-ratio: ${pair.ratio ?? '4/3'}; --ba-pos: ${start}%;`}
            >
              {/* BASE layer: the "after". Unclipped, so it is what fills any
                  part of the frame the overlay has been wiped off. */}
              <Image
                src={pair.after.src}
                alt={pair.after.alt}
                class="before-after__img"
                widths={[400, 800, 1200]}
                sizes="(max-width: 900px) 100vw, 50vw"
                loading="lazy"
              />
              <span class="before-after__tag before-after__tag--after">{afterLabel}</span>

              {/* OVERLAY layer: the "before", clipped to the left --ba-pos of
                  the frame. Its own tag rides inside the clip, so it is
                  squeezed out of sight exactly when its half is. */}
              <div class="before-after__overlay">
                <Image
                  src={pair.before.src}
                  alt={pair.before.alt}
                  class="before-after__img"
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 900px) 100vw, 50vw"
                  loading="lazy"
                />
                <span class="before-after__tag before-after__tag--before">{beforeLabel}</span>
              </div>

              {/* THE CONTROL. A native range input, not a hand-rolled drag
                  handler: it brings pointer drag, touch, click-to-position,
                  arrow/Home/End keys, and a screen-reader-announced value
                  with it, none of which would come free from a div with
                  pointer events. It is laid transparently over the whole
                  frame; the visible affordance is the divider below it.

                  ⚠️ IT MUST STAY BEFORE THE DIVIDER IN THE DOM. The input is
                  transparent, so its focus ring has to be drawn on the grip
                  instead, and the only selector that can reach across from
                  the focused element to the grip is a sibling combinator —
                  which walks FORWARD only. With the divider written first
                  (as it was) that rule matches nothing, silently, with no
                  warning from anything. Stacking order is handled by
                  z-index, not source order, so this costs nothing. */}
              <label class="before-after__sr" for={inputId}>
                {pair.caption
                  ? `Reveal more of the before or after photo: ${pair.caption}`
                  : 'Reveal more of the before or after photo'}
              </label>
              <input
                id={inputId}
                class="before-after__range"
                type="range"
                min="0"
                max="100"
                step="1"
                value={start}
                data-ba-range
              />

              {/* The drawn divider + grip. Pure decoration — every bit of
                  interaction belongs to the range input above it, which is
                  why this is aria-hidden and not focusable. */}
              <div class="before-after__divider" aria-hidden="true">
                <span class="before-after__grip">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" transform="translate(-4 0)" />
                    <polyline points="9 18 15 12 9 6" transform="translate(4 0)" />
                  </svg>
                </span>
              </div>
            </div>
            {pair.caption && <figcaption class="before-after__caption">{pair.caption}</figcaption>}
          </figure>
        );
      })}
    </div>

    {note && <p class="before-after__note">{note}</p>}
  </div>
</section>

<script>
  // Per-instance and per-pair, gathered by attribute rather than by a single
  // unscoped id/class query — the same scoping discipline the carousels in
  // this codebase were patched to use, and for the same reason: two of these
  // on one page must not cross-wire.
  //
  // The whole job is copying the input's value onto the frame's --ba-pos.
  // The clip and the divider both read that one property, so there is no
  // second source of truth to keep in step.
  document.querySelectorAll<HTMLElement>('[data-ba-frame]').forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const apply = () => frame.style.setProperty('--ba-pos', `${range.value}%`);
    // `input` covers drag, click, touch and keys alike.
    range.addEventListener('input', apply);
    // Re-assert once on load: a browser restoring a previous form value on
    // back/forward navigation changes the input without firing `input`, which
    // would leave the drawn divider out of step with the real control.
    apply();
  });
</script>

<style>
  .before-after__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .before-after__heading {
    max-width: 26ch;
  }

  .before-after__lead {
    max-width: 62ch;
    font-size: var(--text-big);
  }

  .before-after__grid {
    width: 100%;
    margin-top: var(--space-sm);
    display: grid;
    /* auto-fit rather than a fixed column count, so the component works with
       any number of pairs — same call SiteFooter.astro's link grid makes.
       The 420px floor is a usability minimum, not a look: below about that
       the handle has too little travel for a drag to feel like a comparison
       rather than a fidget. Two pairs sit side by side in a 1200px container
       and drop to one column on their own well before phone widths. */
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: var(--space-lg);
  }

  .before-after__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .before-after__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    /* --ba-pos is set inline per pair and then updated by the script. The
       fallback matters: with JS disabled or still parsing, every layer below
       reads this and the pair renders as a clean static split rather than as
       one image with an invisible one on top. */
    --ba-pos: 50%;
    /* The frame is the drag surface, so say so on the whole thing — the
       divider is only 2px wide and the input covers the full box. */
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .before-after__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* cover, so a pair whose files differ slightly in ratio still aligns
       with ITSELF inside one frame. Set here rather than passed through a
       custom property because both layers always want the same fit. */
    object-fit: cover;
  }

  .before-after__overlay {
    position: absolute;
    inset: 0;
    /* Show only the left --ba-pos of this layer. inset() rather than a
       width change on a wrapper: the image inside must not RESIZE as the
       handle moves, only be revealed, or the two halves stop lining up and
       the wipe reads as a zoom. */
    clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0);
  }

  .before-after__tag {
    position: absolute;
    bottom: var(--space-xs);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-inverse);
    color: var(--color-on-inverse);
    font-family: var(--font-display);
    font-weight: var(--weight-heading);
    font-size: var(--text-small);
    /* Above the images, below the divider and the input. */
    z-index: 1;
    pointer-events: none;
  }

  .before-after__tag--before {
    left: var(--space-xs);
  }

  .before-after__tag--after {
    right: var(--space-xs);
  }

  .before-after__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Sits ON the clip's edge. The -1px centres the 2px line over it. */
    left: calc(var(--ba-pos) - 1px);
    width: 2px;
    background: var(--color-surface);
    z-index: 2;
    pointer-events: none;
  }

  .before-after__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(35, 75, 81, 0.35);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .before-after__frame:hover .before-after__grip {
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* The real control: full-frame, invisible, and on top of everything. */
  .before-after__range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    /* A range input's own thumb is a small target in the middle of the
       track; stretching the track over the frame and hiding it means a
       press anywhere in the image jumps the handle there, which is what
       people expect of these. */
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
  }

  .before-after__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    /* Full-height thumb so a webkit drag can start from anywhere vertically
       in the frame, not just a band across its middle. */
    width: 44px;
    height: 100%;
  }

  .before-after__range::-moz-range-thumb {
    width: 44px;
    height: 100%;
    border: none;
    opacity: 0;
  }

  /* The input is transparent, so its own focus ring would be invisible.
     Move the ring onto the drawn grip instead — global.css's focus-visible
     rule can't do this, since the thing that needs the ring isn't the thing
     that has focus. */
  .before-after__range:focus-visible ~ .before-after__divider .before-after__grip {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .before-after__caption {
    font-size: var(--text-small);
    color: var(--color-body);
  }

  .before-after__note {
    max-width: 62ch;
    margin-top: var(--space-xs);
    font-size: var(--text-small);
    color: var(--color-body);
  }

  /* Visually-hidden label for the range input. The control needs an
     accessible name — "slider, 50" tells a screen-reader user nothing about
     which two photos they are moving between. */
  .before-after__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Below the auto-fit floor the grid is already one column; this is about
     the section's own rhythm, matching every other section in this library. */
  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .before-after__inner {
      padding-block: var(--space-xl);
    }

    .before-after__grid {
      /* Drop the 420px floor at phone widths — a 1fr column narrower than
         the floor would otherwise overflow the container rather than shrink.
         Same "a breakpoint has to be able to beat a layout choice" problem
         ContentGrid.astro and TrustBar.astro both document. */
      grid-template-columns: 1fr;
    }

    .before-after__grip {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The wipe itself is direct manipulation and stays — suppressing it
       would break the control. Only the decorative hover grow goes. */
    .before-after__grip {
      transition: none;
    }

    .before-after__frame:hover .before-after__grip {
      transform: translate(-50%, -50%);
    }
  }
</style>
