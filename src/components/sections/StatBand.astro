---
import Button from '../ui/Button.astro';
import type { ButtonData } from '../../data/types';

type IconName = 'group' | 'heart' | 'language' | 'house';

interface Stat {
  icon: IconName;
  value: string;
  caption: string;
}

interface Props {
  heading: string;
  stats: Stat[];
  buttons: ButtonData[];
}

const { heading, stats, buttons } = Astro.props;
---

<section class="stat-band" aria-labelledby="stat-band-heading">
  <div class="container stat-band__inner">
    <h2 id="stat-band-heading" class="stat-band__heading">{heading}</h2>

    <ul class="stat-band__list">
      {stats.map((stat) => (
        <li class="stat-band__item">
          <span class="stat-band__badge" aria-hidden="true">
            {stat.icon === 'group' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="8" cy="8" r="3" />
                <circle cx="16" cy="8" r="3" />
                <path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke-linecap="round" />
                <path d="M12 20c0-3.3 2.7-6 6-6s4 2.7 4 6" stroke-linecap="round" />
              </svg>
            )}
            {stat.icon === 'heart' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 20s-7-4.4-9.5-9C.8 7.4 3 4 6.5 4c2 0 3.4 1 5.5 3 2.1-2 3.5-3 5.5-3 3.5 0 5.7 3.4 4 7-2.5 4.6-9.5 9-9.5 9Z" stroke-linejoin="round" />
                <path d="M8 11h2l1-2 2 4 1-2h2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {stat.icon === 'language' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.7 3.8 6 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-6-3.8-9S9.5 5.7 12 3Z" />
              </svg>
            )}
            {stat.icon === 'house' && (
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 11 12 4l9 7" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M5 10v9h14v-9" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M10 19v-5h4v5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </span>
          <p class="stat-band__value">{stat.value}</p>
          <p class="stat-band__caption">{stat.caption}</p>
        </li>
      ))}
    </ul>

    <div class="stat-band__actions">
      {buttons.map((button) => (
        <Button label={button.label} href={button.href} variant={button.variant ?? 'inverse-accent'} />
      ))}
    </div>
  </div>
</section>

<style>
  .stat-band {
    background: var(--color-brand);
  }

  .stat-band__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .stat-band__heading {
    color: var(--color-on-brand);
    text-align: center;
  }

  .stat-band__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    width: 100%;
  }

  .stat-band__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
  }

  /* ⚠️ WAS background:--color-inverse + color:--color-brand, WHICH RENDERED
     NOTHING AT ALL. tokens.css Layer 2 resolves --color-brand and
     --color-inverse to the same Dark Teal (#234B51), and `.stat-band` above
     already paints the band --color-brand. So this was a teal circle on a
     teal band holding a teal icon: three identical colours, the badge
     invisible against the band and the icon invisible against the badge.
     The <svg> children draw with stroke="currentColor", so they inherit
     whatever `color` is set here.

     A 96px circle is there to be SEEN, so the badge now takes the light ink
     role the band already uses for its heading (--color-on-brand, Off White)
     as its fill, with Dark Teal icons on top at 8.33:1.

     ⚠️ THIS FIX IS UNVERIFIED AGAINST A REAL RENDERING, because nothing
     consumes this component: locations/index.astro considered it and chose
     MetricsBlock instead, and that comment is the only mention of StatBand
     in the repo. The colours are the obvious reading of the original intent
     (light badge, dark icon, dark band) rather than something checked on a
     page. Look at it before shipping the first consumer.

     Same brand re-skin leftover as PathwayCards' heading accent, and the
     same bug class Callout.astro's style block warns about. When two roles
     resolve to one colour, a component that stacks them disappears. */
  .stat-band__badge {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-on-brand);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-xs);
  }

  .stat-band__value {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--title-3);
    color: var(--color-on-brand);
  }

  .stat-band__caption {
    color: var(--color-on-brand);
    font-size: var(--text-small);
    max-width: 22ch;
  }

  .stat-band__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .stat-band__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* mirrors --bp-sm */
  @media (max-width: 480px) {
    .stat-band__list {
      grid-template-columns: 1fr;
    }

    .stat-band__actions {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
