---
// Alternating two-column prose/image mosaic. Fully generic: blocks are
// rendered in DOM order into a 2-column grid, so whichever column an image
// or text block lands in is just a function of its position in the array —
// no special-casing. This is what makes it reusable both as the dark "About
// Maple" story (section 3) and, via theme="light" + an optional cta, as the
// "Who Can We Help?" AudienceCollage (section 7). Don't fork a new
// component for a variant of this shape — add a prop instead.
//
// ⚠️ This component rendered NOTHING BUT dashed placeholder boxes until the
// "by type of premises" cluster was built, because `StoryBlock` had no `src`
// field and this file never passed one to Placeholder. See the note on
// StoryBlock in src/data/types.ts — four pages shipped seven empty slots with
// the real photos already imported and sitting unused.
import Placeholder from '../ui/Placeholder.astro';
import Button from '../ui/Button.astro';
import type { StoryBlock, ButtonData } from '../../data/types';

interface Props {
  theme?: 'dark' | 'light';
  heading?: string;
  blocks: StoryBlock[];
  cta?: ButtonData;
}

const { theme = 'dark', heading, blocks, cta } = Astro.props;
---

<section class:list={['story', `story--${theme}`]} aria-labelledby={heading ? 'story-heading' : undefined}>
  <div class="container story__inner">
    {heading && <h2 id="story-heading" class="story__heading">{heading}</h2>}

    <div class="story__grid">
      {blocks.map((block) =>
        block.type === 'image' ? (
          <div class="story__image">
            <Placeholder ratio={block.ratio} label={block.label} src={block.src} />
          </div>
        ) : (
          <div class="story__text">
            {block.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      )}
    </div>

    {cta && (
      <div class="story__cta">
        <Button label={cta.label} href={cta.href} variant={cta.variant ?? 'brand'} />
      </div>
    )}
  </div>
</section>

<style>
  .story--dark {
    background: var(--color-inverse);
    color: var(--color-on-inverse);
  }

  .story--light {
    background: var(--color-surface);
    color: var(--color-on-surface);
  }

  .story__inner {
    padding-block: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .story--dark .story__heading,
  .story--dark :global(h2) {
    color: var(--color-on-inverse);
  }

  .story__heading {
    text-align: center;
  }

  .story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  /* Wrapped in a <div> authored here rather than passed to Placeholder as a
     class, per the passthrough scoping rule this library learned twice
     already (Hero.astro's note, and PathwayCards.astro's patch note): a class
     handed to a component lands under THAT component's scope, not this
     file's, so `.story__image` on Placeholder's own root element never
     matched and this border-radius silently did nothing. Invisible while
     every slot was an empty dashed box — the box inherits its corners from
     elsewhere — and visible the moment real photos went in. */
  .story__image {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .story__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    font-size: var(--text-big);
    line-height: var(--leading-normal);
  }

  .story--dark .story__text {
    color: var(--color-on-inverse);
  }

  .story--light .story__text {
    color: var(--color-body);
  }

  .story__cta {
    display: flex;
    justify-content: center;
  }

  /* mirrors --bp-md */
  @media (max-width: 768px) {
    .story__inner {
      padding-block: var(--space-xl);
    }

    .story__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
